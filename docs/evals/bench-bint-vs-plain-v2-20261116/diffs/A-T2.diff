diff --git a/internal/detect/log.go b/internal/detect/log.go
new file mode 100644
index 0000000..7d2a286
--- /dev/null
+++ b/internal/detect/log.go
@@ -0,0 +1,180 @@
+package detect
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"regexp"
+	"sort"
+	"strings"
+	"sync"
+)
+
+var (
+	credentialKey   = regexp.MustCompile(`(?i)(^|[_-])(password|passwd|pwd|token|secret|api[_-]?key|private[_-]?key|auth|authorization|cookie|credentials?)([_-]|$)|^(access[_-]?token|refresh[_-]?token|client[_-]?secret|apikey|set-cookie)$`)
+	credentialField = regexp.MustCompile(`(?i)(\b[\w-]*(?:password|passwd|pwd|token|secret|api[_-]?key|private[_-]?key|auth|authorization|cookie|credentials?)["']?\s*[:=]\s*)("(?:\\.|[^"\\])*"|'[^']*'|[^\s&,;]+)`)
+	authHeader      = regexp.MustCompile(`(?im)(\b(?:authorization|proxy-authorization|cookie|set-cookie)\s*:\s*)[^\r\n]+`)
+)
+
+// SecretValues selects credential values from the effective child environment.
+// It never changes that environment. Longest values are replaced first.
+func SecretValues(env []string) []string {
+	var values []string
+	for _, kv := range env {
+		k, v, ok := strings.Cut(kv, "=")
+		if ok && v != "" && credentialKey.MatchString(k) {
+			values = append(values, v)
+		}
+	}
+	return logSecrets(values)
+}
+
+func logSecrets(values []string) []string {
+	var out []string
+	for _, v := range values {
+		if v == "" {
+			continue
+		}
+		out = append(out, v)
+		if strings.ContainsAny(v, "\r\n") {
+			out = append(out, strings.FieldsFunc(v, func(r rune) bool { return r == '\r' || r == '\n' })...)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return len(out[i]) > len(out[j]) })
+	return out
+}
+
+// RedactLog preserves valid JSON, including JSON embedded in string fields.
+// Scrub before truncating so that a partial credential cannot survive the cut.
+func RedactLog(s string, values []string) string {
+	return redactLog(s, logSecrets(values))
+}
+
+func redactLog(s string, values []string) string {
+	trimmed := strings.TrimSpace(s)
+	if strings.HasPrefix(trimmed, "{") || strings.HasPrefix(trimmed, "[") {
+		var value any
+		d := json.NewDecoder(strings.NewReader(s))
+		d.UseNumber()
+		if d.Decode(&value) == nil && json.Valid([]byte(s)) {
+			if safe, changed := redactJSON(value, values); changed {
+				if b, err := json.Marshal(safe); err == nil {
+					return string(b)
+				}
+			}
+			return s
+		}
+	}
+	for _, v := range values {
+		if v != "" {
+			s = strings.ReplaceAll(s, v, "***")
+		}
+	}
+	s = authHeader.ReplaceAllString(s, "${1}***")
+	s = envAssign.ReplaceAllStringFunc(s, func(assignment string) string {
+		k, _, _ := strings.Cut(assignment, "=")
+		if credentialKey.MatchString(k) {
+			return k + "=***"
+		}
+		return assignment
+	})
+	s = secretFlags.ReplaceAllString(s, "${1}***")
+	s = credentialField.ReplaceAllString(s, "${1}***")
+	s = bearer.ReplaceAllString(s, "${1}***")
+	return urlCreds.ReplaceAllString(s, "${1}***@")
+}
+
+func redactJSON(v any, values []string) (any, bool) {
+	changed := false
+	switch x := v.(type) {
+	case string:
+		s := redactLog(x, values)
+		return s, s != x
+	case json.Number:
+		if redactLog(string(x), values) != string(x) {
+			return "***", true
+		}
+	case map[string]any:
+		for k, val := range x {
+			if credentialKey.MatchString(k) {
+				if s, ok := val.(string); !ok || s != "***" {
+					x[k], changed = "***", true
+				}
+			} else if safe, c := redactJSON(val, values); c {
+				x[k], changed = safe, true
+			}
+		}
+	case []any:
+		for i, val := range x {
+			if safe, c := redactJSON(val, values); c {
+				x[i], changed = safe, true
+			}
+		}
+	}
+	return v, changed
+}
+
+const maxLogLine = 64 << 10
+
+// LogWriter buffers a complete line before redaction, so split writes cannot
+// leak credentials. Oversized lines are omitted rather than partially logged.
+// Use separate writers for stdout and stderr and Flush after the process exits.
+type LogWriter struct {
+	mu       sync.Mutex
+	out      io.Writer
+	values   []string
+	buf      []byte
+	dropping bool
+}
+
+func NewLogWriter(out io.Writer, values []string) *LogWriter {
+	return &LogWriter{out: out, values: logSecrets(values)}
+}
+
+func (w *LogWriter) Write(p []byte) (int, error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	n := len(p)
+	for len(p) > 0 {
+		i := bytes.IndexByte(p, '\n')
+		end := len(p)
+		if i >= 0 {
+			end = i
+		}
+		if !w.dropping {
+			if len(w.buf)+end > maxLogLine {
+				w.buf = nil
+				w.dropping = true
+			} else {
+				w.buf = append(w.buf, p[:end]...)
+			}
+		}
+		if i < 0 {
+			break
+		}
+		if err := w.flush(true); err != nil {
+			return n, err
+		}
+		p = p[i+1:]
+	}
+	return n, nil
+}
+
+func (w *LogWriter) Flush() error {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	return w.flush(false)
+}
+
+func (w *LogWriter) flush(newline bool) error {
+	s := redactLog(string(w.buf), w.values)
+	if w.dropping {
+		s = "[bint: oversized log line omitted]"
+	}
+	if newline {
+		s += "\n"
+	}
+	w.buf, w.dropping = nil, false
+	_, err := io.WriteString(w.out, s)
+	return err
+}
