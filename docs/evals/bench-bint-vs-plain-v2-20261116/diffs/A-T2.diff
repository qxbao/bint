+package detect
+
+import (
+	"bytes"
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestLogWriterRedactsAtEveryChunkBoundary(t *testing.T) {
+	const input = "ready\n{\"password\":\"fixture-secret\",\"count\":9007199254740993}\nfixture-env-secret"
+	for split := 0; split <= len(input); split++ {
+		var out bytes.Buffer
+		w := NewLogWriter(&out, []string{"fixture-env-secret"})
+		if _, err := w.Write([]byte(input[:split])); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := w.Write([]byte(input[split:])); err != nil {
+			t.Fatal(err)
+		}
+		if err := w.Flush(); err != nil {
+			t.Fatal(err)
+		}
+		got := out.String()
+		if strings.Contains(got, "fixture-secret") || strings.Contains(got, "fixture-env-secret") {
+			t.Fatalf("credential leaked at split %d", split)
+		}
+		lines := strings.Split(got, "\n")
+		if len(lines) != 3 || lines[0] != "ready" || !json.Valid([]byte(lines[1])) ||
+			!strings.Contains(lines[1], "9007199254740993") || lines[2] != "***" {
+			t.Fatalf("log content lost at split %d: %q", split, got)
+		}
+	}
+}
+
+func TestLogWriterOmitsOversizedLine(t *testing.T) {
+	for _, ending := range []string{"", "\nready\n"} {
+		var out bytes.Buffer
+		w := NewLogWriter(&out, nil)
+		w.Write([]byte("password=" + strings.Repeat("s", maxLogLine)))
+		w.Write([]byte("secret-suffix" + ending))
+		w.Flush()
+		if strings.Contains(out.String(), "secret-suffix") || strings.Contains(out.String(), "ssss") {
+			t.Fatal("partial oversized credential was logged")
+		}
+		if !strings.Contains(out.String(), "omitted") || (ending != "" && !strings.Contains(out.String(), "ready")) {
+			t.Fatal("missing omission marker or subsequent diagnostic")
+		}
+	}
+}
+
+func TestSecretValuesRecognizesCredentialNames(t *testing.T) {
+	values := SecretValues([]string{"PATH=/safe/bin", "OUTPUT_TOKENS=1200", "AWS_SECRET_ACCESS_KEY=fixture-aws-secret",
+		"MY_TOKEN=fixture-token", "PRIVATE_KEY=fixture-private-key", "DB_PASSWORD=fixture-password", "EMPTY_TOKEN="})
+	got := RedactLog("/safe/bin 1200 fixture-aws-secret fixture-token fixture-private-key fixture-password", values)
+	if got != "/safe/bin 1200 *** *** *** ***" {
+		t.Fatal("environment credentials not scrubbed, or ordinary environment masked")
+	}
+}
+
+func TestLogRedactionPreservesOrdinaryAssignments(t *testing.T) {
+	const in = "BINT_RUN_ID=unset\nBINT_AGENT=1\nstatus=ready"
+	if got := RedactLog(in, nil); got != in {
+		t.Fatal("ordinary process diagnostics were masked")
+	}
+	if got := RedactLog("AWS_SECRET_ACCESS_KEY=fixture-secret", nil); strings.Contains(got, "fixture-secret") {
+		t.Fatal("credential assignment survived")
+	}
+}
+
+func TestRedactPrettyJSONLineAndMalformedJSON(t *testing.T) {
+	for _, in := range []string{`  "password": "fixture-secret",`, `{"access_token":"fixture-secret"`, `{"password":{"value":"fixture-secret"}}`, `  "private_key": "fixture-secret",`, `pwd: fixture-secret`, `credentials: fixture-secret`} {
+		if strings.Contains(RedactLog(in, nil), "fixture-secret") {
+			t.Error("credential leaked from JSON diagnostic")
+		}
+	}
+}
+
+func TestRedactLogOverlappingSecrets(t *testing.T) {
+	if got := RedactLog("abcdef", []string{"abc", "abcdef"}); got != "***" {
+		t.Fatalf("credential suffix survived: %q", got)
+	}
+}
+
+func TestLogWriterNormalizesKnownSecrets(t *testing.T) {
+	var out bytes.Buffer
+	w := NewLogWriter(&out, []string{"abc", "abcdef", "fixture-first-line\nfixture-second-line"})
+	w.Write([]byte("abcdef\nfixture-first-line\nfixture-second-line\n"))
+	w.Flush()
+	if out.String() != "***\n***\n***\n" {
+		t.Fatal("overlapping or multiline credential leaked")
+	}
+}
+
+func TestRedactKnownNumericCredentialInJSON(t *testing.T) {
+	for _, in := range []string{`{"ordinary":123456789}`, `[123456789]`} {
+		got := RedactLog(in, []string{"123456789"})
+		if strings.Contains(got, "123456789") || !json.Valid([]byte(got)) {
+			t.Fatal("numeric credential survived or JSON damaged")
+		}
+	}
+}
