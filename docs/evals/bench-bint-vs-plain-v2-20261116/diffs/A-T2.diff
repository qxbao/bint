+		10*time.Second, logPath,
+		append(os.Environ(), "BINT_REDACTION_FIXTURE=1", "BINT_TEST_TOKEN=fixture-env-secret"), nil, &stdout)
+	if !res.OK() {
+		t.Fatalf("fixture failed: %v", res.Err)
+	}
+	raw, err := os.ReadFile(logPath)
+	if err != nil {
+		t.Fatal(err)
