+
+func TestDaemonLogRedactsCredentials(t *testing.T) {
+	var out bytes.Buffer
+	d := &Daemon{opts: Options{Log: &out}, token: "fixture-gateway-credential"}
+	d.logf("upstream failed: %s", `{"password":"fixture-password","status":"failed"} fixture-gateway-credential`)
+	if got := out.String(); strings.Contains(got, "fixture") || !strings.Contains(got, "failed") || !strings.Contains(got, "***") {
+		t.Fatalf("unsafe daemon log: %q", got)
+	}
+}
+
+func TestCodegraphRedactsStreamsBeforeMerging(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("fixture requires an executable POSIX shell script")
+	}
+	testutil.Isolate(t)
+	bin := filepath.Join(t.TempDir(), "codegraph")
+	script := "#!/bin/sh\nprintf '%s' 'fixture-private-'\nprintf '%s\\n' 'index-progress' >&2\nprintf '%s\\n' 'token'\nexit 1\n"
+	if err := os.WriteFile(bin, []byte(script), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	secrets := filepath.Join(t.TempDir(), "secrets.env")
+	if err := os.WriteFile(secrets, []byte("CODEGRAPH_TOKEN=fixture-private-token\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	m := config.MachineMCP{Version: 1, SecretsFile: secrets, Services: map[string]config.Registration{
+		"codegraph": {Command: bin, EnvNames: []string{"CODEGRAPH_TOKEN"}},
+	}}
+	if err := config.SaveMachineMCP(m); err != nil {
+		t.Fatal(err)
+	}
+	var out bytes.Buffer
+	if _, err := CodegraphInit(context.Background(), t.TempDir(), &out); err == nil {
+		t.Fatal("expected fixture command to fail")
+	}
+	if got := out.String(); strings.Contains(got, "fixture-private-") || !strings.Contains(got, "index-progress") || !strings.Contains(got, "***") {
+		t.Fatalf("unsafe or missing codegraph diagnostics: %q", got)
+	}
+}
+
+func TestShimLogRedactsCredentials(t *testing.T) {
+	var out bytes.Buffer
+	s := &Shim{o: ShimOptions{Log: &out}}
+	s.logf("failed: %s", "password: fixture-password")
+	if got := out.String(); strings.Contains(got, "fixture") || !strings.Contains(got, "failed") || !strings.Contains(got, "***") {
+		t.Fatalf("unsafe shim log: %q", got)
+	}
+}
