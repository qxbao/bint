+// Sanitizing diagnostic copies must not alter the hook response or leave secrets
+// in nested JSON/commands, including an unterminated value at the trace size cap.
+func TestHookTraceRedactsSecrets(t *testing.T) {
+	root, ws := subagentRepo(t)
+	t.Setenv(HookTraceEnv, "1")
+	input := hookInput("sess-trace", "PostToolUse", root, map[string]any{
+		"tool_name": "Bash", "tool_use_id": "secret-trace",
+		"tool_input": map[string]any{"command": `curl --password "fixture command password"`, "token": "fixture-json-token"},
+	})
+	tr := startHookTrace("claude", "PostToolUse", []byte(input))
+	if tr == nil {
+		t.Fatal("trace not created")
+	}
+	tr.finish(hookcore.Result{Output: `{"access_token":"fixture-output-token"}`}, errors.New("password: fixture-error-password"), time.Millisecond)
+	for _, ext := range []string{".in", ".out"} {
+		b, err := os.ReadFile(tr.base + ext)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !json.Valid(b) || bytes.Contains(b, []byte("fixture")) || !bytes.Contains(b, []byte("***")) {
+			t.Fatalf("unsafe trace %s: %s", ext, b)
+		}
+	}
+	if len(traceFiles(t, ws)) != 2 {
+		t.Fatal("missing trace pair")
+	}
+	// A credential crossing the old size cap must be masked as a whole before
+	// the trace is truncated, rather than persisting its opening fragment.
+	big := hookInput("sess-trace", "PostToolUse", root, map[string]any{
+		"token": "fixture-prefix-" + strings.Repeat("x", maxHookTraceInput),
+	})
+	bigTrace := startHookTrace("claude", "PostToolUse", []byte(big))
+	if bigTrace == nil {
+		t.Fatal("large trace not created")
+	}
+	b, err := os.ReadFile(bigTrace.base + ".in")
+	if err != nil || !json.Valid(b) || len(b) > 1024 || bytes.Contains(b, []byte("fixture-prefix")) {
+		t.Fatalf("credential was truncated before redaction: len=%d, err=%v", len(b), err)
+	}
+	bigTrace.finish(hookcore.Result{}, nil, time.Millisecond)
+}
