+		t.Fatalf("execution changed: %+v", res)
+	}
+	want := "{\"password\":\"fixture password with spaces\",\"status\":\"ok\"}\nAuthorization: Bearer fixture-bearer\n" + `{"message":"run --password \"fixture embedded password\""}` + "\n" + `{"type":"item.completed","item":{"text":"{\"password\":{\"value\":\"fixture-private-password\"}}"}}` + "\nplain argument: fixture-argument-token\n"
+	if stdout.String() != want {
+		t.Fatalf("raw stdout changed: %q", stdout.String())
+	}
+	log, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for name, got := range map[string]string{"log": string(log), "tail": res.Tail} {
+		for _, secret := range []string{"fixture password", "fixture embedded password", "fixture-bearer", "fixture-env-credential", "fixture-final-password", "fixture-argument-token", "fixture-argument-password", "spaces-canary", "fixture-private-password", "fixture-private-token"} {
+			if strings.Contains(got, secret) {
+				t.Errorf("%s leaked %q", name, secret)
+			}
+		}
+		if !strings.Contains(got, `"status":"ok"`) || !strings.Contains(got, "***") {
+			t.Errorf("%s lost useful diagnostics: %q", name, got)
+		}
+	}
+}
+
+func TestRunShellRedactsStructuredCredentials(t *testing.T) {
+	for _, tc := range []struct {
+		name, command, secret string
+	}{
+		{"multiline JSON", `printf '{\n"password":\n"fixture-private-password"\n}\n'`, "fixture-private-password"},
+		{"shell comma", `set -- --password=fixture-prefix,fixture-suffix; printf '%s\n' "${1#*=}"`, "fixture-suffix"},
+		{"numeric JSON", `printf '{"value":%s,"count":42}\n' "$DB_PASSWORD"`, "123456789"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			log := filepath.Join(t.TempDir(), "output.log")
+			res := RunShell(context.Background(), t.TempDir(), tc.command, 10*time.Second, log, append(os.Environ(), "DB_PASSWORD=123456789"))
+			if !res.OK() {
+				t.Fatalf("fixture command failed: %+v", res)
+			}
+			data, err := os.ReadFile(log)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for name, got := range map[string]string{"log": string(data), "tail": res.Tail} {
+				if strings.Contains(got, tc.secret) || !strings.Contains(got, "***") {
+					t.Errorf("%s leaked credential or lost redaction: %q", name, got)
+				}
+			}
+		})
+	}
+}
