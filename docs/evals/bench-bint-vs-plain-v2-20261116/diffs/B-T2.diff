new file mode 100644
index 0000000..b3ae3e1
--- /dev/null
+++ b/internal/redact/redact.go
@@ -0,0 +1,380 @@
+// Package redact removes recognizable credentials from diagnostic copies of data.
+// It must never be used on the input to a command or an agent protocol decoder.
+package redact
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"regexp"
+	"slices"
+	"strings"
+	"sync"
+)
+
+const Marker = "***"
+
+const key = `(?:[a-z0-9]+[-_])*(?:password|passwd|pwd|(?:access|refresh|id)?[-_]?token|(?:client)?[-_]?secret|api[-_]?key|auth(?:orization)?|credentials?|private[-_]?key|access[-_]?key)(?:[-_](?:secret|token))?`
+const value = `"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'|[^\s,;&}"']+|"[^\r\n]*|'[^\r\n]*`
+
+// Commas and closing braces delimit JSON values, but are ordinary shell word
+// characters. Keep both interpretations when collecting credentials to scrub.
+const shellValue = `"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'|[^\s;&"']+`
+
+var (
+	sensitive       = regexp.MustCompile(`(?i)^` + key + `$`)
+	assignment      = regexp.MustCompile(`(?i)(\b` + key + `["']?\s*[:=]\s*)(` + value + `)`)
+	flag            = regexp.MustCompile(`(?i)(--?` + key + `[\t ]+)(` + value + `)`)
+	auth            = regexp.MustCompile(`(?i)(\b(?:bearer|basic)[\t ]+)([^\s"',;\\]+)`)
+	urlUser         = regexp.MustCompile(`(://)[^/\s@]+@`)
+	quoted          = regexp.MustCompile(`"(?:\\.|[^"\\])*"`)
+	shellAssignment = regexp.MustCompile(`(?i)(\b` + key + `[\t ]*=[\t ]*)(` + shellValue + `)`)
+	shellFlag       = regexp.MustCompile(`(?i)(--?` + key + `[\t ]+)(` + shellValue + `)`)
+	// Common standalone tokens, including those copied without a key name.
+	token = regexp.MustCompile(`\b(?:gh[pousr]_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{10,})\b`)
+)
+
+// String preserves diagnostic structure while masking common credential fields,
+// flags, Authorization values, URL credentials and recognizable token formats.
+func String(s string) string {
+	return text(s, 0)
+}
+
+func text(s string, depth int) string {
+	// Agent JSON often embeds commands in escaped strings. If such a field
+	// contains a credential, mask the whole field; rescanning re-encoded quotes
+	// as shell syntax could otherwise expose fragments or corrupt the JSON.
+	s = quoted.ReplaceAllStringFunc(s, func(q string) string {
+		if !strings.Contains(q, `\`) {
+			return q
+		}
+		if depth >= 8 {
+			return `"***"`
+		}
+		var decoded string
+		if json.Unmarshal([]byte(q), &decoded) != nil {
+			return q
+		}
+		clean := text(decoded, depth+1)
+		if clean == decoded {
+			return q
+		}
+		return `"***"`
+	})
+	s = auth.ReplaceAllString(s, "${1}"+Marker)
+	for _, re := range []*regexp.Regexp{shellAssignment, shellFlag, assignment, flag} {
+		s = re.ReplaceAllStringFunc(s, func(m string) string {
+			parts := re.FindStringSubmatch(m)
+			v := Marker
+			if parts[2][0] == '"' || parts[2][0] == '\'' {
+				v = string(parts[2][0]) + Marker + string(parts[2][0])
+			}
+			return parts[1] + v
+		})
+	}
+	s = urlUser.ReplaceAllString(s, "${1}"+Marker+"@")
+	return token.ReplaceAllString(s, Marker)
+}
+
+// Values extracts labeled credentials from the original command solely for
+// masking later unlabeled echoes. It never changes the command being executed.
+func Values(s string) []string {
+	var out []string
+	for _, re := range []*regexp.Regexp{assignment, flag, auth, shellAssignment, shellFlag} {
+		for _, match := range re.FindAllStringSubmatch(s, -1) {
+			v := match[2]
+			if strings.HasPrefix(v, `"`) {
+				var decoded string
+				if json.Unmarshal([]byte(v), &decoded) == nil {
+					v = decoded
+				}
+			} else if strings.HasPrefix(v, "'") {
+				v = strings.Trim(v, "'")
+			}
+			if v != "" && v != Marker && !strings.EqualFold(v, "Bearer") && !strings.EqualFold(v, "Basic") {
+				out = append(out, v)
+			}
+		}
+	}
+	return out
+}
+
+// ArgSecrets also respects argv boundaries: an entire argument following a
+// sensitive flag is a credential, including any spaces or punctuation in it.
+func ArgSecrets(args []string) []string {
+	var out []string
+	for i, arg := range args {
+		out = append(out, Values(arg)...)
+		name, val, assigned := strings.Cut(strings.TrimLeft(arg, "-"), "=")
+		if assigned && sensitive.MatchString(name) {
+			out = append(out, val)
+		} else if strings.HasPrefix(arg, "-") && sensitive.MatchString(name) && i+1 < len(args) {
+			out = append(out, args[i+1])
+		}
+	}
+	return out
+}
+
+// EnvSecrets returns credential values from the effective child environment.
+// Matching is by name; ordinary variables (PATH, model names, etc.) stay useful.
+func EnvSecrets(env []string) []string {
+	var out []string
+	for _, kv := range env {
+		k, v, ok := strings.Cut(kv, "=")
+		if ok && v != "" && sensitive.MatchString(k) {
+			out = append(out, v)
+		}
+	}
+	return out
+}
+
+// WithSecrets also masks exact credential values, even when output has no label.
+func WithSecrets(s string, secrets []string) string {
+	// Match labels before literal replacement: a short credential could itself
+	// occur inside "token" or "password" and otherwise hide the label.
+	s = String(s)
+	// Longest first: one credential may be a prefix of another.
+	vals := slices.Clone(secrets)
+	// A multiline credential is written as several log lines. Mask its pieces
+	// as well, since the writer deliberately never persists an unchecked line.
+	for _, v := range secrets {
+		if strings.ContainsAny(v, "\r\n") {
+			vals = append(vals, strings.FieldsFunc(v, func(r rune) bool { return r == '\r' || r == '\n' })...)
+		}
+	}
+	slices.SortFunc(vals, func(a, b string) int { return len(b) - len(a) })
+	for _, v := range vals {
+		if v == "" {
+			continue
+		}
+		s = strings.ReplaceAll(s, v, Marker)
+		// Credentials can appear in JSON strings with escaped quotes/newlines.
+		b, _ := json.Marshal(v)
+		if escaped := string(b[1 : len(b)-1]); escaped != v {
+			s = strings.ReplaceAll(s, escaped, Marker)
+		}
+		// A labeled unquoted value may have been masked up to a delimiter by
+		// String. Remove the rest of that known value adjacent to the marker,
+		// rather than leaving a password suffix after a space or comma.
+		for i, r := range v {
+			if strings.ContainsRune(" \t\r\n,;&}\"'", r) {
+				s = strings.ReplaceAll(s, Marker+v[i:], Marker)
+			}
+		}
+	}
+	return s
+}
+
+// JSON sanitizes keys and nested strings without breaking JSON quoting. Clean
+// input is returned verbatim so existing trace readers retain their formatting.
+func JSON(data []byte, secrets ...string) []byte {
+	return jsonAtDepth(data, secrets, 0)
+}
+
+func jsonAtDepth(data []byte, secrets []string, depth int) []byte {
+	var v any
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.UseNumber()
+	if !json.Valid(data) || dec.Decode(&v) != nil {
+		return []byte(WithSecrets(string(data), secrets))
+	}
+	if depth >= 8 {
+		// Bound decoding of JSON embedded in strings. Omit the whole value
+		// rather than falling back to regexes that cannot mask containers.
+		return []byte(`"***"`)
+	}
+	var walk func(any) (any, bool)
+	walk = func(v any) (any, bool) {
+		changed := false
+		switch x := v.(type) {
+		case map[string]any:
+			for k, child := range x {
+				if sensitive.MatchString(k) {
+					x[k], changed = Marker, true
+				} else {
+					var c bool
+					x[k], c = walk(child)
+					changed = changed || c
+				}
+			}
+		case []any:
+			for i, child := range x {
+				var c bool
+				x[i], c = walk(child)
+				changed = changed || c
+			}
+		case string:
+			// Agent/tool text can itself be serialized JSON, including object
+			// or array credentials. Decode it before applying text patterns.
+			s := x
+			if trimmed := strings.TrimSpace(x); len(trimmed) > 0 && strings.ContainsRune(`{["`, rune(trimmed[0])) {
+				s = string(jsonAtDepth([]byte(x), secrets, depth+1))
+			}
+			s = WithSecrets(s, secrets)
+			return s, s != x
+		case json.Number:
+			if WithSecrets(x.String(), secrets) != x.String() {
+				// Replacing digits with a marker must produce a JSON string,
+				// while unrelated numbers keep their original precision.
+				return Marker, true
+			}
+		}
+		return v, changed
+	}
+	v, changed := walk(v)
+	if !changed {
+		return data
+	}
+	b, _ := json.Marshal(v)
+	return b
+}
+
+// Writer buffers lines and complete JSON objects/arrays before redaction, so
+// secrets spanning writes or JSON lines are never partially persisted. Each
+// independent stream needs its own Writer. Close does not close the destination.
+type Writer struct {
+	mu         sync.Mutex
+	dst        io.Writer
+	secrets    []string
+	needles    [][]byte
+	buf        []byte
+	dropping   bool
+	started    bool
+	structured bool
+	depth      int
+	quoted     bool
+	escaped    bool
+}
+
+const maxLine = 64 << 10
+
+func NewWriter(dst io.Writer, secrets []string) *Writer {
+	w := &Writer{dst: dst, secrets: slices.Clone(secrets)}
+	for _, v := range secrets {
+		if v == "" {
+			continue
+		}
+		w.needles = append(w.needles, []byte(v))
+		for _, line := range strings.FieldsFunc(v, func(r rune) bool { return r == '\r' || r == '\n' }) {
+			w.needles = append(w.needles, []byte(line))
+		}
+		b, _ := json.Marshal(v)
+		w.needles = append(w.needles, bytes.Clone(b[1:len(b)-1]))
+	}
+	return w
+}
+
+func (w *Writer) Write(p []byte) (int, error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	n := len(p)
+	for len(p) > 0 {
+		i := bytes.IndexByte(p, '\n')
+		end := len(p)
+		if i >= 0 {
+			end = i + 1
+		}
+		w.frame(p[:end])
+		if !w.dropping && len(w.buf)+end > maxLine {
+			// Omit the whole record, including all remaining JSON lines.
+			w.buf = nil
+			w.dropping = true
+			if _, err := io.WriteString(w.dst, "[bint: oversized log line omitted]\n"); err != nil {
+				return 0, err
+			}
+		}
+		if !w.dropping {
+			w.buf = append(w.buf, p[:end]...)
+		}
+		p = p[end:]
+		if i >= 0 && (!w.structured || w.depth == 0) {
+			if err := w.flush(); err != nil {
+				return 0, err
+			}
+			w.dropping = false
+			w.started, w.structured, w.quoted, w.escaped = false, false, false, false
+		}
+	}
+	return n, nil
+}
+
+// frame tracks only record boundaries; JSON performs validation and redaction.
+// Quotes and escapes prevent braces inside strings from ending a record early.
+func (w *Writer) frame(p []byte) {
+	for _, c := range p {
+		if !w.started {
+			if c == ' ' || c == '\t' || c == '\r' || c == '\n' {
+				continue
+			}
+			w.started = true
+			w.structured = c == '{' || c == '['
+		}
+		if !w.structured {
+			return
+		}
+		if w.quoted {
+			if w.escaped {
+				w.escaped = false
+			} else if c == '\\' {
+				w.escaped = true
+			} else if c == '"' {
+				w.quoted = false
+			}
+			continue
+		}
+		switch c {
+		case '"':
+			w.quoted = true
+		case '{', '[':
+			w.depth++
+		case '}', ']':
+			if w.depth > 0 {
+				w.depth--
+			}
+		}
+	}
+}
+
+func (w *Writer) flush() error {
+	if len(w.buf) == 0 {
+		return nil
+	}
+	payload := w.buf
+	// Ordinary progress rows need no JSON/regex passes. Every labeled pattern
+	// requires a separator; standalone tokens and known (also JSON-escaped or
+	// multiline) values are checked separately before taking this fast path.
+	check := bytes.ContainsAny(payload, "=: \t") || token.Match(payload)
+	if !check {
+		for _, v := range w.needles {
+			if bytes.Contains(payload, v) {
+				check = true
+				break
+			}
+		}
+	}
+	if check {
+		payload = JSON(payload, w.secrets...)
+		if w.buf[len(w.buf)-1] == '\n' && (len(payload) == 0 || payload[len(payload)-1] != '\n') {
+			payload = append(payload, '\n')
+		}
+	}
+	n, err := w.dst.Write(payload)
+	if err == nil && n < len(payload) {
+		err = io.ErrShortWrite
+	}
+	w.buf = w.buf[:0]
+	return err
+}
+
+func (w *Writer) Close() error {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.structured && w.depth > 0 && !w.dropping {
+		// A truncated object may contain a credential whose label was on an
+		// earlier line. Do not persist a fragment without a complete parse.
+		w.buf = nil
+		_, err := io.WriteString(w.dst, "[bint: incomplete JSON log record omitted]\n")
+		return err
+	}
+	return w.flush()
+}
diff --git a/internal/redact/redact_test.go b/internal/redact/redact_test.go
new file mode 100644
index 0000000..76efdc0
--- /dev/null
+++ b/internal/redact/redact_test.go
@@ -0,0 +1,248 @@
+package redact
+
+import (
+	"bytes"
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestString(t *testing.T) {
+	for _, tc := range []struct{ in, want string }{
+		{`{"password":"a\"b c","status":"ok"}`, `{"password":"***","status":"ok"}`},
+		{`--token   "one two" --verbose`, `--token   "***" --verbose`},
+		{`OPENAI_API_KEY=fixture-key count=3`, `OPENAI_API_KEY=*** count=3`},
+		{`password=fixture-prefix,fixture-suffix; status=ok`, `password=***; status=ok`},
+		{`--password fixture-prefix,fixture-suffix --verbose`, `--password *** --verbose`},
+		{`https://user:pass@host/path?access_token=abc&mode=read`, `https://***@host/path?access_token=***&mode=read`},
+		{`https://fixture-token@host/path`, `https://***@host/path`},
+		{`Bearer abc.def-ghi`, `Bearer ***`},
+		{`Basic dXNlcjpwYXNz`, `Basic ***`},
+		{`password: "unfinished secret`, `password: "***"`},
+		{`exit_code=1 input_tokens=128 src/main.go:42`, `exit_code=1 input_tokens=128 src/main.go:42`},
+		{`{"accessToken":"camel-case-secret"}`, `{"accessToken":"***"}`},
+		{`failed: {"message":"run --password \"fixture password\""}`, `failed: {"message":"***"}`},
+	} {
+		if got := String(tc.in); got != tc.want {
+			t.Errorf("String(%q) = %q, want %q", tc.in, got, tc.want)
+		}
+	}
+}
+
+func TestWriterEverySplit(t *testing.T) {
+	const in = "status=ok\npassword=\"fixture secret\"\nAuthorization: Bearer fixture-token\nfinal fixture-env-value"
+	for split := 0; split <= len(in); split++ {
+		var out bytes.Buffer
+		w := NewWriter(&out, []string{"fixture-env-value"})
+		for _, part := range []string{in[:split], in[split:]} {
+			if n, err := w.Write([]byte(part)); err != nil || n != len(part) {
+				t.Fatalf("Write at %d: %d, %v", split, n, err)
+			}
+		}
+		if err := w.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if got := out.String(); strings.Contains(got, "fixture") || !strings.HasPrefix(got, "status=ok\n") || !strings.HasSuffix(got, "final ***") {
+			t.Fatalf("split %d: %q", split, got)
+		}
+	}
+}
+
+func TestWriterOversizedLine(t *testing.T) {
+	var out bytes.Buffer
+	w := NewWriter(&out, nil)
+	// No part of this oversized quoted value may reach the destination.
+	w.Write([]byte(`password="` + strings.Repeat("private", maxLine)))
+	w.Write([]byte("private-suffix\"\nnext line\n"))
+	w.Close()
+	if got := out.String(); strings.Contains(got, "private") || !strings.HasSuffix(got, "next line\n") || len(got) > 100 {
+		t.Fatalf("oversized line leaked or lost following line: %q", got)
+	}
+}
+
+func TestWriterKnownMultilineSecret(t *testing.T) {
+	var out bytes.Buffer
+	w := NewWriter(&out, []string{"first-private-line\nsecond-private-line"})
+	w.Write([]byte("first-private-line\nsecond-private-line\nstatus=ok\n"))
+	w.Close()
+	if got := out.String(); strings.Contains(got, "private") || !strings.Contains(got, "status=ok") {
+		t.Fatalf("multiline credential leaked: %q", got)
+	}
+}
+
+func TestWriterKnownEscapedSecret(t *testing.T) {
+	var out bytes.Buffer
+	w := NewWriter(&out, []string{"first\nsecond"})
+	w.Write([]byte(`"first\nsecond"` + "\n"))
+	w.Close()
+	if got := strings.TrimSpace(out.String()); got != `"***"` {
+		t.Fatalf("escaped bare credential leaked: %q", got)
+	}
+}
+
+func TestJSON(t *testing.T) {
+	in := []byte(`{"password":{"nested":"secret"},"tool_input":{"command":"curl --token 'fixture secret'"},"count":9007199254740993}`)
+	got := JSON(in)
+	if !json.Valid(got) || strings.Contains(string(got), "secret") || !bytes.Contains(got, []byte("9007199254740993")) {
+		t.Fatalf("unsafe or invalid JSON: %s", got)
+	}
+	clean := []byte("{ \"status\" : \"ok\" }\n")
+	if !bytes.Equal(JSON(clean), clean) {
+		t.Fatal("clean trace formatting changed")
+	}
+}
+
+func TestWriterEmbeddedJSONCredentials(t *testing.T) {
+	for _, in := range []string{
+		`{"type":"item.completed","item":{"text":"{\"password\":{\"value\":\"fixture-private-password\"}}"},"status":"ok"}`,
+		`{"content":"{\"access_token\":[\"fixture-private-token\"]}","status":"ok"}`,
+		`{"content":"[{\"credentials\":{\"value\":\"fixture-private-password\"}}]","status":"ok"}`,
+		`{"content":"{\"text\":\"{\\\"password\\\":{\\\"value\\\":\\\"fixture-private-password\\\"}}\"}","status":"ok"}`,
+	} {
+		for split := 0; split <= len(in); split++ {
+			var out bytes.Buffer
+			w := NewWriter(&out, nil)
+			for _, part := range []string{in[:split], in[split:]} {
+				if _, err := w.Write([]byte(part)); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if err := w.Close(); err != nil {
+				t.Fatal(err)
+			}
+			got := out.Bytes()
+			if !json.Valid(got) || bytes.Contains(got, []byte("fixture-private")) || !bytes.Contains(got, []byte(`"status":"ok"`)) || !bytes.Contains(got, []byte(Marker)) {
+				t.Fatalf("split %d: embedded credential leaked or diagnostics lost: %s", split, got)
+			}
+		}
+	}
+}
+
+func TestJSONEmbeddedCleanFormatting(t *testing.T) {
+	in := []byte(`{ "text": "{ \"count\": 9007199254740993, \"status\": \"ok\" }", "content": "[1, 2]" }`)
+	if got := JSON(in); !bytes.Equal(got, in) {
+		t.Fatalf("clean embedded JSON changed: %s", got)
+	}
+}
+
+func TestJSONEmbeddedDepthLimit(t *testing.T) {
+	in := []byte(`{"password":{"value":"fixture-private-password"}}`)
+	for range 12 {
+		var err error
+		in, err = json.Marshal(map[string]string{"content": string(in)})
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	got := JSON(in)
+	if !json.Valid(got) || bytes.Contains(got, []byte("fixture-private-password")) || !bytes.Contains(got, []byte(Marker)) {
+		t.Fatalf("deeply embedded credential leaked or invalid JSON: %s", got)
+	}
+}
+
+func TestJSONKnownStringCredential(t *testing.T) {
+	for _, secret := range []string{"true", "null", "123456789", `{"value":"private"}`} {
+		in, err := json.Marshal(map[string]string{"text": secret, "status": "ok"})
+		if err != nil {
+			t.Fatal(err)
+		}
+		got := JSON(in, secret)
+		if string(got) != `{"status":"ok","text":"***"}` {
+			t.Errorf("known credential %q leaked or diagnostics changed: %s", secret, got)
+		}
+	}
+}
+
+func TestKnownSecrets(t *testing.T) {
+	secrets := EnvSecrets([]string{"PATH=/usr/bin", "BINT_FIXTURE_TOKEN=longer-secret", "DB_PASSWORD=longer", "EMPTY_SECRET="})
+	got := WithSecrets("longer-secret longer /usr/bin", secrets)
+	if got != "*** *** /usr/bin" {
+		t.Fatalf("known credentials: %q", got)
+	}
+	// A short known value must not destroy the label before pattern matching.
+	if got := WithSecrets("token=unrelated-secret", []string{"ok"}); strings.Contains(got, "unrelated-secret") {
+		t.Fatalf("known value obscured a credential label: %q", got)
+	}
+	for _, secret := range []string{"prefix suffix", "prefix,suffix"} {
+		if got := WithSecrets("password="+secret, []string{secret}); got != "password=***" {
+			t.Fatalf("known credential suffix leaked: %q", got)
+		}
+	}
+}
+
+func TestArgSecretsKeepsValueBoundaries(t *testing.T) {
+	secrets := ArgSecrets([]string{"--password=prefix suffix", "--token", "one,two", "-c", `curl --api-key "three four"`})
+	if got := WithSecrets("prefix suffix / one,two / three four", secrets); got != "*** / *** / ***" {
+		t.Fatalf("argument value boundary lost: %q", got)
+	}
+}
+
+func TestWriterMultilineJSONEverySplit(t *testing.T) {
+	const in = "{\n\"password\":\n{\"nested\":[\"fixture-private-password\"]},\n\"status\":\"ok\"\n}\nnext row\n"
+	for split := 0; split <= len(in); split++ {
+		var out bytes.Buffer
+		w := NewWriter(&out, nil)
+		for _, part := range []string{in[:split], in[split:]} {
+			if _, err := w.Write([]byte(part)); err != nil {
+				t.Fatal(err)
+			}
+			if strings.Contains(out.String(), "fixture-private-password") {
+				t.Fatalf("split %d persisted a credential before Close", split)
+			}
+		}
+		if err := w.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if got := out.String(); strings.Contains(got, "fixture-private-password") || !strings.Contains(got, `"status":"ok"`) || !strings.HasSuffix(got, "next row\n") {
+			t.Fatalf("split %d: unsafe or missing diagnostics: %q", split, got)
+		}
+	}
+}
+
+func TestJSONKnownNumericCredential(t *testing.T) {
+	in := []byte(`{"value":123456789,"count":42}`)
+	got := JSON(in, "123456789")
+	if !json.Valid(got) || bytes.Contains(got, []byte("123456789")) || !bytes.Contains(got, []byte(`"count":42`)) {
+		t.Fatalf("numeric credential leaked or unrelated count changed: %s", got)
+	}
+}
+
+func TestWriterJSONRecordBoundaries(t *testing.T) {
+	for _, tc := range []struct {
+		name, input string
+		omitted     bool
+	}{
+		{"array with quoted braces", "[\n{\"status\":\"brace } and quote \\\" [\",\n\"password\":\n\"fixture-private-password\"}\n]\nnext row\n", false},
+		{"oversized", "{\n\"filler\":\"" + strings.Repeat("x", maxLine) + "\",\n\"password\":\n\"fixture-private-password\"\n}\nnext row\n", true},
+		{"incomplete", "{\n\"password\":\n{\"value\":\"fixture-private-password\"}\n", true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var out bytes.Buffer
+			w := NewWriter(&out, nil)
+			// Include boundaries inside quotes and escapes, as real pipe reads do.
+			for i := 0; i < len(tc.input); i += 7 {
+				if _, err := w.Write([]byte(tc.input[i:min(i+7, len(tc.input))])); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if err := w.Close(); err != nil {
+				t.Fatal(err)
+			}
+			got := out.String()
+			if strings.Contains(got, "fixture-private-password") || strings.Contains(got, "omitted") != tc.omitted {
+				t.Fatalf("unsafe or unexpected JSON log: %q", got)
+			}
+			if strings.HasSuffix(tc.input, "next row\n") && !strings.HasSuffix(got, "next row\n") {
+				t.Fatalf("lost next record: %q", got)
+			}
+		})
+	}
+}
+
+func TestShellSecretsKeepsCommaInValue(t *testing.T) {
+	for _, command := range []string{`set -- --password=fixture-prefix,fixture-suffix; echo "$1"`, `tool --password fixture-prefix,fixture-suffix`} {
+		if got := WithSecrets("fixture-prefix,fixture-suffix", Values(command)); got != Marker {
+			t.Fatalf("shell credential boundary lost: %q", got)
+		}
+	}
+}
