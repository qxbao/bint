+package workflow
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"bint/internal/eval"
+	"bint/internal/spool"
+)
+
+func TestRunnerLogRedactsCommandCredentials(t *testing.T) {
+	var out bytes.Buffer
+	r := &Runner{Logf: func(format string, args ...any) { fmt.Fprintf(&out, format, args...) }}
+	r.logf("verify: %s → failed", `test --password "fixture password" --token=fixture-token`)
+	if got := out.String(); strings.Contains(got, "fixture") || !strings.Contains(got, "failed") || !strings.Contains(got, "***") {
+		t.Fatalf("unsafe workflow log: %q", got)
+	}
+}
+
+func TestWorkflowSummaryRedactedBeforePersistence(t *testing.T) {
+	h := newHarness(t)
+	t.Setenv("BINT_FIXTURE_TOKEN", "fixture-unlabeled-private")
+	h.mutate = func(_ string, res *eval.AgentResult) {
+		// Redaction must precede truncation: the label fits in the summary,
+		// but the credential extends beyond its 500-character limit.
+		res.Text = "status=ok fixture-unlabeled-private password=\"" + strings.Repeat("fixture-private-", 60) + "\""
+	}
+	ctx := context.Background()
+	res, err := h.runner().Run(ctx, RunOptions{Workflow: StepFeat, Request: "Update app.txt"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	files, err := filepath.Glob(filepath.Join(h.spool, "*.jsonl"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	seen := false
+	for _, file := range files {
+		data, err := os.ReadFile(file)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if strings.Contains(string(data), "fixture-private-") || strings.Contains(string(data), "fixture-unlabeled-private") {
+			t.Fatal("credential persisted in workflow spool")
+		}
+		events, err := spool.ReadFile(file)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, ev := range events {
+			if ev.Type == spool.WorkflowFinished && ev.RunID != res.RunID && ev.Payload["result_summary"] != nil {
+				seen = true
+				if got := ev.Payload["result_summary"]; got != `status=ok *** password="***"` {
+					t.Errorf("unexpected persisted summary: %v", got)
+				}
+			}
+		}
+	}
+	if !seen {
+		t.Fatal("missing workflow result summary")
+	}
+	s := h.ingest()
+	var summary string
+	if err := s.DB.QueryRowContext(ctx, `SELECT result_summary FROM runs WHERE parent_run_id = ? AND result_summary IS NOT NULL`, res.RunID).Scan(&summary); err != nil {
+		t.Fatal(err)
+	}
+	if summary != `status=ok *** password="***"` {
+		t.Fatalf("unsafe summary in run history: %q", summary)
+	}
+}
+
+func TestWorkflowEventRedactsDiagnosticCopies(t *testing.T) {
+	e := &Env{Root: t.TempDir(), Spool: t.TempDir()}
+	payload := map[string]any{
+		"result_summary": "{\n\"password\":\n{\"value\":\"fixture-summary-private\"}\n}",
+		"end_reason":     "failed: --token fixture-prefix,fixture-suffix",
+		"task_id":        "task-fixture",
+		"cost_usd":       0.25,
+	}
+	if err := e.emitRun("run-fixture", spool.WorkflowFinished, payload); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(payload["result_summary"].(string), "fixture-summary-private") || !strings.Contains(payload["end_reason"].(string), "fixture-suffix") {
+		t.Fatal("redaction changed the caller's result")
+	}
+	files, err := filepath.Glob(filepath.Join(e.Spool, "*.jsonl"))
+	if err != nil || len(files) != 1 {
+		t.Fatalf("expected one spool file, got %v: %v", files, err)
+	}
+	events, err := spool.ReadFile(files[0])
+	if err != nil || len(events) != 1 {
+		t.Fatalf("expected one event, got %v: %v", events, err)
+	}
+	got := events[0].Payload
+	if got["result_summary"] != `{"password":"***"}` || got["end_reason"] != "failed: --token ***" || got["task_id"] != "task-fixture" || got["cost_usd"] != 0.25 {
+		t.Fatalf("unsafe diagnostics or changed metadata: %v", got)
+	}
+}
