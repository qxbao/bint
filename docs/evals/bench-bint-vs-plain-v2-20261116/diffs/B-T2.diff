 	"path/filepath"
 	"strings"
 	"time"
@@ -12,6 +14,7 @@ import (
 	"bint/internal/flow"
 	adapters "bint/internal/harness"
 	"bint/internal/harness/hookcore"
+	"bint/internal/redact"
 	"bint/internal/spool"
 	"bint/internal/task"
 	"bint/internal/ulid"
@@ -965,6 +968,20 @@ func (e *Env) discardPendingForCancel(t *task.Task) {
 
 // emitRun ghi sự kiện của một lượt chạy do Bint cấp (Runner có bản gắn nhật ký lỗi ghi).
 func (e *Env) emitRun(runID, typ string, payload map[string]any) error {
+	// Sanitize diagnostic copies at the persistence boundary, before the spool
+	// and SQLite history can see them. Keep routing IDs and the caller's data.
+	payload = maps.Clone(payload)
+	secrets := redact.EnvSecrets(os.Environ())
+	for _, key := range []string{"result_summary", "end_reason"} {
+		if s, ok := payload[key].(string); ok {
+			s = string(redact.JSON([]byte(s), secrets...))
+			if key == "result_summary" {
+				// A truncated value can lose its closing quote or label.
+				s = truncate(s, 500)
+			}
+			payload[key] = s
+		}
+	}
 	ev := spool.Event{SchemaVersion: spool.SchemaVersion, EventID: "ev_wf_" + ulid.New(), Type: typ, Source: "bint-run",
 		Timestamp: e.now().UTC(), RunID: runID, Worktree: e.Root, Payload: payload}
 	_, err := spool.Write(e.Spool, ev)
