--- /dev/null
+++ b/internal/state/cleanup_windows.go
@@ -0,0 +1,20 @@
+//go:build windows
+
+package state
+
+import (
+	"os"
+	"syscall"
+)
+
+func cleanupLink(fi os.FileInfo) bool {
+	if fi.Mode()&os.ModeSymlink != 0 {
+		return true
+	}
+	if data, ok := fi.Sys().(*syscall.Win32FileAttributeData); ok {
+		return data.FileAttributes&syscall.FILE_ATTRIBUTE_REPARSE_POINT != 0
+	}
+	return true // Unknown metadata cannot establish that a junction is absent.
+}
+
+func cleanupOpenFlags(flags int) int { return flags }
