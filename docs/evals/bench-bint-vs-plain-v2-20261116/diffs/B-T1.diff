+)
+
+func appCleanupLog(t *testing.T, ws *Workspace) string {
+	t.Helper()
+	p := filepath.Join(ws.Paths.Runtime, "evolve", "old.log")
+	if err := os.MkdirAll(filepath.Dir(p), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(p, []byte("old diagnostic"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	old := time.Now().Add(-100 * 24 * time.Hour)
+	if err := os.Chtimes(p, old, old); err != nil {
+		t.Fatal(err)
+	}
+	if err := state.RecordCompletedDiagnostic(ws.Paths, p); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+func TestCleanupRunsOnlyAfterSuccessfulIngest(t *testing.T) {
+	root, ws := subagentRepo(t)
+	path := appCleanupLog(t, ws)
+	ctx := context.Background()
+	if _, err := OpenWorkspace(ctx, root, true); err != nil {
+		t.Fatal(err)
+	}
+	traceRun(t, root, traceInput(root))
+	if _, err := StatusNoIngest(ctx, root); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(path); err != nil {
+		t.Fatalf("read/hook removed log: %v", err)
+	}
+	// A failed ingest must leave the diagnostic untouched.
+	s, err := ws.OpenStore(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.Close()
+	if _, err := ws.Ingest(ctx, s, time.Now()); err == nil {
+		t.Fatal("closed store accepted")
+	}
+	if _, err := os.Stat(path); err != nil {
+		t.Fatalf("failed ingest removed log: %v", err)
+	}
+	if _, err := Status(ctx, root); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(path); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("successful ingest did not delete old log: %v", err)
+	}
+	rep, err := state.ReadCleanupReport(ws.Paths)
+	if err != nil || rep == nil || rep.DeletedFiles != 1 || rep.DeletedBytes != 14 {
+		t.Fatalf("report %+v %v", rep, err)
+	}
+	// A new Workspace/process uses the same persisted throttle.
+	path = appCleanupLog(t, ws)
+	if _, err := Status(ctx, root); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(path); err != nil {
+		t.Fatalf("throttle lost: %v", err)
+	}
+}
+func TestCleanupFailureDoesNotFailStatus(t *testing.T) {
+	root, ws := subagentRepo(t)
+	if err := os.WriteFile(filepath.Join(ws.Paths.Runtime, "cleanup.json"), []byte("broken"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := Status(context.Background(), root); err != nil {
+		t.Fatalf("cleanup failed main command: %v", err)
+	}
+}
+
+type cleanupRevalidator struct {
+	t           *testing.T
+	path        string
+	breakLedger bool
+}
+
+func (a *cleanupRevalidator) Name() string                   { return "cleanup-revalidator" }
+func (a *cleanupRevalidator) Version(context.Context) string { return "" }
+func (a *cleanupRevalidator) ReportsCost() bool              { return false }
+func (a *cleanupRevalidator) Run(_ context.Context, req eval.AgentRequest) eval.AgentResult {
+	a.path = req.LogPath
+	if err := os.WriteFile(req.LogPath, []byte("failed diagnostic"), 0600); err != nil {
+		a.t.Fatal(err)
+	}
+	old := time.Now().Add(-100 * 24 * time.Hour)
+	if err := os.Chtimes(req.LogPath, old, old); err != nil {
+		a.t.Fatal(err)
+	}
+	if a.breakLedger {
+		if err := os.WriteFile(filepath.Join(filepath.Dir(filepath.Dir(req.LogPath)), "cleanup.json"), []byte("corrupt"), 0600); err != nil {
+			a.t.Fatal(err)
+		}
+	}
+	return eval.AgentResult{Error: "agent failed"}
+}
+func TestCleanupRevalidateRecordsFailedAgent(t *testing.T) {
+	root, ids, _ := seedKnowledge(t, 1, "cleanup")
+	ctx := context.Background()
+	k, err := OpenKnowledge(ctx, root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	all, _, err := k.Items()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var it *knowledge.Item
+	for _, item := range all {
+		if item.ID == ids[0] {
+			it = item
+		}
+	}
+	if it == nil {
+		t.Fatal("missing fixture item")
+	}
+	it.Status = knowledge.StatusStale
+	if err := k.Store.Save(it); err != nil {
+		t.Fatal(err)
+	}
+	a := &cleanupRevalidator{t: t}
+	rep, err := RevalidateKnowledge(ctx, k, RevalidateOptions{Refs: ids, Agent: a})
+	if err != nil || len(rep.Results) != 1 || a.path == "" {
+		t.Fatalf("revalidation %+v %v", rep, err)
+	}
+	cleaned, err := state.MaybeCleanup(ctx, k.Paths, 90, time.Now())
+	if err != nil || cleaned.DeletedFiles != 1 {
+		t.Fatalf("completed revalidation log retained: %+v %v", cleaned, err)
+	}
+}
+
+func TestCleanupRevalidateLedgerFailureRetainsLog(t *testing.T) {
+	root, ids, _ := seedKnowledge(t, 1, "cleanup-ledger-failure")
+	ctx := context.Background()
+	k, err := OpenKnowledge(ctx, root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	all, _, err := k.Items()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, it := range all {
+		if it.ID == ids[0] {
+			it.Status = knowledge.StatusStale
+			if err := k.Store.Save(it); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	a := &cleanupRevalidator{t: t, breakLedger: true}
+	rep, err := RevalidateKnowledge(ctx, k, RevalidateOptions{Refs: ids, Agent: a})
+	if err != nil || len(rep.Results) != 1 || rep.Results[0].Verdict != "unsure" {
+		t.Fatalf("main result changed: %+v %v", rep, err)
+	}
+	if _, err := os.Stat(a.path); err != nil {
+		t.Fatalf("log lost on ledger failure: %v", err)
+	}
+}
