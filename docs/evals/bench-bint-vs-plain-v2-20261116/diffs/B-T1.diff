+			defer root.Close()
+			dir, err := openCleanupDir(root, "evolve")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer dir.Close()
+			before, err := dir.Lstat("a.log")
+			if err != nil {
+				t.Fatal(err)
+			}
+			fs := &swappingCleanupDir{Root: dir, beforeRename: func() {
+				if kind == "append" {
+					if err := os.WriteFile(path, []byte("still being written"), 0600); err != nil {
+						t.Fatal(err)
+					}
+					return
+				}
+				if err := os.Rename(path, path+".original"); err != nil {
+					t.Fatal(err)
+				}
+				switch kind {
+				case "replace":
+					if err := os.WriteFile(path, []byte("replacement"), 0600); err != nil {
+						t.Fatal(err)
+					}
+				case "directory":
+					if err := os.Mkdir(path, 0700); err != nil {
+						t.Fatal(err)
+					}
+				case "symlink":
+					if err := os.Symlink(path+".original", path); err != nil {
+						t.Skip(err)
+					}
+				}
+			}}
+			rep := CleanupReport{Reasons: map[string]int{}}
+			if removeCleanupFile(fs, "a.log", before, &rep) || rep.DeletedFiles != 0 || rep.DeletedBytes != 0 {
+				t.Fatalf("replacement deleted: %+v", rep)
+			}
+			if kind == "append" || kind == "replace" {
+				b, err := os.ReadFile(path)
+				if err != nil || len(b) < 10 {
+					t.Fatalf("replacement not restored: %q %v %+v", b, err, rep)
+				}
+			} else if kind == "directory" {
+				entries, err := os.ReadDir(filepath.Dir(path))
+				if err != nil {
+					t.Fatal(err)
+				}
+				preserved := false
+				for _, e := range entries {
+					if e.IsDir() && strings.HasPrefix(e.Name(), ".cleanup-") {
+						preserved = true
+					}
+				}
+				if !preserved || len(rep.Errors) == 0 {
+					t.Fatalf("directory replacement not preserved: %+v", rep)
+				}
+			} else {
+				if _, err := os.Lstat(path); err != nil {
+					t.Fatal(err)
+				}
+			}
+		})
+	}
