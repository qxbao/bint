+//go:build windows
+
+package state
+
+import (
+	"context"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestCleanupRejectsJunctions(t *testing.T) {
+	for _, kind := range []string{"outside", "protected"} {
+		t.Run(kind, func(t *testing.T) {
+			p, now := cleanupFixture(t)
+			target := t.TempDir()
+			if kind == "protected" {
+				target = filepath.Join(p.Runtime, "tasks")
+				if err := os.Mkdir(target, 0700); err != nil {
+					t.Fatal(err)
+				}
+			}
+			for _, name := range []string{"a.in", "a.out"} {
+				file := filepath.Join(target, name)
+				body := "input"
+				if name == "a.out" {
+					body = `{"output":"ok","duration_ms":1}`
+				}
+				if err := os.WriteFile(file, []byte(body), 0600); err != nil {
+					t.Fatal(err)
+				}
+				old := now.Add(-100 * 24 * time.Hour)
+				if err := os.Chtimes(file, old, old); err != nil {
+					t.Fatal(err)
+				}
+			}
+			link := filepath.Join(p.Runtime, "hook-trace")
+			if out, err := exec.Command("cmd", "/c", "mklink", "/J", link, target).CombinedOutput(); err != nil {
+				t.Skipf("junction unavailable: %s %v", out, err)
+			}
+			rep, err := MaybeCleanup(context.Background(), p, 90, now)
+			if err != nil || rep.DeletedFiles != 0 || len(rep.Errors) == 0 {
+				t.Fatalf("junction accepted: %+v %v", rep, err)
+			}
+			for _, name := range []string{"a.in", "a.out"} {
+				if _, err := os.Stat(filepath.Join(target, name)); err != nil {
+					t.Fatal(err)
+				}
+			}
+		})
+	}
+}
