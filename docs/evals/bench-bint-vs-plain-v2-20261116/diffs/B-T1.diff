+package config
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestCleanupRetention(t *testing.T) {
+	for _, tc := range []struct {
+		yaml    string
+		want    int
+		invalid bool
+	}{
+		{"state:\n  dir: auto\n", 90, false},
+		{"state:\n  cleanup_retention_days: 0\n", 0, false},
+		{"state:\n  cleanup_retention_days: 120\n", 120, false},
+		{"state:\n  cleanup_retention_days: -1\n", -1, true},
+		{"state:\n  cleanup_retention_days: 106752\n", 106752, true},
+	} {
+		c := Default()
+		if err := Decode(strings.NewReader(tc.yaml), &c); err != nil {
+			t.Fatal(err)
+		}
+		if c.State.CleanupRetentionDays != tc.want {
+			t.Fatalf("got %d want %d", c.State.CleanupRetentionDays, tc.want)
+		}
+		if err := c.Validate(); (err != nil) != tc.invalid {
+			t.Fatalf("Validate: %v", err)
+		}
+	}
+}
+
+func TestCleanupRetentionUpgradeAndLocalLayer(t *testing.T) {
+	template := Render(InitParams{ProjectName: "cleanup"})
+	var lines []string
+	for _, line := range strings.Split(template, "\n") {
+		if !strings.Contains(line, "cleanup_retention_days:") {
+			lines = append(lines, line)
+		}
+	}
+	old := strings.Join(lines, "\n")
+	upgraded, err := Upgrade([]byte(old))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !upgraded.Changed() {
+		t.Fatal("missing key not added")
+	}
+	cfg := Default()
+	if err := Decode(strings.NewReader(string(upgraded.Content)), &cfg); err != nil || cfg.State.CleanupRetentionDays != 90 {
+		t.Fatalf("upgrade: %+v %v", cfg.State, err)
+	}
+	t.Setenv("BINT_CONFIG_HOME", t.TempDir())
+	root := t.TempDir()
+	if err := os.Mkdir(filepath.Join(root, DirName), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(ProjectPath(root), []byte(old), 0600); err != nil {
+		t.Fatal(err)
+	}
+	loaded, _, err := Load(root, true)
+	if err != nil || loaded.State.CleanupRetentionDays != 90 {
+		t.Fatalf("legacy load: %+v %v", loaded.State, err)
+	}
+	if err := os.WriteFile(LocalPath(root), []byte("state:\n  cleanup_retention_days: 0\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	loaded, _, err = Load(root, true)
+	if err != nil || loaded.State.CleanupRetentionDays != 0 {
+		t.Fatalf("local override: %+v %v", loaded.State, err)
+	}
+}
