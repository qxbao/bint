new file mode 100644
index 0000000..28e9013
--- /dev/null
+++ b/internal/state/cleanup.go
@@ -0,0 +1,503 @@
+package state
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"bint/internal/fslock"
+)
+
+const cleanupLedgerLimit = 8 << 20
+
+// CleanupReport counts only successful removals. Skipped describes a whole skipped
+// attempt; Reasons counts files/pairs retained during the last completed scan.
+type CleanupReport struct {
+	At           time.Time      `json:"at"`
+	DeletedFiles int            `json:"deleted_files"`
+	DeletedBytes int64          `json:"deleted_bytes"`
+	Skipped      string         `json:"skipped,omitempty"`
+	Reasons      map[string]int `json:"reasons,omitempty"`
+	Errors       []string       `json:"errors,omitempty"`
+}
+type diagnosticStamp struct {
+	Size  int64     `json:"size"`
+	Mtime time.Time `json:"mtime"`
+}
+type cleanupLedger struct {
+	Version   int                        `json:"version"`
+	LastScan  time.Time                  `json:"last_scan"`
+	Report    *CleanupReport             `json:"report,omitempty"`
+	Completed map[string]diagnosticStamp `json:"completed"`
+}
+
+type cleanupDirectoryOpener interface {
+	Lstat(string) (os.FileInfo, error)
+	OpenRoot(string) (*os.Root, error)
+}
+type cleanupFileOpener interface {
+	Lstat(string) (os.FileInfo, error)
+	OpenFile(string, int, os.FileMode) (*os.File, error)
+}
+
+// openCleanupDir pins a directory and rejects redirects before using its handle.
+func openCleanupDir(parent cleanupDirectoryOpener, name string) (*os.Root, error) {
+	before, err := parent.Lstat(name)
+	if err != nil {
+		return nil, err
+	}
+	if !before.IsDir() || cleanupLink(before) {
+		return nil, fmt.Errorf("unsafe directory: %s", name)
+	}
+	child, err := parent.OpenRoot(name + string(os.PathSeparator) + ".")
+	if err != nil {
+		return nil, err
+	}
+	after, err := child.Stat(".")
+	entry, entryErr := parent.Lstat(name)
+	if err != nil || entryErr != nil || cleanupLink(entry) || !entry.IsDir() || !os.SameFile(before, entry) || !os.SameFile(before, after) {
+		child.Close()
+		return nil, fmt.Errorf("directory changed: %s", name)
+	}
+	return child, nil
+}
+func cleanupRuntime(p Paths) (*os.Root, error) {
+	root, err := os.OpenRoot(p.Root) // A state-root alias is allowed.
+	if err != nil {
+		return nil, err
+	}
+	defer root.Close()
+	return openCleanupDir(root, "runtime")
+}
+func cleanupRegular(r interface {
+	Lstat(string) (os.FileInfo, error)
+}, name string) (os.FileInfo, error) {
+	fi, err := r.Lstat(name)
+	if err != nil {
+		return nil, err
+	}
+	if !fi.Mode().IsRegular() || cleanupLink(fi) {
+		return nil, fmt.Errorf("unsafe file: %s", name)
+	}
+	return fi, nil
+}
+func openCleanupFile(r cleanupFileOpener, name string, flags int) (*os.File, error) {
+	before, err := cleanupRegular(r, name)
+	if errors.Is(err, os.ErrNotExist) && flags&os.O_CREATE != 0 {
+		return r.OpenFile(name, flags|os.O_EXCL, 0600)
+	}
+	if err != nil {
+		return nil, err
+	}
+	f, err := r.OpenFile(name, cleanupOpenFlags(flags), 0600)
+	if err != nil {
+		return nil, err
+	}
+	after, err := f.Stat()
+	entry, entryErr := r.Lstat(name)
+	if err != nil || entryErr != nil || cleanupLink(entry) || !entry.Mode().IsRegular() || !os.SameFile(before, entry) || !os.SameFile(before, after) {
+		f.Close()
+		return nil, fmt.Errorf("file changed: %s", name)
+	}
+	return f, nil
+}
+func cleanupLock(r *os.Root) (*os.File, error) {
+	f, err := openCleanupFile(r, "cleanup.lock", os.O_RDWR|os.O_CREATE)
+	if err != nil {
+		return nil, err
+	}
+	busy, err := fslock.Try(f, true)
+	if busy || err != nil {
+		f.Close()
+		if busy {
+			err = errCleanupBusy
+		}
+		return nil, err
+	}
+	return f, nil
+}
+
+var errCleanupBusy = errors.New("cleanup busy")
+
+func diagnosticName(name string) bool {
+	parts := strings.Split(name, "/")
+	return len(parts) == 2 && (parts[0] == "evolve" || parts[0] == "revalidate") &&
+		parts[1] != ".log" && strings.HasSuffix(parts[1], ".log") &&
+		!strings.ContainsAny(parts[1], `\:`) && filepath.Base(parts[1]) == parts[1]
+}
+func readCleanupLedger(r *os.Root) (cleanupLedger, error) {
+	empty := cleanupLedger{Version: 1, Completed: map[string]diagnosticStamp{}}
+	f, err := openCleanupFile(r, "cleanup.json", os.O_RDONLY)
+	if errors.Is(err, os.ErrNotExist) {
+		return empty, nil
+	}
+	if err != nil {
+		return empty, err
+	}
+	defer f.Close()
+	data, err := io.ReadAll(io.LimitReader(f, cleanupLedgerLimit+1))
+	if err != nil {
+		return empty, err
+	}
+	if len(data) > cleanupLedgerLimit {
+		return empty, errors.New("cleanup ledger too large")
+	}
+	var l cleanupLedger
+	if err = json.Unmarshal(data, &l); err != nil {
+		return empty, fmt.Errorf("cleanup ledger: %w", err)
+	}
+	if l.Version != 1 {
+		return empty, errors.New("unknown cleanup ledger version")
+	}
+	for name, stamp := range l.Completed {
+		if !diagnosticName(name) || stamp.Size < 0 || stamp.Mtime.IsZero() {
+			return empty, errors.New("invalid completed diagnostic")
+		}
+	}
+	if l.Completed == nil {
+		l.Completed = empty.Completed
+	}
+	return l, nil
+}
+func writeCleanupLedger(r *os.Root, l cleanupLedger) error {
+	// Never open/truncate the destination: a symlink is an error, including links
+	// whose targets are protected files within the root.
+	if _, err := cleanupRegular(r, "cleanup.json"); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	data, err := json.Marshal(l)
+	if err != nil {
+		return err
+	}
+	if len(data) > cleanupLedgerLimit {
+		return errors.New("cleanup ledger too large")
+	}
+	tmp := ".cleanup-" + rand.Text() + ".tmp"
+	f, err := r.OpenFile(tmp, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return err
+	}
+	defer r.Remove(tmp)
+	_, err = f.Write(data)
+	if err == nil {
+		err = f.Sync()
+	}
+	cerr := f.Close()
+	if err == nil {
+		err = cerr
+	}
+	if err != nil {
+		return err
+	}
+	return r.Rename(tmp, "cleanup.json")
+}
+
+// RecordCompletedDiagnostic must be called only after Agent.Run returns and has
+// closed its log. Busy/error means retaining the log, never guessing completion.
+func RecordCompletedDiagnostic(p Paths, logPath string) error {
+	rel, err := filepath.Rel(p.Runtime, logPath)
+	if err != nil {
+		return err
+	}
+	name := filepath.ToSlash(rel)
+	if !diagnosticName(name) {
+		return errors.New("diagnostic outside cleanup allowlist")
+	}
+	r, err := cleanupRuntime(p)
+	if err != nil {
+		return err
+	}
+	defer r.Close()
+	lock, err := cleanupLock(r)
+	if err != nil {
+		return err
+	}
+	defer lock.Close()
+	l, err := readCleanupLedger(r)
+	if err != nil {
+		return err
+	}
+	dir, err := openCleanupDir(r, filepath.Dir(rel))
+	if err != nil {
+		return err
+	}
+	defer dir.Close()
+	fi, err := cleanupRegular(dir, filepath.Base(rel))
+	if err != nil {
+		return err
+	}
+	l.Completed[name] = diagnosticStamp{Size: fi.Size(), Mtime: fi.ModTime().UTC()}
+	return writeCleanupLedger(r, l)
+}
+
+// ReadCleanupReport reads without creating files or starting cleanup.
+func ReadCleanupReport(p Paths) (*CleanupReport, error) {
+	r, err := cleanupRuntime(p)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	defer r.Close()
+	l, err := readCleanupLedger(r)
+	return l.Report, err
+}
+func (rep *CleanupReport) keep(reason string) { rep.Reasons[reason]++ }
+func (rep *CleanupReport) fail(err error) {
+	if len(rep.Errors) < 32 {
+		rep.Errors = append(rep.Errors, err.Error())
+	}
+	rep.keep("error")
+}
+func sameCleanupFile(a, b os.FileInfo) bool {
+	return b != nil && b.Mode().IsRegular() && !cleanupLink(b) && os.SameFile(a, b) && a.Size() == b.Size() && a.ModTime().Equal(b.ModTime())
+}
+
+// cleanupRemovalDir contains the operations needed to capture and restore entries.
+type cleanupRemovalDir interface {
+	Lstat(string) (os.FileInfo, error)
+	Rename(string, string) error
+	Link(string, string) error
+	Remove(string) error
+}
+
+// Capture the entry under an unpredictable quarantine name before validating it.
+// Replacement of the original name cannot redirect the destructive operation.
+// A changed entry is restored with an exclusive hard link; if another writer has
+// reused the original name, preserve the quarantine and report its location.
+func removeCleanupFile(dir cleanupRemovalDir, name string, fi os.FileInfo, rep *CleanupReport) bool {
+	current, err := dir.Lstat(name)
+	if err != nil {
+		rep.fail(err)
+		return false
+	}
+	if !sameCleanupFile(fi, current) {
+		rep.keep("changed")
+		return false
+	}
+	quarantine := ".cleanup-" + rand.Text() + ".retained"
+	if err := dir.Rename(name, quarantine); err != nil {
+		rep.fail(err)
+		return false
+	}
+	restore := func() {
+		if err := dir.Link(quarantine, name); err != nil {
+			rep.fail(fmt.Errorf("preserved %s as %s: %w", name, quarantine, err))
+			return
+		}
+		if err := dir.Remove(quarantine); err != nil {
+			rep.fail(fmt.Errorf("preserved %s: %w", quarantine, err))
+		}
+	}
+	captured, err := dir.Lstat(quarantine)
+	if err != nil || !sameCleanupFile(fi, captured) {
+		rep.keep("changed")
+		restore()
+		return false
+	}
+	if err := dir.Remove(quarantine); err != nil {
+		rep.fail(err)
+		restore()
+		return false
+	}
+	rep.DeletedFiles++
+	rep.DeletedBytes += fi.Size()
+	return true
+}
+func scanCleanupDir(ctx context.Context, r *os.Root, name string, visit func(*os.Root, string)) error {
+	dir, err := openCleanupDir(r, name)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	defer dir.Close()
+	f, err := dir.Open(".")
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		entries, err := f.ReadDir(128)
+		for _, e := range entries {
+			if ctx.Err() != nil {
+				return ctx.Err()
+			}
+			visit(dir, e.Name())
+		}
+		if errors.Is(err, io.EOF) {
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+	}
+}
+func completeHookOutput(dir *os.Root, name string, fi os.FileInfo) bool {
+	if fi.Size() > 2<<20 {
+		return false
+	}
+	f, err := openCleanupFile(dir, name, os.O_RDONLY)
+	if err != nil {
+		return false
+	}
+	defer f.Close()
+	current, err := f.Stat()
+	if err != nil || !sameCleanupFile(fi, current) {
+		return false
+	}
+	data, err := io.ReadAll(io.LimitReader(f, 2<<20+1))
+	if err != nil {
+		return false
+	}
+	var out struct {
+		Output   *string `json:"output"`
+		Duration *int64  `json:"duration_ms"`
+	}
+	return json.Unmarshal(data, &out) == nil && out.Output != nil && out.Duration != nil
+}
+
+// MaybeCleanup performs at most one completed scan per 24 hours for a shared
+// state directory. Errors are deliberately separate from spool ingestion errors.
+func MaybeCleanup(ctx context.Context, p Paths, retentionDays int, now time.Time) (CleanupReport, error) {
+	rep := CleanupReport{At: now.UTC(), Reasons: map[string]int{}}
+	if retentionDays == 0 {
+		rep.Skipped = "disabled"
+		return rep, nil
+	}
+	if retentionDays < 0 || retentionDays > 106751 {
+		return rep, errors.New("invalid cleanup retention")
+	}
+	if err := ctx.Err(); err != nil {
+		return rep, err
+	}
+	r, err := cleanupRuntime(p)
+	if err != nil {
+		return rep, err
+	}
+	defer r.Close()
+	lock, err := cleanupLock(r)
+	if errors.Is(err, errCleanupBusy) {
+		rep.Skipped = "busy"
+		return rep, nil
+	}
+	if err != nil {
+		return rep, err
+	}
+	defer lock.Close()
+	l, err := readCleanupLedger(r)
+	if err != nil {
+		return rep, err
+	}
+	if !l.LastScan.IsZero() && now.Sub(l.LastScan) < 24*time.Hour {
+		rep.Skipped = "not_due"
+		return rep, nil
+	}
+	cutoff := now.Add(-time.Duration(retentionDays) * 24 * time.Hour)
+	for _, group := range []string{"revalidate", "evolve", "hook-trace"} {
+		err := scanCleanupDir(ctx, r, group, func(dir *os.Root, name string) {
+			if group == "hook-trace" {
+				if !strings.HasSuffix(name, ".in") {
+					return
+				}
+				in, err := cleanupRegular(dir, name)
+				if err != nil {
+					rep.keep("unsafe")
+					return
+				}
+				outName := strings.TrimSuffix(name, ".in") + ".out"
+				out, err := cleanupRegular(dir, outName)
+				if err != nil {
+					rep.keep("incomplete")
+					return
+				}
+				if !in.ModTime().Before(cutoff) || !out.ModTime().Before(cutoff) {
+					rep.keep("retained")
+					return
+				}
+				if !completeHookOutput(dir, outName, out) {
+					rep.keep("incomplete")
+					return
+				}
+				// Check both snapshots again before deleting either side.
+				a, e1 := dir.Lstat(name)
+				b, e2 := dir.Lstat(outName)
+				if e1 != nil || e2 != nil || !sameCleanupFile(in, a) || !sameCleanupFile(out, b) {
+					rep.keep("changed")
+					return
+				}
+				if removeCleanupFile(dir, name, in, &rep) {
+					removeCleanupFile(dir, outName, out, &rep)
+				}
+				return
+			}
+			if !strings.HasSuffix(name, ".log") {
+				return
+			}
+			key := group + "/" + name
+			stamp, ok := l.Completed[key]
+			if !ok {
+				rep.keep("unconfirmed")
+				return
+			}
+			fi, err := cleanupRegular(dir, name)
+			if err != nil {
+				rep.keep("unsafe")
+				return
+			}
+			if stamp.Size != fi.Size() || !stamp.Mtime.Equal(fi.ModTime()) {
+				rep.keep("changed")
+				delete(l.Completed, key)
+				return
+			}
+			if !fi.ModTime().Before(cutoff) {
+				rep.keep("retained")
+				return
+			}
+			if removeCleanupFile(dir, name, fi, &rep) {
+				delete(l.Completed, key)
+			}
+		})
+		if err != nil {
+			rep.fail(err)
+		}
+	}
+	// Remove stale completion entries, never promote unknown logs to completed.
+	for key := range l.Completed {
+		if ctx.Err() != nil {
+			break
+		}
+		parts := strings.Split(key, "/")
+		dir, err := openCleanupDir(r, parts[0])
+		if err != nil {
+			continue
+		}
+		_, err = dir.Lstat(parts[1])
+		dir.Close()
+		if errors.Is(err, os.ErrNotExist) {
+			delete(l.Completed, key)
+		}
+	}
+	if err := ctx.Err(); err != nil {
+		rep.fail(err)
+	} else {
+		l.LastScan = now.UTC()
+	}
+	l.Report = &rep
+	if err := writeCleanupLedger(r, l); err != nil {
+		return rep, err
+	}
+	return rep, nil
+}
