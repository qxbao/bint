+
+func TestCleanupStatusDeletesExpiredLogAndReports(t *testing.T) {
+	testutil.Isolate(t)
+	root := testutil.NewRepo(t, map[string]string{"go.mod": "module demo\n"})
+	if out, code := run(t, root, "", "init", "--no-hooks"); code != 0 {
+		t.Fatal(out)
+	}
+	ws, err := app.OpenWorkspace(context.Background(), root, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(ws.Paths.Runtime, "evolve", "old.log")
+	if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte("diagnostic"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	old := time.Now().Add(-100 * 24 * time.Hour)
+	if err := os.Chtimes(path, old, old); err != nil {
+		t.Fatal(err)
+	}
+	if err := state.RecordCompletedDiagnostic(ws.Paths, path); err != nil {
+		t.Fatal(err)
+	}
+	out, code := run(t, root, "", "status")
+	if code != 0 {
+		t.Fatal(out)
+	}
+	if _, err := os.Stat(path); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("old log still exists: %v\n%s", err, out)
+	}
+	if !strings.Contains(out, "1 tệp, 10 byte") {
+		t.Fatalf("missing actual deletion report: %s", out)
+	}
+	// A separate CLI process must see the same report/throttle.
+	out, code = run(t, root, "", "status")
+	if code != 0 || !strings.Contains(out, "1 tệp, 10 byte") {
+		t.Fatal(out)
+	}
+}
