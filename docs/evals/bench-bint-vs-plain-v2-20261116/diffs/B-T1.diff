+package evolve
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"bint/internal/eval"
+	"bint/internal/state"
+)
+
+type cleanupAgent struct {
+	t           *testing.T
+	paths       state.Paths
+	log         string
+	during      bool
+	breakLedger bool
+}
+
+func (a *cleanupAgent) Name() string                   { return "cleanup-fixture" }
+func (a *cleanupAgent) Version(context.Context) string { return "" }
+func (a *cleanupAgent) ReportsCost() bool              { return false }
+func (a *cleanupAgent) Run(ctx context.Context, req eval.AgentRequest) eval.AgentResult {
+	a.log = req.LogPath
+	if err := os.WriteFile(req.LogPath, []byte("closed diagnostic"), 0600); err != nil {
+		a.t.Fatal(err)
+	}
+	old := time.Now().Add(-100 * 24 * time.Hour)
+	if err := os.Chtimes(req.LogPath, old, old); err != nil {
+		a.t.Fatal(err)
+	}
+	rep, err := state.MaybeCleanup(ctx, a.paths, 90, time.Now())
+	if err != nil {
+		a.t.Fatal(err)
+	}
+	a.during = rep.DeletedFiles > 0
+	if a.breakLedger {
+		if err := os.WriteFile(filepath.Join(a.paths.Runtime, "cleanup.json"), []byte("corrupt"), 0600); err != nil {
+			a.t.Fatal(err)
+		}
+	}
+	return eval.AgentResult{Error: "agent failed"}
+}
+func TestCleanupEvolveRecordsAfterRunEvenOnError(t *testing.T) {
+	for _, kind := range []string{"skill", "harness"} {
+		t.Run(kind, func(t *testing.T) {
+			f := setup(t)
+			ctx := context.Background()
+			a := &cleanupAgent{t: t, paths: f.k.Paths}
+			if kind == "skill" {
+				_, h := f.scan(t)
+				_, _, _, _ = agentSkillProposal(ctx, ProposeInput{K: f.k, DB: f.db, Agent: a, History: h}, Opportunity{Kind: KindSkillCandidate}, nil, 1)
+			} else {
+				cases, scan, h := seedLessonFailures(t, f)
+				var opp Opportunity
+				for _, o := range scan.Opportunities {
+					if o.Key == harnessSignalPrefix+SigNoTest {
+						opp = o
+					}
+				}
+				_, _ = Propose(ctx, ProposeInput{K: f.k, DB: f.db, Scan: scan, History: h, Refs: []string{opp.ID}, Max: 1, HarnessProposer: a, Cases: cases, RepoDir: f.root, Now: now})
+			}
+			if a.log == "" {
+				t.Fatal("agent was not run")
+			}
+			if a.during {
+				t.Fatal("log deleted while agent was running")
+			}
+			rep, err := state.MaybeCleanup(ctx, f.k.Paths, 90, time.Now().Add(25*time.Hour))
+			if err != nil || rep.DeletedFiles != 1 {
+				t.Fatalf("completed failed-agent log not deleted: %+v %v", rep, err)
+			}
+		})
+	}
+}
+
+func TestCleanupSkillLedgerFailurePreservesMainError(t *testing.T) {
+	f := setup(t)
+	_, h := f.scan(t)
+	a := &cleanupAgent{t: t, paths: f.k.Paths, breakLedger: true}
+	_, _, _, err := agentSkillProposal(context.Background(), ProposeInput{K: f.k, DB: f.db, Agent: a, History: h}, Opportunity{Kind: KindSkillCandidate}, nil, 1)
+	if err == nil || !strings.Contains(err.Error(), "agent failed") {
+		t.Fatalf("main error lost: %v", err)
+	}
+	if _, err := os.Stat(a.log); err != nil {
+		t.Fatalf("log lost: %v", err)
+	}
+}
