+type swappingCleanupDir struct {
+	*os.Root
+	beforeRename func()
+}
+
+func (d *swappingCleanupDir) Rename(from, to string) error {
+	if d.beforeRename != nil {
+		f := d.beforeRename
+		d.beforeRename = nil
+		f()
+	}
+	return d.Root.Rename(from, to)
+}
+func TestCleanupReplacementAtRemovalBoundary(t *testing.T) {
+	for _, kind := range []string{"append", "replace", "directory", "symlink"} {
+		t.Run(kind, func(t *testing.T) {
+			p, now := cleanupFixture(t)
+			path := cleanupFile(t, p, "runtime/evolve/a.log", "old", now.Add(-100*24*time.Hour), true)
+			root, err := cleanupRuntime(p)
+			if err != nil {
