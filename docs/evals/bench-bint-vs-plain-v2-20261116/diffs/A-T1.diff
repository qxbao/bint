+
+func TestCleanPreviewAndApply(t *testing.T) {
+	testutil.Isolate(t)
+	repo := testutil.NewRepo(t, map[string]string{"README.md": "demo"})
+	if out, code := run(t, repo, "", "init", "--no-hooks", "--no-skills"); code != 0 {
+		t.Fatalf("init: %d %s", code, out)
+	}
+	w, err := app.OpenWorkspace(context.Background(), repo, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(w.Paths.Backups, "old.txt")
+	if err := os.WriteFile(path, []byte("abc"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	old := time.Now().AddDate(0, 0, -40)
+	if err := os.Chtimes(path, old, old); err != nil {
+		t.Fatal(err)
+	}
+	for _, dry := range []bool{true, false} {
+		args := []string{"clean", "--json"}
+		if dry {
+			args = append(args, "--dry-run")
+		}
+		out, code := run(t, repo, "", args...)
+		var result app.CleanResult
+		if code != 0 || json.Unmarshal([]byte(out), &result) != nil || result.Files != 1 || result.Bytes != 3 {
+			t.Fatalf("dry=%v: code=%d %s", dry, code, out)
+		}
+		_, err := os.Stat(path)
+		if dry && err != nil {
+			t.Fatal(err)
+		}
+		if !dry && !os.IsNotExist(err) {
+			t.Fatalf("not removed: %v", err)
+		}
+	}
+}
