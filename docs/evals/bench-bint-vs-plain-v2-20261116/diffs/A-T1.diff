@@ -0,0 +1,25 @@
+package eval
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestResumeWaitsForMaintenance(t *testing.T) {
+	workRoot := t.TempDir()
+	release, busy, err := TryMaintenanceLock(workRoot, true)
+	if err != nil || busy {
+		t.Fatalf("maintenance lock: busy=%v err=%v", busy, err)
+	}
+	defer release()
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+	// Nil DB/agent are deliberately unreachable: no batch or artifact access is
+	// allowed before maintenance finishes, even when resuming an existing batch.
+	_, err = Run(ctx, Env{WorkRoot: workRoot}, nil, RunOptions{ResumeBatch: "old"})
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("resume bypassed maintenance: %v", err)
+	}
+}
diff --git a/internal/eval/runner.go b/internal/eval/runner.go
index d6c778d..f6dad6c 100644
--- a/internal/eval/runner.go
+++ b/internal/eval/runner.go
@@ -130,6 +130,23 @@ var ErrBudget = errors.New("vượt ngân sách")
 
 // Run chạy một đợt đánh giá và ghi mọi lượt vào cơ sở dữ liệu.
 func Run(ctx context.Context, env Env, db *sql.DB, opts RunOptions) (RunResult, error) {
+	// Hold a shared filesystem lease before changing batch status or reading
+	// artifacts. Cleanup uses the exclusive side, so resume cannot race expiry.
+	for {
+		release, busy, err := TryMaintenanceLock(env.WorkRoot, false)
+		if err != nil {
+			return RunResult{}, err
+		}
+		if !busy {
+			defer release()
+			break
+		}
+		select {
+		case <-ctx.Done():
+			return RunResult{}, ctx.Err()
+		case <-time.After(50 * time.Millisecond):
+		}
+	}
 	if opts.Now == nil {
 		opts.Now = time.Now
 	}
