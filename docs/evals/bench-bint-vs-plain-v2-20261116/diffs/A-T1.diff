+package cli
+
+import (
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"bint/internal/app"
+	"github.com/spf13/cobra"
+)
+
+func newCleanCmd(stdio IO) *cobra.Command {
+	var dryRun, asJSON bool
+	c := &cobra.Command{
+		Use: "clean", Short: "Dọn log, bộ đệm đánh giá và bản sao lưu đã hết hạn",
+		Long: "Dọn dữ liệu phụ cũ theo state.retention_days (mặc định 30 ngày; 0 = tắt). Giữ lịch sử SQLite, tài liệu tác vụ và dữ liệu đang dùng. Dùng --dry-run để xem trước.",
+		Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			dir, err := cwd()
+			if err != nil {
+				return err
+			}
+			ws, err := app.OpenWorkspace(cmd.Context(), dir, true)
+			if err != nil {
+				return err
+			}
+			s, err := ws.OpenStore(cmd.Context())
+			if err != nil {
+				return err
+			}
+			defer s.Close()
+			res, err := ws.Clean(cmd.Context(), s, time.Now(), dryRun)
+			if err != nil {
+				return err
+			}
+			if asJSON {
+				return json.NewEncoder(stdio.Out).Encode(res)
+			}
+			for _, p := range res.Paths {
+				fmt.Fprintln(stdio.Out, p)
+			}
+			verb := "Đã dọn"
+			if dryRun {
+				verb = "Sẽ dọn"
+			}
+			fmt.Fprintf(stdio.Out, "%s %d tệp (%d byte).\n", verb, res.Files, res.Bytes)
+			return nil
+		},
+	}
+	c.Flags().BoolVar(&dryRun, "dry-run", false, "chỉ liệt kê tệp hết hạn, không xoá")
+	c.Flags().BoolVar(&asJSON, "json", false, "xuất JSON")
+	return c
+}
