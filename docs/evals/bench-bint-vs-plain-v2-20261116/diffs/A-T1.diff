+
+	"bint/internal/eval"
+)
+
+func TestCleanDryRunDisabledAndSchedule(t *testing.T) {
+	repo, _ := runsRepo(t)
+	ctx := context.Background()
+	w, err := OpenWorkspace(ctx, repo, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s, err := w.OpenStore(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	now := time.Now().UTC()
+	old := now.AddDate(0, 0, -40)
+	path := filepath.Join(w.Paths.Backups, "old.txt")
+	write := func() {
+		t.Helper()
+		if err := os.MkdirAll(w.Paths.Backups, 0700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(path, []byte("abc"), 0600); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Chtimes(path, old, old); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write()
+	res, err := w.Clean(ctx, s, now, true)
+	if err != nil || res.Files != 1 || res.Bytes != 3 {
+		t.Fatalf("preview: %+v %v", res, err)
+	}
+	for _, p := range []string{path} {
+		if _, err := os.Stat(p); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, name := range []string{"cleanup.lock", "cleanup.last"} {
+		if _, err := os.Stat(filepath.Join(w.Paths.Root, name)); !os.IsNotExist(err) {
+			t.Fatalf("preview wrote %s: %v", name, err)
+		}
+	}
+	w.Config.State.RetentionDays = 0
+	if res, err := w.Clean(ctx, s, now, false); err != nil || res.Files != 0 {
+		t.Fatalf("disabled: %+v %v", res, err)
+	}
+	if _, err := os.Stat(path); err != nil {
+		t.Fatal(err)
+	}
+	w.Config.State.RetentionDays = 30
+	if _, err := w.Ingest(ctx, s, now); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(path); !os.IsNotExist(err) {
+		t.Fatalf("first cleanup: %v", err)
+	}
+	write()
+	if _, err := w.Ingest(ctx, s, now.Add(time.Hour)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(path); err != nil {
+		t.Fatalf("cleanup ran twice in a day: %v", err)
+	}
+	if _, err := w.Ingest(ctx, s, now.Add(24*time.Hour)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(path); !os.IsNotExist(err) {
+		t.Fatalf("next day's cleanup: %v", err)
+	}
+}
+
+func TestCleanEvalKeepsRunningAndUnknownBatches(t *testing.T) {
+	repo, _ := runsRepo(t)
+	ctx := context.Background()
+	w, err := OpenWorkspace(ctx, repo, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s, err := w.OpenStore(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	now := time.Now().UTC()
+	old := now.AddDate(0, 0, -40)
+	for _, row := range []struct {
+		id, status string
+		at         time.Time
+	}{
+		{"old", "completed", old}, {"active", "running", old}, {"recent", "completed", now},
+	} {
+		_, err := s.DB.ExecContext(ctx, `INSERT INTO eval_batches
+			(batch_id,status,harness,leakage_mode,arms,repeats,case_ids,prompt_version,seed,started_at,finished_at)
+			VALUES (?,?,'claude','strict','[]',1,'[]',1,1,?,?)`, row.id, row.status, old.Format(time.RFC3339Nano), row.at.Format(time.RFC3339Nano))
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, id := range []string{"old", "active", "recent", "unknown"} {
+		p := filepath.Join(w.Paths.EvalWork, "logs", id, "agent.log")
+		if err := os.MkdirAll(filepath.Dir(p), 0700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(p, []byte(id), 0600); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Chtimes(p, old, old); err != nil {
+			t.Fatal(err)
+		}
+	}
+	// A resumed evaluation holds this shared lease before changing DB status.
+	// Even a stale completed status must not permit cleanup while it is held.
+	release, busy, err := eval.TryMaintenanceLock(w.Paths.EvalWork, false)
+	if err != nil || busy {
+		t.Fatalf("evaluation lease: busy=%v err=%v", busy, err)
+	}
+	res, err := w.Clean(ctx, s, now, false)
+	release()
+	if err != nil || res.Files != 0 {
+		t.Fatalf("cleaned during evaluation resume: %+v %v", res, err)
+	}
+	res, err = w.Clean(ctx, s, now, false)
+	if err != nil || res.Files != 1 {
+		t.Fatalf("cleanup: %+v %v", res, err)
+	}
+	for _, id := range []string{"active", "recent", "unknown"} {
+		if _, err := os.Stat(filepath.Join(w.Paths.EvalWork, "logs", id, "agent.log")); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var count int
+	if err := s.DB.QueryRowContext(ctx, `SELECT COUNT(*) FROM eval_batches`).Scan(&count); err != nil || count != 3 {
+		t.Fatalf("history lost: %d %v", count, err)
+	}
+}
+
+func TestCleanMetadataSymlinkCannotOverwriteDatabase(t *testing.T) {
+	repo, _ := runsRepo(t)
+	ctx := context.Background()
+	w, err := OpenWorkspace(ctx, repo, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s, err := w.OpenStore(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	if err := os.Symlink("state.sqlite", filepath.Join(w.Paths.Root, "cleanup.last")); err != nil {
+		t.Skipf("symlinks unavailable: %v", err)
+	}
+	if _, err := w.Clean(ctx, s, time.Now(), false); err != nil {
+		t.Fatal(err)
+	}
+	var n int
+	if err := s.DB.QueryRowContext(ctx, `SELECT COUNT(*) FROM runs`).Scan(&n); err != nil {
+		t.Fatalf("database damaged by metadata write: %v", err)
+	}
+	info, err := os.Lstat(filepath.Join(w.Paths.Root, "cleanup.last"))
+	if err != nil || !info.Mode().IsRegular() {
+		t.Fatalf("metadata symlink not replaced: %v %v", info, err)
+	}
+}
+
+// Expiring files must not remove pending events, task documents, active task logs,
+// or files reached through a symlink, even when all have an old modification time.
+func TestIngestCleansExpiredFiles(t *testing.T) {
+	repo, _ := runsRepo(t)
+	w, err := OpenWorkspace(context.Background(), repo, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now().UTC()
+	old := now.AddDate(0, 0, -40)
+	write := func(rel, content string, at time.Time) {
+		t.Helper()
+		p := filepath.Join(w.Paths.Root, rel)
+		if err := os.MkdirAll(filepath.Dir(p), 0700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(p, []byte(content), 0600); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Chtimes(p, at, at); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write("backups/old/config.yml", "old", old)
+	write("backups/new/config.yml", "new", now)
+	write("spool/rejected/bad.jsonl", "bad", old)
+	write("runtime/hook-trace/old.in", "trace", old)
+	write("runtime/tasks/done/state.json", `{"status":"done","updated_at":"`+old.Format(time.RFC3339Nano)+`"}`, old)
+	write("runtime/tasks/done/logs/agent.log", "done", old)
+	write("runtime/tasks/done/plan.md", "plan", old)
+	write("runtime/tasks/active/state.json", `{"status":"in_progress"}`, old)
+	write("runtime/tasks/active/logs/agent.log", "active", old)
+	write("runtime/tasks/paused/state.json", `{"status":"interrupted"}`, old)
+	write("runtime/tasks/paused/logs/agent.log", "paused", old)
+	write("runtime/tasks/unknown/logs/agent.log", "unknown", old)
+	write("runtime/harness/session.jsonl", "guardrail", old)
+	write("worktrees/task/source.go", "source", old)
+	write("generated/inspect.json", "index", old)
+	outside := t.TempDir()
+	victim := filepath.Join(outside, "keep")
+	if err := os.WriteFile(victim, []byte("keep"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chtimes(victim, old, old); err != nil {
+		t.Fatal(err)
+	}
+	// Symlink creation can be unavailable on Windows.
+	_ = os.Symlink(outside, filepath.Join(w.Paths.Backups, "link"))
+	s, err := w.OpenStore(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	if _, err := w.Ingest(context.Background(), s, now); err != nil {
+		t.Fatal(err)
+	}
+	for _, rel := range []string{"backups/old/config.yml", "spool/rejected/bad.jsonl", "runtime/hook-trace/old.in", "runtime/tasks/done/logs/agent.log"} {
+		if _, err := os.Stat(filepath.Join(w.Paths.Root, rel)); !os.IsNotExist(err) {
+			t.Errorf("expired file remains: %s (%v)", rel, err)
+		}
+	}
+	for _, rel := range []string{"backups/new/config.yml", "runtime/tasks/done/plan.md", "runtime/tasks/active/logs/agent.log", "runtime/tasks/paused/logs/agent.log", "runtime/tasks/unknown/logs/agent.log", "runtime/harness/session.jsonl", "worktrees/task/source.go", "generated/inspect.json"} {
+		if _, err := os.Stat(filepath.Join(w.Paths.Root, rel)); err != nil {
+			t.Errorf("protected file lost: %s (%v)", rel, err)
+		}
+	}
+	if _, err := os.Stat(victim); err != nil {
+		t.Fatal(err)
+	}
+}
