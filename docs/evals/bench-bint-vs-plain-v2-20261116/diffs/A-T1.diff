@@ -0,0 +1,36 @@
+package eval
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"bint/internal/fslock"
+)
+
+// TryMaintenanceLock excludes cleanup from evaluations, including resumed batches.
+// Evaluations share the lock; maintenance takes it exclusively. Never remove the
+// lock file: OS locks attach to the open file, not to its name.
+func TryMaintenanceLock(workRoot string, exclusive bool) (release func(), busy bool, err error) {
+	if err := os.MkdirAll(workRoot, 0700); err != nil {
+		return nil, false, err
+	}
+	root, err := os.OpenRoot(workRoot)
+	if err != nil {
+		return nil, false, err
+	}
+	defer root.Close()
+	if info, err := root.Lstat(".maintenance.lock"); err == nil && !info.Mode().IsRegular() {
+		return nil, false, fmt.Errorf("%s không phải tệp thường", filepath.Join(workRoot, ".maintenance.lock"))
+	}
+	f, err := root.OpenFile(".maintenance.lock", os.O_CREATE|os.O_RDWR, 0600)
+	if err != nil {
+		return nil, false, err
+	}
+	busy, err = fslock.Try(f, exclusive)
+	if busy || err != nil {
+		f.Close()
+		return nil, busy, err
+	}
+	return func() { _ = f.Close() }, false, nil
+}
