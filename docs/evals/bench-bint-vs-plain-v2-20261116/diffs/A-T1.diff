diff --git a/internal/app/cleanup.go b/internal/app/cleanup.go
new file mode 100644
index 0000000..08353e3
--- /dev/null
+++ b/internal/app/cleanup.go
@@ -0,0 +1,236 @@
+package app
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"bint/internal/eval"
+	"bint/internal/fslock"
+	"bint/internal/store"
+	"bint/internal/task"
+	"bint/internal/ulid"
+)
+
+// CleanResult counts regular files, using logical sizes (hardlinks may share disk blocks).
+type CleanResult struct {
+	Files int      `json:"files"`
+	Bytes int64    `json:"bytes"`
+	Paths []string `json:"paths,omitempty"`
+}
+
+// Clean removes only disposable files in known state subdirectories. SQLite,
+// task documents, resumable tasks, worktrees and pending spool are never expired.
+// dryRun neither ingests events nor writes files, locks or scheduling metadata.
+func (w *Workspace) Clean(ctx context.Context, s *store.Store, now time.Time, dryRun bool) (CleanResult, error) {
+	return w.clean(ctx, s, now, dryRun, false)
+}
+
+func (w *Workspace) clean(ctx context.Context, s *store.Store, now time.Time, dryRun, automatic bool) (res CleanResult, err error) {
+	days := w.Config.State.RetentionDays
+	if days == 0 {
+		return res, nil
+	}
+	if days < 0 || days > 36500 {
+		return res, Usagef("state.retention_days: phải trong khoảng 0–36500")
+	}
+	root, err := os.OpenRoot(w.Paths.Root)
+	if err != nil {
+		return res, err
+	}
+	defer root.Close()
+	if !dryRun {
+		if info, err := root.Lstat("cleanup.lock"); err == nil && !info.Mode().IsRegular() {
+			return res, fmt.Errorf("cleanup.lock không phải tệp thường")
+		}
+		lock, err := root.OpenFile("cleanup.lock", os.O_CREATE|os.O_RDWR, 0600)
+		if err != nil {
+			return res, err
+		}
+		defer lock.Close()
+		busy, err := fslock.Try(lock, true)
+		if err != nil {
+			return res, err
+		}
+		if busy {
+			if automatic {
+				return res, nil
+			}
+			return res, fmt.Errorf("đang có tiến trình dọn dữ liệu")
+		}
+	}
+	if automatic {
+		if data, err := root.ReadFile("cleanup.last"); err == nil {
+			if last, err := time.Parse(time.RFC3339Nano, string(data)); err == nil && !last.After(now) && now.Sub(last) < 24*time.Hour {
+				return res, nil
+			}
+		}
+	}
+	cutoff := now.AddDate(0, 0, -days)
+	// Check every ancestor: WalkDir alone would follow a symlink used as its root.
+	safe := func(rel string) bool {
+		if !filepath.IsLocal(rel) {
+			return false
+		}
+		var path string
+		for _, part := range strings.Split(filepath.Clean(rel), string(filepath.Separator)) {
+			path = filepath.Join(path, part)
+			info, err := root.Lstat(path)
+			if err != nil || info.Mode()&os.ModeSymlink != 0 {
+				return false
+			}
+		}
+		return true
+	}
+	var sweep func(string) error
+	sweep = func(rel string) error {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if !safe(rel) {
+			return nil
+		}
+		info, err := root.Lstat(rel)
+		if err != nil {
+			return err
+		}
+		if info.IsDir() {
+			f, err := root.Open(rel)
+			if err != nil {
+				return err
+			}
+			entries, err := f.ReadDir(-1)
+			f.Close()
+			if err != nil {
+				return err
+			}
+			for _, entry := range entries {
+				if err := sweep(filepath.Join(rel, entry.Name())); err != nil {
+					return err
+				}
+			}
+			// Remove empty directories only; a directory containing a fresh or linked
+			// file remains. Never recursively remove an uninspected directory.
+			if !dryRun {
+				_ = root.Remove(rel)
+			}
+			return nil
+		}
+		if !info.Mode().IsRegular() || !info.ModTime().Before(cutoff) {
+			return nil
+		}
+		if !dryRun {
+			if err := root.Remove(rel); err != nil && !errors.Is(err, fs.ErrNotExist) {
+				return err
+			}
+		}
+		res.Files++
+		res.Bytes += info.Size()
+		if !automatic {
+			res.Paths = append(res.Paths, filepath.ToSlash(rel))
+		}
+		return nil
+	}
+	for _, rel := range []string{"backups", "spool/rejected", "runtime/hook-trace", "runtime/revalidate"} {
+		if err := sweep(filepath.FromSlash(rel)); err != nil {
+			return res, err
+		}
+	}
+	// Only terminal tasks: failed/interrupted/blocked tasks may be resumed.
+	if safe(filepath.FromSlash("runtime/tasks")) {
+		entries, err := fs.ReadDir(root.FS(), "runtime/tasks")
+		if err != nil {
+			return res, err
+		}
+		for _, entry := range entries {
+			if !entry.IsDir() {
+				continue
+			}
+			base := filepath.Join("runtime", "tasks", entry.Name())
+			stateFile := filepath.Join(base, task.StateFile)
+			if !safe(stateFile) {
+				continue
+			}
+			data, err := root.ReadFile(stateFile)
+			var st task.State
+			if err != nil || json.Unmarshal(data, &st) != nil || !task.Terminal(st.Status) {
+				continue
+			}
+			at, err := time.Parse(time.RFC3339Nano, st.UpdatedAt)
+			if err != nil || !at.Before(cutoff) {
+				continue
+			}
+			if err := sweep(filepath.Join(base, task.LogsDir)); err != nil {
+				return res, err
+			}
+		}
+	}
+	// Exclude writers before querying status, including eval resume in another
+	// process. A busy eval is skipped until a later maintenance pass.
+	cleanEval := safe("eval-work")
+	if cleanEval && !dryRun {
+		release, busy, err := eval.TryMaintenanceLock(w.Paths.EvalWork, true)
+		if err != nil {
+			return res, err
+		}
+		cleanEval = !busy
+		if !busy {
+			defer release()
+		}
+	}
+	// Derive paths from a validated batch ID, never from stored absolute log_dir.
+	rows, err := s.DB.QueryContext(ctx, `SELECT batch_id FROM eval_batches b
+		WHERE status <> 'running' AND finished_at IS NOT NULL AND finished_at < ?
+		AND NOT EXISTS (SELECT 1 FROM evaluation_runs r WHERE r.batch_id = b.batch_id AND r.status = 'running')`, cutoff.UTC().Format("2006-01-02T15:04:05.000Z"))
+	if err != nil {
+		return res, err
+	}
+	var batches []string
+	for rows.Next() {
+		var id string
+		if err := rows.Scan(&id); err != nil {
+			rows.Close()
+			return res, err
+		}
+		if id != "." && filepath.IsLocal(id) && !strings.ContainsAny(id, `/\`) {
+			batches = append(batches, id)
+		}
+	}
+	err = rows.Err()
+	rows.Close()
+	if err != nil {
+		return res, err
+	}
+	for _, id := range batches {
+		if !cleanEval {
+			break
+		}
+		for _, kind := range []string{"logs", "runs"} {
+			if err := sweep(filepath.Join("eval-work", kind, id)); err != nil {
+				return res, err
+			}
+		}
+	}
+	if !dryRun {
+		// Atomic replacement never follows an existing cleanup.last symlink.
+		name := ".cleanup-" + ulid.New()
+		f, err := root.OpenFile(name, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+		if err != nil {
+			return res, err
+		}
+		defer func() { _ = root.Remove(name) }()
+		_, writeErr := f.WriteString(now.UTC().Format(time.RFC3339Nano))
+		closeErr := f.Close()
+		if err := errors.Join(writeErr, closeErr); err != nil {
+			return res, err
+		}
+		err = root.Rename(name, "cleanup.last")
+	}
+	return res, err
+}
