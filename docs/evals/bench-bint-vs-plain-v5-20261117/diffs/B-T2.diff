diff --git a/internal/privateinput/privateinput.go b/internal/privateinput/privateinput.go
new file mode 100644
index 0000000..048bdca
--- /dev/null
+++ b/internal/privateinput/privateinput.go
@@ -0,0 +1,239 @@
+// Package privateinput owns short-lived functional inputs. Retained diagnostic
+// copies must be redacted separately. OS locks, not PIDs, distinguish live input
+// from an orphan after a crash.
+package privateinput
+
+import (
+	"bint/internal/redact"
+	"context"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+
+	"bint/internal/fslock"
+	"bint/internal/ulid"
+)
+
+type Lease struct {
+	Path string
+	name string
+	work string
+	lock *os.File
+	root *os.Root
+	once sync.Once
+	err  error
+}
+
+func Create(ctx context.Context, dir string, data []byte) (*Lease, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if err := Cleanup(ctx, dir); err != nil {
+		return nil, err
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return nil, err
+	}
+	info, err := os.Lstat(dir)
+	if err != nil {
+		return nil, err
+	}
+	if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+		return nil, errors.New("private input directory must be a regular directory")
+	}
+	root, err := os.OpenRoot(dir)
+	if err != nil {
+		return nil, err
+	}
+	id := ulid.New()
+	lock, err := root.OpenFile(id+".lock", os.O_CREATE|os.O_EXCL|os.O_RDWR, 0600)
+	if err != nil {
+		root.Close()
+		return nil, err
+	}
+	busy, err := fslock.Try(lock, true)
+	if err != nil || busy {
+		lock.Close()
+		root.Close()
+		if err == nil {
+			err = errors.New("private input lock busy")
+		}
+		return nil, err
+	}
+	work := id + ".work"
+	if err := root.Mkdir(work, 0700); err != nil {
+		lock.Close()
+		root.Close()
+		return nil, err
+	}
+	name := filepath.Join(work, "prompt.txt")
+	lease := &Lease{Path: filepath.Join(dir, name), name: name, work: work, lock: lock, root: root}
+	file, err := root.OpenFile(lease.name, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		lease.Close()
+		return nil, err
+	}
+	if _, err = file.Write(data); err != nil {
+		file.Close()
+		lease.Close()
+		return nil, err
+	}
+	if err = file.Close(); err != nil {
+		lease.Close()
+		return nil, err
+	}
+	if err = ctx.Err(); err != nil {
+		lease.Close()
+		return nil, err
+	}
+	return lease, nil
+}
+
+func (l *Lease) Close() error {
+	l.once.Do(func() {
+		l.err = l.root.RemoveAll(l.work)
+		if errors.Is(l.err, os.ErrNotExist) {
+			l.err = nil
+		}
+		// Lock files are intentionally retained: unlinking a lock permits two
+		// owners on different inodes. They contain no input or credential data.
+		if err := l.lock.Close(); l.err == nil {
+			l.err = err
+		}
+		if err := l.root.Close(); l.err == nil {
+			l.err = err
+		}
+	})
+	return l.err
+}
+
+func Cleanup(ctx context.Context, dir string) error {
+	root, err := os.OpenRoot(dir)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	defer root.Close()
+	folder, err := root.Open(".")
+	if err != nil {
+		return err
+	}
+	defer folder.Close()
+	entries, err := folder.ReadDir(-1)
+	if err != nil {
+		return err
+	}
+	for _, entry := range entries {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if !strings.HasSuffix(entry.Name(), ".work") && !strings.HasSuffix(entry.Name(), ".input") {
+			continue
+		}
+		id := strings.TrimSuffix(strings.TrimSuffix(entry.Name(), ".input"), ".work")
+		if !ulid.Valid(id) {
+			continue
+		}
+		lock, err := root.OpenFile(id+".lock", os.O_CREATE|os.O_RDWR, 0600)
+		if err != nil {
+			return err
+		}
+		busy, err := fslock.Try(lock, true)
+		if err != nil {
+			lock.Close()
+			return err
+		}
+		if busy {
+			lock.Close()
+			continue
+		}
+		err = root.RemoveAll(entry.Name())
+		lock.Close()
+		if err != nil && !errors.Is(err, os.ErrNotExist) {
+			return err
+		}
+	}
+	return nil
+}
+
+// ExportArtifacts retains agent-created siblings of the functional input as
+// diagnostic copies. Each run owns a separate directory, so parallel agents
+// cannot mix their outputs. Symlinks/special files cannot escape the lease.
+func (l *Lease) ExportArtifacts(destination string, environ ...string) error {
+	if err := os.MkdirAll(destination, 0700); err != nil {
+		return err
+	}
+	out, err := os.OpenRoot(destination)
+	if err != nil {
+		return err
+	}
+	defer out.Close()
+	engine := redact.Environment()
+	if len(environ) > 0 {
+		engine = redact.EnvironmentFrom(environ)
+	}
+	return l.exportDirectory(out, l.work, ".", engine)
+}
+func (l *Lease) exportDirectory(out *os.Root, source, target string, engine *redact.Engine) error {
+	dir, err := l.root.Open(source)
+	if err != nil {
+		return err
+	}
+	entries, err := dir.ReadDir(-1)
+	dir.Close()
+	if err != nil {
+		return err
+	}
+	for _, entry := range entries {
+		src := filepath.Join(source, entry.Name())
+		dst := filepath.Join(target, entry.Name())
+		if src == l.name {
+			continue
+		}
+		if entry.Type()&os.ModeSymlink != 0 {
+			return errors.New("agent artifact symlink is not a retained diagnostic")
+		}
+		if entry.IsDir() {
+			if err := out.Mkdir(dst, 0700); err != nil && !errors.Is(err, os.ErrExist) {
+				return err
+			}
+			if err := l.exportDirectory(out, src, dst, engine); err != nil {
+				return err
+			}
+			continue
+		}
+		if !entry.Type().IsRegular() {
+			return errors.New("agent artifact must be a regular file")
+		}
+		in, err := l.root.Open(src)
+		if err != nil {
+			return err
+		}
+		// Do not overwrite Bint's prompt or live log if a custom agent reused a name.
+		file, err := out.OpenFile(dst, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+		if err != nil {
+			in.Close()
+			return err
+		}
+		writer := engine.Writer(file)
+		_, copyErr := io.Copy(writer, in)
+		closeErr := writer.Close()
+		fileErr := file.Close()
+		in.Close()
+		if copyErr != nil {
+			return copyErr
+		}
+		if closeErr != nil {
+			return closeErr
+		}
+		if fileErr != nil {
+			return fileErr
+		}
+	}
+	return nil
+}
