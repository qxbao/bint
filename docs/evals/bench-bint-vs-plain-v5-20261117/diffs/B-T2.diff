@@ -0,0 +1,136 @@
+package eval
+
+import (
+	"bint/internal/state"
+	"bint/internal/testutil"
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestCommandAgentPromptFilePreservesExecutionInput(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("fixture uses a POSIX shell")
+	}
+	testutil.Isolate(t)
+	const prompt = "password=prompt-input-canary-123456"
+	agent := &CommandAgent{Command: `test "$(cat "$BINT_EVAL_PROMPT_FILE")" = "$(cat)"`}
+	result := agent.Run(context.Background(), AgentRequest{Dir: t.TempDir(), Prompt: prompt, LogPath: filepath.Join(t.TempDir(), "agent.log")})
+	if result.ExitCode != 0 {
+		t.Fatal("file-based agent received a changed prompt while stdin had the original")
+	}
+	pool, err := state.PrivateInputsDir()
+	if err != nil {
+		t.Fatal(err)
+	}
+	entries, err := os.ReadDir(pool)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, entry := range entries {
+		if strings.HasSuffix(entry.Name(), ".input") {
+			t.Error("retained functional input after agent returned")
+		}
+	}
+}
+
+func TestCommandAgentInputRemovedOnFailureAndCancellation(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("fixture uses a POSIX shell")
+	}
+	for _, cancelled := range []bool{false, true} {
+		t.Run(fmt.Sprint(cancelled), func(t *testing.T) {
+			testutil.Isolate(t)
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			command := "exit 7"
+			if cancelled {
+				command = "sleep 20"
+				time.AfterFunc(50*time.Millisecond, cancel)
+			}
+			result := (&CommandAgent{Command: command}).Run(ctx, AgentRequest{Dir: t.TempDir(), Prompt: "password=failed-input-canary-123", LogPath: filepath.Join(t.TempDir(), "agent.log")})
+			if result.ExitCode == 0 {
+				t.Fatal("expected fixture failure")
+			}
+			pool, err := state.PrivateInputsDir()
+			if err != nil {
+				t.Fatal(err)
+			}
+			entries, err := os.ReadDir(pool)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, entry := range entries {
+				if strings.HasSuffix(entry.Name(), ".input") {
+					t.Error("retained secret input after failure/cancellation")
+				}
+			}
+		})
+	}
+}
+
+func TestChildOnlyCredentialDoesNotReachLogOrTail(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("fixture uses a POSIX shell")
+	}
+	testutil.Isolate(t)
+	const value = "child-only-canary-123456789"
+	log := filepath.Join(t.TempDir(), "agent.log")
+	result := RunShell(context.Background(), t.TempDir(), `printf '%s\n' "$CHILD_API_TOKEN"`, time.Second, log, append(os.Environ(), "CHILD_API_TOKEN="+value))
+	if !result.OK() {
+		t.Fatal(result.Err)
+	}
+	b, err := os.ReadFile(log)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(b), value) || strings.Contains(result.Tail, value) {
+		t.Fatal("child-only credential leaked to diagnostics")
+	}
+}
+
+func TestCustomAgentSiblingArtifactsRemainInLogDir(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("POSIX fixture")
+	}
+	testutil.Isolate(t)
+	dir := t.TempDir()
+	agent := &CommandAgent{Command: `printf 'ordinary password=artifactCanary123\n' > "$(dirname "$BINT_EVAL_PROMPT_FILE")/seen.txt"`}
+	result := agent.Run(context.Background(), AgentRequest{Dir: t.TempDir(), Prompt: "password=promptCanary123", LogPath: filepath.Join(dir, "agent.log")})
+	if result.ExitCode != 0 {
+		t.Fatal(result.Error)
+	}
+	b, err := os.ReadFile(filepath.Join(dir, "seen.txt"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(b), "Canary") || !strings.Contains(string(b), "ordinary") {
+		t.Fatal("artifact was not retained safely")
+	}
+}
+
+func TestSiblingArtifactUsesChildCredentialEnvironment(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("POSIX fixture")
+	}
+	testutil.Isolate(t)
+	const token = "sibling-child-canary-123456"
+	dir := t.TempDir()
+	agent := &CommandAgent{Command: `printf '%s\n' "$PRIVATE_API_TOKEN" > "$(dirname "$BINT_EVAL_PROMPT_FILE")/seen.txt"`}
+	result := agent.Run(context.Background(), AgentRequest{Dir: t.TempDir(), Prompt: "ordinary", LogPath: filepath.Join(dir, "agent.log"), Env: []string{"PRIVATE_API_TOKEN=" + token}})
+	if result.ExitCode != 0 {
+		t.Fatal(result.Error)
+	}
+	b, err := os.ReadFile(filepath.Join(dir, "seen.txt"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(b), token) {
+		t.Fatal("child credential leaked through sibling artifact export")
+	}
+}
