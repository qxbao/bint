+	// contend for the sweep lock, rather than only reading a completed marker.
+	if err := os.Remove(filepath.Join(paths.Root, "privacy-v1.json")); err != nil {
+		t.Fatal(err)
+	}
+	// Exercise two independent CLI processes opening/ingesting the same store.
+	var concurrent [2]bytes.Buffer
+	commands := make([]*exec.Cmd, 2)
+	for i := range commands {
+		commands[i] = exec.Command(bintBin, "status")
+		commands[i].Dir = root
+		commands[i].Stdout = &concurrent[i]
+		commands[i].Stderr = &concurrent[i]
