+	first, err := Scrub(context.Background(), Options{StateRoot: root})
+	if err != nil || first.Complete {
+		t.Fatalf("first: %+v %v", first, err)
+	}
+	retry, err := Scrub(context.Background(), Options{StateRoot: root})
+	if err != nil || retry.Complete {
+		t.Fatalf("retry: %+v %v", retry, err)
+	}
+	if retry.Scanned != 0 {
+		t.Fatal("pending sweep re-read already clean diagnostic data")
+	}
+}
+
+func TestReviewClaudeMCPFunctionalCredentials(t *testing.T) {
+	root, isoHome := t.TempDir(), t.TempDir()
+	dir := filepath.Join(isoHome, "profiles", "claude--review", "home", ".claude")
+	if err := os.MkdirAll(dir, 0700); err != nil {
