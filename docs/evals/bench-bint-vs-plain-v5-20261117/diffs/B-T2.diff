diff --git a/internal/safesql/safesql.go b/internal/safesql/safesql.go
new file mode 100644
index 0000000..ba7b55a
--- /dev/null
+++ b/internal/safesql/safesql.go
@@ -0,0 +1,29 @@
+package safesql
+
+import (
+	"bint/internal/redact"
+	"context"
+	"database/sql"
+)
+
+type executor interface {
+	ExecContext(context.Context, string, ...any) (sql.Result, error)
+}
+
+// ExecContext protects diagnostic SQL parameters before SQLite can journal them.
+// SQL text and execution inputs are never rewritten.
+func ExecContext(db executor, ctx context.Context, query string, args ...any) (sql.Result, error) {
+	engine := redact.Environment()
+	safe := make([]any, len(args))
+	for i, arg := range args {
+		switch value := arg.(type) {
+		case string:
+			safe[i] = engine.String(value)
+		case []byte:
+			safe[i] = []byte(engine.String(string(value)))
+		default:
+			safe[i] = arg
+		}
+	}
+	return db.ExecContext(ctx, query, safe...)
+}
