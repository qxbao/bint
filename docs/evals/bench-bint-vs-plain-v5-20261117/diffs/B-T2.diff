+package privateinput
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+)
+
+func TestLeasePreservesInputAndRemovesIt(t *testing.T) {
+	root := t.TempDir()
+	ctx := context.Background()
+	lease, err := Create(ctx, root, []byte("password=lease-canary-123456"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 2; i++ {
+		b, err := os.ReadFile(lease.Path)
+		if err != nil || string(b) != "password=lease-canary-123456" {
+			t.Fatal("functional input is not readable verbatim twice")
+		}
+	}
+	info, err := os.Stat(lease.Path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Mode().Perm()&0077 != 0 && runtime.GOOS != "windows" {
+		t.Fatal("input is readable by another user")
+	}
+	if err := Cleanup(ctx, root); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(lease.Path); err != nil {
+		t.Fatal("cleanup removed live agent input")
+	}
+	if err := lease.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(lease.Path); !os.IsNotExist(err) {
+		t.Fatal("input retained after execution")
+	}
+	if err := lease.Close(); err != nil {
+		t.Fatal("release must be idempotent")
+	}
+}
+
+func TestReapOrphanAndLeaveOtherDataAlone(t *testing.T) {
+	root := t.TempDir()
+	ctx := context.Background()
+	lease, err := Create(ctx, root, []byte("password=orphan-canary-123456"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Closing only the OS lock models process death: no PID-based reclamation.
+	lease.lock.Close()
+	lease.root.Close()
+	other := filepath.Join(root, "unrelated.txt")
+	if err := os.WriteFile(other, []byte("untouched"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := Cleanup(ctx, root); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(lease.Path); !os.IsNotExist(err) {
+		t.Fatal("orphan secret was not removed")
+	}
+	b, err := os.ReadFile(other)
+	if err != nil || string(b) != "untouched" {
+		t.Fatal("modified an unrelated file")
+	}
+	entries, err := os.ReadDir(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, entry := range entries {
+		if strings.HasSuffix(entry.Name(), ".input") {
+			t.Error("retained input after orphan collection")
+		}
+	}
+}
+
+func TestMissingPoolCleanupIsReadOnly(t *testing.T) {
+	root := filepath.Join(t.TempDir(), "not-created")
+	if err := Cleanup(context.Background(), root); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(root); !os.IsNotExist(err) {
+		t.Fatal("created a pool during read-only cleanup")
+	}
+}
