+package fsafe
+
+import (
+	"bint/internal/redact"
+	"os"
+)
+
+// WriteDiagnosticAtomic is only for retained diagnostic data, not source code,
+// executable configuration or credential stores. Even its temporary file is safe.
+func WriteDiagnosticAtomic(path string, data []byte, perm os.FileMode) error {
+	return WriteAtomic(path, redact.Bytes(data), perm)
+}
+
+func WriteDiagnosticFile(path string, data []byte, perm os.FileMode) error {
+	return os.WriteFile(path, redact.Bytes(data), perm)
+}
