diff --git a/internal/redact/stream.go b/internal/redact/stream.go
new file mode 100644
index 0000000..b643d60
--- /dev/null
+++ b/internal/redact/stream.go
@@ -0,0 +1,262 @@
+package redact
+
+import (
+	"bytes"
+	"io"
+	"regexp"
+	"strings"
+	"sync"
+)
+
+const streamLimit = 64 * 1024
+const lookbehind = 8192
+
+// Writer buffers bounded diagnostic records, not the agent's execution stream.
+// Close flushes the final partial record; it never closes the underlying writer.
+type Writer struct {
+	mu         sync.Mutex
+	dst        io.Writer
+	engine     *Engine
+	buf        []byte
+	discard    byte
+	escaped    bool
+	dynamic    bool
+	yamlIndent int
+	closed     bool
+	err        error
+}
+
+// NewDisplayWriter refreshes workspace credentials at each CLI output call.
+// It is for diagnostics only, never hook/RPC protocol or interactive agent IO.
+func NewDisplayWriter(dst io.Writer) *Writer { w := NewWriter(dst); w.dynamic = true; return w }
+func NewWriter(dst io.Writer) *Writer        { return Environment().Writer(dst) }
+func (e *Engine) Writer(dst io.Writer) *Writer {
+	return &Writer{dst: dst, engine: e, buf: make([]byte, 0, streamLimit), yamlIndent: -1}
+}
+
+var yamlBlock = regexp.MustCompile(`^([ \t]*)([A-Za-z_][A-Za-z0-9_.-]*):[ \t]*[|>][-+0-9]*[ \t]*$`)
+
+func (w *Writer) emit(b []byte) {
+	line := string(b)
+	indent := len(line) - len(strings.TrimLeft(line, " \t"))
+	if w.yamlIndent >= 0 {
+		if strings.TrimSpace(line) == "" || indent > w.yamlIndent {
+			return
+		}
+		w.yamlIndent = -1
+	}
+	if match := yamlBlock.FindStringSubmatch(strings.TrimRight(line, "\r\n")); match != nil && Sensitive(match[2]) {
+		w.yamlIndent = len(match[1])
+		b = []byte(match[1] + match[2] + ": \"" + Marker + "\"\n")
+	}
+	if w.err == nil {
+		_, w.err = io.WriteString(w.dst, w.engine.String(string(b)))
+	}
+}
+func (w *Writer) Write(p []byte) (int, error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.closed {
+		return 0, io.ErrClosedPipe
+	}
+	if w.dynamic {
+		w.engine = Environment()
+	}
+	n := len(p)
+	for len(p) > 0 {
+		// Bulk-copy complete ordinary records; incomplete records stay buffered
+		// so a label split across writes cannot evade recognition.
+		if len(w.buf) == 0 && w.discard == 0 && w.yamlIndent < 0 && len(p) >= 1024 {
+			end := min(len(p), streamLimit)
+			if last := bytes.LastIndexByte(p[:end], '\n'); last >= 0 && !w.engine.candidate(string(p[:last+1])) {
+				if w.err == nil {
+					n, err := w.dst.Write(p[:last+1])
+					if err == nil && n != last+1 {
+						err = io.ErrShortWrite
+					}
+					w.err = err
+				}
+				p = p[last+1:]
+				continue
+			}
+		}
+		if w.discard != 0 {
+			i := 0
+			for i < len(p) {
+				c := p[i]
+				if (w.discard == ' ' && strings.ContainsRune(" \t\r\n\"',;}]", rune(c))) || (c == w.discard && !w.escaped) {
+					break
+				}
+				if w.discard == '"' || w.discard == '\'' {
+					if c == '\\' {
+						w.escaped = !w.escaped
+					} else {
+						w.escaped = false
+					}
+				}
+				i++
+			}
+			p = p[i:]
+			if len(p) == 0 {
+				break
+			}
+			w.discard = 0
+		}
+		take := min(len(p), streamLimit-len(w.buf))
+		// Flush full lines early, preserving record order and complete JSON.
+		if i := bytes.IndexByte(p[:take], '\n'); i >= 0 {
+			take = i + 1
+		}
+		w.buf = append(w.buf, p[:take]...)
+		p = p[take:]
+		if len(w.buf) > 0 && w.buf[len(w.buf)-1] == '\n' {
+			if !w.incompleteQuoted() {
+				w.emit(w.buf)
+				w.buf = w.buf[:0]
+			}
+			continue
+		}
+		if len(w.buf) == streamLimit {
+			w.overflow()
+		}
+	}
+	if w.err != nil {
+		return n, w.err
+	}
+	return n, nil
+}
+
+var assignmentHead = regexp.MustCompile(`(?i)(\b[A-Za-z_][A-Za-z0-9_.-]*["']?\s*[:=]\s*|(?:^|[ \t])--?[A-Za-z_][A-Za-z0-9_.-]*\s+)`)
+var urlHead = regexp.MustCompile(`://[^/\s:@]+:`)
+
+func (w *Writer) secretPrefix(prefix []byte, end byte) {
+	w.emit(prefix)
+	if w.err == nil {
+		_, w.err = io.WriteString(w.dst, Marker)
+	}
+	w.discard = end
+	w.escaped = false
+	w.buf = w.buf[:0]
+}
+func (w *Writer) overflow() {
+	s := string(w.buf)
+	if w.yamlIndent >= 0 && len(s)-len(strings.TrimLeft(s, " \t")) > w.yamlIndent {
+		w.buf = w.buf[:0]
+		w.discard = '\n'
+		return
+	}
+	// Detect unterminated quoted fields separately: the complete-value regexp
+	// intentionally cannot match them, and flushing a prefix would leak them.
+	for _, loc := range assignmentHead.FindAllStringIndex(s, -1) {
+		if !Sensitive(keyName.FindString(strings.TrimLeft(s[loc[0]:loc[1]], " -\t"))) {
+			continue
+		}
+		start := loc[1]
+		if start >= len(s) {
+			continue
+		}
+		quote := s[start]
+		if quote != '"' && quote != '\'' {
+			continue
+		}
+		escaped, closed := false, false
+		for i := start + 1; i < len(s); i++ {
+			c := s[i]
+			if c == quote && !escaped {
+				closed = true
+				break
+			}
+			if c == '\\' {
+				escaped = !escaped
+			} else {
+				escaped = false
+			}
+		}
+		if !closed {
+			w.secretPrefix(w.buf[:start+1], quote)
+			w.escaped = escaped
+			return
+		}
+	}
+	for _, loc := range assignment.FindAllStringSubmatchIndex(s, -1) {
+		if loc[1] == len(s) && Sensitive(keyName.FindString(strings.TrimLeft(s[loc[2]:loc[3]], " -\t"))) {
+			w.secretPrefix(w.buf[:loc[4]], ' ')
+			return
+		}
+	}
+	if loc := bearer.FindStringSubmatchIndex(s); loc != nil && loc[1] == len(s) {
+		w.secretPrefix(w.buf[:loc[3]], ' ')
+		return
+	}
+	if loc := apiKey.FindStringIndex(s); loc != nil && loc[1] == len(s) {
+		w.secretPrefix(w.buf[:loc[0]], ' ')
+		return
+	}
+	if loc := urlHead.FindStringIndex(s); loc != nil && !strings.ContainsAny(s[loc[1]:], "@/ \t\r\n") {
+		w.secretPrefix(w.buf[:loc[0]+3], '@')
+		return
+	}
+	cut := len(w.buf) - lookbehind
+	if i := bytes.LastIndexAny(w.buf[:cut], " \t\r\n,;}"); i >= 0 {
+		cut = i + 1
+	}
+	// Do not split an occurrence of a known value at the flush boundary.
+	for _, value := range w.engine.known {
+		from := max(0, cut-len(value)+1)
+		if i := strings.Index(s[from:], value); i >= 0 && from+i < cut && from+i+len(value) > cut {
+			cut = from + i
+		}
+	}
+	w.emit(w.buf[:cut])
+	w.buf = append(w.buf[:0], w.buf[cut:]...)
+}
+func (w *Writer) Close() error {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if !w.closed {
+		if w.incompleteQuoted() {
+			w.overflow()
+		} else {
+			w.emit(w.buf)
+		}
+		w.buf = nil
+		w.closed = true
+	}
+	return w.err
+}
+
+// Keep quoted secret records across real newlines. A bounded overflow switches
+// to discarding the value until its closing quote, without emitting any part.
+func (w *Writer) incompleteQuoted() bool {
+	s := string(w.buf)
+	for _, loc := range assignmentHead.FindAllStringIndex(s, -1) {
+		if !Sensitive(keyName.FindString(strings.TrimLeft(s[loc[0]:loc[1]], " -\t"))) {
+			continue
+		}
+		start := loc[1]
+		if start >= len(s) {
+			continue
+		}
+		quote := s[start]
+		if quote != '"' && quote != '\'' {
+			continue
+		}
+		escaped, closed := false, false
+		for i := start + 1; i < len(s); i++ {
+			c := s[i]
+			if c == quote && !escaped {
+				closed = true
+				break
+			}
+			if c == '\\' {
+				escaped = !escaped
+			} else {
+				escaped = false
+			}
+		}
+		if !closed {
+			return true
+		}
+	}
+	return false
+}
diff --git a/internal/redact/structured.go b/internal/redact/structured.go
new file mode 100644
index 0000000..66b3d2d
--- /dev/null
+++ b/internal/redact/structured.go
@@ -0,0 +1,72 @@
+package redact
+
+import (
+	"bytes"
+	"strings"
+
+	"github.com/pelletier/go-toml/v2"
+	"gopkg.in/yaml.v3"
+)
+
+func (e *Engine) structured(s string) (string, bool) {
+	if strings.Contains(s, "=") {
+		var doc map[string]any
+		if toml.Unmarshal([]byte(s), &doc) == nil && len(doc) > 0 {
+			value := any(doc)
+			if !e.walk(&value) {
+				return s, true
+			}
+			if b, err := toml.Marshal(value); err == nil {
+				return string(b), true
+			}
+		}
+	}
+	// Avoid treating arbitrary prose as YAML scalar data. Node-based editing
+	// preserves scalar types, aliases and block quoting of non-secret fields.
+	if strings.Contains(s, ":") {
+		var doc yaml.Node
+		if yaml.Unmarshal([]byte(s), &doc) == nil && len(doc.Content) > 0 && doc.Content[0].Kind == yaml.MappingNode {
+			if !e.yaml(&doc) {
+				return s, true
+			}
+			var out bytes.Buffer
+			enc := yaml.NewEncoder(&out)
+			enc.SetIndent(2)
+			if err := enc.Encode(&doc); err == nil {
+				enc.Close()
+				return out.String(), true
+			}
+		}
+	}
+	return "", false
+}
+func (e *Engine) yaml(node *yaml.Node) bool {
+	changed := false
+	if node.Kind == yaml.MappingNode {
+		for i := 0; i+1 < len(node.Content); i += 2 {
+			key, value := node.Content[i], node.Content[i+1]
+			if Sensitive(key.Value) && value.Kind == yaml.ScalarNode && value.Tag != "!!null" && !(strings.EqualFold(key.Value, "auth") && value.Tag == "!!bool") {
+				if value.Value != Marker && !isCommandReference(value.Value) {
+					value.Value = Marker
+					value.Tag = "!!str"
+					changed = true
+				}
+			} else if e.yaml(value) {
+				changed = true
+			}
+		}
+	} else if node.Kind == yaml.ScalarNode && node.Tag == "!!str" {
+		next := e.text(node.Value)
+		if next != node.Value {
+			node.Value = next
+			changed = true
+		}
+	} else {
+		for _, child := range node.Content {
+			if e.yaml(child) {
+				changed = true
+			}
+		}
+	}
+	return changed
+}
