diff --git a/internal/store/privacy.go b/internal/store/privacy.go
new file mode 100644
index 0000000..2644d13
--- /dev/null
+++ b/internal/store/privacy.go
@@ -0,0 +1,148 @@
+package store
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"strings"
+
+	"bint/internal/redact"
+)
+
+func quoteIdentifier(s string) string { return `"` + strings.ReplaceAll(s, `"`, `""`) + `"` }
+
+// ScrubDiagnostics rewrites retained text, then eliminates obsolete SQLite and
+// FTS pages. Call on a dedicated store, never from a hook. Busy readers/writers
+// produce an error: a partial cleanup is never reported as complete.
+func (s *Store) ScrubDiagnostics(ctx context.Context, engine *redact.Engine) error {
+	s.DB.SetMaxOpenConns(1)
+	if _, err := s.DB.ExecContext(ctx, "PRAGMA secure_delete=ON"); err != nil {
+		return err
+	}
+	rows, err := s.DB.QueryContext(ctx, "PRAGMA table_list")
+	if err != nil {
+		return err
+	}
+	type table struct{ name, kind string }
+	var tables []table
+	for rows.Next() {
+		var schema, name, kind string
+		var cols, withoutRowid, strict int
+		if err := rows.Scan(&schema, &name, &kind, &cols, &withoutRowid, &strict); err != nil {
+			rows.Close()
+			return err
+		}
+		if schema == "main" && !strings.HasPrefix(name, "sqlite_") && kind != "shadow" {
+			if withoutRowid != 0 {
+				rows.Close()
+				return fmt.Errorf("privacy: unsupported WITHOUT ROWID table %s", name)
+			}
+			tables = append(tables, table{name, kind})
+		}
+	}
+	if err := rows.Err(); err != nil {
+		rows.Close()
+		return err
+	}
+	rows.Close()
+	tx, err := s.DB.BeginTx(ctx, nil)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	for _, tbl := range tables {
+		result, err := tx.QueryContext(ctx, "SELECT rowid,* FROM "+quoteIdentifier(tbl.name))
+		if err != nil {
+			return err
+		}
+		cols, err := result.Columns()
+		if err != nil {
+			result.Close()
+			return err
+		}
+		type update struct {
+			id     any
+			cols   []string
+			values []any
+		}
+		var updates []update
+		for result.Next() {
+			values := make([]any, len(cols))
+			ptrs := make([]any, len(cols))
+			for i := range values {
+				ptrs[i] = &values[i]
+			}
+			if err := result.Scan(ptrs...); err != nil {
+				result.Close()
+				return err
+			}
+			u := update{id: values[0]}
+			for i := 1; i < len(values); i++ {
+				var original string
+				switch v := values[i].(type) {
+				case string:
+					original = v
+				case []byte:
+					original = string(v)
+				default:
+					continue
+				}
+				safe := engine.String(original)
+				if safe != original {
+					u.cols = append(u.cols, quoteIdentifier(cols[i])+"=?")
+					u.values = append(u.values, safe)
+				}
+			}
+			if len(u.cols) > 0 {
+				updates = append(updates, u)
+			}
+		}
+		if err := result.Err(); err != nil {
+			result.Close()
+			return err
+		}
+		result.Close()
+		for _, u := range updates {
+			u.values = append(u.values, u.id)
+			if _, err := tx.ExecContext(ctx, "UPDATE "+quoteIdentifier(tbl.name)+" SET "+strings.Join(u.cols, ",")+" WHERE rowid=?", u.values...); err != nil {
+				return err
+			}
+		}
+		if tbl.kind == "virtual" {
+			var ddl string
+			if err := tx.QueryRowContext(ctx, "SELECT sql FROM sqlite_master WHERE name=?", tbl.name).Scan(&ddl); err != nil {
+				return err
+			}
+			if strings.Contains(strings.ToLower(ddl), "fts5") {
+				if _, err := tx.ExecContext(ctx, "INSERT INTO "+quoteIdentifier(tbl.name)+"("+quoteIdentifier(tbl.name)+") VALUES('rebuild')"); err != nil {
+					return err
+				}
+			}
+		}
+	}
+	if err := tx.Commit(); err != nil {
+		return err
+	}
+	if _, err := s.DB.ExecContext(ctx, "VACUUM"); err != nil {
+		return err
+	}
+	var busy, logPages, checkpointed int
+	if err := s.DB.QueryRowContext(ctx, "PRAGMA wal_checkpoint(TRUNCATE)").Scan(&busy, &logPages, &checkpointed); err != nil {
+		return err
+	}
+	if busy != 0 {
+		return fmt.Errorf("privacy: SQLite checkpoint busy")
+	}
+	return nil
+}
+
+// ScrubFile opens an existing SQLite diagnostic database without adding Bint's
+// schema to unrelated indexes or backup databases.
+func ScrubFile(ctx context.Context, path string, engine *redact.Engine) error {
+	db, err := sql.Open("sqlite", DSN(path))
+	if err != nil {
+		return err
+	}
+	defer db.Close()
+	return (&Store{DB: db, Path: path}).ScrubDiagnostics(ctx, engine)
+}
