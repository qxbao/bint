@@ -0,0 +1,49 @@
+package redact
+
+import (
+	"bytes"
+	"io"
+	"os"
+	"testing"
+)
+
+func BenchmarkStreamIO(b *testing.B) {
+	data := bytes.Repeat([]byte("ordinary output timeout=1\n"), 420000)
+	for _, protect := range []bool{false, true} {
+		name := "baseline"
+		if protect {
+			name = "redacted"
+		}
+		b.Run(name, func(b *testing.B) {
+			file, err := os.CreateTemp(b.TempDir(), "diagnostic")
+			if err != nil {
+				b.Fatal(err)
+			}
+			defer file.Close()
+			b.SetBytes(int64(len(data)))
+			b.ResetTimer()
+			for i := 0; i < b.N; i++ {
+				if _, err := file.Seek(0, 0); err != nil {
+					b.Fatal(err)
+				}
+				var dst io.Writer = file
+				var safe *Writer
+				if protect {
+					safe = New().Writer(file)
+					dst = safe
+				}
+				if _, err := io.CopyBuffer(dst, bytes.NewReader(data), make([]byte, 32*1024)); err != nil {
+					b.Fatal(err)
+				}
+				if safe != nil {
+					if err := safe.Close(); err != nil {
+						b.Fatal(err)
+					}
+				}
+				if err := file.Sync(); err != nil {
+					b.Fatal(err)
+				}
+			}
+		})
+	}
+}
diff --git a/internal/redact/redact.go b/internal/redact/redact.go
new file mode 100644
index 0000000..b9a3575
--- /dev/null
+++ b/internal/redact/redact.go
@@ -0,0 +1,186 @@
+// Package redact protects diagnostic copies, never inputs used for execution.
+package redact
+
+import (
+	"encoding/json"
+	"os"
+	"regexp"
+	"strings"
+	"sync"
+)
+
+const Marker = "***"
+
+var assignment = regexp.MustCompile(`(?i)(\b[A-Za-z_][A-Za-z0-9_.-]*["']?\s*[:=]\s*|(?:^|[ \t])--?[A-Za-z_][A-Za-z0-9_.-]*\s+)((?:"(?:\\.|[^"\\])*"|'[^']*'|\{\{[^\s,;]+|[^\s,;\}\]"']+))`)
+var bearer = regexp.MustCompile(`(?i)(\bbearer\s+)[^\s"',;\}\]]+`)
+var urlCredentials = regexp.MustCompile(`(://)[^/\s:@]+:[^/\s@]+@`)
+var apiKey = regexp.MustCompile(`\b(?:sk-(?:proj-|ant-)?[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[A-Z0-9]{16})\b`)
+var keyName = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_.-]*`)
+
+// Sensitive is deliberately label based; token counts and ordinary assignments
+// are not credentials. It also covers camelCase OAuth fields and env names.
+func Sensitive(key string) bool {
+	k := strings.ToLower(strings.NewReplacer("_", "", "-", "", ".", "").Replace(key))
+	for _, suffix := range []string{"password", "passwd", "token", "secret", "apikey", "authorization", "clientsecret"} {
+		if strings.HasSuffix(k, suffix) {
+			return true
+		}
+	}
+	return k == "auth"
+}
+
+// Engine is immutable after construction and can be shared by output streams.
+// Known secrets remain in memory only, scoped to the caller's environment.
+type Engine struct{ known []string }
+
+func New(values ...string) *Engine {
+	e := &Engine{}
+	seen := map[string]bool{}
+	for _, v := range values {
+		if len(v) >= 8 && len(v) <= 4096 && !seen[v] && v != Marker {
+			e.known = append(e.known, v)
+			seen[v] = true
+		}
+	}
+	return e
+}
+
+var credentialMu sync.RWMutex
+var credentialValues []string
+
+func SetCredentials(values []string) {
+	credentialMu.Lock()
+	defer credentialMu.Unlock()
+	credentialValues = append([]string(nil), values...)
+}
+
+func Environment() *Engine { return EnvironmentFrom(os.Environ()) }
+
+// EnvironmentFrom uses the environment actually passed to the child, including
+// credentials absent from the parent process.
+func EnvironmentFrom(environ []string) *Engine {
+	credentialMu.RLock()
+	values := append([]string(nil), credentialValues...)
+	credentialMu.RUnlock()
+	for _, pair := range environ {
+		k, v, ok := strings.Cut(pair, "=")
+		if ok && Sensitive(k) {
+			values = append(values, v)
+		}
+	}
+	return New(values...)
+}
+func String(s string) string { return Environment().String(s) }
+func Bytes(b []byte) []byte {
+	s := String(string(b))
+	if s == string(b) {
+		return b
+	}
+	return []byte(s)
+}
+
+func (e *Engine) text(s string) string {
+	for _, v := range e.known {
+		s = strings.ReplaceAll(s, v, Marker)
+	}
+	s = assignment.ReplaceAllStringFunc(s, func(match string) string {
+		groups := assignment.FindStringSubmatch(match)
+		if !Sensitive(keyName.FindString(strings.TrimLeft(groups[1], " -\t"))) {
+			return match
+		}
+		value := groups[2]
+		if isCommandReference(strings.Trim(value, "\"'")) {
+			return match
+		}
+
+		// Preserve quoting, including valid JSON numeric values handled by String.
+		if len(value) >= 2 && (value[0] == '"' || value[0] == '\'') && value[len(value)-1] == value[0] {
+			return groups[1] + string(value[0]) + Marker + string(value[0])
+		}
+		return groups[1] + Marker
+	})
+	s = bearer.ReplaceAllString(s, "${1}"+Marker)
+	s = urlCredentials.ReplaceAllString(s, "${1}"+Marker+"@")
+	return apiKey.ReplaceAllString(s, Marker)
+}
+func (e *Engine) String(s string) string {
+	if !e.candidate(s) {
+		return s
+	}
+	// Parsing full JSON allows escaped secrets and sensitive typed fields without
+	// corrupting the document. Ordinary JSON is returned byte for byte unchanged.
+	if strings.ContainsAny(s, "{[") && json.Valid([]byte(s)) {
+		var v any
+		decoder := json.NewDecoder(strings.NewReader(s))
+		decoder.UseNumber()
+		if decoder.Decode(&v) == nil {
+			changed := e.walk(&v)
+			if changed {
+				if b, err := json.Marshal(v); err == nil {
+					return string(b)
+				}
+			}
+			return s
+		}
+	}
+	if safe, ok := e.structured(s); ok {
+		return safe
+	}
+	return e.text(s)
+}
+func (e *Engine) walk(v *any) bool {
+	changed := false
+	switch x := (*v).(type) {
+	case string:
+		next := e.text(x)
+		changed = next != x
+		*v = next
+	case map[string]any:
+		for k, value := range x {
+			if Sensitive(k) && value != nil {
+				if str, ok := value.(string); ok && (str == Marker || isCommandReference(str)) {
+					continue
+				}
+				switch value.(type) {
+				case bool:
+					if strings.EqualFold(k, "auth") {
+						continue
+					}
+					x[k] = Marker
+					changed = true
+					continue
+				case string, json.Number, int, int64, uint64, float64:
+					x[k] = Marker
+					changed = true
+					continue
+				}
+			}
+			if e.walk(&value) {
+				x[k] = value
+				changed = true
+			}
+		}
+	case []any:
+		for i := range x {
+			if e.walk(&x[i]) {
+				changed = true
+			}
+		}
+	}
+	return changed
+}
+
+func (e *Engine) candidate(s string) bool {
+	lower := strings.ToLower(s)
+	for _, label := range []string{"password", "passwd", "token", "secret", "api", "auth", "bearer", "://", "sk-", "ghp_", "gho_", "ghu_", "ghs_", "ghr_", "github_pat_", "akia"} {
+		if strings.Contains(lower, label) {
+			return true
+		}
+	}
+	for _, v := range e.known {
+		if strings.Contains(s, v) {
+			return true
+		}
+	}
+	return false
+}
diff --git a/internal/redact/redact_test.go b/internal/redact/redact_test.go
new file mode 100644
index 0000000..80d14e2
--- /dev/null
+++ b/internal/redact/redact_test.go
@@ -0,0 +1,158 @@
+package redact
+
+import (
+	"bytes"
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestSecretsAndOrdinaryContent(t *testing.T) {
+	for _, in := range []string{
+		`password=canary-123`, `ordinary-content password=canary-123
+` + `sk-proj-<FIXTURE>`, `--token canary-123`, `Bearer canary-123`,
+		`https://user:canary-123@example.com`, `{"password":"canary-123","timeout":1}`,
+		`api_key: 'canary-123'`, `ACCESS_TOKEN="canary-123"`,
+		`{"nested":{"accessToken":"canary-123"},"note":"password=canary-123"}`,
+	} {
+		got := String(in)
+		if strings.Contains(got, "canary-123") {
+			t.Errorf("secret form not protected: %q", in)
+		}
+		if json.Valid([]byte(in)) && !json.Valid([]byte(got)) {
+			t.Errorf("damaged JSON: %s", got)
+		}
+		if String(got) != got {
+			t.Errorf("not idempotent: %s", got)
+		}
+	}
+	for _, in := range []string{`timeout=1 answer=42`, `tokens=100`, `go test ./...`, `{"timeout":1,"token_count":2}`} {
+		if got := String(in); got != in {
+			t.Errorf("ordinary content changed: %q -> %q", in, got)
+		}
+	}
+}
+
+func TestStreamEveryBoundary(t *testing.T) {
+	t.Setenv("TEST_API_KEY", "known-credential-123456")
+	input := `ordinary password="stream-secret-123" timeout=1` + "\n" + `{"token":"stream-secret-123"}` + "\nknown-credential-123456\n"
+	for size := 1; size <= len(input); size++ {
+		var dst bytes.Buffer
+		w := NewWriter(&dst)
+		for start := 0; start < len(input); start += size {
+			end := min(start+size, len(input))
+			if _, err := w.Write([]byte(input[start:end])); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if err := w.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if strings.Contains(dst.String(), "stream-secret-123") || strings.Contains(dst.String(), "known-credential-123456") {
+			t.Fatalf("leak at chunk size %d", size)
+		}
+		if !strings.Contains(dst.String(), "ordinary") || !strings.Contains(dst.String(), "timeout=1") {
+			t.Fatalf("ordinary content lost at %d", size)
+		}
+	}
+}
+
+func TestStreamLongSecretAndOrdinary(t *testing.T) {
+	for _, prefix := range []string{"password=", "ordinary="} {
+		var dst bytes.Buffer
+		w := NewWriter(&dst)
+		for i := 0; i < 2048; i++ {
+			chunk := strings.Repeat("x", 1024)
+			if i == 0 {
+				chunk = prefix + chunk
+			}
+			if _, err := w.Write([]byte(chunk)); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if _, err := w.Write([]byte("\n")); err != nil {
+			t.Fatal(err)
+		}
+		if err := w.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if prefix == "password=" && strings.Contains(dst.String(), strings.Repeat("x", 16)) {
+			t.Fatal("long secret leaked")
+		}
+		if prefix == "ordinary=" && dst.Len() != len(prefix)+2048*1024+1 {
+			t.Fatal("long ordinary value was truncated")
+		}
+	}
+}
+
+func BenchmarkPlain(b *testing.B) {
+	data := bytes.Repeat([]byte("ordinary content timeout=1\n"), 400000)
+	b.SetBytes(int64(len(data)))
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		String(string(data))
+	}
+}
+
+func TestLongQuotedAndPrefixSecrets(t *testing.T) {
+	for _, prefix := range []string{`password="`, `{"token":"`, `Bearer `, `sk-proj-`} {
+		var dst bytes.Buffer
+		w := NewWriter(&dst)
+		input := prefix + strings.Repeat("z", 200000) + `"}` + "\nordinary\n"
+		for i := 0; i < len(input); i += 73 {
+			if _, err := w.Write([]byte(input[i:min(i+73, len(input))])); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if err := w.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if strings.Contains(dst.String(), strings.Repeat("z", 12)) {
+			t.Errorf("long value leaked for prefix %q", prefix)
+		}
+		if !strings.Contains(dst.String(), "ordinary") {
+			t.Error("lost record after a long secret")
+		}
+	}
+}
+
+func TestStructuredMultilineSecrets(t *testing.T) {
+	for _, in := range []string{"password: |\n  yaml-canary-secret\ntimeout: 1\n", "password: 'yaml-canary''secret'\ntimeout: 1\n", "api_key = \"\"\"toml-canary-secret\"\"\"\ntimeout=1\n"} {
+		got := String(in)
+		if strings.Contains(got, "canary") {
+			t.Errorf("structured secret leaked: %q", got)
+		}
+		if !strings.Contains(got, "timeout") {
+			t.Fatal("lost ordinary key")
+		}
+	}
+}
+
+func TestStreamYAMLBlock(t *testing.T) {
+	input := "password: |\n  multiline-canary\n  second-canary\ntimeout: 1\n"
+	for size := 1; size <= len(input); size++ {
+		var dst bytes.Buffer
+		w := NewWriter(&dst)
+		for i := 0; i < len(input); i += size {
+			if _, err := w.Write([]byte(input[i:min(i+size, len(input))])); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if err := w.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if strings.Contains(dst.String(), "canary") {
+			t.Fatalf("multiline leak at chunk %d", size)
+		}
+		if !strings.Contains(dst.String(), "timeout: 1") {
+			t.Fatal("lost the next YAML field")
+		}
+	}
+}
+
+func TestJSONOrdinaryIntegerIsExact(t *testing.T) {
+	got := String(`{"token":"canary-123456","count":9007199254740993}`)
+	if !strings.Contains(got, `9007199254740993`) {
+		t.Fatal("redaction rounded an ordinary integer")
+	}
+}
