@@ -0,0 +1,55 @@
+package privacy
+
+import (
+	"os"
+	"path/filepath"
+	"time"
+
+	"bint/internal/fsafe"
+	"bint/internal/redact"
+)
+
+func scrubManagedBlocks(repoRoot, stateRoot string, engine *redact.Engine) []string {
+	if repoRoot == "" {
+		return nil
+	}
+	var pending []string
+	changed := false
+	manifest, err := fsafe.LoadManifest(filepath.Join(stateRoot, "managed.json"))
+	if err != nil {
+		return []string{"managed.json"}
+	}
+	for _, name := range []string{"AGENTS.md", "CLAUDE.md"} {
+		path := filepath.Join(repoRoot, name)
+		info, err := os.Lstat(path)
+		if os.IsNotExist(err) {
+			continue
+		}
+		if err != nil || !info.Mode().IsRegular() {
+			continue
+		}
+		block, err := fsafe.ReadBlock(path, fsafe.HTMLMarkers)
+		if err != nil {
+			pending = append(pending, name)
+			continue
+		}
+		if block == nil {
+			continue
+		}
+		safe := engine.String(*block)
+		if safe == *block {
+			continue
+		}
+		changed = true
+		_, err = fsafe.SyncBlock(fsafe.BlockSync{Path: path, RelName: name, Markers: fsafe.HTMLMarkers, Inner: safe, Force: true, BackupDir: filepath.Join(stateRoot, "backups"), Manifest: manifest, Now: time.Now()})
+		if err != nil {
+			pending = append(pending, name)
+		}
+	}
+	if len(pending) == 0 && changed {
+		if err := manifest.Save(); err != nil {
+			pending = append(pending, "managed.json")
+		}
+	}
+	return pending
+}
diff --git a/internal/privacy/large.go b/internal/privacy/large.go
new file mode 100644
index 0000000..a1de7aa
--- /dev/null
+++ b/internal/privacy/large.go
@@ -0,0 +1,70 @@
+package privacy
+
+import (
+	"context"
+	"crypto/sha256"
+	"io"
+	"os"
+	"path/filepath"
+
+	"bint/internal/redact"
+)
+
+type contextReader struct {
+	ctx context.Context
+	io.Reader
+}
+
+func (r contextReader) Read(p []byte) (int, error) {
+	if err := r.ctx.Err(); err != nil {
+		return 0, err
+	}
+	return r.Reader.Read(p)
+}
+
+func scrubLarge(ctx context.Context, path string, info os.FileInfo, engine *redact.Engine) error {
+	in, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer in.Close()
+	tmp, err := os.CreateTemp(filepath.Dir(path), ".privacy-safe-*")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(tmp.Name())
+	defer tmp.Close()
+	before, after := sha256.New(), sha256.New()
+	writer := engine.Writer(io.MultiWriter(tmp, after))
+	_, err = io.Copy(writer, io.TeeReader(contextReader{ctx, in}, before))
+	if err != nil {
+		return err
+	}
+	if err = writer.Close(); err != nil {
+		return err
+	}
+	if string(before.Sum(nil)) == string(after.Sum(nil)) {
+		return nil
+	}
+	current, err := os.Stat(path)
+	if err != nil {
+		return err
+	}
+	if current.Size() != info.Size() || !current.ModTime().Equal(info.ModTime()) {
+		return os.ErrInvalid
+	}
+	if err = tmp.Chmod(info.Mode().Perm()); err != nil {
+		return err
+	}
+	if err = tmp.Sync(); err != nil {
+		return err
+	}
+	if err = tmp.Close(); err != nil {
+		return err
+	}
+	// Close the input before replacement, required on Windows.
+	if err = in.Close(); err != nil {
+		return err
+	}
+	return os.Rename(tmp.Name(), path)
+}
diff --git a/internal/privacy/scrub.go b/internal/privacy/scrub.go
new file mode 100644
index 0000000..19f27f7
--- /dev/null
+++ b/internal/privacy/scrub.go
@@ -0,0 +1,495 @@
+// Package privacy migrates Bint-owned diagnostic data. It never runs in hooks.
+package privacy
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"github.com/pelletier/go-toml/v2"
+	"gopkg.in/yaml.v3"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"bint/internal/fsafe"
+	"bint/internal/fslock"
+	"bint/internal/redact"
+	"bint/internal/store"
+	"bint/internal/task"
+)
+
+const policyVersion = 1
+
+type Options struct{ StateRoot, RepoRoot, ISOHome string }
+type Report struct {
+	Complete bool
+	Scanned  int
+	Pending  []string
+}
+type signature struct {
+	Size     int64 `json:"size"`
+	Modified int64 `json:"modified"`
+}
+
+func stamp(info os.FileInfo) signature { return signature{info.Size(), info.ModTime().UnixNano()} }
+func pathKey(path string) string {
+	digest := sha256.Sum256([]byte(path))
+	return hex.EncodeToString(digest[:])
+}
+
+type checkpoint struct {
+	Done     map[string]signature `json:"done,omitempty"`
+	Version  int                  `json:"version"`
+	Complete bool                 `json:"complete"`
+	Roots    []string             `json:"roots"`
+	Pending  []string             `json:"pending,omitempty"`
+}
+
+func tryLock(path string) (*os.File, error) {
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_RDWR, 0600)
+	if err != nil {
+		return nil, err
+	}
+	busy, err := fslock.Try(f, true)
+	if err != nil || busy {
+		f.Close()
+		if err == nil {
+			err = errors.New("busy")
+		}
+		return nil, err
+	}
+	return f, nil
+}
+
+func Scrub(ctx context.Context, o Options) (Report, error) {
+	var report Report
+	// Resolve aliases for containment only; repository identities are unchanged.
+	for _, path := range []*string{&o.StateRoot, &o.RepoRoot, &o.ISOHome} {
+		if *path != "" {
+			if real, e := filepath.EvalSymlinks(*path); e == nil {
+				*path = real
+			}
+		}
+	}
+	if err := ctx.Err(); err != nil {
+		return report, err
+	}
+	if _, err := os.Stat(o.StateRoot); errors.Is(err, os.ErrNotExist) {
+		report.Complete = true
+		return report, nil
+	} else if err != nil {
+		return report, err
+	}
+	lock, err := tryLock(filepath.Join(o.StateRoot, ".privacy.lock"))
+	if err != nil {
+		report.Pending = []string{"privacy sweep busy"}
+		return report, nil
+	}
+	defer lock.Close()
+	roots := []string{o.StateRoot}
+	if o.RepoRoot != "" {
+		roots = append(roots, filepath.Join(o.RepoRoot, ".bint", "tasks"), filepath.Join(o.RepoRoot, ".bint", "knowledge"))
+	}
+	if o.ISOHome != "" {
+		roots = append(roots, filepath.Join(o.ISOHome, "profiles"))
+	}
+	auth, values, err := credentials(o.ISOHome)
+	if err != nil {
+		return report, err
+	}
+	redact.SetCredentials(values)
+	engine := redact.Environment()
+	marker := filepath.Join(o.StateRoot, "privacy-v1.json")
+	var prev checkpoint
+	if data, err := os.ReadFile(marker); err == nil && json.Unmarshal(data, &prev) == nil && prev.Version == policyVersion && prev.Complete && strings.Join(prev.Roots, "\x00") == strings.Join(roots, "\x00") {
+		report.Complete = true
+		return report, nil
+	}
+	done := map[string]signature{}
+	if prev.Version == policyVersion && strings.Join(prev.Roots, "\x00") == strings.Join(roots, "\x00") && prev.Done != nil {
+		done = prev.Done
+	}
+	markerRoots := append([]string(nil), roots...)
+	report.Pending = append(report.Pending, scrubManagedBlocks(o.RepoRoot, o.StateRoot, engine)...)
+	for rootIndex := 0; rootIndex < len(roots); rootIndex++ {
+		root := roots[rootIndex]
+		confined, e := os.OpenRoot(root)
+		if errors.Is(e, os.ErrNotExist) {
+			continue
+		}
+		if e != nil {
+			report.Pending = append(report.Pending, redact.String(root))
+			continue
+		}
+		err := filepath.WalkDir(root, func(path string, d fs.DirEntry, walkErr error) error {
+			if errors.Is(walkErr, os.ErrNotExist) {
+				return nil
+			}
+			if err := ctx.Err(); err != nil {
+				return err
+			}
+			if walkErr != nil {
+				report.Pending = append(report.Pending, redact.String(path))
+				return nil
+			}
+			if d.Type()&os.ModeSymlink != 0 {
+				return nil
+			}
+			if d.IsDir() {
+				// A Git checkout is executable user input, not a diagnostic copy.
+				// Its managed .bint subtree is audited separately below.
+				if path != root {
+					if _, e := os.Lstat(filepath.Join(path, ".git")); e == nil {
+						roots = append(roots, filepath.Join(path, ".bint", "tasks"), filepath.Join(path, ".bint", "knowledge"))
+						report.Pending = append(report.Pending, scrubManagedBlocks(path, o.StateRoot, engine)...)
+						return filepath.SkipDir
+					}
+				}
+				if d.Name() == ".git" {
+					return filepath.SkipDir
+				}
+				return nil
+			}
+			if !d.Type().IsRegular() || path == marker || strings.HasSuffix(path, ".lock") || strings.HasSuffix(path, ".lk") || strings.HasSuffix(path, "-wal") || strings.HasSuffix(path, "-shm") || strings.HasSuffix(path, "-journal") {
+				return nil
+			}
+			// Coordinate with task writers, including the long-lived runner. Never
+			// replace a live task's log or artifacts underneath its owner.
+			var ticketLock *os.File
+			rel, _ := filepath.Rel(o.StateRoot, path)
+			parts := strings.Split(filepath.ToSlash(rel), "/")
+			if len(parts) >= 4 && parts[0] == "runtime" && parts[1] == "tasks" {
+				dir := filepath.Join(o.StateRoot, "runtime", "tasks", parts[2])
+				var st struct {
+					Runner *task.Runner `json:"runner"`
+				}
+				if b, e := os.ReadFile(filepath.Join(dir, "state.json")); e == nil && json.Unmarshal(b, &st) == nil && task.RunnerAlive(st.Runner) {
+					report.Pending = append(report.Pending, redact.String(path))
+					return nil
+				}
+				ticketLock, err = tryLock(filepath.Join(dir, ".ticket.lock"))
+				if err != nil {
+					report.Pending = append(report.Pending, redact.String(path))
+					return nil
+				}
+				defer ticketLock.Close()
+			}
+			// Profile sessions cooperate with the existing exclusive session lock.
+			if o.ISOHome != "" {
+				profileRel, e := filepath.Rel(filepath.Join(o.ISOHome, "profiles"), path)
+				if e == nil && profileRel != ".." && !strings.HasPrefix(profileRel, ".."+string(filepath.Separator)) {
+					id := strings.Split(profileRel, string(filepath.Separator))[0]
+					profileLock, e := tryLock(filepath.Join(o.ISOHome, "profiles", id, "session.lock"))
+					if e != nil {
+						report.Pending = append(report.Pending, redact.String(path))
+						return nil
+					}
+					defer profileLock.Close()
+				}
+			}
+			info, e := d.Info()
+			if e != nil {
+				report.Pending = append(report.Pending, redact.String(path))
+				return nil
+			}
+			key := pathKey(path)
+			if previous, ok := done[key]; ok && previous == stamp(info) {
+				return nil
+			}
+			delete(done, key)
+			succeeded := false
+			defer func() {
+				if succeeded {
+					if current, e := os.Stat(path); e == nil {
+						done[key] = stamp(current)
+					}
+				}
+			}()
+			report.Scanned++
+			if strings.HasSuffix(path, ".sqlite") || strings.HasSuffix(path, ".db") {
+				e := store.ScrubFile(ctx, path, engine)
+				succeeded = e == nil
+				if e != nil {
+					report.Pending = append(report.Pending, redact.String(path))
+				}
+				return nil
+			}
+			if info.Size() > 16<<20 {
+				if _, isAuth := auth[path]; isAuth {
+					report.Pending = append(report.Pending, redact.String(path)+" (oversized authentication document)")
+					return nil
+				}
+				if e := scrubLarge(ctx, path, info, engine); e != nil {
+					report.Pending = append(report.Pending, redact.String(path)+" (large file)")
+				} else {
+					succeeded = true
+				}
+				return nil
+			}
+			name, e := filepath.Rel(root, path)
+			if e != nil {
+				report.Pending = append(report.Pending, redact.String(path))
+				return nil
+			}
+			data, e := confined.ReadFile(name)
+			original := string(data)
+			if e != nil {
+				report.Pending = append(report.Pending, redact.String(path))
+				return nil
+			}
+			if bytes.HasPrefix(data, []byte("SQLite format 3\x00")) {
+				if e := store.ScrubFile(ctx, path, engine); e != nil {
+					report.Pending = append(report.Pending, redact.String(path))
+				} else {
+					succeeded = true
+				}
+				return nil
+			}
+			// Preserve proof identity before sanitizing old command diagnostics.
+			if filepath.Base(path) == "state.json" {
+				var state map[string]any
+				decoder := json.NewDecoder(bytes.NewReader(data))
+				decoder.UseNumber()
+				if decoder.Decode(&state) == nil {
+					for _, key := range []string{"verify_approval", "setup_approval"} {
+						if a, ok := state[key].(map[string]any); ok {
+							if cmd, ok := a["command"].(string); ok {
+								if hash, _ := a["sha256"].(string); hash == "" {
+									a["sha256"] = task.CommandSHA256(cmd)
+								}
+							}
+						}
+					}
+					if checks, ok := state["verifications"].([]any); ok {
+						for _, check := range checks {
+							if v, ok := check.(map[string]any); ok {
+								if cmd, ok := v["command"].(string); ok {
+									if hash, _ := v["command_sha256"].(string); hash == "" {
+										v["command_sha256"] = task.CommandSHA256(cmd)
+									}
+								}
+							}
+						}
+					}
+					if encoded, e := json.Marshal(state); e == nil {
+						data = encoded
+					}
+				}
+			}
+			safe := engine.String(string(data))
+			if filepath.Base(path) == "task.yml" {
+				var ticket map[string]any
+				if e := yaml.Unmarshal(data, &ticket); e != nil {
+					report.Pending = append(report.Pending, redact.String(path))
+					return nil
+				}
+				if verify, ok := ticket["verify"].(map[string]any); ok {
+					if command, ok := verify["command"].(string); ok {
+						protected, e := redact.ProtectCommand(command)
+						if e != nil {
+							report.Pending = append(report.Pending, redact.String(path)+" (command credential source required)")
+							return nil
+						}
+						if protected != command {
+							verify["command"] = protected
+							encoded, e := yaml.Marshal(ticket)
+							if e != nil {
+								report.Pending = append(report.Pending, redact.String(path))
+								return nil
+							}
+							safe = engine.String(string(encoded))
+						}
+					}
+				}
+			}
+			if fields, ok := auth[path]; ok {
+				safe, e = preserveAuth(path, data, fields, engine)
+				if e != nil {
+					report.Pending = append(report.Pending, redact.String(path))
+					return nil
+				}
+			}
+			if safe == original {
+				succeeded = true
+				return nil
+			}
+			current, e := confined.Stat(name)
+			if e != nil || !os.SameFile(current, info) || current.Size() != info.Size() || !current.ModTime().Equal(info.ModTime()) {
+				report.Pending = append(report.Pending, redact.String(path))
+				return nil
+			}
+			if e = atomicAt(confined, name, []byte(safe), info.Mode().Perm()); e != nil {
+				report.Pending = append(report.Pending, redact.String(path))
+			} else {
+				succeeded = true
+			}
+			return nil
+		})
+		confined.Close()
+		if err != nil {
+			return report, err
+		}
+	}
+	report.Complete = len(report.Pending) == 0
+	next := checkpoint{Done: done, Version: policyVersion, Complete: report.Complete, Roots: markerRoots, Pending: report.Pending}
+	data, err := json.Marshal(next)
+	if err != nil {
+		return report, err
+	}
+	if err = fsafe.WriteAtomic(marker, data, 0600); err != nil {
+		return report, err
+	}
+	return report, nil
+}
+
+// Auth exceptions are exact paths AND exact fields. A backup named auth.json
+// cannot opt itself into an exception, nor can arbitrary notes in a real auth file.
+func credentials(isoHome string) (map[string][]string, []string, error) {
+	auth := map[string][]string{}
+	var values []string
+	if isoHome == "" {
+		return auth, values, nil
+	}
+	profiles, err := os.ReadDir(filepath.Join(isoHome, "profiles"))
+	if errors.Is(err, os.ErrNotExist) {
+		return auth, values, nil
+	}
+	if err != nil {
+		return nil, nil, err
+	}
+	for _, profile := range profiles {
+		if !profile.IsDir() {
+			continue
+		}
+		for rel, fields := range map[string][]string{
+			"home/.codex/auth.json":          {"OPENAI_API_KEY", "tokens.access_token", "tokens.id_token", "tokens.refresh_token"},
+			"home/.claude/.credentials.json": {"claudeAiOauth.accessToken", "claudeAiOauth.refreshToken"},
+			"home/.codex/config.toml":        {},
+			"home/.claude/settings.json":     {},
+			"home/.claude/.claude.json":      {},
+		} {
+			path := filepath.Join(isoHome, "profiles", profile.Name(), filepath.FromSlash(rel))
+			info, e := os.Lstat(path)
+			if errors.Is(e, os.ErrNotExist) {
+				continue
+			}
+			if e != nil {
+				return nil, nil, e
+			}
+			if !info.Mode().IsRegular() {
+				continue
+			}
+			b, e := os.ReadFile(path)
+			if e != nil {
+				return nil, nil, e
+			}
+			var doc map[string]any
+			if e = decodeAuth(path, b, &doc); e != nil {
+				return nil, nil, fmt.Errorf("privacy: invalid authentication document")
+			}
+			if strings.HasSuffix(rel, "config.toml") || strings.HasSuffix(rel, "settings.json") || strings.HasSuffix(rel, ".claude.json") {
+				fields = functionalFields(doc, nil)
+			}
+			auth[path] = fields
+			for _, field := range fields {
+				if value, ok := lookup(doc, strings.Split(field, ".")); ok {
+					if s, ok := value.(string); ok {
+						values = append(values, s)
+					}
+				}
+			}
+		}
+	}
+	return auth, values, nil
+}
+func lookup(doc map[string]any, path []string) (any, bool) {
+	var value any = doc
+	for _, key := range path {
+		m, ok := value.(map[string]any)
+		if !ok {
+			return nil, false
+		}
+		value, ok = m[key]
+		if !ok {
+			return nil, false
+		}
+	}
+	return value, true
+}
+func preserveAuth(path string, data []byte, fields []string, engine *redact.Engine) (string, error) {
+	var raw, safe map[string]any
+	if err := decodeAuth(path, data, &raw); err != nil {
+		return "", err
+	}
+	if err := decodeAuth(path, []byte(engine.String(string(data))), &safe); err != nil {
+		return "", err
+	}
+	for _, field := range fields {
+		parts := strings.Split(field, ".")
+		value, ok := lookup(raw, parts)
+		if !ok {
+			continue
+		}
+		m := safe
+		for _, key := range parts[:len(parts)-1] {
+			next, ok := m[key].(map[string]any)
+			if !ok {
+				next = map[string]any{}
+				m[key] = next
+			}
+			m = next
+		}
+		m[parts[len(parts)-1]] = value
+	}
+	var b []byte
+	var err error
+	if strings.HasSuffix(path, ".toml") {
+		b, err = toml.Marshal(safe)
+	} else {
+		b, err = json.Marshal(safe)
+	}
+	return string(b), err
+}
+
+func decodeAuth(path string, data []byte, doc *map[string]any) error {
+	if strings.HasSuffix(path, ".toml") {
+		return toml.Unmarshal(data, doc)
+	}
+	return json.Unmarshal(data, doc)
+}
+func functionalFields(doc map[string]any, prefix []string) []string {
+	var fields []string
+	for key, value := range doc {
+		path := append(append([]string(nil), prefix...), key)
+		if child, ok := value.(map[string]any); ok {
+			fields = append(fields, functionalFields(child, path)...)
+			continue
+		}
+		// Only actual credential locations consumed by providers/MCP. An unrelated
+		// diagnostic.password field in the same document receives no exception.
+		functional := len(path) == 2 && path[0] == "env"
+		if len(path) >= 3 && (path[0] == "mcp_servers" || path[0] == "mcpServers" || path[0] == "model_providers") {
+			parent := path[len(path)-2]
+			functional = parent == "env" || parent == "http_headers" || key == "bearer_token"
+		}
+		if functional && redact.Sensitive(key) {
+			fields = append(fields, strings.Join(path, "."))
+		}
+	}
+	return fields
+}
+
+// RegisterCredentials reads only local credential metadata, never SQLite or
+// diagnostic history. Hooks may use it before writing trace/error copies.
+func RegisterCredentials(isoHome string) error {
+	_, values, err := credentials(isoHome)
+	if err == nil {
+		redact.SetCredentials(values)
+	}
+	return err
+}
diff --git a/internal/privacy/scrub_test.go b/internal/privacy/scrub_test.go
new file mode 100644
index 0000000..e44cb1a
--- /dev/null
+++ b/internal/privacy/scrub_test.go
@@ -0,0 +1,239 @@
+package privacy
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"bint/internal/fslock"
+)
+
+func TestScrubLockRetryAndOwnership(t *testing.T) {
+	root := t.TempDir()
+	outside := t.TempDir()
+	put := func(p, s string) {
+		t.Helper()
+		if err := os.MkdirAll(filepath.Dir(p), 0700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(p, []byte(s), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	secret := "password=history-canary-123456"
+	taskDir := filepath.Join(root, "runtime", "tasks", "task-a")
+	file := filepath.Join(taskDir, "review.md")
+	put(file, secret)
+	put(filepath.Join(outside, "keep.txt"), secret)
+	_ = os.Symlink(outside, filepath.Join(root, "outside-link"))
+	lock, err := os.OpenFile(filepath.Join(taskDir, ".ticket.lock"), os.O_CREATE|os.O_RDWR, 0600)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if busy, err := fslock.Try(lock, true); err != nil || busy {
+		t.Fatal("cannot lock fixture")
+	}
+	options := Options{StateRoot: root}
+	report, err := Scrub(context.Background(), options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if report.Complete || len(report.Pending) == 0 {
+		t.Fatal("locked task reported clean")
+	}
+	b, _ := os.ReadFile(file)
+	if string(b) != secret {
+		t.Fatal("modified locked task")
+	}
+	lock.Close()
+	report, err = Scrub(context.Background(), options)
+	if err != nil || !report.Complete {
+		t.Fatalf("retry incomplete: %+v %v", report, err)
+	}
+	b, _ = os.ReadFile(file)
+	if strings.Contains(string(b), "history-canary") {
+		t.Fatal("retry did not scrub")
+	}
+	b, _ = os.ReadFile(filepath.Join(outside, "keep.txt"))
+	if string(b) != secret {
+		t.Fatal("followed symlink outside ownership")
+	}
+	report, err = Scrub(context.Background(), options)
+	if err != nil || !report.Complete || report.Scanned != 0 {
+		t.Fatal("completed sweep rescanned the store")
+	}
+}
+
+func TestScrubCancellationDoesNotClaimComplete(t *testing.T) {
+	root := t.TempDir()
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if report, err := Scrub(ctx, Options{StateRoot: root}); err == nil || report.Complete {
+		t.Fatal("cancelled scrub claimed success")
+	}
+	if report, err := Scrub(context.Background(), Options{StateRoot: root}); err != nil || !report.Complete {
+		t.Fatalf("cannot resume: %+v %v", report, err)
+	}
+}
+
+func TestCredentialExceptionIsPerFieldAndPurpose(t *testing.T) {
+	root := t.TempDir()
+	isoHome := t.TempDir()
+	dir := filepath.Join(isoHome, "profiles", "codex--test", "home", ".codex")
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	const token = "config-auth-canary-123456"
+	auth := filepath.Join(dir, "auth.json")
+	if err := os.WriteFile(auth, []byte(`{"OPENAI_API_KEY":"`+token+`","note":"password=diagnostic-canary-123"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	config := filepath.Join(dir, "config.toml")
+	if err := os.WriteFile(config, []byte("[mcp_servers.demo.env]\nAPI_KEY='"+token+"'\n[diagnostic]\nnote='password=diagnostic-canary-123'\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	backup := filepath.Join(root, "backups", "auth.json")
+	if err := os.MkdirAll(filepath.Dir(backup), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(backup, []byte(`{"OPENAI_API_KEY":"`+token+`"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	report, err := Scrub(context.Background(), Options{StateRoot: root, ISOHome: isoHome})
+	if err != nil || !report.Complete {
+		t.Fatalf("scrub: %+v %v", report, err)
+	}
+	for _, file := range []string{auth, config} {
+		b, err := os.ReadFile(file)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !strings.Contains(string(b), token) {
+			t.Errorf("destroyed functional credential in %s", filepath.Base(file))
+		}
+		if strings.Contains(string(b), "diagnostic-canary") {
+			t.Errorf("exempted diagnostic field in %s", filepath.Base(file))
+		}
+	}
+	b, _ := os.ReadFile(backup)
+	if strings.Contains(string(b), token) {
+		t.Fatal("backup gained an auth exception")
+	}
+}
+
+type interruptedSweep struct {
+	context.Context
+	calls int
+}
+
+func (c *interruptedSweep) Err() error {
+	c.calls++
+	if c.calls >= 8 {
+		return context.Canceled
+	}
+	return nil
+}
+
+func TestScrubInterruptedAfterPartialProgress(t *testing.T) {
+	root := t.TempDir()
+	for i := 0; i < 12; i++ {
+		if err := os.WriteFile(filepath.Join(root, fmt.Sprintf("%02d.log", i)), []byte("password=resume-canary-123456\n"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	report, err := Scrub(&interruptedSweep{Context: context.Background()}, Options{StateRoot: root})
+	if err == nil || report.Complete {
+		t.Fatal("interrupted sweep reported complete")
+	}
+	clean, raw := 0, 0
+	entries, _ := os.ReadDir(root)
+	for _, entry := range entries {
+		if !strings.HasSuffix(entry.Name(), ".log") {
+			continue
+		}
+		b, _ := os.ReadFile(filepath.Join(root, entry.Name()))
+		if strings.Contains(string(b), "resume-canary") {
+			raw++
+		} else {
+			clean++
+		}
+	}
+	if clean == 0 || raw == 0 {
+		t.Fatalf("fixture did not interrupt partial progress: clean=%d raw=%d", clean, raw)
+	}
+	report, err = Scrub(context.Background(), Options{StateRoot: root})
+	if err != nil || !report.Complete {
+		t.Fatalf("resume: %+v %v", report, err)
+	}
+	entries, _ = os.ReadDir(root)
+	for _, entry := range entries {
+		b, _ := os.ReadFile(filepath.Join(root, entry.Name()))
+		if strings.Contains(string(b), "resume-canary") {
+			t.Errorf("residual secret in %s", entry.Name())
+		}
+	}
+}
+
+func TestPendingRetryDoesNotRescanCleanFiles(t *testing.T) {
+	root := t.TempDir()
+	dir := filepath.Join(root, "runtime", "tasks", "busy")
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "review.md"), []byte("password=busy-canary-123456"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	clean := filepath.Join(root, "old.log")
+	if err := os.WriteFile(clean, []byte("password=old-canary-123456"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	lock, err := os.OpenFile(filepath.Join(dir, ".ticket.lock"), os.O_CREATE|os.O_RDWR, 0600)
+	if err != nil {
