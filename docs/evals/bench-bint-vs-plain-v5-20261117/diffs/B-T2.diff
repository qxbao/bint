index 0000000..7d2985a
--- /dev/null
+++ b/internal/redact/command.go
@@ -0,0 +1,65 @@
+package redact
+
+import (
+	"errors"
+	"os"
+	"regexp"
+	"sort"
+	"strings"
+)
+
+var shellRef = regexp.MustCompile(`\$(?:[A-Za-z_][A-Za-z0-9_]*|\{[A-Za-z_][A-Za-z0-9_]*\})`)
+
+var commandRef = regexp.MustCompile(`\{\{bint-secret:([A-Za-z_][A-Za-z0-9_]*)\}\}`)
+
+// ProtectCommand keeps execution credentials in their existing environment
+// source, not in the retained task. Never execute a diagnostic marker.
+func ProtectCommand(command string) (string, error) {
+	type pair struct{ name, value string }
+	var pairs []pair
+	for _, entry := range os.Environ() {
+		k, v, ok := strings.Cut(entry, "=")
+		if ok && Sensitive(k) && len(v) >= 8 {
+			pairs = append(pairs, pair{k, v})
+		}
+	}
+	sort.Slice(pairs, func(i, j int) bool { return len(pairs[i].value) > len(pairs[j].value) })
+	protected := command
+	for _, p := range pairs {
+		protected = strings.ReplaceAll(protected, p.value, "{{bint-secret:"+p.name+"}}")
+	}
+	// Check for literal credentials not available from an existing functional
+	// source. The caller must leave old data pending rather than corrupt it.
+	probe := commandRef.ReplaceAllString(protected, Marker)
+	probe = shellRef.ReplaceAllString(probe, Marker)
+	probe = urlCredentials.ReplaceAllStringFunc(probe, func(value string) string {
+		if strings.HasSuffix(value, ":"+Marker+"@") {
+			return "://" + Marker + "@"
+		}
+		return value
+	})
+	if String(probe) != probe {
+		return "", errors.New("secret in executable command: use an existing credential environment variable")
+	}
+	return protected, nil
+}
+func RestoreCommand(command string) (string, error) {
+	missing := false
+	result := commandRef.ReplaceAllStringFunc(command, func(ref string) string {
+		name := commandRef.FindStringSubmatch(ref)[1]
+		value, ok := os.LookupEnv(name)
+		if !ok || value == "" {
+			missing = true
+			return ref
+		}
+		return value
+	})
+	if missing {
+		return "", errors.New("credential environment variable required by the stored command is unavailable")
+	}
+	return result, nil
+}
+
+func isCommandReference(value string) bool {
+	return commandRef.FindString(value) == value && value != ""
+}
diff --git a/internal/redact/io_bench_test.go b/internal/redact/io_bench_test.go
