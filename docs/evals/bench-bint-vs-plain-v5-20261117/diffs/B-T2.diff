+				}
+			}
+		}
+		if err := rows.Err(); err != nil {
+			t.Fatal(err)
+		}
+		rows.Close()
+	}
+	if err := reopened.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if b, _ := os.ReadFile(outside); string(b) != "password="+secret {
+		t.Fatal("modified a file outside Bint ownership")
+	}
+	if b, _ := os.ReadFile(filepath.Join(root, "app.txt")); string(b) != "v2\n" {
+		t.Fatal("agent execution was damaged")
+	}
+}
+
+// Only invoked in a separate test process; abrupt exit models a real crash,
+// including automatic release of OS locks without running Go defers.
+func runSecretGoalCrashWorker() bool {
+	marker := os.Getenv("BINT_SECRET_CRASH_MARKER")
+	if marker == "" {
+		return false
+	}
+	pool, err := state.PrivateInputsDir()
+	if err != nil {
+		os.Exit(72)
+	}
+	lease, err := privateinput.Create(context.Background(), pool, []byte("password=crashCanary123456"))
+	if err != nil {
+		os.Exit(73)
+	}
+	if err := os.WriteFile(marker, []byte(lease.Path), 0600); err != nil {
+		os.Exit(74)
+	}
+	os.Exit(71)
+	return true
+}
+
+// Observe live files as well as atomic staging names; this supplements the
+// final recursive audit rather than replacing it. Fixture historical secrets
+// have already been migrated before this watcher starts.
+func goalWatchDiagnosticWrites(t *testing.T, roots, canaries, authFiles []string) func() {
+	t.Helper()
+	stop, done := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	go func() {
+		defer close(done)
+		ticker := time.NewTicker(time.Millisecond)
+		defer ticker.Stop()
+		scan := func() {
+			for _, root := range roots {
+				_ = filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {
+					if err != nil {
+						return nil
+					}
+					if d.IsDir() {
+						if strings.HasSuffix(d.Name(), ".work") {
+							return filepath.SkipDir
+						}
+						return nil
+					}
+					if !d.Type().IsRegular() {
+						return nil
+					}
+					for _, auth := range authFiles {
+						if path == auth {
+							return nil
+						}
+					} // checked field-by-field by final audit
+					data, err := os.ReadFile(path)
+					if err != nil {
+						return nil
+					}
+					for _, value := range canaries {
+						if bytes.Contains(data, []byte(value)) {
+							t.Errorf("secret observed during diagnostic write at %s", path)
+							break
+						}
+					}
+					return nil
+				})
+			}
+		}
+		for {
+			select {
+			case <-ticker.C:
+				scan()
+			case <-stop:
+				scan()
+				return
+			}
+		}
+	}()
+	return func() { once.Do(func() { close(stop); <-done }) }
+}
