+		out, code := run(t, root, "", "task", "show", id, "--json")
+		if code != 0 {
+			t.Fatalf("show: %d", code)
+		}
+		put(paths.Generated, "task-export.json", out)
+		for _, value := range []string{secret, credential, api} {
+			if strings.Contains(out, value) {
+				t.Error("task show exposed a canary")
+			}
+		}
+	}
+	if _, err := os.Stat(orphan); !os.IsNotExist(err) {
+		t.Error("workspace reopen did not remove an orphan functional input")
+	}
+	if b, err := os.ReadFile(live.Path); err != nil || string(b) != "password="+secret {
+		t.Error("workspace cleanup damaged an active agent input")
+	}
