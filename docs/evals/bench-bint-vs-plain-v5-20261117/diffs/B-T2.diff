+		t.Fatalf("workflow: %d %s", code, out)
+	}
+	t.Run("functional_prompt_file", func(t *testing.T) {
+		agent := &eval.CommandAgent{Command: `test "$(cat "$BINT_EVAL_PROMPT_FILE")" = "$(cat)"`}
