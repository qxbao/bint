+	}
+	const credential = "goal-auth-Canary-123456789"
+	const secret = "goal-password-Canary-987654321"
+	const api = "sk-proj-<FIXTURE>"
+	t.Setenv("GOAL_API_TOKEN", credential)
+	profile := filepath.Join(os.Getenv("BINT_ISO_HOME"), "profiles", "codex--goal", "home", ".codex")
+	auth := put(profile, "auth.json", `{"OPENAI_API_KEY":"`+credential+`","note":"password=`+secret+`"}`)
+	claudeAuth := put(os.Getenv("BINT_ISO_HOME"), "profiles/claude--goal/home/.claude/.credentials.json", `{"claudeAiOauth":{"accessToken":"`+credential+`"},"note":"password=`+secret+`"}`)
+	claudeConfig := put(os.Getenv("BINT_ISO_HOME"), "profiles/claude--goal/home/.claude/.claude.json", `{"mcpServers":{"demo":{"env":{"API_TOKEN":"`+credential+`"}}},"note":"password=`+secret+`"}`)
+	codexConfig := put(profile, "config.toml", "[mcp_servers.demo.env]\nAPI_TOKEN='"+credential+"'\n[diagnostic]\nnote='password="+secret+"'\n")
+	t.Setenv("GOAL_CLAUDE_AUTH", claudeAuth)
+	t.Setenv("GOAL_CODEX_AUTH", auth)
+	t.Setenv("GOAL_CLAUDE_CONFIG", claudeConfig)
+	t.Setenv("GOAL_CODEX_CONFIG", codexConfig)
+	for _, rel := range []string{"runtime/old.log", "runtime/hook-trace/old.in", "generated/prompt.txt", "backups/old/auth.json", "tmp/abandoned.tmp", "eval-work/old/report.md"} {
+		put(paths.Root, rel, "ordinary-content password="+secret+"\nBearer "+credential+"\n"+api+"\n")
+	}
+	put(profile, "sessions/old.jsonl", `{"text":"Bearer `+credential+` password=`+secret+`"}`+"\n")
+	outside := put(t.TempDir(), "outside.txt", "password="+secret)
