diff --git a/internal/privacy/atomic.go b/internal/privacy/atomic.go
new file mode 100644
index 0000000..5bc4e4b
--- /dev/null
+++ b/internal/privacy/atomic.go
@@ -0,0 +1,33 @@
+package privacy
+
+import (
+	"os"
+	"path/filepath"
+
+	"bint/internal/ulid"
+)
+
+// atomicAt confines both staging and replacement to the ownership root, even
+// if a directory is concurrently replaced by a symlink.
+func atomicAt(root *os.Root, name string, data []byte, perm os.FileMode) error {
+	tmpName := filepath.Join(filepath.Dir(name), ".privacy-safe-"+ulid.New())
+	f, err := root.OpenFile(tmpName, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return err
+	}
+	defer root.Remove(tmpName)
+	defer f.Close()
+	if _, err = f.Write(data); err != nil {
+		return err
+	}
+	if err = f.Sync(); err != nil {
+		return err
+	}
+	if err = f.Chmod(perm); err != nil {
+		return err
+	}
+	if err = f.Close(); err != nil {
+		return err
+	}
+	return root.Rename(tmpName, name)
+}
