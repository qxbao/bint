@@ -0,0 +1,87 @@
+package task
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestSecretCommandPersistencePreservesExecutionAndApproval(t *testing.T) {
+	const secret = "command-auth-canary-123456"
+	t.Setenv("TASK_API_TOKEN", secret)
+	s := NewStore(t.TempDir())
+	original := "curl --token '" + secret + "' https://example.test"
+	tk, err := s.Create(Ticket{Goal: "task", Verify: Verify{Command: original}, Autonomy: AutonomyAuto}, State{}, time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := os.ReadFile(filepath.Join(tk.Dir, TicketFile))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(b), secret) {
+		t.Fatal("literal secret persisted in command")
+	}
+	loaded, err := s.Load(tk.Ticket.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if loaded.Ticket.Verify.Command != original {
+		t.Fatal("stored command no longer executes the original input")
+	}
+	if CommandSHA256(loaded.Ticket.Verify.Command) != CommandSHA256(original) {
+		t.Fatal("unchanged secret changed command identity")
+	}
+	t.Setenv("TASK_API_TOKEN", "changed-token-canary-123")
+	loaded, err = s.Load(tk.Ticket.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if CommandSHA256(loaded.Ticket.Verify.Command) == CommandSHA256(original) {
+		t.Fatal("changed credential reused the old command identity")
+	}
+}
+
+func TestSecretCommandApprovalSurvivesStorage(t *testing.T) {
+	const secret = "approval-auth-canary-123456"
+	t.Setenv("TASK_API_TOKEN", secret)
+	command := "curl --token '" + secret + "' https://example.test"
+	s := NewStore(t.TempDir())
+	tk, err := s.Create(Ticket{Goal: "task", Verify: Verify{Command: command}, Autonomy: AutonomyAuto}, State{VerifyApproval: &Approval{Command: command}, Verifications: []Verification{{Command: command, Passed: true, Confirmed: true}}}, time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	loaded, err := s.Load(tk.Ticket.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if loaded.State.VerifyApproval.SHA256 != CommandSHA256(command) {
+		t.Fatal("approval identity was lost")
+	}
+	if !loaded.State.Verifications[0].MatchesCommand(command) {
+		t.Fatal("verification identity was lost")
+	}
+	t.Setenv("TASK_API_TOKEN", "new-auth-canary-123456")
+	loaded, err = s.Load(tk.Ticket.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if loaded.State.Verifications[0].MatchesCommand(loaded.Ticket.Verify.Command) {
+		t.Fatal("new credential reused the old verification")
+	}
+}
+
+func TestMissingCredentialStillAllowsViewingTask(t *testing.T) {
+	t.Setenv("TASK_API_TOKEN", "temporary-canary-123456")
+	s := NewStore(t.TempDir())
+	tk, err := s.Create(Ticket{Goal: "task", Verify: Verify{Command: "echo --token temporary-canary-123456"}, Autonomy: AutonomyAuto}, State{}, time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("TASK_API_TOKEN", "")
+	if _, err := s.Load(tk.Ticket.ID); err != nil {
+		t.Fatal("missing runtime credentials must not prevent reading a task")
+	}
+}
