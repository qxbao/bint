@@ -0,0 +1,62 @@
+package store
+
+import (
+	"context"
+	"os"
+	"strings"
+	"testing"
+
+	"bint/internal/redact"
+)
+
+func TestScrubDiagnosticsRemovesFTSAndWALBytes(t *testing.T) {
+	ctx := context.Background()
+	path := t.TempDir() + "/legacy.sqlite"
+	s, err := Open(ctx, path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	const value = "sqlite-legacy-canary-123456"
+	for _, statement := range []string{"CREATE TABLE old_notes(body TEXT)", "CREATE VIRTUAL TABLE old_search USING fts5(body)"} {
+		if _, err := s.DB.ExecContext(ctx, statement); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, table := range []string{"old_notes", "old_search"} {
+		if _, err := s.DB.ExecContext(ctx, "INSERT INTO "+table+" VALUES (?)", "password="+value); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := ScrubFile(ctx, path, redact.New()); err != nil {
+		t.Fatal(err)
+	}
+	for _, file := range []string{path, path + "-wal", path + "-journal"} {
+		b, err := os.ReadFile(file)
+		if os.IsNotExist(err) {
+			continue
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		if strings.Contains(string(b), value) {
+			t.Errorf("legacy bytes remain in %s", file)
+		}
+	}
+	s, err = Open(ctx, path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	for _, table := range []string{"old_notes", "old_search"} {
+		var body string
+		if err := s.DB.QueryRowContext(ctx, "SELECT body FROM "+table).Scan(&body); err != nil {
+			t.Fatal(err)
+		}
+		if strings.Contains(body, value) || !strings.Contains(body, redact.Marker) {
+			t.Fatal("logical record not scrubbed")
+		}
+	}
+}
