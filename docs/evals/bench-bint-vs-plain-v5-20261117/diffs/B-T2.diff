+		writeDoc(t, root, id, name, "ordinary-content password="+secret+"\n"+api)
+	}
+	review, _ := json.Marshal(map[string]any{"summary": "password=" + secret, "findings": []map[string]any{{"kind": "risk", "severity": "low", "title": "token=" + credential, "evidence": "api_key=" + api}}})
+	if out, code := run(t, root, string(review), "task", "review", id, "-"); code != 0 {
+		t.Fatalf("review: %d %s", code, out)
+	}
+	if out, code := run(t, root, "", "knowledge", "add", "--type", "warning", "--paths", "app.txt", "--evidence", "app.txt:1", "password="+secret); code != 0 {
+		t.Fatalf("knowledge: %d %s", code, out)
+	}
+	t.Setenv("BINT_HOOK_TRACE", "1")
+	hook, _ := json.Marshal(map[string]any{"cwd": root, "session_id": "privacy-goal", "hook_event_name": "PostToolUse", "tool_name": "Bash", "tool_input": map[string]any{"command": "echo --token " + credential}, "tool_response": map[string]any{"stdout": "password=" + secret}})
+	if _, code := run(t, root, string(hook), "hook", "claude"); code != 0 {
+		t.Fatal("hook must not block")
