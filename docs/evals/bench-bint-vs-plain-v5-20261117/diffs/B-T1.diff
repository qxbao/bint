@@ -0,0 +1,54 @@
+package cli
+
+import (
+	"fmt"
+
+	"github.com/spf13/cobra"
+
+	"bint/internal/app"
+)
+
+func newCleanCmd(stdio IO) *cobra.Command {
+	o := app.CleanOptions{OlderThanDays: 90}
+	c := &cobra.Command{Use: "clean", Short: "Xem trước hoặc dọn cache và thư mục kiểm chứng cũ", Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			if o.OlderThanDays <= 0 {
+				return usageError{fmt.Errorf("older-than-days must be positive")}
+			}
+			if err := app.ValidateCleanOptions(o); err != nil {
+				return usageError{err}
+			}
+			dir, err := cwd()
+			if err != nil {
+				return err
+			}
+			ws, err := app.OpenWorkspace(cmd.Context(), dir, true)
+			if err != nil {
+				return err
+			}
+			rep, err := app.Clean(cmd.Context(), ws, o)
+			if !o.Apply {
+				fmt.Fprintln(stdio.Out, "Preview only; no data deleted.")
+			}
+			for _, item := range rep.Items {
+				fmt.Fprintf(stdio.Out, "%s\t%d bytes\t%s\t%s\n", item.Group, item.Bytes, item.Path, item.Reason)
+				if item.Error != "" {
+					fmt.Fprintf(stdio.Out, "  error: %s\n", item.Error)
+				}
+			}
+			var kept int64
+			for _, item := range rep.Items {
+				if o.Apply {
+					kept += item.Bytes - item.RemovedBytes
+				} else if !item.Eligible {
+					kept += item.Bytes
+				}
+			}
+			fmt.Fprintf(stdio.Out, "Eligible: %d bytes; removed: %d bytes; kept: %d bytes (logical file sizes; hardlinks may retain disk blocks).\n", rep.EligibleBytes, rep.RemovedBytes, kept)
+			fmt.Fprintln(stdio.Out, "History, backups, worktrees and iso profiles are retained; external iso profiles are not measured.")
+			return err
+		}}
+	c.Flags().BoolVar(&o.Apply, "apply", false, "Xóa dữ liệu đủ điều kiện (mặc định chỉ xem trước)")
+	c.Flags().IntVar(&o.OlderThanDays, "older-than-days", 90, "Giữ dữ liệu ít nhất số ngày này")
+	return c
+}
