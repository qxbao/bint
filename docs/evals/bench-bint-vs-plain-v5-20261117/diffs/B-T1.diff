+package cleanup
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"bint/internal/fslock"
+)
+
+var errContainsLock = errors.New("contains lock file")
+
+// Lock age and PID are not evidence of ownership. Keep the containing tree,
+// including unlocked lock files, to avoid splitting a live lock's inode.
+func lockName(name string) bool {
+	name = strings.ToLower(name)
+	return name == "lock" || name == ".lock" || name == "lockfile" || strings.HasSuffix(name, ".lock") || strings.HasSuffix(name, ".lk") || strings.HasSuffix(name, ".lck") || strings.HasSuffix(name, ".lockfile")
+}
+
+type Options struct {
+	Apply         bool
+	OlderThanDays int
+	Now           time.Time
+	// BaseSafe must verify source availability and absence of live references.
+	BaseSafe func(context.Context, string) (bool, error)
+}
+type Item struct {
+	Path         string
+	Group        string
+	Bytes        int64
+	Eligible     bool
+	Removed      bool
+	RemovedBytes int64
+	Reason       string
+	Error        string
+}
+type Report struct {
+	Items         []Item
+	EligibleBytes int64
+	RemovedBytes  int64
+}
+
+// Run always inventories and reselects from current state; it never accepts an
+// old preview as deletion authority. The lifecycle gate covers selection/delete.
+func Run(ctx context.Context, root string, o Options) (Report, error) {
+	var rep Report
+	if o.OlderThanDays == 0 {
+		o.OlderThanDays = 90
+	}
+	if o.OlderThanDays < 1 || o.OlderThanDays > 365000 {
+		return rep, errors.New("cleanup: retention must be between 1 and 365000 days")
+	}
+	if o.Now.IsZero() {
+		o.Now = time.Now()
+	}
+	r, err := os.OpenRoot(root)
+	if err != nil {
+		return rep, err
+	}
+	defer r.Close()
+	cutoff := o.Now.AddDate(0, 0, -o.OlderThanDays)
+	var errs []error
+	var visit func(string, string) error
+	visit = func(rel, group string) error {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		fi, err := r.Lstat(rel)
+		if err != nil {
+			return err
+		}
+		if fi.Mode()&os.ModeSymlink != 0 {
+			rep.Items = append(rep.Items, Item{Path: rel, Group: group, Reason: "kept: symlink"})
+			return nil
+		}
+		logical := filepath.ToSlash(rel)
+		if logical == "eval-work" || logical == "eval-work/bases" || logical == "tmp" {
+			if !fi.IsDir() {
+				rep.Items = append(rep.Items, Item{Path: rel, Group: group, Reason: "kept: not a directory"})
+				return nil
+			}
+			f, err := r.Open(rel)
+			if err != nil {
+				return err
+			}
+			es, err := f.ReadDir(-1)
+			f.Close()
+			if err != nil {
+				return err
+			}
+			for _, e := range es {
+				child := filepath.Join(rel, e.Name())
+				g := group
+				if rel == "eval-work" {
+					g = "eval-work/" + e.Name()
+				}
+				if err := visit(child, g); err != nil {
+					rep.Items = append(rep.Items, Item{Path: child, Group: g, Reason: "kept: inventory incomplete", Error: err.Error()})
+					errs = append(errs, err)
+				}
+			}
+			return nil
+		}
+		item := Item{Path: rel, Group: group, Reason: "kept: history, recovery or unmanaged data"}
+		base := filepath.Dir(rel) == filepath.Join("eval-work", "bases")
+		temp := filepath.Dir(rel) == "tmp" && strings.HasPrefix(filepath.Base(rel), "verify-")
+		var gateErr error
+		if base || temp {
+			var release func()
+			release, gateErr = Guard(root, true)
+			if gateErr == nil {
+				defer release()
+			}
+		}
+		n, newest, scanErr := measure(ctx, r, rel, base || temp)
+		item.Bytes = n
+		if errors.Is(scanErr, errContainsLock) {
+			item.Reason = "kept: " + scanErr.Error()
+		} else if scanErr != nil {
+			item.Error = scanErr.Error()
+			errs = append(errs, fmt.Errorf("%s: %w", rel, scanErr))
+		}
+		if (base || temp) && scanErr == nil && fi.IsDir() {
+			at := fi.ModTime()
+			if base && newest.After(at) {
+				at = newest
+			}
+			safe := false
+			if base && strings.HasSuffix(rel, ".git") && o.BaseSafe != nil {
+				safe, err = o.BaseSafe(ctx, filepath.Base(rel))
+				if err != nil {
+					item.Error = err.Error()
+					errs = append(errs, err)
+				}
+				item.Reason = "kept: source or references not proven safe"
+			}
+			if temp {
+				b, e := r.ReadFile(filepath.Join(rel, TempMarker))
+				var m TempState
+				safe = e == nil && json.Unmarshal(b, &m) == nil && m.Version == 1 && m.Completed && !m.At.IsZero() && !m.At.After(o.Now)
+				at = m.At
+				item.Reason = "kept: missing or incomplete lifecycle marker"
+				// New payload after completion invalidates an old completion timestamp.
+				// Marker mtime itself reflects when it was written, not the simulated clock.
+				if safe && newest.After(at) {
+					safe = false
+					item.Reason = "kept: contents changed after completion"
+				}
+			}
+			if safe {
+				item.Reason = "kept: within retention"
+				if at.Before(cutoff) {
+					item.Reason = "eligible: expired disposable data"
+					if gateErr != nil {
+						item.Reason = "kept: lifecycle gate unavailable"
+						if !errors.Is(gateErr, ErrBusy) {
+							item.Error = gateErr.Error()
+							errs = append(errs, gateErr)
+						}
+					} else {
+						item.Eligible = true
+						rep.EligibleBytes += n
+						if o.Apply {
+							// Reject replacement after inventory; rooted recursion pins
+							// directories and refuses symlinks and lock files.
+							current, e := r.Lstat(rel)
+							if e == nil && !os.SameFile(fi, current) {
+								e = errors.New("identity changed during cleanup")
+							}
+							var removed int64
+							if e == nil {
+								removed, e = removeTree(ctx, r, rel)
+							}
+							rep.RemovedBytes += removed
+							item.RemovedBytes = removed
+							if e != nil {
+								item.Error = e.Error()
+								item.Reason = "partial: removal failed"
+								errs = append(errs, e)
+							} else {
+								item.Removed = true
+								item.Reason = "removed"
+							}
+						}
+					}
+				}
+			}
+		}
+		rep.Items = append(rep.Items, item)
+		return nil
+	}
+	es, err := os.ReadDir(root)
+	if err != nil {
+		return rep, err
+	}
+	for _, e := range es {
+		if err := visit(e.Name(), e.Name()); err != nil {
+			rep.Items = append(rep.Items, Item{Path: e.Name(), Group: e.Name(), Reason: "kept: inventory incomplete", Error: err.Error()})
+			errs = append(errs, err)
+		}
+	}
+	return rep, errors.Join(errs...)
+}
+
+// measure does not follow symlinks or count their targets, and checks cancellation.
+func measure(ctx context.Context, r *os.Root, rel string, strict bool) (int64, time.Time, error) {
+	var bytes int64
+	var newest time.Time
+	var protected string
+	err := fs.WalkDir(r.FS(), filepath.ToSlash(rel), func(p string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if d.Type()&os.ModeSymlink != 0 {
+			if strict {
+				return fmt.Errorf("symlink in %s", p)
+			}
+			return nil
+		}
+		if strict && lockName(d.Name()) && protected == "" {
+			protected = p
+		}
+		if strict && !d.IsDir() && !d.Type().IsRegular() {
+			return fmt.Errorf("special file in %s", p)
+		}
+		fi, e := d.Info()
+		if e != nil {
+			return e
+		}
+		if d.Type().IsRegular() {
+			bytes += fi.Size()
+			if strict && !lockName(d.Name()) {
+				f, e := lockDisposableFile(r, filepath.FromSlash(p))
+				if errors.Is(e, errContainsLock) {
+					protected = p
+				} else if e != nil {
+					return e
+				} else {
+					f.Close()
+				}
+			}
+		}
+		if d.Name() != TempMarker && fi.ModTime().After(newest) {
+			newest = fi.ModTime()
+		}
+		return nil
+	})
+	if err == nil && protected != "" {
+		err = fmt.Errorf("%w: %s", errContainsLock, protected)
+	}
+	return bytes, newest, err
+}
+
+// removeTree pins each directory before descending and never follows a link.
+// Count only successful file unlinks, including when a later operation fails.
+func removeTree(ctx context.Context, r *os.Root, name string) (int64, error) {
+	if err := ctx.Err(); err != nil {
+		return 0, err
+	}
+	fi, err := r.Lstat(name)
+	if err != nil {
+		return 0, err
+	}
+	if fi.Mode()&os.ModeSymlink != 0 {
+		return 0, fmt.Errorf("refuse symlink: %s", name)
+	}
+	if lockName(filepath.Base(name)) {
+		return 0, fmt.Errorf("%w: %s", errContainsLock, name)
+	}
+	if fi.Mode().IsRegular() {
+		// Recheck kernel ownership immediately before unlinking, holding our
+		// handle until the operation ends. Filename checks alone miss locks on
+		// ordinary data files.
+		f, err := lockDisposableFile(r, name)
+		if err != nil {
+			return 0, err
+		}
+		defer f.Close()
+		if err := r.Remove(name); err != nil {
+			return 0, err
+		}
+		return fi.Size(), nil
+	}
+	if !fi.IsDir() {
+		return 0, fmt.Errorf("refuse special file: %s", name)
+	}
+	sub, err := r.OpenRoot(name)
+	if err != nil {
+		return 0, err
+	}
+	current, err := sub.Lstat(".")
+	if err != nil || !os.SameFile(fi, current) {
+		sub.Close()
+		return 0, fmt.Errorf("directory replaced: %s", name)
+	}
+	f, err := sub.Open(".")
+	if err != nil {
+		sub.Close()
+		return 0, err
+	}
+	entries, err := f.ReadDir(-1)
+	f.Close()
+	if err != nil {
+		sub.Close()
+		return 0, err
+	}
+	var removed int64
+	for _, de := range entries {
+		n, e := removeTree(ctx, sub, de.Name())
+		removed += n
+		if e != nil {
+			sub.Close()
+			return removed, e
+		}
+	}
+	sub.Close()
+	// Do not remove a replacement directory/link introduced during recursion.
+	current, err = r.Lstat(name)
+	if err != nil {
+		return removed, err
+	}
+	if !os.SameFile(fi, current) {
+		return removed, fmt.Errorf("directory replaced: %s", name)
+	}
+	return removed, r.Remove(name)
+}
+
+// lockDisposableFile probes real OS ownership without changing file contents.
+// Permission or identity uncertainty keeps the file; callers close the handle.
+func lockDisposableFile(r *os.Root, name string) (*os.File, error) {
+	before, err := r.Lstat(name)
+	if err != nil {
+		return nil, err
+	}
+	if !before.Mode().IsRegular() {
+		return nil, fmt.Errorf("file changed: %s", name)
+	}
+	f, err := r.Open(name)
+	if err != nil {
+		return nil, err
+	}
+	actual, err := f.Stat()
+	if err != nil || !os.SameFile(before, actual) {
+		f.Close()
+		return nil, fmt.Errorf("file replaced: %s", name)
+	}
+	busy, err := fslock.Try(f, true)
+	if busy || err != nil {
+		f.Close()
+		if busy {
+			return nil, fmt.Errorf("%w: %s", errContainsLock, name)
+		}
+		return nil, err
+	}
+	return f, nil
+}
