+package cli_test
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"bint/internal/app"
+	"bint/internal/cleanup"
+	"bint/internal/testutil"
+)
+
+func TestCleanPreviewApplyAndInvalidAge(t *testing.T) {
+	testutil.Isolate(t)
+	repo := testutil.NewRepo(t, map[string]string{"a": "keep"})
+	if out, code := run(t, repo, "", "init", "--no-hooks", "--no-skills"); code != 0 {
+		t.Fatalf("init: %s", out)
+	}
+	ws, err := app.OpenWorkspace(context.Background(), repo, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	dir := filepath.Join(ws.Paths.Root, "tmp", "verify-expired")
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	p := filepath.Join(dir, "payload")
+	if err := os.WriteFile(p, []byte("disposable"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	old := time.Now().Add(-120 * 24 * time.Hour)
+	if err := os.Chtimes(p, old, old); err != nil {
+		t.Fatal(err)
+	}
+	if err := cleanup.MarkTemp(dir, old, true); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chtimes(dir, old, old); err != nil {
+		t.Fatal(err)
+	}
+	out, code := run(t, repo, "", "clean")
+	if code != 0 || !strings.Contains(out, "Preview only") || !strings.Contains(out, "eligible:") {
+		t.Fatalf("preview %d: %s", code, out)
+	}
+	if _, err := os.Stat(p); err != nil {
+		t.Fatal("default deleted data")
+	}
+	for _, age := range []string{"0", "-1", "999999999", "invalid"} {
+		if out, code := run(t, repo, "", "clean", "--older-than-days", age); code == 0 {
+			t.Fatalf("accepted %s: %s", age, out)
+		}
+	}
+	out, code = run(t, repo, "", "clean", "--apply")
+	if code != 0 || !strings.Contains(out, "removed") {
+		t.Fatalf("apply %d: %s", code, out)
+	}
+	if _, err := os.Stat(dir); !os.IsNotExist(err) {
+		t.Fatal("apply did not remove expired data")
+	}
+}
