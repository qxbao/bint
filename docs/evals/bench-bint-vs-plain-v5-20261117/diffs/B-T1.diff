+++ b/docs/workflows.md
@@ -1431,3 +1431,44 @@ xoá khi dừng), `gateway.log`, `tools-cache/` (M3).
   harness + session thì không ghi (đếm trong `dropped_events`). Daemon không mở SQLite.
 
 Chưa kiểm với service thật trên máy và Job Object trên Windows thật (CI chỉ biên dịch và vet cho Windows).
+
+
+## Thu hồi dung lượng dữ liệu cũ
+
+`bint clean` xem trước theo repository hiện tại: từng đường dẫn, nhóm dữ liệu,
+byte và lý do giữ hoặc được dọn. Mặc định giữ ít nhất 90 ngày; đổi cho lần chạy bằng
+`bint clean --older-than-days 180`. Sau khi xem danh sách, chạy
+`bint clean --apply` (kèm cùng cờ tuổi nếu đã đổi) để dọn. Lệnh kiểm tra lại trạng thái
+thực tế, không áp dụng mù danh sách xem trước. Không tự dọn nền hay quét trong hook.
+
+Chỉ cache base eval tái tạo được và tmp kiểm chứng có marker hoàn tất hợp lệ mới
+được dọn. Mục đang dùng, bị khóa, còn tham chiếu, thiếu nguồn, không đọc được hoặc
+có symlink được giữ. Ứng viên chứa tệp khóa (`.lock`, `.lk`, `.lck`, `LOCK`)
+được giữ nguyên cả cây, kể cả khi khóa đã nhả; khóa hệ điều hành đang giữ trên
+tệp tên khác cũng được kiểm tra, không suy luận quyền xóa từ tuổi tệp hay PID.
+Tmp legacy không có marker và phiên bị ngắt chưa ghi hoàn tất
+được giữ để tránh mất dữ liệu chưa rõ chủ. Khóa liên tiến trình bảo vệ lúc clone
+base và suốt lúc dùng tmp; khóa bận khiến clean bỏ qua mục, không chờ tiến trình đó.
+Clone eval hiện dùng hardlink, không dùng Git alternates: sau clone, workspace
+không còn cần giữ khóa cache nguồn. Tiến trình Bint cũ chưa tham gia giao thức khóa
+không được bảo vệ bởi khóa mới; hãy kết thúc chúng trước khi dùng apply. Các run
+running/lease không xác định được vẫn khiến cache được giữ.
+
+Repository được giữ lại có thể còn phụ thuộc cache dù run đã kết thúc, ví dụ clone
+bằng Git alternates. Khi thấy `objects/info/alternates`, gitfile (`.git` là tệp), `commondir`,
+symlink hoặc metadata không kiểm tra được trong toàn bộ cây trạng thái (kể cả tmp legacy và thư mục chưa được nhận diện), clean giữ cache base thay vì
+đoán dependency. Chính sách này có thể giữ cả base không liên quan; tmp độc lập
+đủ điều kiện vẫn được dọn. Kiểm tra được chạy lại khi apply, không chỉ khi preview.
+
+Lịch sử SQLite, phiếu/log tác vụ, spool, worktree (kể cả sửa chưa commit),
+generated và backup được giữ và báo dung lượng. Profile iso có GC riêng và không bị
+clean thay đổi; profile nằm ngoài state không được quét hoặc tính dung lượng.
+Nếu dữ liệu giữ lại chiếm đa số, lệnh này chỉ thu hồi phần cache/tmp đủ điều kiện,
+không bảo đảm trần dung lượng cho toàn bộ state. Không xóa thủ công các tệp WAL/SHM.
+
+Báo cáo byte là tổng kích thước tệp logic đã gỡ, không phải số block vật lý:
+hardlink/sparse file có thể khiến dung lượng đĩa giải phóng khác con số báo cáo.
+Lỗi từng mục được in cùng đường dẫn và kết quả một phần; các mục độc lập vẫn được
+xử lý, mã thoát khác 0 nếu có lỗi. Xóa tmp không thể hoàn tác; cache được nạp lại
+khi dùng. Xem trước không nạp spool hay áp migration; đọc SQLite có thể cập nhật
+byte khóa tạm trong SHM nhưng không sửa dữ liệu lịch sử.
diff --git a/internal/app/cleanup.go b/internal/app/cleanup.go
new file mode 100644
index 0000000..203f0d0
--- /dev/null
+++ b/internal/app/cleanup.go
@@ -0,0 +1,186 @@
+package app
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/url"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"time"
+
+	"bint/internal/cleanup"
+	"bint/internal/gitrepo"
+	"bint/internal/state"
+)
+
+type CleanOptions struct {
+	Apply         bool
+	OlderThanDays int
+	Now           time.Time
+}
+
+var cleanBaseName = regexp.MustCompile(`^([0-9a-f]{40}|[0-9a-f]{64})\.git$`)
+
+// Clean never opens Workspace.OpenStore: preview must neither migrate nor ingest.
+func Clean(ctx context.Context, w *Workspace, o CleanOptions) (cleanup.Report, error) {
+	var empty cleanup.Report
+	info, err := w.Paths.ReadRepoInfo()
+	if err != nil {
+		return empty, err
+	}
+	if state.NormalizePath(info.CommonDir) != state.NormalizePath(w.Repo.CommonDir) {
+		return empty, state.ErrForeignState
+	}
+	return cleanup.Run(ctx, w.Paths.Root, cleanup.Options{Apply: o.Apply, OlderThanDays: o.OlderThanDays, Now: o.Now,
+		BaseSafe: func(ctx context.Context, name string) (bool, error) {
+			if !cleanBaseName.MatchString(name) {
+				return false, nil
+			}
+			sha := strings.TrimSuffix(name, ".git")
+			safe, err := cleanReferences(ctx, w, sha)
+			if err != nil || !safe {
+				return false, err
+			}
+			// Both the original repository and cached ref must still contain this base.
+			for _, q := range []struct{ dir, ref string }{{w.Repo.Toplevel, sha + "^{commit}"}, {filepath.Join(w.Paths.EvalWork, "bases", name), "refs/heads/eval-base^{commit}"}} {
+				cmd := gitrepo.CommandContext(ctx, "-c", "core.fsmonitor=false", "-C", q.dir, "rev-parse", "--verify", q.ref)
+				out, err := cmd.Output()
+				if err != nil {
+					return false, nil
+				}
+				if strings.TrimSpace(string(out)) != sha {
+					return false, nil
+				}
+			}
+			cmd := gitrepo.CommandContext(ctx, "-c", "core.fsmonitor=false", "-C", filepath.Join(w.Paths.EvalWork, "bases", name), "for-each-ref", "--format=%(refname) %(objectname)")
+			out, err := cmd.Output()
+			if err != nil {
+				return false, nil
+			}
+			if strings.TrimSpace(string(out)) != "refs/heads/eval-base "+sha {
+				return false, nil
+			}
+			return true, nil
+		}})
+}
+
+func cleanReferences(ctx context.Context, w *Workspace, sha string) (bool, error) {
+	r, err := os.OpenRoot(w.Paths.Root)
+	if err != nil {
+		return false, err
+	}
+	defer r.Close()
+	// Read raw state only: task.Store.List may synchronize projections on read.
+	f, err := r.Open(filepath.Join("runtime", "tasks"))
+	if err == nil {
+		entries, e := f.ReadDir(-1)
+		f.Close()
+		if e != nil {
+			return false, e
+		}
+		for _, entry := range entries {
+			if entry.Type()&os.ModeSymlink != 0 {
+				return false, nil
+			}
+			if !entry.IsDir() {
+				continue
+			}
+			b, e := r.ReadFile(filepath.Join("runtime", "tasks", entry.Name(), "state.json"))
+			if e != nil {
+				return false, nil
+			}
+			var st struct {
+				Status string `json:"status"`
+				Base   string `json:"base"`
+			}
+			if json.Unmarshal(b, &st) != nil || st.Status == "" {
+				return false, nil
+			}
+			// Open tasks can depend on a base even without a currently held runner lock.
+			if st.Status != "done" && st.Status != "cancelled" && st.Status != "canceled" && (st.Base == sha || st.Base == "") {
+				return false, nil
+			}
+		}
+	} else if !os.IsNotExist(err) {
+		return false, err
+	}
+	// Unknown leases are retained conservatively, regardless of reported PID.
+	for _, name := range []string{"runtime/leases", "runtime/locks"} {
+		f, e := r.Open(filepath.FromSlash(name))
+		if e == nil {
+			es, e := f.ReadDir(-1)
+			f.Close()
+			if e != nil {
+				return false, e
+			}
+			for _, de := range es {
+				if de.Type()&os.ModeSymlink != 0 {
+					return false, nil
+				}
+				if strings.HasSuffix(de.Name(), ".json") {
+					return false, nil
+				}
+				if de.IsDir() {
+					sub, e := r.Open(filepath.Join(filepath.FromSlash(name), de.Name()))
+					if e != nil {
+						return false, e
+					}
+					children, e := sub.ReadDir(1)
+					sub.Close()
+					if e != nil && !errors.Is(e, io.EOF) {
+						return false, e
+					}
+					if len(children) > 0 {
+						return false, nil
+					}
+				}
+			}
+		} else if !os.IsNotExist(e) {
+			return false, e
+		}
+	}
+	if fi, err := r.Lstat("state.sqlite"); err == nil && !fi.Mode().IsRegular() {
+		return false, nil
+	}
+	if _, err := r.Stat("state.sqlite"); err != nil {
+		if os.IsNotExist(err) {
+			return false, nil
+		}
+		return false, err
+	}
+	dbPath := filepath.ToSlash(w.Paths.DB)
+	if !strings.HasPrefix(dbPath, "/") {
+		dbPath = "/" + dbPath
+	}
+	u := url.URL{Scheme: "file", Path: dbPath}
+	db, err := sql.Open("sqlite", u.String()+"?mode=ro")
+	if err != nil {
+		return false, err
+	}
+	defer db.Close()
+	var n int
+	if err := db.QueryRowContext(ctx, `SELECT count(*) FROM eval_batches WHERE status = 'running'`).Scan(&n); err != nil {
+		return false, fmt.Errorf("read evaluation references: %w", err)
+	}
+	if n != 0 {
+		return false, nil
+	}
+	if err := ctx.Err(); err != nil {
+		return false, err
+	}
+	return cleanRetainedRepositories(ctx, r)
+}
+
+// ValidateCleanOptions is shared by CLI and callers; zero selects the default.
+func ValidateCleanOptions(o CleanOptions) error {
+	if o.OlderThanDays < 0 || o.OlderThanDays > 365000 {
+		return errors.New("retention must be between 1 and 365000 days")
+	}
+	return nil
+}
diff --git a/internal/app/cleanup_alternates.go b/internal/app/cleanup_alternates.go
new file mode 100644
index 0000000..1cec615
--- /dev/null
+++ b/internal/app/cleanup_alternates.go
@@ -0,0 +1,58 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"strings"
+)
+
+var errRetainedGitDependency = errors.New("retained Git dependency cannot be ruled out")
+
+// cleanRetainedRepositories runs under cleanup's lifecycle gate for each base,
+// rather than caching the preview result. A completed run's shared clone can
+// still need its source object store, even with no running task or eval batch.
+//
+// Conservatively retain all bases when alternates or indirect Git metadata is
+// present. This avoids guessing about relative/quoted paths, transitive object
+// stores, gitfiles and shared common directories. No external paths are followed.
+func cleanRetainedRepositories(ctx context.Context, r *os.Root) (bool, error) {
+	// Every retained directory can contain a repository, including legacy tmp
+	// and directories not recognized by the cleanup allowlist. Scan the whole
+	// rooted inventory rather than maintaining another incomplete root list.
+	err := fs.WalkDir(r.FS(), ".", func(p string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		// A link can hide a repository or an alternate file. Keep caches instead
+		// of walking it, including links that happen to stay within the state dir.
+		if d.Type()&os.ModeSymlink != 0 {
+			return errRetainedGitDependency
+		}
+		if strings.EqualFold(d.Name(), ".git") && !d.IsDir() {
+			return errRetainedGitDependency
+		}
+		if strings.EqualFold(d.Name(), "commondir") {
+			return errRetainedGitDependency
+		}
+		if strings.HasSuffix(strings.ToLower(p), "/objects/info/alternates") {
+			return errRetainedGitDependency
+		}
+		if !d.IsDir() && !d.Type().IsRegular() {
+			return errRetainedGitDependency
+		}
+		return nil
+	})
+	if errors.Is(err, errRetainedGitDependency) {
+		return false, nil
+	}
+	if err != nil {
+		return false, fmt.Errorf("inspect retained state: %w", err)
+	}
+	return true, nil
+}
