+// Indirect or opaque Git metadata must fail closed without following external
+// paths or trying to interpret quoted/relative alternate object-store syntax.
+func TestCleanupOpaqueGitMetadata(t *testing.T) {
+	for _, rel := range []string{"eval-work/runs/retained/.git", "eval-work/verify/retained.git/objects/info/alternates", "worktrees/retained.git/commondir"} {
+		t.Run(rel, func(t *testing.T) {
+			f := newCleanupGoalFixture(t)
+			before, err := Clean(f.ctx, f.ws, CleanOptions{Now: f.now})
+			if err != nil || !goalItemEligible(before, f.base) {
+				t.Fatalf("before metadata: %+v %v", before, err)
+			}
+			file := filepath.Join(f.ws.Paths.Root, filepath.FromSlash(rel))
+			if err := os.MkdirAll(filepath.Dir(file), 0700); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(file, []byte("external metadata not safe to resolve"), 0600); err != nil {
+				t.Fatal(err)
+			}
+			rep, err := Clean(f.ctx, f.ws, CleanOptions{Now: f.now, Apply: true})
+			if err != nil || goalItemRemoved(rep, f.base) || goalItemEligible(rep, f.base) {
+				t.Fatalf("opaque dependency selected: %+v %v", rep, err)
+			}
+			if _, err := os.Stat(filepath.Join(f.ws.Paths.Root, f.base)); err != nil {
+				t.Fatal(err)
+			}
+			if !goalItemRemoved(rep, f.tmp) {
+				t.Fatalf("independent temp retained: %+v", rep)
+			}
+		})
+	}
+}
