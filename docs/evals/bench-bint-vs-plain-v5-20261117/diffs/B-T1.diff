+package cleanup
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"bint/internal/fslock"
+)
+
+func oldTemp(t *testing.T, root, name string, now time.Time) string {
+	t.Helper()
+	d := filepath.Join(root, "tmp", name)
+	if err := os.MkdirAll(d, 0700); err != nil {
+		t.Fatal(err)
+	}
+	old := now.Add(-120 * 24 * time.Hour)
+	p := filepath.Join(d, "payload")
+	if err := os.WriteFile(p, []byte("disposable"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chtimes(p, old, old); err != nil {
+		t.Fatal(err)
+	}
+	if err := MarkTemp(d, old, true); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chtimes(d, old, old); err != nil {
+		t.Fatal(err)
+	}
+	return d
+}
+
+func TestCleanupLockProcess(t *testing.T) {
+	if os.Getenv("BINT_TEST_CLEAN_LOCK") == "" {
+		return
+	}
+	release, err := Guard(os.Getenv("BINT_TEST_CLEAN_LOCK"), false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer release()
+	fmt.Println("locked")
+	_, _ = bufio.NewReader(os.Stdin).ReadString('\n')
+}
+
+func TestCleanupSubprocessAndRecheck(t *testing.T) {
+	root := t.TempDir()
+	now := time.Now().UTC()
+	dir := oldTemp(t, root, "verify-expired", now)
+	o := Options{Now: now, Apply: true}
+	preview, err := Run(context.Background(), root, Options{Now: now})
+	if err != nil || preview.EligibleBytes == 0 {
+		t.Fatalf("preview: %+v %v", preview, err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestCleanupLockProcess$")
+	cmd.Env = append(os.Environ(), "BINT_TEST_CLEAN_LOCK="+root)
+	in, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	out, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() { in.Close(); _ = cmd.Wait() }()
+	scanner := bufio.NewScanner(out)
+	if !scanner.Scan() || scanner.Text() != "locked" {
+		t.Fatal("child did not acquire lock")
+	}
+	rep, err := Run(context.Background(), root, o)
+	if err != nil || rep.RemovedBytes != 0 {
+		t.Fatalf("busy: %+v %v", rep, err)
+	}
+	if _, err := os.Stat(dir); err != nil {
+		t.Fatal("busy directory removed")
+	}
+	// The OS releases ownership when the process exits. The inode stays.
+	in.Close()
+	if err := cmd.Wait(); err != nil {
+		t.Fatal(err)
+	}
+	lockPath := filepath.Join(root, "runtime", "cleanup-locks", "lifecycle.lock")
+	if _, err := os.Stat(lockPath); err != nil {
+		t.Fatal(err)
+	}
+	if err := MarkTemp(dir, now, true); err != nil {
+		t.Fatal(err)
+	}
+	rep, err = Run(context.Background(), root, o)
+	if err != nil || rep.RemovedBytes != 0 {
+		t.Fatalf("new completion after preview: %+v %v", rep, err)
+	}
+	if _, err := os.Stat(dir); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestCleanupSymlinkAndPartial(t *testing.T) {
+	root := t.TempDir()
+	now := time.Now()
+	good := oldTemp(t, root, "verify-good", now)
+	bad := oldTemp(t, root, "verify-bad", now)
+	outside := t.TempDir()
+	sentinel := filepath.Join(outside, "sentinel")
+	if err := os.WriteFile(sentinel, []byte("keep"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(bad, "link")); err != nil {
+		t.Skipf("symlinks unavailable: %v", err)
+	}
+	rep, err := Run(context.Background(), root, Options{Now: now, Apply: true})
+	if err == nil || rep.RemovedBytes == 0 {
+		t.Fatalf("partial: %+v %v", rep, err)
+	}
+	if _, err := os.Stat(good); !os.IsNotExist(err) {
+		t.Fatal("independent eligible item not removed")
+	}
+	if b, err := os.ReadFile(sentinel); err != nil || string(b) != "keep" {
+		t.Fatal("external data modified")
+	}
+	if _, err := os.Stat(bad); err != nil {
+		t.Fatal("unsafe tree removed")
+	}
+	found := false
+	for _, i := range rep.Items {
+		if strings.Contains(i.Path, "verify-bad") && i.Error != "" {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatal("missing item error")
+	}
+}
+
+func TestCleanupReplacementAndCancellation(t *testing.T) {
+	root := t.TempDir()
+	now := time.Now()
+	dir := oldTemp(t, root, "verify-replace", now)
+	if _, err := Run(context.Background(), root, Options{Now: now}); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "new-user-data"), []byte("keep"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	rep, err := Run(context.Background(), root, Options{Now: now, Apply: true})
+	if err != nil || rep.RemovedBytes != 0 {
+		t.Fatalf("changed data: %+v %v", rep, err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err = Run(ctx, root, Options{Now: now, Apply: true})
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancel: %v", err)
+	}
+}
+
+func TestCleanupSymlinkReplacementAfterPreview(t *testing.T) {
+	root := t.TempDir()
+	now := time.Now()
+	dir := oldTemp(t, root, "verify-replaced", now)
+	if _, err := Run(context.Background(), root, Options{Now: now}); err != nil {
+		t.Fatal(err)
+	}
+	// Rename, rather than delete, the old candidate to preserve its contents.
+	moved := dir + "-saved"
+	if err := os.Rename(dir, moved); err != nil {
+		t.Fatal(err)
+	}
+	outside := t.TempDir()
+	p := filepath.Join(outside, "keep")
+	if err := os.WriteFile(p, []byte("keep"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, dir); err != nil {
+		t.Skipf("symlink unavailable: %v", err)
+	}
+	rep, err := Run(context.Background(), root, Options{Now: now, Apply: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// The saved directory is still a managed expired candidate and may be removed;
+	// the replacement link and its target must survive.
+	if _, err := os.Lstat(dir); err != nil {
+		t.Fatal(err)
+	}
+	if b, err := os.ReadFile(p); err != nil || string(b) != "keep" {
+		t.Fatalf("target changed: %+v %v", rep, err)
+	}
+}
+
+func TestCleanupLargeRetentionDoesNotOverflow(t *testing.T) {
+	root := t.TempDir()
+	now := time.Now()
+	dir := oldTemp(t, root, "verify-old", now)
+	rep, err := Run(context.Background(), root, Options{Now: now, Apply: true, OlderThanDays: 365000})
+	if err != nil || rep.RemovedBytes != 0 {
+		t.Fatalf("large retention: %+v %v", rep, err)
+	}
+	if _, err := os.Stat(dir); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// A held flock does not refresh timestamps: expiry cannot authorize unlinking it.
+func TestCleanupRetainsHeldLock(t *testing.T) {
+	for _, name := range []string{"writer.lock", "lease.lk", "LOCK", "nested/writer.lck", "writer.data", "reader.data"} {
+		t.Run(name, func(t *testing.T) {
+			root := t.TempDir()
+			now := time.Now()
+			old := now.Add(-120 * 24 * time.Hour)
+			dir := oldTemp(t, root, "verify-held-lock", now)
+			lock := filepath.Join(dir, filepath.FromSlash(name))
+			if err := os.MkdirAll(filepath.Dir(lock), 0700); err != nil {
+				t.Fatal(err)
+			}
+			f, err := os.OpenFile(lock, os.O_CREATE|os.O_RDWR, 0600)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer f.Close()
+			if busy, err := fslock.Try(f, name != "reader.data"); err != nil || busy {
+				t.Fatalf("lock: busy=%v err=%v", busy, err)
+			}
+			fi, err := f.Stat()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := filepath.WalkDir(dir, func(p string, d os.DirEntry, e error) error {
+				if e != nil {
+					return e
+				}
+				return os.Chtimes(p, old, old)
+			}); err != nil {
+				t.Fatal(err)
+			}
+			for _, apply := range []bool{true, false} {
+				rep, err := Run(context.Background(), root, Options{Now: now, Apply: apply})
+				if err != nil {
+					t.Fatal(err)
+				}
+				after, e := os.Stat(lock)
+				if e != nil || !os.SameFile(fi, after) {
+					t.Fatalf("held lock was unlinked: apply=%v removed=%d err=%v", apply, rep.RemovedBytes, e)
+				}
+				if _, e := os.Stat(filepath.Join(dir, "payload")); e != nil {
+					t.Fatal("lock's containing candidate was partially removed")
+				}
+				if rep.RemovedBytes != 0 || rep.EligibleBytes != 0 {
+					t.Fatalf("locked candidate eligible: %+v", rep)
+				}
+				found := false
+				for _, item := range rep.Items {
+					if item.Path == filepath.Join("tmp", "verify-held-lock") && strings.Contains(item.Reason, "lock") {
+						found = true
+					}
+				}
+				if !found {
+					t.Fatalf("missing lock retention reason: %+v", rep)
+				}
+			}
+		})
+	}
+}
+
+func TestCleanupRetainsUnlockedLockFile(t *testing.T) {
+	root := t.TempDir()
+	now := time.Now()
+	old := now.Add(-120 * 24 * time.Hour)
+	dir := oldTemp(t, root, "verify-unlocked-lock", now)
+	p := filepath.Join(dir, "writer.lock")
+	if err := os.WriteFile(p, []byte("owner metadata"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chtimes(p, old, old); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chtimes(dir, old, old); err != nil {
+		t.Fatal(err)
+	}
+	rep, err := Run(context.Background(), root, Options{Now: now, Apply: true})
+	if err != nil || rep.EligibleBytes != 0 || rep.RemovedBytes != 0 {
+		t.Fatalf("unlocked lock: %+v %v", rep, err)
+	}
+	if b, err := os.ReadFile(p); err != nil || string(b) != "owner metadata" {
+		t.Fatalf("lock file lost: %v", err)
+	}
+}
diff --git a/internal/cleanup/lock.go b/internal/cleanup/lock.go
new file mode 100644
index 0000000..5b975d5
--- /dev/null
+++ b/internal/cleanup/lock.go
@@ -0,0 +1,95 @@
+// Package cleanup implements conservative, opt-in reclamation of disposable Bint data.
+package cleanup
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"time"
+
+	"bint/internal/fslock"
+)
+
+var ErrBusy = errors.New("cleanup: data is in use")
+
+// Guard holds the repository-wide lifecycle gate. Writers use shared handles,
+// reclamation uses an exclusive handle. Never unlink the lock file on release.
+func Guard(root string, exclusive bool) (func(), error) {
+	r, err := os.OpenRoot(root)
+	if err != nil {
+		return nil, err
+	}
+	defer r.Close()
+	dir := filepath.Join("runtime", "cleanup-locks")
+	// Refuse symlink components, including links that stay within the state tree.
+	for _, d := range []string{"runtime", dir} {
+		if fi, e := r.Lstat(d); e == nil {
+			if !fi.IsDir() || fi.Mode()&os.ModeSymlink != 0 {
+				return nil, errors.New("cleanup: unsafe lock directory")
+			}
+		} else if !os.IsNotExist(e) {
+			return nil, e
+		}
+		if e := r.MkdirAll(d, 0700); e != nil {
+			return nil, e
+		}
+	}
+	name := filepath.Join(dir, "lifecycle.lock")
+	if fi, e := r.Lstat(name); e == nil && !fi.Mode().IsRegular() {
+		return nil, errors.New("cleanup: unsafe lock file")
+	}
+	f, err := r.OpenFile(name, os.O_CREATE|os.O_RDWR, 0600)
+	if err != nil {
+		return nil, err
+	}
+	busy, err := fslock.Try(f, exclusive)
+	if err != nil || busy {
+		f.Close()
+		if busy {
+			return nil, ErrBusy
+		}
+		return nil, err
+	}
+	return func() { _ = f.Close() }, nil
+}
+
+const TempMarker = ".bint-cleanup.json"
+
+type TempState struct {
+	Version   int       `json:"version"`
+	Completed bool      `json:"completed"`
+	At        time.Time `json:"at"`
+}
+
+// MarkTemp records a managed verification directory. Call with a shared Guard
+// held throughout its lifetime. Incomplete/crashed directories are retained.
+func MarkTemp(dir string, at time.Time, completed bool) error {
+	b, err := json.Marshal(TempState{1, completed, at.UTC()})
+	if err != nil {
+		return err
+	}
+	r, err := os.OpenRoot(dir)
+	if err != nil {
+		return err
+	}
+	defer r.Close()
+	return r.WriteFile(TempMarker, b, 0600)
+}
+
+// Use waits only while a concurrent cleanup holds the lifecycle gate. A writer
+// never proceeds unprotected, and cancellation remains effective.
+func Use(ctx context.Context, root string) (func(), error) {
+	for {
+		release, err := Guard(root, false)
+		if !errors.Is(err, ErrBusy) {
+			return release, err
+		}
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-time.After(10 * time.Millisecond):
+		}
+	}
+}
