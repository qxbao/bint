+package app
+
+import (
+	"bufio"
+	"context"
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"runtime"
+	"strings"
+	"testing"
+	"time"
+
+	"bint/internal/cleanup"
+	"bint/internal/config"
+	"bint/internal/eval"
+	"bint/internal/state"
+	"bint/internal/store"
+	"bint/internal/task"
+	"bint/internal/testutil"
+	"bint/internal/workflow"
+)
+
+func TestAutoCleanupStateGoal(t *testing.T) {
+	testutil.Isolate(t)
+	ctx := context.Background()
+	repo := testutil.NewRepo(t, map[string]string{"a": "source"})
+	paths := state.At("test", t.TempDir())
+	ws := &Workspace{Paths: paths}
+	// Use the same repository discovery/identity checks as production.
+	real, err := OpenWorkspace(ctx, repo, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ws.Repo = real.Repo
+	if err := paths.Ensure(ws.Repo); err != nil {
+		t.Fatal(err)
+	}
+	db, err := store.Open(ctx, paths.DB)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	if _, err := db.DB.Exec(`CREATE TABLE cleanup_sentinel (value TEXT); INSERT INTO cleanup_sentinel VALUES ('keep')`); err != nil {
+		t.Fatal(err)
+	}
+	now := time.Date(2026, 11, 17, 12, 0, 0, 0, time.UTC)
+	old := now.Add(-120 * 24 * time.Hour)
+	sha := strings.TrimSpace(testutil.Git(t, repo, "rev-parse", "HEAD"))
+	base := filepath.Join(paths.EvalWork, "bases", sha+".git")
+	testutil.Git(t, repo, "clone", "--bare", "--no-hardlinks", repo, base)
+	testutil.Git(t, base, "update-ref", "refs/heads/eval-base", sha)
+	testutil.Git(t, base, "update-ref", "-d", "refs/heads/main")
+	testutil.Git(t, base, "update-ref", "-d", "refs/heads/master")
+	if err := filepath.WalkDir(base, func(p string, d os.DirEntry, e error) error {
+		if e != nil {
+			return e
+		}
+		return os.Chtimes(p, old, old)
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chtimes(base, old, old); err != nil {
+		t.Fatal(err)
+	}
+	// Independent commits exercise source availability, retention and open-task references.
+	activeSHA := ""
+	for _, kind := range []string{"new", "boundary", "active", "missing"} {
+		testutil.Git(t, repo, "commit", "--allow-empty", "-m", kind)
+		hash := testutil.Git(t, repo, "rev-parse", "HEAD")
+		if kind == "active" {
+			activeSHA = hash
+		}
+		name := hash
+		if kind == "missing" {
+			name = strings.Repeat("0", 40)
+		}
+		d := filepath.Join(paths.EvalWork, "bases", name+".git")
+		testutil.Git(t, repo, "clone", "--bare", "--no-hardlinks", repo, d)
+		testutil.Git(t, d, "update-ref", "refs/heads/eval-base", hash)
+		// Remove clone's main branch: these caches have a single eval-base ref.
+		testutil.Git(t, d, "update-ref", "-d", "refs/heads/main")
+		testutil.Git(t, d, "update-ref", "-d", "refs/heads/master")
+		at := old
+		if kind == "new" {
+			at = now.Add(-10 * 24 * time.Hour)
+		}
+		if kind == "boundary" {
+			at = now.Add(-90 * 24 * time.Hour)
+		}
+		if err := filepath.WalkDir(d, func(p string, entry os.DirEntry, e error) error {
+			if e != nil {
+				return e
+			}
+			return os.Chtimes(p, at, at)
+		}); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Chtimes(d, at, at); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write := func(rel string) string {
+		t.Helper()
+		p := filepath.Join(paths.Root, filepath.FromSlash(rel))
+		if err := os.MkdirAll(filepath.Dir(p), 0700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(p, []byte("keep-or-clean-"+rel), 0600); err != nil {
+			t.Fatal(err)
+		}
+		return p
+	}
+	tmp := filepath.Join(paths.Root, "tmp", "verify-old")
+	oldPayload := write("tmp/verify-old/payload")
+	if err := os.Chtimes(oldPayload, old, old); err != nil {
+		t.Fatal(err)
+	}
+	if err := cleanup.MarkTemp(tmp, old, true); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chtimes(tmp, old, old); err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range []string{"new", "boundary", "running", "legacy"} {
+		d := filepath.Join(paths.Root, "tmp", "verify-"+name)
+		write("tmp/verify-" + name + "/payload")
+		at := old
+		if name == "new" {
+			at = now.Add(-10 * 24 * time.Hour)
+		}
+		if name == "boundary" {
+			at = now.Add(-90 * 24 * time.Hour)
+		}
+		if err := os.Chtimes(filepath.Join(d, "payload"), at, at); err != nil {
+			t.Fatal(err)
+		}
+		if name != "legacy" {
+			if err := cleanup.MarkTemp(d, at, name != "running"); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if err := os.Chtimes(d, at, at); err != nil {
+			t.Fatal(err)
+		}
+	}
+	tasks := task.NewStore(paths.Runtime)
+	command := "git rev-parse --verify HEAD"
+	open, err := tasks.Create(task.Ticket{Goal: "Continue unfinished user work", Verify: task.Verify{Command: command}}, task.State{Status: task.StatusInProgress, Base: activeSHA, Worktree: repo}, now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	relOpen := filepath.ToSlash(filepath.Join("runtime", "tasks", open.State.ID))
+	for _, rel := range []string{relOpen + "/logs/agent.log", relOpen + "/requirement.md", "runtime/context/seen", "runtime/subagents/a.json", "runtime/leases/live", "spool/pending.jsonl", "spool/rejected/bad.jsonl", "spool/denials/run/deny.jsonl", "eval-work/runs/unfinished/edit", "eval-work/logs/evidence", "eval-work/verify/evidence", "worktrees/open/uncommitted", "generated/config", "backups/config", "managed.json"} {
+		write(rel)
+	}
+	if _, err := tasks.Load(open.State.ID); err != nil {
+		t.Fatalf("task fixture not readable: %v", err)
+	}
+
+	outside := t.TempDir()
+	sentinel := filepath.Join(outside, "sentinel")
+	if err := os.WriteFile(sentinel, []byte("outside-and-profile"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(paths.Root, "tmp", "verify-link")); err != nil {
+		t.Logf("symlink unavailable: %v", err)
+	}
+	// SQLite readers update SHM lock bytes; compare logical rows/integrity below.
+	snapshot := func() map[string][32]byte {
+		t.Helper()
+		m := map[string][32]byte{}
+		err := filepath.WalkDir(paths.Root, func(p string, d os.DirEntry, e error) error {
+			if e != nil {
+				return e
+			}
+			r, _ := filepath.Rel(paths.Root, p)
+			if strings.HasPrefix(filepath.ToSlash(r), "runtime/cleanup-locks/") {
+				return nil
+			}
+			if r == "state.sqlite" || r == "state.sqlite-wal" || r == "state.sqlite-shm" {
+				return nil
+			}
+			if d.Type().IsRegular() {
+				b, e := os.ReadFile(p)
+				if e != nil {
+					return e
+				}
+				m[r] = sha256.Sum256(b)
+			}
+			return nil
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return m
+	}
+	logicalSize := func() int64 {
+		t.Helper()
+		var n int64
+		err := filepath.WalkDir(paths.Root, func(p string, d os.DirEntry, e error) error {
+			if e != nil {
+				return e
+			}
+			rel, _ := filepath.Rel(paths.Root, p)
+			if strings.HasPrefix(filepath.ToSlash(rel), "runtime/cleanup-locks/") || strings.HasPrefix(rel, "state.sqlite") {
+				return nil
+			}
+			if d.Type().IsRegular() {
+				fi, e := d.Info()
+				if e != nil {
+					return e
+				}
+				n += fi.Size()
+			}
+			return nil
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return n
+	}
+	beforeBytes := logicalSize()
+	before := snapshot()
+	opts := CleanOptions{Now: now, OlderThanDays: 90}
+	preview, err := Clean(ctx, ws, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if after := snapshot(); !reflect.DeepEqual(before, after) {
+		for p, h := range before {
+			if after[p] != h {
+				t.Logf("changed: %s", p)
+			}
+		}
+		for p := range after {
+			if _, ok := before[p]; !ok {
+				t.Logf("added: %s", p)
+			}
+		}
+		t.Fatal("preview mutated state")
+	}
+	if preview.EligibleBytes <= 0 {
+		t.Fatalf("nothing reclaimable: %+v", preview)
+	}
+	// The external symlink in this all-surfaces fixture makes dependency
+	// inspection uncertain: retain base caches, while still reclaiming tmp.
+	if goalItemEligible(preview, filepath.Join("eval-work", "bases", sha+".git")) {
+		t.Fatal("base eligible despite opaque symlink")
+	}
+	opts.Apply = true
+	report, err := Clean(ctx, ws, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if report.RemovedBytes != preview.EligibleBytes {
+		t.Fatalf("removed=%d eligible=%d", report.RemovedBytes, preview.EligibleBytes)
+	}
+	for _, p := range []string{tmp} {
+		if _, err := os.Lstat(p); !os.IsNotExist(err) {
+			t.Fatalf("eligible remains %s: %v", p, err)
+		}
+	}
+	after := snapshot()
+	if delta := beforeBytes - logicalSize(); delta != report.RemovedBytes {
+		t.Fatalf("measured reclaimed bytes=%d reported=%d", delta, report.RemovedBytes)
+	}
+	for rel, hash := range before {
+		if strings.HasPrefix(filepath.ToSlash(rel), "tmp/verify-old/") {
+			continue
+		}
+		if after[rel] != hash {
+			t.Errorf("preserved data changed: %s", rel)
+		}
+	}
+	var value, integrity string
+	if err := db.DB.QueryRow(`SELECT value FROM cleanup_sentinel`).Scan(&value); err != nil || value != "keep" {
+		t.Fatalf("database data: %q %v", value, err)
+	}
+	if err := db.DB.QueryRow(`PRAGMA integrity_check`).Scan(&integrity); err != nil || integrity != "ok" {
+		t.Fatalf("integrity: %s %v", integrity, err)
+	}
+	if b, err := os.ReadFile(sentinel); err != nil || string(b) != "outside-and-profile" {
+		t.Fatal("outside data changed")
+	}
+	again, err := Clean(ctx, ws, opts)
+	if err != nil || again.RemovedBytes != 0 {
+		t.Fatalf("repeat: %+v %v", again, err)
+	}
+	cfg := config.Default()
+	cfg.Eval.TestCommand = &command
+	env := workflow.Env{Root: repo, Cfg: cfg, Tasks: tasks}
+	continued, result, err := env.Verify(ctx, open.State.ID)
+	if err != nil || continued == nil || !result.Verification.Passed || !result.Verification.Confirmed {
+		t.Fatalf("cannot continue task after cleanup: %+v %v", result, err)
+	}
+	reloaded, err := tasks.Load(open.State.ID)
+	if err != nil || reloaded.State.LastVerification() == nil || !reloaded.State.LastVerification().Passed {
+		t.Fatalf("verification was not persisted: %v", err)
+	}
+	testCleanupGoalTransitions(t)
+
+}
+
+// Each transition runs through the app service, including its task/lease/SQLite
+// reference checks, rather than testing cleanup.Run with a synthetic predicate.
+func testCleanupGoalTransitions(t *testing.T) {
+	for _, where := range []string{"eval-work/runs/retained", "eval-work/verify/retained", "worktrees/retained", "tmp/verify-legacy/retained", "custom-retained/retained"} {
+		t.Run("retained alternate dependency/"+where, func(t *testing.T) {
+			f := newCleanupGoalFixture(t)
+			preview, err := Clean(f.ctx, f.ws, CleanOptions{Now: f.now})
+			if err != nil || !goalItemEligible(preview, f.base) {
+				t.Fatalf("before dependency: %+v %v", preview, err)
+			}
+			consumer := filepath.Join(f.ws.Paths.Root, filepath.FromSlash(where))
+			testutil.Git(t, f.repo, "clone", "--shared", "--branch", "eval-base", filepath.Join(f.ws.Paths.Root, f.base), consumer)
+			testutil.Git(t, consumer, "cat-file", "-e", "HEAD^{commit}")
+			// Creating the dependency after preview must invalidate its eligibility.
+			preview, err = Clean(f.ctx, f.ws, CleanOptions{Now: f.now})
+			if err != nil || goalItemEligible(preview, f.base) {
+				t.Fatalf("preview ignored dependency: %+v %v", preview, err)
+			}
+			rep, err := Clean(f.ctx, f.ws, CleanOptions{Now: f.now, Apply: true})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if goalItemRemoved(rep, f.base) || goalItemEligible(rep, f.base) {
+				t.Fatalf("dependent base selected: %+v", rep)
+			}
+			testutil.Git(t, consumer, "cat-file", "-e", "HEAD^{commit}")
+			testutil.Git(t, consumer, "status", "--porcelain")
+			if _, err := os.Stat(filepath.Join(f.ws.Paths.Root, f.base)); err != nil {
+				t.Fatal(err)
+			}
+			// Safety does not disable reclamation of the independent expired tmp.
+			if !goalItemRemoved(rep, f.tmp) {
+				t.Fatalf("unrelated temp not reclaimed: %+v", rep)
+			}
+		})
+	}
+
+	t.Run("writer starts after preview", func(t *testing.T) {
+		f := newCleanupGoalFixture(t)
+		preview, err := Clean(f.ctx, f.ws, CleanOptions{Now: f.now})
+		if err != nil || preview.EligibleBytes == 0 {
+			t.Fatalf("preview: %+v %v", preview, err)
+		}
+		stop := startCleanupGoalWriter(t, f.ws.Paths.Root)
+		rep, err := Clean(f.ctx, f.ws, CleanOptions{Now: f.now, Apply: true})
+		if err != nil || rep.RemovedBytes != 0 {
+			t.Fatalf("active writer: %+v %v", rep, err)
+		}
+		f.assertCandidates(t)
+		stop()
+		rep, err = Clean(f.ctx, f.ws, CleanOptions{Now: f.now, Apply: true})
+		if err != nil || rep.RemovedBytes != preview.EligibleBytes {
+			t.Fatalf("after writer released: %+v %v", rep, err)
+		}
+	})
+	t.Run("evaluation run starts after preview", func(t *testing.T) {
+		f := newCleanupGoalFixture(t)
+		if rep, err := Clean(f.ctx, f.ws, CleanOptions{Now: f.now}); err != nil || !goalItemEligible(rep, f.base) {
+			t.Fatalf("preview: %+v %v", rep, err)
+		}
+		// OnBatch pauses a real Run immediately after its SQLite running row exists.
+		// No cases or agent work are dispatched by this lifecycle test.
+		result, err := eval.Run(f.ctx, eval.Env{RepoDir: f.repo, WorkRoot: f.ws.Paths.EvalWork, Cfg: config.Default()}, f.db.DB, eval.RunOptions{Agent: &eval.CommandAgent{Command: "unused"}, Repeats: 1, OnBatch: func(id string) error {
+			batch, e := eval.GetBatch(f.ctx, f.db.DB, id)
+			if e != nil {
+				return e
+			}
+			if batch.Status != "running" {
+				return fmt.Errorf("not running: %s", batch.Status)
+			}
+			rep, e := Clean(f.ctx, f.ws, CleanOptions{Now: f.now, Apply: true})
+			if e != nil {
+				return e
+			}
+			if goalItemRemoved(rep, f.base) {
+				return fmt.Errorf("running eval base removed: %+v", rep)
+			}
+			if _, e := os.Stat(filepath.Join(f.ws.Paths.Root, f.base)); e != nil {
+				return e
+			}
+			return nil
+		}})
+		if err != nil || result.Status != "completed" {
+			t.Fatalf("eval lifecycle: %+v %v", result, err)
+		}
+	})
+	t.Run("workflow lease starts after preview", func(t *testing.T) {
+		f := newCleanupGoalFixture(t)
+		if rep, err := Clean(f.ctx, f.ws, CleanOptions{Now: f.now}); err != nil || !goalItemEligible(rep, f.base) {
+			t.Fatalf("preview: %+v %v", rep, err)
+		}
+		// The task is based on a different commit: retaining the old cache must depend
+		// on the real live lease, not merely on matching task.State.Base.
+		testutil.Git(t, f.repo, "commit", "--allow-empty", "-m", "ongoing workflow")
+		cfg := config.Default()
+		command := "git rev-parse --verify HEAD"
+		cfg.Eval.TestCommand = &command
+		env := &workflow.Env{Root: f.repo, Cfg: cfg, Tasks: task.NewStore(f.ws.Paths.Runtime), Spool: f.ws.Paths.Spool, Human: true}
+		r := workflow.Runner{Env: env}
+		yes := true
+		tk, _, err := r.NewTask(f.ctx, workflow.NewTaskOptions{Request: "Inspect a safely", Workflow: workflow.StepDo, Driver: task.DriverSession, Isolation: task.IsolationShared, Plan: &yes})
+		if err != nil {
+			t.Fatal(err)
+		}
+		action, err := r.Next(f.ctx, workflow.NextOptions{TaskRef: tk.State.ID, NoWait: true})
+		if err != nil || action == nil || action.Action != workflow.ActionAgent {
+			t.Fatalf("open lease: %+v %v", action, err)
+		}
+		defer func() { _, _ = r.Abort(f.ctx, tk.State.ID, "fixture finished") }()
+		if steps := workflow.ActiveSteps(env.Tasks.Dir, f.repo); len(steps) == 0 {
+			t.Fatal("workflow did not issue a live lease")
+		}
+		rep, err := Clean(f.ctx, f.ws, CleanOptions{Now: f.now, Apply: true})
+		if err != nil || goalItemRemoved(rep, f.base) {
+			t.Fatalf("live lease lost its base: %+v %v", rep, err)
+		}
+		if _, err := os.Stat(filepath.Join(f.ws.Paths.Root, f.base)); err != nil {
+			t.Fatal(err)
+		}
+		// Resume the same pending step after cleanup; its run and lease must survive.
+		resumed, err := r.Next(f.ctx, workflow.NextOptions{TaskRef: tk.State.ID, NoWait: true})
+		if err != nil || resumed == nil || resumed.RunID != action.RunID {
+			t.Fatalf("cannot continue leased task: %+v %v", resumed, err)
+		}
+	})
+	t.Run("candidate becomes symlink after preview", func(t *testing.T) {
+		f := newCleanupGoalFixture(t)
+		preview, err := Clean(f.ctx, f.ws, CleanOptions{Now: f.now})
+		if err != nil || !goalItemEligible(preview, f.tmp) {
+			t.Fatalf("preview: %+v %v", preview, err)
+		}
+		dir := filepath.Join(f.ws.Paths.Root, f.tmp)
+		saved := filepath.Join(t.TempDir(), "saved-temp")
+		if err := os.Rename(dir, saved); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Symlink(saved, dir); err != nil {
+			t.Skipf("symlinks unavailable: %v", err)
+		}
+		rep, err := Clean(f.ctx, f.ws, CleanOptions{Now: f.now, Apply: true})
+		if err != nil || goalItemRemoved(rep, f.tmp) {
+			t.Fatalf("replacement: %+v %v", rep, err)
+		}
+		if fi, e := os.Lstat(dir); e != nil || fi.Mode()&os.ModeSymlink == 0 {
+			t.Fatalf("replacement link was removed: %v", e)
+		}
+		if b, e := os.ReadFile(filepath.Join(saved, "payload")); e != nil || string(b) != "disposable" {
+			t.Fatal("symlink target modified")
+		}
+	})
+	t.Run("IO failure after preview", func(t *testing.T) {
+		if runtime.GOOS == "windows" {
+			t.Skip("POSIX directory permission fixture; Windows does not implement these mode bits")
+		}
+		f := newCleanupGoalFixture(t)
+		if rep, err := Clean(f.ctx, f.ws, CleanOptions{Now: f.now}); err != nil || !goalItemEligible(rep, f.tmp) {
+			t.Fatalf("preview: %+v %v", rep, err)
+		}
+		dir := filepath.Join(f.ws.Paths.Root, f.tmp)
+		if err := os.Chmod(dir, 0); err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { _ = os.Chmod(dir, 0700) })
+		// Root/CAP_DAC_OVERRIDE cannot model EACCES with chmod.
+		if es, err := os.ReadDir(dir); err == nil {
+			_ = es
+			t.Skip("filesystem permissions do not deny this process")
+		}
+		rep, err := Clean(f.ctx, f.ws, CleanOptions{Now: f.now, Apply: true})
+		if err == nil || !errors.Is(err, os.ErrPermission) {
+			t.Fatalf("missing I/O error: %+v %v", rep, err)
+		}
+		found := false
+		for _, item := range rep.Items {
+			if item.Path == f.tmp && item.Error != "" && !item.Removed {
+				found = true
+			}
+		}
+		if !found {
+			t.Fatalf("missing failed path: %+v", rep)
+		}
+		if err := os.Chmod(dir, 0700); err != nil {
+			t.Fatal(err)
+		}
+		if b, e := os.ReadFile(filepath.Join(dir, "payload")); e != nil || string(b) != "disposable" {
+			t.Fatal("unreadable work lost")
+		}
+	})
+}
+
+type cleanupGoalFixture struct {
+	ctx       context.Context
+	ws        *Workspace
+	repo      string
+	db        *store.Store
+	now       time.Time
+	base, tmp string
+}
+
+func newCleanupGoalFixture(t *testing.T) *cleanupGoalFixture {
+	t.Helper()
+	testutil.Isolate(t)
+	ctx := context.Background()
+	repo := testutil.NewRepo(t, map[string]string{"a": "source"})
+	real, err := OpenWorkspace(ctx, repo, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	paths := state.At("transition", t.TempDir())
+	ws := &Workspace{Repo: real.Repo, Paths: paths}
+	if err := paths.Ensure(ws.Repo); err != nil {
+		t.Fatal(err)
+	}
+	db, err := store.Open(ctx, paths.DB)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = db.Close() })
+	now := time.Now().UTC()
+	old := now.AddDate(0, 0, -120)
+	sha := testutil.Git(t, repo, "rev-parse", "HEAD")
+	base := filepath.Join("eval-work", "bases", sha+".git")
+	bdir := filepath.Join(paths.Root, base)
+	testutil.Git(t, repo, "clone", "--bare", "--no-hardlinks", repo, bdir)
+	testutil.Git(t, bdir, "update-ref", "refs/heads/eval-base", sha)
+	testutil.Git(t, bdir, "update-ref", "-d", "refs/heads/main")
+	testutil.Git(t, bdir, "update-ref", "-d", "refs/heads/master")
+	tmp := filepath.Join("tmp", "verify-transition")
+	dir := filepath.Join(paths.Root, tmp)
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "payload"), []byte("disposable"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := cleanup.MarkTemp(dir, old, true); err != nil {
+		t.Fatal(err)
+	}
+	for _, tree := range []string{bdir, dir} {
+		if err := filepath.WalkDir(tree, func(p string, d os.DirEntry, e error) error {
+			if e != nil {
+				return e
+			}
+			return os.Chtimes(p, old, old)
+		}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return &cleanupGoalFixture{ctx, ws, repo, db, now, base, tmp}
+}
+func (f *cleanupGoalFixture) assertCandidates(t *testing.T) {
+	t.Helper()
+	for _, rel := range []string{f.base, f.tmp} {
+		if _, err := os.Stat(filepath.Join(f.ws.Paths.Root, rel)); err != nil {
+			t.Fatalf("active candidate lost %s: %v", rel, err)
+		}
+	}
+}
+func goalItemEligible(rep cleanup.Report, rel string) bool {
+	for _, i := range rep.Items {
+		if i.Path == rel {
+			return i.Eligible
+		}
+	}
+	return false
+}
+func goalItemRemoved(rep cleanup.Report, rel string) bool {
+	for _, i := range rep.Items {
+		if i.Path == rel {
+			return i.Removed
+		}
+	}
+	return false
+}
+
+func TestCleanupGoalWriterProcess(t *testing.T) {
+	root := os.Getenv("BINT_CLEAN_GOAL_WRITER")
+	if root == "" {
+		return
+	}
+	release, err := cleanup.Guard(root, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer release()
+	fmt.Println("writer-ready")
+	_, _ = bufio.NewReader(os.Stdin).ReadString('\n')
+}
+func startCleanupGoalWriter(t *testing.T, root string) func() {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestCleanupGoalWriterProcess$")
+	cmd.Env = append(os.Environ(), "BINT_CLEAN_GOAL_WRITER="+root)
+	in, err := cmd.StdinPipe()
+	if err != nil {
+		cancel()
+		t.Fatal(err)
+	}
+	out, err := cmd.StdoutPipe()
+	if err != nil {
+		cancel()
+		t.Fatal(err)
+	}
+	if err := cmd.Start(); err != nil {
+		cancel()
+		t.Fatal(err)
+	}
+	stopped := false
+	stop := func() {
+		if !stopped {
+			stopped = true
+			in.Close()
+			if err := cmd.Wait(); err != nil {
+				t.Errorf("writer: %v", err)
+			}
+			cancel()
+		}
+	}
+	t.Cleanup(stop)
+	scanner := bufio.NewScanner(out)
+	if !scanner.Scan() || scanner.Text() != "writer-ready" {
+		t.Fatal("writer did not acquire lifecycle gate")
+	}
+	return stop
+}
