+package redact
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"strings"
+	"testing"
+)
+
+func TestWriterEveryBoundary(t *testing.T) {
+	for _, c := range redactionCases() {
+		for split := 0; split <= len(c[0]); split++ {
+			var dst bytes.Buffer
+			w := NewWriter(&dst)
+			for _, part := range []string{c[0][:split], c[0][split:]} {
+				p := []byte(part)
+				before := bytes.Clone(p)
+				if n, err := w.Write(p); err != nil || n != len(p) {
+					t.Fatalf("Write = %d, %v", n, err)
+				}
+				if !bytes.Equal(p, before) {
+					t.Fatal("mutated caller's buffer")
+				}
+			}
+			if err := w.Close(); err != nil {
+				t.Fatal(err)
+			}
+			if err := w.Close(); err != nil {
+				t.Fatal(err)
+			}
+			if got := dst.String(); got != c[1] {
+				t.Fatalf("split %d of %q: %q, want %q", split, c[0], got, c[1])
+			}
+		}
+		var dst bytes.Buffer
+		w := NewWriter(&dst)
+		for i := range len(c[0]) {
+			if _, err := w.Write([]byte{c[0][i]}); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if err := w.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if dst.String() != c[1] {
+			t.Fatalf("byte writes: %q", dst.String())
+		}
+	}
+}
+
+type brokenWriter struct{ short bool }
+
+func (b brokenWriter) Write(p []byte) (int, error) {
+	if b.short {
+		return 0, nil
+	}
+	return 0, io.ErrClosedPipe
+}
+
+func TestWriterErrors(t *testing.T) {
+	for _, c := range []struct {
+		dst io.Writer
+		err error
+	}{{brokenWriter{}, io.ErrClosedPipe}, {brokenWriter{true}, io.ErrShortWrite}} {
+		w := NewWriter(c.dst)
+		_, err := w.Write([]byte("normal text\n"))
+		if !errors.Is(err, c.err) {
+			t.Fatalf("Write: %v", err)
+		}
+		if !errors.Is(w.Close(), c.err) {
+			t.Fatal("lost sink error")
+		}
+	}
+	w := NewWriter(io.Discard)
+	if err := w.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := w.Write([]byte("after close")); !errors.Is(err, io.ErrClosedPipe) {
+		t.Fatalf("Write after Close: %v", err)
+	}
+}
+
+func TestWriterBoundedMemory(t *testing.T) {
+	for _, size := range []int{1 << 20, 16 << 20} {
+		for _, start := range []string{"token=\"", "token=", "ghp_", "https://user:", "ordinary", "password: ", `{\"password\":\"`} {
+			w := NewWriter(io.Discard)
+			if _, err := io.WriteString(w, start); err != nil {
+				t.Fatal(err)
+			}
+			block := []byte(strings.Repeat("x", 4096))
+			for sent := 0; sent < size; sent += len(block) {
+				if _, err := w.Write(block); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if err := w.Close(); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+}
