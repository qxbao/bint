+package eval
+
+import (
+	"fmt"
+	"io"
+	"strings"
+	"testing"
+
+	"bint/internal/redact"
+)
+
+// Compare the original diagnostic path to the redacted path on this machine.
+func BenchmarkDiagnosticOutput(b *testing.B) {
+	data := []byte(strings.Repeat(strings.Repeat("ordinary build output OK ", 9)+"token=benchmark-fake-secret ", 5000))[:1<<20]
+	for _, mask := range []bool{false, true} {
+		b.Run(fmt.Sprintf("redact=%v", mask), func(b *testing.B) {
+			b.SetBytes(int64(len(data)))
+			b.ReportAllocs()
+			for range b.N {
+				tail := &tailBuffer{max: tailBytes}
+				var sink io.Writer = &diagnosticWriter{dst: io.MultiWriter(tail, io.Discard)}
+				var w *redact.Writer
+				if mask {
+					w = redact.NewWriter(sink)
+					sink = w
+				}
+				for pos := 0; pos < len(data); pos += 4096 {
+					_, _ = sink.Write(data[pos:min(pos+4096, len(data))])
+				}
+				if w != nil {
+					_ = w.Close()
+				}
+			}
+		})
+	}
+}
