@@ -0,0 +1,212 @@
+package redact
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/url"
+	"strings"
+	"testing"
+)
+
+func redactionCases() [][2]string {
+	return [][2]string{
+		{`password=hunter2 ordinary=1`, `password=*** ordinary=1`},
+		{`passwd='two words'`, `passwd='***'`},
+		{`TOKEN="a\"b"`, `TOKEN="***"`},
+		{`--access_token abc --refresh_token=def`, `--access_token *** --refresh_token=***`},
+		{`--api-key abc --api_key=def --secret ghi --client_secret=jkl`, `--api-key *** --api_key=*** --secret *** --client_secret=***`},
+		{`SERVICE_PASSWORD=x SERVICE_TOKEN=y SERVICE_API_KEY=z SERVICE_SECRET=w`, `SERVICE_PASSWORD=*** SERVICE_TOKEN=*** SERVICE_API_KEY=*** SERVICE_SECRET=***`},
+		{`{"password":"a\"b","token":1,"name":"Bao"}`, `{"password":"***","token":***,"name":"Bao"}`},
+		{"api_key: 'line1\nline2'\r\nname: Bao", "api_key: '***'\r\nname: Bao"},
+		{`Authorization: Bearer abc.def==`, `Authorization: Bearer ***`},
+		{`https://user:pass@host:8080/path`, `https://user:***@host:8080/path`},
+		{`ghp_<FIXTURE> github_pat_12345678901234567890 sk-proj-<FIXTURE>`, `*** *** ***`},
+		{`token=1 number=1`, `token=*** number=1`},
+		{"password=\"chưa đóng\n", "password=\"***"},
+		{`token=unfinished`, `token=***`},
+		{`password=first"second"'third'fourth visible`, `password=***""'' visible`},
+		{`prefix-ghp_<FIXTURE>-suffix`, `prefix-***-suffix`},
+		{`https://user:unfinished`, `https://user:***`},
+		{`https://user:unfinished/path`, `https://user:***/path`},
+		{`https://ghp_<FIXTURE>@host/path`, `https://***@host/path`},
+		{`https://password:8080/path https://[::1]:8080/`, `https://password:8080/path https://[::1]:8080/`},
+		{`password=first\ second visible`, `password=*** visible`},
+		{"password: |\n  line one\n  line two\nname: normal\n", "password: ***\nname: normal\n"},
+		{"nested:\n  token: >-\r\n    secret one\r\n    secret two\r\n  name: normal\r\n", "nested:\n  token: ***\r\n  name: normal\r\n"},
+		{`ghp_<FIXTURE> github_pat_1234567890123456789 sk-proj-<FIXTURE>`, `ghp_<FIXTURE> github_pat_1234567890123456789 sk-proj-<FIXTURE>`},
+		{`hello 世界 ordinary=abc tokenization=xyz ghp_short sk-proj-<FIXTURE> https://host:8080/path`, `hello 世界 ordinary=abc tokenization=xyz ghp_short sk-proj-<FIXTURE> https://host:8080/path`},
+		{`a password question; name: normal; https://example.org/`, `a password question; name: normal; https://example.org/`},
+		{`PASSWORD=first,second-fake-secret visible`, `PASSWORD=*** visible`},
+		{`--token=first}second]third visible`, `--token=*** visible`},
+		{"password: first second-fake-secret\nname: normal\n", "password: ***\nname: normal\n"},
+		{"password: first\n  second-fake-secret\nname: normal\n", "password: ***\nname: normal\n"},
+		{`{"type":"result","result":"{\"password\":\"nested-fake-secret\"}"}`, `{"type":"result","result":"{\"password\":\"***\"}"}`},
+		{"- password: |\n    first-fake-secret\n  name: normal\n- name: second\n", "- password: ***\n  name: normal\n- name: second\n"},
+		{"- 'password': |\n    first-fake-secret\n  name: normal\n", "- 'password': ***\n  name: normal\n"},
+		{"- password: first second-fake-secret\r\n    continued-fake-secret\r\n  name: normal\r\n", "- password: ***\r\n  name: normal\r\n"},
+		{"password:\nname: normal\n", "password:***\nname: normal\n"},
+		{`{"password":1,"name":"normal"}`, `{"password":***,"name":"normal"}`},
+		{`{password: first second, name: normal}`, `{password: ***, name: normal}`},
+		{`{password: first'second secret, name: normal}`, `{password: ***, name: normal}`},
+		{"message: \"[\"\npassword: first,second-fake-secret\nname: normal\n", "message: \"[\"\npassword: ***\nname: normal\n"},
+		{`{"message":"}","token":12345,"name":"normal"}`, `{"message":"}","token":***,"name":"normal"}`},
+		{"message: hello [\npassword: first,second-fake-secret\nname: normal\n", "message: hello [\npassword: ***\nname: normal\n"},
+		{"message: |\n  [ ordinary text\npassword: first,second-fake-secret\nname: normal\n", "message: |\n  [ ordinary text\npassword: ***\nname: normal\n"},
+		{`https://alice:before)after-fake-secret@host/path`, `https://alice:***@host/path`},
+		{`https://alice:before'after-fake-secret@host/path`, `https://alice:***@host/path`},
+		{`export "PASSWORD=first second-fake-secret"`, `export "PASSWORD=***"`},
+		{`export 'PASSWORD=first second-fake-secret'`, `export 'PASSWORD=***'`},
+		{`export "PASSWORD=first\" second-fake-secret" visible`, `export "PASSWORD=***" visible`},
+		{"&key password: |\n  second-fake-secret\nname: normal\n", "&key password: ***\nname: normal\n"},
+		{"- &key password: >\n    second-fake-secret\n  name: normal\n", "- &key password: ***\n  name: normal\n"},
+		{"!!str &key 'password': first\n  second-fake-secret\nname: normal\n", "!!str &key 'password': ***\nname: normal\n"},
+		{"message: &meta {token: 12345, name: normal}\npassword: first,second-fake-secret\n", "message: &meta {token: ***, name: normal}\npassword: ***\n"},
+		{"message: &meta\n  {token: 12345, name: normal}\npassword: first,second-fake-secret\n", "message: &meta\n  {token: ***, name: normal}\npassword: ***\n"},
+		{"message:\nnext: {token: 12345, name: normal}\npassword: first,second-fake-secret\n", "message:\nnext: {token: ***, name: normal}\npassword: ***\n"},
+		{"# ordinary [ comment\npassword: first,second-fake-secret\nname: normal\n", "# ordinary [ comment\npassword: ***\nname: normal\n"},
+		{"message:\n  data: {token: 12345, name: normal}\npassword: first,second-fake-secret\n", "message:\n  data: {token: ***, name: normal}\npassword: ***\n"},
+		{"message:\n  hello [\n  more plain text\npassword: first,second-fake-secret\n", "message:\n  hello [\n  more plain text\npassword: ***\n"},
+	}
+}
+
+func TestOrdinaryScalarDoesNotChangeSyntax(t *testing.T) {
+	for _, message := range []string{"[", "]", "{", "}", `escaped \"[} quote`, "don't [ lose } context"} {
+		encoded, err := json.Marshal(message)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, c := range [][2]string{
+			{`{"message":` + string(encoded) + `,"token":12345,"name":"normal"}`, `{"message":` + string(encoded) + `,"token":***,"name":"normal"}`},
+			{"message: " + string(encoded) + "\npassword: first,second-fake-secret\nname: normal\n", "message: " + string(encoded) + "\npassword: ***\nname: normal\n"},
+			{"message: |\n  " + message + "\npassword: first,second-fake-secret\nname: normal\n", "message: |\n  " + message + "\npassword: ***\nname: normal\n"},
+		} {
+			checkSyntaxChunks(t, c[0], c[1])
+		}
+	}
+}
+
+func TestURLUserinfoSubDelimiters(t *testing.T) {
+	for _, delimiter := range "!$&'()*+,;=:" {
+		password := "before" + string(delimiter) + "after-fake-secret"
+		input := "https://alice:" + password + "@host/path"
+		u, err := url.Parse(input)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got, _ := u.User.Password(); got != password {
+			t.Fatalf("invalid fixture %q", got)
+		}
+		checkSyntaxChunks(t, input, "https://alice:***@host/path")
+	}
+}
+
+func checkSyntaxChunks(t *testing.T, input, want string) {
+	t.Helper()
+	if got := Text(input); got != want {
+		t.Fatalf("Text(%q) = %q, want %q", input, got, want)
+	}
+	if got := Text(want); got != want {
+		t.Fatalf("not idempotent: %q", got)
+	}
+	for _, chunk := range []int{1, 7, 4096} {
+		var out bytes.Buffer
+		w := NewWriter(&out)
+		for i := 0; i < len(input); i += chunk {
+			if _, err := w.Write([]byte(input[i:min(i+chunk, len(input))])); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if err := w.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if out.String() != want {
+			t.Fatalf("chunk %d: %q, want %q", chunk, out.String(), want)
+		}
+	}
+}
+
+func TestNestedJSONEscapes(t *testing.T) {
+	for _, raw := range []string{
+		`{"password":"nested-fake-secret\"quoted\\tail","name":"normal"}`,
+		`{"password":"nested-fake-secret\\","name":"normal"}`,
+	} {
+		input, want := raw, `{"password":"***","name":"normal"}`
+		for depth := 0; depth <= 3; depth++ {
+			if got := Text(input); got != want {
+				t.Fatalf("depth %d: %q, want %q", depth, got, want)
+			}
+			if got := Text(want); got != want {
+				t.Fatalf("depth %d not idempotent: %q", depth, got)
+			}
+			for split := 0; split <= len(input); split++ {
+				var out bytes.Buffer
+				w := NewWriter(&out)
+				for _, part := range []string{input[:split], input[split:]} {
+					if _, err := w.Write([]byte(part)); err != nil {
+						t.Fatal(err)
+					}
+				}
+				if err := w.Close(); err != nil {
+					t.Fatal(err)
+				}
+				if out.String() != want {
+					t.Fatalf("depth %d split %d: %q", depth, split, out.String())
+				}
+			}
+			encodedInput, err := json.Marshal(struct {
+				Result string `json:"result"`
+			}{input})
+			if err != nil {
+				t.Fatal(err)
+			}
+			encodedWant, err := json.Marshal(struct {
+				Result string `json:"result"`
+			}{want})
+			if err != nil {
+				t.Fatal(err)
+			}
+			input, want = string(encodedInput), string(encodedWant)
+		}
+	}
+}
+
+func TestArgsPreservesBoundaries(t *testing.T) {
+	in := []string{"--token", "secret with spaces and \"quotes\"", "--password=two words", "normal", `{"api_key":"fake-value"}`, "PASSWORD=first second-fake-secret", "-c", "PASSWORD=first,second-fake-secret true", "/C", `export "PASSWORD=first second-fake-secret"`}
+	want := []string{"--token", "***", "--password=***", "normal", `{"api_key":"***"}`, "PASSWORD=***", "-c", "PASSWORD=*** true", "/C", `export "PASSWORD=***"`}
+	got := Args(in)
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("arg %d: %q, want %q", i, got[i], want[i])
+		}
+	}
+	if in[1] != "secret with spaces and \"quotes\"" {
+		t.Fatal("mutated argv")
+	}
+}
+
+func TestText(t *testing.T) {
+	for _, c := range redactionCases() {
+		if got := Text(c[0]); got != c[1] {
+			t.Errorf("Text(%q) = %q, want %q", c[0], got, c[1])
+		}
+		if got := Text(c[1]); got != c[1] {
+			t.Errorf("not idempotent: %q -> %q", c[1], got)
+		}
+	}
+}
+
+func TestTextLongSecrets(t *testing.T) {
+	secret := strings.Repeat("s", 128<<10)
+	for _, c := range [][2]string{
+		{"password=" + secret + " visible", "password=*** visible"},
+		{"token=\"" + secret + "\" visible", "token=\"***\" visible"},
+		{"ghp_" + secret + " visible", "*** visible"},
+		{"https://user:" + secret + "@host/path", "https://user:***@host/path"},
+		{`{\"password\":\"` + secret + `\"}`, `{\"password\":\"***\"}`},
+		{"password: first " + secret + "\n  continued-secret\nname: normal\n", "password: ***\nname: normal\n"},
+	} {
+		if got := Text(c[0]); got != c[1] {
+			t.Errorf("long secret: output len %d, want %q", len(got), c[1])
+		}
+	}
+}
diff --git a/internal/redact/writer.go b/internal/redact/writer.go
new file mode 100644
index 0000000..b42e163
--- /dev/null
+++ b/internal/redact/writer.go
@@ -0,0 +1,507 @@
+package redact
+
+import (
+	"bytes"
+	"io"
+	"strings"
+)
+
+type mode uint8
+
+const (
+	plain mode = iota
+	word
+	afterKey
+	beforeValue
+	unquoted
+	quoted
+	afterQuoted
+	prefixed
+	slash1
+	slash2
+	authority
+	longAuthority
+	blockHeader
+	blockStart
+	blockBody
+	yamlPlain
+	valueQuoteProbe
+	flowPlain
+)
+
+// Writer redacts one stream. It never mutates input or closes the destination.
+// Use a separate Writer for each stream; callers synchronize a shared sink.
+// Fixed arrays bound retained storage to less than 16 KiB regardless of input
+// length. Values are discarded as they arrive, not accumulated in memory.
+// Ambiguous URL authorities beyond 4 KiB are conservatively hidden: arbitrarily
+// long credentials cannot be buffered while waiting for their final '@'.
+type Writer struct {
+	dst                                    io.Writer
+	state                                  mode
+	keyFlag, escaped, widePrefix, overflow bool
+	quote                                  byte
+	wordBuf                                [256]byte
+	wordN                                  int
+	url                                    [4096]byte
+	urlN                                   int
+	out                                    [8192]byte
+	outN                                   int
+	err                                    error
+	closed                                 bool
+	column                                 int
+	keyIndent, blockIndent                 int
+	yamlValue                              bool
+	flowValue                              bool
+	quoteSlashes, slashRun                 int
+	wordQuote, keyQuote, pendingWordQuote  byte
+	syntax                                 syntax
+}
+
+func NewWriter(dst io.Writer) *Writer { return &Writer{dst: dst} }
+
+func (w *Writer) flush() {
+	if w.err != nil || w.outN == 0 {
+		return
+	}
+	n, err := w.dst.Write(w.out[:w.outN])
+	if err == nil && n != w.outN {
+		err = io.ErrShortWrite
+	}
+	w.err = err
+	w.outN = 0
+}
+
+func (w *Writer) emit(p []byte) {
+	for len(p) > 0 && w.err == nil {
+		n := copy(w.out[w.outN:], p)
+		w.outN += n
+		p = p[n:]
+		if w.outN == len(w.out) {
+			w.flush()
+		}
+	}
+}
+func (w *Writer) char(c byte) {
+	if w.err != nil {
+		return
+	}
+	w.out[w.outN] = c
+	w.outN++
+	if w.outN == len(w.out) {
+		w.flush()
+	}
+}
+func (w *Writer) mask() { w.emit([]byte("***")) }
+
+func (w *Writer) Write(p []byte) (int, error) {
+	if w.err != nil {
+		return 0, w.err
+	}
+	if w.closed {
+		return 0, io.ErrClosedPipe
+	}
+	for i, c := range p {
+		w.syntax.advance(c, w.column)
+		w.step(c)
+		w.column++
+		if c == '\n' {
+			w.column = 0
+		}
+		if w.err != nil {
+			return i + 1, w.err
+		}
+	}
+	w.flush()
+	return len(p), w.err
+}
+
+func (w *Writer) step(c byte) {
+	for {
+		switch w.state {
+		case plain:
+			if wordByte(c) {
+				w.state, w.wordN, w.overflow = word, 1, false
+				w.wordQuote, w.pendingWordQuote = w.pendingWordQuote, 0
+				w.wordBuf[0] = c
+			} else {
+				w.pendingWordQuote = 0
+				if c == '"' || c == '\'' {
+					w.pendingWordQuote = c
+				}
+				w.char(c)
+			}
+			return
+		case word:
+			if wordByte(c) {
+				if w.wordN == len(w.wordBuf) {
+					// Retain a suffix for arbitrarily long environment variable names.
+					w.emit(w.wordBuf[:w.wordN-64])
+					copy(w.wordBuf[:], w.wordBuf[w.wordN-64:w.wordN])
+					w.wordN, w.overflow = 64, true
+				}
+				w.wordBuf[w.wordN] = c
+				w.wordN++
+				{
+					s := w.wordBuf[:w.wordN]
+					for _, prefix := range credentialPrefixes {
+						start := len(s) - len(prefix) - 20
+						if start >= 0 && bytes.HasPrefix(s[start:], []byte(prefix)) {
+							valid := true
+							for _, b := range s[start+len(prefix):] {
+								if b >= 128 || b == '-' && prefix != "sk-proj-" {
+									valid = false
+								}
+							}
+							if valid {
+								w.emit(s[:start])
+								w.mask()
+								w.state, w.widePrefix, w.wordN = prefixed, prefix == "sk-proj-", 0
+								break
+							}
+						}
+					}
+				}
+				return
+			}
+			s := string(w.wordBuf[:w.wordN])
+			w.emit(w.wordBuf[:w.wordN])
+			w.wordN = 0
+			w.state = plain
+			if secretKey(s, !w.overflow) || !w.overflow && strings.EqualFold(s, "bearer") {
+				w.state = afterKey
+				w.keyFlag = strings.HasPrefix(s, "-") || strings.EqualFold(s, "bearer")
+				w.keyIndent, w.yamlValue = w.syntax.entryIndent, false
+				w.flowValue = false
+				w.keyQuote = w.wordQuote
+			} else if c == ':' {
+				w.char(c)
+				w.state = slash1
+				return
+			}
+		case afterKey:
+			switch {
+			case c == '\\':
+				// JSON output can carry another JSON document in a string.
+				// Its key-closing quote is escaped, even across Write calls.
+				w.char(c)
+				return
+			case c == '"' || c == '\'':
+				w.char(c)
+				w.keyQuote = 0
+				return
+			case space(c):
+				w.char(c)
+				if w.keyFlag {
+					w.state = beforeValue
+				}
+				return
+			case c == '=' || c == ':':
+				w.char(c)
+				if c == '=' && w.keyQuote != 0 {
+					// export "PASSWORD=two words": the quote already opened
+					// before the key, and encloses the entire assignment.
+					w.mask()
+					w.quote, w.quoteSlashes, w.slashRun, w.state = w.keyQuote, 0, 0, quoted
+					return
+				}
+				w.yamlValue = c == ':'
+				w.flowValue = c == ':' && w.syntax.flowDepth > 0
+				w.state = beforeValue
+				return
+			default:
+				w.state = plain
+			}
+		case beforeValue:
+			if space(c) {
+				if w.yamlValue && !w.flowValue && (c == '\r' || c == '\n') {
+					w.mask()
+					w.state = blockHeader
+					continue
+				}
+				w.char(c)
+				return
+			}
+			if c == '\'' || c == '"' {
+				w.char(c)
+				w.mask()
+				w.quote, w.escaped, w.state = c, false, quoted
+				w.quoteSlashes, w.slashRun = 0, 0
+				return
+			}
+			if c == '\\' {
+				w.slashRun, w.state = 1, valueQuoteProbe
+				return
+			}
+			if w.yamlValue && !w.flowValue && (c == '|' || c == '>') {
+				w.mask()
+				w.state = blockHeader
+				return
+			}
+			if w.yamlValue && !w.flowValue {
+				// YAML plain scalars include spaces and may continue on
+				// indented lines. Reuse the block indentation boundary.
+				w.mask()
+				w.state = yamlPlain
+				continue
+			}
+			if w.flowValue && !flowEnd(c) {
+				w.mask()
+				w.state = flowPlain
+				continue
+			}
+			if w.valueEnd(c) {
+				w.state = plain
+				continue
+			}
+			w.mask()
+			w.state, w.escaped = unquoted, false
+		case unquoted:
+			if w.escaped {
+				w.escaped = false
+				return
+			}
+			if c == '\\' {
+				w.escaped = true
+				return
+			}
+			if c == '\'' || c == '"' {
+				w.char(c)
+				w.quote, w.escaped, w.state = c, false, quoted
+				w.quoteSlashes, w.slashRun = 0, 0
+				return
+			}
+			if !w.valueEnd(c) {
+				return
+			}
+			w.state = plain
+		case quoted:
+			if c == '\\' && w.quote == '"' {
+				w.slashRun++
+				return
+			}
+			// At encoding depth n the delimiter has 2^n-1 backslashes.
+			// An escaped quote inside the value has an additional 2^n;
+			// escaped trailing backslashes add multiples of 2^(n+1).
+			if c == w.quote && (w.quote != '"' || w.slashRun >= w.quoteSlashes &&
+				(w.slashRun-w.quoteSlashes)%(2*(w.quoteSlashes+1)) == 0) {
+				for range w.quoteSlashes {
+					w.char('\\')
+				}
+				w.char(c)
+				w.state = afterQuoted
+			}
+			w.slashRun = 0
+			return
+		case afterQuoted:
+			if c == '\'' || c == '"' {
+				w.char(c)
+				w.quote, w.escaped, w.state = c, false, quoted
+				w.quoteSlashes, w.slashRun = 0, 0
+				return
+			}
+			if !w.valueEnd(c) {
+				w.state, w.escaped = unquoted, false
+				continue
+			}
+			w.state = plain
+		case prefixed:
+			if prefixByte(c, w.widePrefix) {
+				return
+			}
+			w.state = plain
+		case slash1:
+			w.state = plain
+			if c == '/' {
+				w.state = slash2
+				w.char(c)
+				return
+			}
+		case slash2:
+			w.state = plain
+			if c == '/' {
+				w.char(c)
+				w.state, w.urlN = authority, 0
+				return
+			}
+		case authority:
+			if c == '@' {
+				w.emitAuthority(true)
+				w.char(c)
+				w.state = plain
+				return
+			}
+			if authorityEnd(c) {
+				w.emitAuthority(false)
+				w.state = plain
+				continue
+			}
+			if w.urlN == len(w.url) {
+				if colon := bytes.IndexByte(w.url[:w.urlN], ':'); colon >= 0 {
+					w.publicAuthority(w.url[:colon+1])
+				}
+				w.mask()
+				w.urlN, w.state = 0, longAuthority
+				continue
+			}
+			w.url[w.urlN] = c
+			w.urlN++
+			return
+		case longAuthority:
+			if c == '@' {
+				w.char(c)
+				w.state = plain
+				return
+			}
+			if !authorityEnd(c) {
+				return
+			}
+			w.state = plain
+		case blockHeader:
+			if c == '\r' {
+				w.char(c)
+			}
+			if c == '\n' {
+				w.char(c)
+				w.state, w.blockIndent = blockStart, 0
+			}
+			return
+		case blockStart:
+			if c == ' ' || c == '\t' {
+				w.blockIndent++
+				return
+			}
+			if c == '\r' || c == '\n' {
+				w.blockIndent = 0
+				return
+			}
+			if w.blockIndent > w.keyIndent {
+				w.state = blockBody
+				return
+			}
+			for range w.blockIndent {
+				w.char(' ')
+			}
+			w.state = plain
+		case blockBody:
+			if c == '\n' {
+				w.state, w.blockIndent = blockStart, 0
+			}
+			return
+		case yamlPlain:
+			if c == '\r' {
+				w.char(c)
+			}
+			if c == '\n' {
+				w.char(c)
+				w.state, w.blockIndent = blockStart, 0
+			}
+			return
+		case flowPlain:
+			if flowEnd(c) {
+				w.state = plain
+				continue
+			}
+			if c == '\r' || c == '\n' {
+				w.char(c)
+			}
+			return
+		case valueQuoteProbe:
+			if c == '\\' {
+				w.slashRun++
+				return
+			}
+			if c == '"' {
+				for range w.slashRun {
+					w.char('\\')
+				}
+				w.char(c)
+				w.mask()
+				w.quote, w.quoteSlashes, w.slashRun, w.state = c, w.slashRun, 0, quoted
+				return
+			}
+			w.mask()
+			w.escaped, w.slashRun, w.state = w.slashRun%2 == 1, 0, unquoted
+			if w.yamlValue && !w.flowValue {
+				w.state = yamlPlain
+			}
+			if w.flowValue {
+				w.state = flowPlain
+			}
+		}
+	}
+}
+
+func (w *Writer) valueEnd(c byte) bool {
+	if w.flowValue {
+		return space(c) || flowEnd(c)
+	}
+	return shellEnd(c)
+}
+
+func (w *Writer) emitAuthority(credential bool) {
+	p := w.url[:w.urlN]
+	// Preserve ordinary host:port URLs, but fail closed for incomplete user:pass
+	// authorities. A nonnumeric port cannot be a valid ordinary URL port.
+	i := bytes.IndexByte(p, ':')
+	if !credential && i >= 0 && len(p) > 0 && p[0] != '[' {
+		for _, c := range p[i+1:] {
+			if c < '0' || c > '9' {
+				credential = true
+				break
+			}
+		}
+	}
+	if credential && i >= 0 {
+		w.publicAuthority(p[:i+1])
+		w.mask()
+	} else {
+		w.publicAuthority(p)
+	}
+	w.urlN = 0
+}
+
+// An authority may carry a prefixed credential as the username alone.
+func (w *Writer) publicAuthority(p []byte) {
+	// Prefixes are the only patterns meaningful in a host/user portion. Scan
+	// those directly to avoid treating a hostname such as password:8080 as a key.
+	start := 0
+	for i := 0; i < len(p); i++ {
+		for _, prefix := range credentialPrefixes {
+			if !bytes.HasPrefix(p[i:], []byte(prefix)) {
+				continue
+			}
+			end := i + len(prefix)
+			for end < len(p) && prefixByte(p[end], prefix == "sk-proj-") {
+				end++
+			}
+			if end-i-len(prefix) < 20 {
+				continue
+			}
+			w.emit(p[start:i])
+			w.mask()
+			start, i = end, end-1
+			break
+		}
+	}
+	w.emit(p[start:])
+}
+
+// Close flushes an incomplete token. Unterminated secret values stay hidden.
+// Errors are sticky; there is no fallback to an unredacted destination.
+func (w *Writer) Close() error {
+	if !w.closed {
+		w.closed = true
+		if w.state == word {
+			w.emit(w.wordBuf[:w.wordN])
+			w.wordN = 0
+		}
+		if w.state == authority {
+			w.emitAuthority(false)
+		}
+		if w.state == valueQuoteProbe {
+			w.mask()
+		}
+		w.flush()
+	}
+	return w.err
+}
