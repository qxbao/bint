+++ b/internal/redact/redact_benchmark_test.go
@@ -0,0 +1,66 @@
+package redact
+
+import (
+	"fmt"
+	"io"
+	"strings"
+	"testing"
+	"unsafe"
+)
+
+// Exactly 1 MiB: nine ordinary rows for each credential row. Alternating
+// newline/no-newline blocks exercises both log shapes. All credentials are fake.
+func benchmarkText() string {
+	var s strings.Builder
+	ordinary := strings.Repeat("ordinary build output succeeded. ", 30)[:900]
+	secret := `token="benchmark-fake-secret" api_key=benchmark-fake-key `
+	secret += strings.Repeat(" ", 100-len(secret))
+	block := 0
+	for s.Len() < 1<<20 {
+		s.WriteString(ordinary)
+		s.WriteString(secret[:99])
+		if block%2 == 0 {
+			s.WriteByte('\n')
+		} else {
+			s.WriteByte(' ')
+		}
+		block++
+	}
+	return s.String()[:1<<20]
+}
+
+func BenchmarkText(b *testing.B) {
+	text := benchmarkText()
+	b.SetBytes(int64(len(text)))
+	b.ReportAllocs()
+	b.ResetTimer()
+	for range b.N {
+		_ = Text(text)
+	}
+}
+
+func BenchmarkWriter(b *testing.B) {
+	data := []byte(benchmarkText())
+	for _, chunk := range []int{1, 4096, 65536} {
+		b.Run(fmt.Sprint(chunk), func(b *testing.B) {
+			b.SetBytes(int64(len(data)))
+			b.ReportAllocs()
+			b.ResetTimer()
+			for range b.N {
+				w := NewWriter(io.Discard)
+				for pos := 0; pos < len(data); pos += chunk {
+					_, _ = w.Write(data[pos:min(pos+chunk, len(data))])
+				}
+				_ = w.Close()
+			}
+		})
+	}
+}
+
+// The writer has no dynamically growing buffers: account for the entire struct,
+// including metadata, rather than just inspecting one allocation snapshot.
+func TestWriterStorageBudget(t *testing.T) {
+	if n := unsafe.Sizeof(Writer{}); n > 64<<10 {
+		t.Fatalf("retained storage %d exceeds 64 KiB", n)
+	}
+}
