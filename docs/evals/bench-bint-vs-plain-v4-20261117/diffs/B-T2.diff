+		{"yaml_plain_multiline", "password: first\n  second-fake-secret\nname: normal\n", "second-fake-secret", "name: normal"},
+		{"encoded_json", `{"type":"result","result":"{\"password\":\"nested-fake-secret\"}","name":"normal"}`, "nested-fake-secret", "normal"},
+		{"yaml_sequence", "- password: |\n    first-fake-secret\n  name: normal\n- name: second\n", "first-fake-secret", "name: normal"},
+		{"yaml_quoted_bracket", "message: \"[\"\npassword: first,second-fake-secret\nname: normal\n", "second-fake-secret", "name: normal"},
+		{"json_quoted_brace", `{"message":"}","token":12345,"name":"normal"}`, "12345", `"name":"normal"`},
+		{"url_parenthesis", "https://alice:before)after-fake-secret@host/path", "after-fake-secret", "host/path"},
+		{"url_apostrophe", "https://alice:before'after-fake-secret@host/path", "after-fake-secret", "host/path"},
+		{"yaml_key_anchor", "&key password: |\n  second-fake-secret\nname: normal\n", "second-fake-secret", "name: normal"},
