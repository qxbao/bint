+)
+
+const fixtureArgSecret = "argv-fake-secret-123"
+const fixtureInputSecret = "stdin-fake-secret-456"
+const fixtureEnvSecret = "env-fake-secret-789"
+const fixtureRawOutput = `{"api_key":"argv-fake-secret-123","password":"stdin-fake-secret-456","token":"env-fake-secret-789","name":"世界"}`
+
+// The real child validates execution inputs, then produces diagnostic copies.
+func TestRedactionProcessFixture(t *testing.T) {
+	mode := os.Getenv("BINT_REDACT_FIXTURE")
+	if mode == "" {
+		return
+	}
+	if mode == "boundary-stdout" || mode == "boundary-stderr" {
+		dst := os.Stdout
+		if mode == "boundary-stderr" {
+			dst = os.Stderr
+		}
+		input, err := io.ReadAll(os.Stdin)
+		if err != nil {
+			os.Exit(14)
+		}
+		for _, b := range input {
+			if _, err := dst.Write([]byte{b}); err != nil {
+				os.Exit(15)
+			}
+		}
+		os.Exit(0)
+	}
+	if mode == "wait" {
+		_, _ = io.WriteString(os.Stdout, "password=\"cancel-fake-secret-123")
+		if err := os.WriteFile(os.Getenv("BINT_REDACT_READY"), []byte("ready"), 0o600); err != nil {
+			os.Exit(10)
+		}
+		time.Sleep(time.Minute)
+		os.Exit(11)
+	}
+	input, err := io.ReadAll(os.Stdin)
+	if err != nil || string(input) != fixtureInputSecret || os.Getenv("BINT_REDACT_INPUT") != fixtureEnvSecret {
+		os.Exit(12)
+	}
+	if len(os.Args) < 3 || os.Args[len(os.Args)-2] != "--token" || os.Args[len(os.Args)-1] != fixtureArgSecret {
+		os.Exit(13)
+	}
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		for i := range len(fixtureRawOutput) {
+			_, _ = os.Stdout.Write([]byte{fixtureRawOutput[i]})
+		}
+	}()
+	go func() {
+		defer wg.Done()
+		for _, part := range []string{"client_", "secret=\"", strings.Repeat("long-fake-secret-", 10000), "\"\nnormal stderr\n"} {
+			_, _ = io.WriteString(os.Stderr, part)
+		}
+	}()
+	wg.Wait()
+	os.Exit(7)
+}
+
+func TestRunProcessRedactsWithoutChangingExecution(t *testing.T) {
+	bin, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, capture := range []bool{true, false} {
+		t.Run(map[bool]string{true: "capture", false: "no-capture"}[capture], func(t *testing.T) {
+			dir := t.TempDir()
+			log := filepath.Join(dir, "process.log")
+			const history = "history token=old-fake-secret\n"
+			if err := os.WriteFile(log, []byte(history), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			var raw bytes.Buffer
+			var stdout *bytes.Buffer
+			if capture {
+				stdout = &raw
+			}
+			res := runProcess(context.Background(), dir, bin,
+				[]string{"-test.run=^TestRedactionProcessFixture$", "--", "--token", fixtureArgSecret},
+				15*time.Second, log, append(os.Environ(), "BINT_REDACT_FIXTURE=output", "BINT_REDACT_INPUT="+fixtureEnvSecret),
+				strings.NewReader(fixtureInputSecret), stdout)
+			if res.ExitCode != 7 || res.TimedOut || res.Err != nil {
+				t.Fatalf("execution changed: %+v", res)
+			}
+			if capture && raw.String() != fixtureRawOutput {
+				t.Fatalf("raw stdout changed: %q", raw.String())
+			}
+			data, err := os.ReadFile(log)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !bytes.HasPrefix(data, []byte(history)) {
+				t.Fatal("history was changed")
+			}
+			for _, diagnostic := range []string{string(data[len(history):]), res.Tail} {
+				for _, secret := range []string{fixtureArgSecret, fixtureInputSecret, fixtureEnvSecret, "long-fake-secret-"} {
+					if strings.Contains(diagnostic, secret) {
+						t.Fatalf("diagnostic leaked %q", secret)
+					}
+				}
+			}
+			if !bytes.Contains(data, []byte("normal stderr")) || !bytes.Contains(data, []byte("世界")) || !bytes.Contains(data, []byte("***")) {
+				t.Fatal("ordinary output or mask lost")
+			}
+			entries, err := os.ReadDir(dir)
+			if err != nil || len(entries) != 1 {
+				t.Fatalf("unexpected backup/raw logs: %v, %v", entries, err)
+			}
+		})
+	}
+}
+
+func TestRunProcessRedactsOnCancellation(t *testing.T) {
+	bin, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, timeout := range []bool{false, true} {
+		t.Run(map[bool]string{false: "cancel", true: "timeout"}[timeout], func(t *testing.T) {
+			dir := t.TempDir()
+			ready, log := filepath.Join(dir, "ready"), filepath.Join(dir, "process.log")
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			// Cancel only once the child has emitted an unterminated credential.
+			finished := make(chan struct{})
+			defer close(finished)
+			if !timeout {
+				go func() {
+					for {
+						if _, err := os.Stat(ready); err == nil {
+							cancel()
+							return
+						}
+						select {
+						case <-finished:
+							return
+						case <-time.After(10 * time.Millisecond):
+						}
+					}
+				}()
+			}
+			limit := 10 * time.Second
+			if timeout {
+				limit = 3 * time.Second
+			}
+			res := runProcess(ctx, dir, bin, []string{"-test.run=^TestRedactionProcessFixture$"}, limit, log,
+				append(os.Environ(), "BINT_REDACT_FIXTURE=wait", "BINT_REDACT_READY="+ready), nil, nil)
+			if _, err := os.Stat(ready); err != nil {
+				t.Fatal("child never reached output")
+			}
+			if timeout {
+				if !res.TimedOut || res.ExitCode != -1 {
+					t.Fatalf("timeout changed: %+v", res)
+				}
+			} else if !errors.Is(res.Err, context.Canceled) {
+				t.Fatalf("cancel changed: %+v", res)
+			}
+			data, err := os.ReadFile(log)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, diagnostic := range []string{string(data), res.Tail} {
+				if strings.Contains(diagnostic, "cancel-fake-secret-123") || !strings.Contains(diagnostic, `password="***`) {
+					t.Fatalf("incomplete secret not hidden: %q", diagnostic)
+				}
+			}
+		})
+	}
+}
