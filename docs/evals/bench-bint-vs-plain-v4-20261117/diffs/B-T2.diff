--- /dev/null
+++ b/internal/redact/syntax.go
@@ -0,0 +1,169 @@
+package redact
+
+// syntax follows the original bytes, including bytes discarded by the masker.
+// Quoted strings and YAML scalar bodies cannot change the enclosing flow depth.
+// This state contains only counters/flags; it never retains a scalar or document.
+type syntax struct {
+	flowDepth                          int
+	quote, previous                    byte
+	escaped                            bool
+	entryIndent                        int
+	entrySet, dashPending, firstOnLine bool
+	yamlColon, yamlValue, yamlProperty bool
+	yamlChild                          bool
+	yamlIndent                         int
+	scalar, ignoreLine                 bool
+	scalarIndent                       int
+	urlSlash, urlText                  bool
+}
+
+func (s *syntax) advance(c byte, column int) {
+	previous := s.previous
+	s.previous = c
+	if column == 0 {
+		s.entryIndent, s.entrySet, s.dashPending = 0, false, false
+		s.firstOnLine, s.ignoreLine = true, false
+	}
+	// An entry starts before its anchor/tag, but after any sequence markers.
+	// Delay accepting '-' until its following byte distinguishes a marker
+	// from an ordinary word such as --token or -123.
+	if !s.entrySet {
+		switch {
+		case space(c):
+			s.dashPending = false
+		case s.dashPending:
+			s.entrySet = true
+		case c == '-':
+			s.entryIndent, s.dashPending = column, true
+		default:
+			s.entryIndent, s.entrySet = column, true
+		}
+	}
+	if s.firstOnLine && !space(c) {
+		s.firstOnLine = false
+		if column <= s.yamlIndent {
+			// A value deferred to a later line cannot consume a sibling entry.
+			s.yamlColon, s.yamlValue, s.yamlProperty = false, false, false
+		}
+		if s.yamlValue && c != '"' && c != '\'' && c != '[' && c != '{' && c != '&' && c != '!' && c != '|' && c != '>' && c != '#' {
+			// A deferred value can be a block mapping or a plain scalar.
+			// Ignore scalar punctuation until a mapping colon is confirmed.
+			s.yamlChild, s.yamlValue = true, false
+		}
+		if s.scalar && s.quote == 0 && s.flowDepth == 0 {
+			if column > s.scalarIndent {
+				s.ignoreLine = true
+			} else {
+				s.scalar = false
+			}
+		}
+	}
+	if c == '\n' && s.quote == 0 {
+		if s.yamlChild && !s.yamlColon {
+			s.scalar, s.scalarIndent = true, s.yamlIndent
+		}
+		s.yamlChild = false
+		if s.yamlColon {
+			s.yamlValue = true
+		}
+		s.yamlColon, s.yamlProperty, s.urlSlash, s.urlText = false, false, false, false
+		return
+	}
+	if s.ignoreLine {
+		return
+	}
+	if s.quote != 0 {
+		if s.escaped {
+			s.escaped = false
+			return
+		}
+		if c == '\\' && s.quote == '"' {
+			s.escaped = true
+			return
+		}
+		if c == s.quote {
+			s.quote = 0
+		}
+		return
+	}
+	if c == '#' && (column == 0 || space(previous)) {
+		s.ignoreLine = true
+		return
+	}
+	if s.yamlChild {
+		if s.yamlColon {
+			s.yamlColon = false
+			if space(c) {
+				s.yamlChild, s.yamlValue = false, true
+			}
+			return
+		}
+		if c == ':' {
+			s.yamlColon, s.yamlIndent = true, s.entryIndent
+		}
+		return
+	}
+	if s.urlText {
+		if !space(c) && c != '"' {
+			return
+		}
+		s.urlText = false
+	}
+	if s.urlSlash {
+		s.urlSlash = false
+		if c == '/' {
+			s.urlText = true
+			return
+		}
+	}
+	if s.yamlColon {
+		s.yamlColon = false
+		if c == '/' {
+			s.urlSlash = true
+			return
+		}
+		if space(c) {
+			s.yamlValue = true
+			return
+		}
+	}
+	if s.yamlValue {
+		// Anchors and tags precede the actual scalar/collection. They do not
+		// turn a following flow collection or quoted value into plain text.
+		if s.yamlProperty {
+			if space(c) {
+				s.yamlProperty = false
+			}
+			return
+		}
+		if space(c) {
+			return
+		}
+		if c == '&' || c == '!' {
+			s.yamlProperty = true
+			return
+		}
+		s.yamlValue = false
+		if c != '"' && c != '\'' && c != '[' && c != '{' {
+			s.scalar, s.scalarIndent, s.ignoreLine = true, s.yamlIndent, true
+			return
+		}
+	}
+	if (c == '"' || c == '\'') && !wordByte(previous) && previous != '\\' {
+		s.quote = c
+		return
+	}
+	switch c {
+	case '{', '[':
+		s.flowDepth++
+	case '}', ']':
+		if s.flowDepth > 0 {
+			s.flowDepth--
+		}
+	case ':':
+		if s.flowDepth == 0 {
+			s.yamlColon = true
+			s.yamlIndent = s.entryIndent
+		}
+	}
+}
diff --git a/internal/redact/text.go b/internal/redact/text.go
new file mode 100644
index 0000000..c8c4531
--- /dev/null
+++ b/internal/redact/text.go
@@ -0,0 +1,79 @@
+// Package redact removes common labelled credentials from diagnostic copies.
+// It is deliberately not a detector for arbitrary unlabelled passwords.
+package redact
+
+import "strings"
+
+var credentialPrefixes = [...]string{"ghp_", "github_pat_", "sk-proj-"}
+
+func prefixByte(c byte, wide bool) bool { return c < 128 && wordByte(c) && (c != '-' || wide) }
+
+// Text applies the same policy as Writer, including at an incomplete EOF.
+func Text(s string) string {
+	var out strings.Builder
+	out.Grow(len(s))
+	w := NewWriter(&out)
+	_, _ = w.Write([]byte(s)) // strings.Builder cannot fail
+	_ = w.Close()
+	return out.String()
+}
+
+// Args redacts a diagnostic argv copy before quoting or truncation. Argument
+// boundaries matter: the whole argument following --token is its value even
+// when it contains whitespace or quotes. The caller's argv is never modified.
+func Args(args []string) []string {
+	out := make([]string, len(args))
+	nextSecret := false
+	scriptNext := false
+	for i, a := range args {
+		key, _, assigned := strings.Cut(a, "=")
+		switch {
+		case nextSecret:
+			out[i], nextSecret = "***", false
+		case scriptNext:
+			// A shell script contains multiple words, unlike a single
+			// argv assignment whose entire right-hand side is its value.
+			out[i], scriptNext = Text(a), false
+		case a == "-c" || strings.EqualFold(a, "/c"):
+			out[i], scriptNext = a, true
+		case assigned && secretKey(key, true):
+			out[i] = key + "=***"
+		case strings.HasPrefix(a, "-"):
+			if secretKey(key, true) {
+				out[i], nextSecret = a, true
+			} else {
+				out[i] = Text(a)
+			}
+		default:
+			out[i] = Text(a)
+		}
+	}
+	return out
+}
+
+func secretKey(s string, whole bool) bool {
+	s = strings.ToLower(s)
+	if whole {
+		switch strings.TrimLeft(s, "-") {
+		case "password", "passwd", "token", "access_token", "refresh_token", "api_key", "api-key", "apikey", "secret", "client_secret", "auth":
+			return true
+		}
+	}
+	for _, suffix := range []string{"_password", "_token", "_api_key", "_secret"} {
+		if strings.HasSuffix(s, suffix) {
+			return true
+		}
+	}
+	return false
+}
+
+func wordByte(c byte) bool {
+	return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_' || c == '-' || c >= 128
+}
+
+func space(c byte) bool    { return c == ' ' || c == '\t' || c == '\r' || c == '\n' }
+func shellEnd(c byte) bool { return space(c) || strings.IndexByte(";|&)<>\"'`", c) >= 0 }
+func flowEnd(c byte) bool  { return c == ',' || c == '}' || c == ']' }
+
+// RFC 3986 userinfo permits sub-delimiters, including apostrophes and parentheses.
+func authorityEnd(c byte) bool { return space(c) || strings.IndexByte("/?#\"<>}]", c) >= 0 }
