new file mode 100644
index 0000000..795edba
--- /dev/null
+++ b/internal/eval/cleanup.go
@@ -0,0 +1,117 @@
+package eval
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"time"
+
+	"bint/internal/fslock"
+)
+
+var errBaseBusy = errors.New("cache đang bận")
+var cleanupBaseName = regexp.MustCompile(`^(?:[0-9a-f]{40}|[0-9a-f]{64})\.git$`)
+
+// CleanupBaseEligible requires both an expired last-use time and a source commit.
+func CleanupBaseEligible(ctx context.Context, repo, name string, used, cutoff time.Time) (bool, string) {
+	if !cleanupBaseName.MatchString(name) {
+		return false, "tên cache không xác định"
+	}
+	if used.IsZero() || !used.Before(cutoff) {
+		return false, "chưa quá hạn"
+	}
+	if err := checkBaseCommit(ctx, repo, strings.TrimSuffix(name, ".git")); err != nil {
+		return false, "không chứng minh được cache tái tạo được"
+	}
+	return true, "cache quá hạn, commit nguồn còn tồn tại"
+}
+
+// TryCleanupBaseAt shares the clone/release/prune lock, using a verified bases
+// handle so replacing eval-work with a link cannot redirect even lock creation.
+// A preview never creates a directory or file.
+func TryCleanupBaseAt(bases *os.Root, name string, create bool) (func(), error) {
+	if filepath.Base(name) != name || !cleanupBaseName.MatchString(name) {
+		return nil, errors.New("tên cache không hợp lệ")
+	}
+	return acquireBaseLockAt(context.Background(), bases, name, true, create)
+}
+
+func acquireBaseLock(ctx context.Context, dir string, try, create bool) (func(), error) {
+	// Temporary fetch trees and their final base have the SAME lock.
+	dir = strings.TrimSuffix(dir, ".tmp")
+	baseDir := filepath.Dir(dir)
+	if create {
+		if err := os.MkdirAll(baseDir, 0700); err != nil {
+			return nil, err
+		}
+	}
+	r, err := os.OpenRoot(baseDir)
+	if err != nil {
+		return nil, err
+	}
+	defer r.Close()
+	return acquireBaseLockAt(ctx, r, filepath.Base(dir), try, create)
+}
+
+func acquireBaseLockAt(ctx context.Context, r *os.Root, base string, try, create bool) (func(), error) {
+	if create {
+		if err := r.Mkdir(".locks", 0700); err != nil && !os.IsExist(err) {
+			return nil, err
+		}
+	}
+	locks, err := OpenCleanupDir(r, ".locks")
+	if os.IsNotExist(err) && !create {
+		return func() {}, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	defer locks.Close()
+	name := base + ".lock"
+	flag := os.O_RDONLY
+	if create {
+		flag = os.O_RDWR | os.O_CREATE
+	}
+	if info, e := locks.Lstat(name); e == nil && !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("khoá không phải tệp thường: %s", name)
+	} else if e != nil && !os.IsNotExist(e) {
+		return nil, e
+	}
+	f, err := locks.OpenFile(name, flag, 0600)
+	if os.IsNotExist(err) && !create {
+		return func() {}, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	info, err := locks.Lstat(name)
+	opened, e := f.Stat()
+	if err != nil || e != nil || !info.Mode().IsRegular() || !os.SameFile(info, opened) {
+		f.Close()
+		return nil, errors.New("tệp khoá thay đổi")
+	}
+	for {
+		busy, err := fslock.Try(f, true)
+		if err != nil {
+			f.Close()
+			return nil, err
+		}
+		if !busy {
+			return func() { _ = f.Close() }, nil
+		}
+		if try {
+			f.Close()
+			return nil, errBaseBusy
+		}
+		select {
+		case <-ctx.Done():
+			f.Close()
+			return nil, ctx.Err()
+		case <-time.After(20 * time.Millisecond):
+		}
+	}
+}
diff --git a/internal/eval/cleanup_fs.go b/internal/eval/cleanup_fs.go
new file mode 100644
index 0000000..f21f986
--- /dev/null
+++ b/internal/eval/cleanup_fs.go
@@ -0,0 +1,175 @@
+package eval
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// OpenCleanupDir pins and verifies EVERY directory component. os.Root alone
+// confines links to the root but would still follow a link to other retained data.
+func OpenCleanupDir(root *os.Root, rel string) (*os.Root, error) {
+	if rel != "." && !filepath.IsLocal(rel) {
+		return nil, errors.New("đường dẫn ngoài state")
+	}
+	current, err := root.OpenRoot(".")
+	if err != nil {
+		return nil, err
+	}
+	for _, part := range strings.Split(filepath.Clean(rel), string(filepath.Separator)) {
+		if part == "." {
+			continue
+		}
+		info, e := current.Lstat(part)
+		if e != nil {
+			current.Close()
+			return nil, e
+		}
+		if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+			current.Close()
+			return nil, fmt.Errorf("giữ liên kết hoặc mục không phải thư mục: %s", part)
+		}
+		next, e := current.OpenRoot(part)
+		if e != nil {
+			current.Close()
+			return nil, e
+		}
+		opened, e := next.Stat(".")
+		again, e2 := current.Lstat(part)
+		current.Close()
+		if e != nil || e2 != nil || !os.SameFile(info, opened) || !os.SameFile(info, again) {
+			next.Close()
+			return nil, errors.New("thư mục thay đổi")
+		}
+		current = next
+	}
+	return current, nil
+}
+
+// CleanupTree is an immutable inventory used to reject changes before deletion.
+type CleanupTree map[string]os.FileInfo
+
+func (tree CleanupTree) Bytes() int64 {
+	var n int64
+	for _, i := range tree {
+		if i.Mode().IsRegular() {
+			n += i.Size()
+		}
+	}
+	return n
+}
+
+// InspectCleanupTree refuses links, special files and locks, including inside bases.
+func InspectCleanupTree(parent *os.Root, name string) (CleanupTree, error) {
+	tree := CleanupTree{}
+	var walk func(*os.Root, string, string) error
+	walk = func(r *os.Root, n, key string) error {
+		i, err := r.Lstat(n)
+		if err != nil {
+			return err
+		}
+		if strings.HasSuffix(n, ".lock") || strings.HasSuffix(n, ".locks") || i.Mode()&os.ModeSymlink != 0 || (!i.IsDir() && !i.Mode().IsRegular()) {
+			return errors.New("giữ liên kết, khoá hoặc tệp đặc biệt")
+		}
+		tree[key] = i
+		if !i.IsDir() {
+			return nil
+		}
+		sub, err := OpenCleanupDir(r, n)
+		if err != nil {
+			return err
+		}
+		defer sub.Close()
+		f, err := sub.Open(".")
+		if err != nil {
+			return err
+		}
+		names, err := f.Readdirnames(-1)
+		f.Close()
+		if err != nil {
+			return err
+		}
+		for _, child := range names {
+			if err := walk(sub, child, filepath.Join(key, child)); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	err := walk(parent, name, ".")
+	return tree, err
+}
+
+// SameCleanupTree checks identity, type, size and time, rather than just names.
+func SameCleanupTree(a, b CleanupTree) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for p, i := range a {
+		j := b[p]
+		if j == nil || !os.SameFile(i, j) || i.Mode() != j.Mode() || i.Size() != j.Size() || !i.ModTime().Equal(j.ModTime()) {
+			return false
+		}
+	}
+	return true
+}
+
+// RemoveCleanupTree operates through verified directory handles; it never uses
+// RemoveAll on a path whose intermediate components could have become links.
+func RemoveCleanupTree(parent *os.Root, name string, expected CleanupTree) error {
+	actual, err := InspectCleanupTree(parent, name)
+	if err != nil {
+		return err
+	}
+	if !SameCleanupTree(expected, actual) {
+		return errors.New("mục thay đổi trước khi xoá")
+	}
+	var remove func(*os.Root, string, string) error
+	remove = func(r *os.Root, n, key string) error {
+		old := expected[key]
+		i, err := r.Lstat(n)
+		if err != nil {
+			return err
+		}
+		if old == nil || !os.SameFile(old, i) || i.Mode() != old.Mode() {
+			return errors.New("danh tính mục thay đổi")
+		}
+		if i.IsDir() {
+			sub, err := OpenCleanupDir(r, n)
+			if err != nil {
+				return err
+			}
+			f, err := sub.Open(".")
+			if err != nil {
+				sub.Close()
+				return err
+			}
+			names, err := f.Readdirnames(-1)
+			f.Close()
+			if err == nil {
+				for _, child := range names {
+					if err = remove(sub, child, filepath.Join(key, child)); err != nil {
+						break
+					}
+				}
+			}
+			sub.Close()
+			if err != nil {
+				return err
+			}
+		} else if i.Size() != old.Size() || !i.ModTime().Equal(old.ModTime()) {
+			return errors.New("tệp đang thay đổi")
+		}
+		again, err := r.Lstat(n)
+		if err != nil {
+			return err
+		}
+		if !os.SameFile(i, again) || again.Mode() != i.Mode() {
+			return errors.New("mục vừa bị thay thế")
+		}
+		return r.Remove(n)
+	}
+	return remove(parent, name, ".")
+}
diff --git a/internal/eval/cleanup_sqlite.go b/internal/eval/cleanup_sqlite.go
new file mode 100644
index 0000000..237e5de
--- /dev/null
+++ b/internal/eval/cleanup_sqlite.go
@@ -0,0 +1,271 @@
+package eval
+
+import (
+	"context"
+	"crypto/sha256"
+	"database/sql"
+	"errors"
+	"fmt"
+	"io"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+	"unicode/utf8"
+
+	_ "modernc.org/sqlite"
+)
+
+type cleanupDBFile struct {
+	info os.FileInfo
+	sum  [sha256.Size]byte
+}
+
+type cleanupContextReader struct {
+	ctx    context.Context
+	reader io.Reader
+}
+
+func (r cleanupContextReader) Read(b []byte) (int, error) {
+	if err := r.ctx.Err(); err != nil {
+		return 0, err
+	}
+	return r.reader.Read(b)
+}
+
+// cleanupReadDBFile uses a pinned root and verifies the opened file before AND
+// after reading. Missing files are represented explicitly, including an absent WAL.
+func cleanupReadDBFile(ctx context.Context, root *os.Root, name string, dst io.Writer) (cleanupDBFile, error) {
+	var result cleanupDBFile
+	info, err := root.Lstat(name)
+	if os.IsNotExist(err) {
+		return result, nil
+	}
+	if err != nil {
+		return result, err
+	}
+	if !info.Mode().IsRegular() {
+		return result, fmt.Errorf("SQLite không phải tệp thường: %s", name)
+	}
+	f, err := root.Open(name)
+	if err != nil {
+		return result, err
+	}
+	defer f.Close()
+	opened, err := f.Stat()
+	if err != nil {
+		return result, err
+	}
+	if !os.SameFile(info, opened) {
+		return result, errors.New("SQLite đổi danh tính")
+	}
+	hash := sha256.New()
+	if dst == nil {
+		dst = io.Discard
+	}
+	n, err := io.Copy(io.MultiWriter(dst, hash), cleanupContextReader{ctx, io.LimitReader(f, info.Size()+1)})
+	if err != nil {
+		return result, err
+	}
+	after, err := f.Stat()
+	if err != nil {
+		return result, err
+	}
+	named, err := root.Lstat(name)
+	if err != nil {
+		return result, err
+	}
+	if n != info.Size() || !os.SameFile(info, after) || !os.SameFile(info, named) || !named.Mode().IsRegular() || info.Size() != after.Size() || !info.ModTime().Equal(after.ModTime()) || !info.ModTime().Equal(named.ModTime()) {
+		return result, errors.New("SQLite đang thay đổi; giữ dữ liệu để an toàn")
+	}
+	result.info = info
+	copy(result.sum[:], hash.Sum(nil))
+	return result, nil
+}
+
+func sameCleanupDBFile(a, b cleanupDBFile) bool {
+	if a.info == nil || b.info == nil {
+		return a.info == nil && b.info == nil
+	}
+	return os.SameFile(a.info, b.info) && a.info.Size() == b.info.Size() && a.info.ModTime().Equal(b.info.ModTime()) && a.sum == b.sum
+}
+
+// CleanupSQLiteReferences reads a private copy of the DB and its WAL. SQLite
+// never opens the surveyed files, so preview cannot create SHM/WAL, checkpoint,
+// migrate, or update them. A concurrent writer or any unreadable input fails closed.
+func CleanupSQLiteReferences(ctx context.Context, root *os.Root) ([]string, error) {
+	info, err := root.Lstat("state.sqlite")
+	if os.IsNotExist(err) {
+		for _, name := range []string{"state.sqlite-wal", "state.sqlite-shm"} {
+			if _, e := root.Lstat(name); !os.IsNotExist(e) {
+				return nil, errors.New("SQLite thiếu DB nhưng còn WAL/SHM")
+			}
+		}
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	if !info.Mode().IsRegular() {
+		return nil, errors.New("SQLite là liên kết hoặc tệp đặc biệt")
+	}
+	for _, name := range []string{"state.sqlite-shm", "state.sqlite-journal"} {
+		i, e := root.Lstat(name)
+		if os.IsNotExist(e) {
+			continue
+		}
+		if e != nil {
+			return nil, e
+		}
+		if !i.Mode().IsRegular() || name == "state.sqlite-journal" && i.Size() > 0 {
+			return nil, fmt.Errorf("SQLite có mục chưa thể đọc an toàn: %s", name)
+		}
+	}
+	// A caller may put TMPDIR inside state. Do not create survey-visible files there.
+	tempBase, err := filepath.EvalSymlinks(os.TempDir())
+	if err != nil {
+		return nil, err
+	}
+	physical, err := filepath.EvalSymlinks(root.Name())
+	if err != nil {
+		return nil, err
+	}
+	if rel, e := filepath.Rel(physical, tempBase); e == nil && (rel == "." || filepath.IsLocal(rel)) {
+		return nil, errors.New("thư mục tạm nằm trong state; không tạo snapshot ở đó")
+	}
+	tmp, err := os.MkdirTemp(tempBase, "bint-clean-sqlite-*")
+	if err != nil {
+		return nil, err
+	}
+	defer os.RemoveAll(tmp)
+	files := map[string]cleanupDBFile{}
+	for _, name := range []string{"state.sqlite", "state.sqlite-wal"} {
+		f, e := os.OpenFile(filepath.Join(tmp, name), os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+		if e != nil {
+			return nil, e
+		}
+		copied, e := cleanupReadDBFile(ctx, root, name, f)
+		closeErr := f.Close()
+		if e != nil {
+			return nil, e
+		}
+		if closeErr != nil {
+			return nil, closeErr
+		}
+		if copied.info == nil {
+			if name == "state.sqlite" {
+				return nil, errors.New("SQLite biến mất khi khảo sát")
+			}
+			if e := os.Remove(filepath.Join(tmp, name)); e != nil {
+				return nil, e
+			}
+		}
+		files[name] = copied
+	}
+	check := func() error {
+		for _, name := range []string{"state.sqlite", "state.sqlite-wal"} {
+			current, e := cleanupReadDBFile(ctx, root, name, nil)
+			if e != nil {
+				return e
+			}
+			if !sameCleanupDBFile(files[name], current) {
+				return errors.New("SQLite/WAL đang thay đổi; không đủ bằng chứng tham chiếu")
+			}
+		}
+		return nil
+	}
+	if err := check(); err != nil {
+		return nil, err
+	}
+	path := filepath.ToSlash(filepath.Join(tmp, "state.sqlite"))
+	if !strings.HasPrefix(path, "/") {
+		path = "/" + path
+	}
+	u := url.URL{Scheme: "file", Path: path}
+	db, err := sql.Open("sqlite", u.String()+"?mode=ro&_pragma=query_only(1)&_pragma=trusted_schema(0)&_pragma=busy_timeout(50)")
+	if err != nil {
+		return nil, err
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	// Logical tables include all retained text (events, artifacts, logs, proposals
+	// and future metadata); skip SQLite internals and FTS shadow storage.
+	rows, err := db.QueryContext(ctx, `SELECT name FROM pragma_table_list WHERE "schema"='main' AND type IN ('table','virtual') AND name NOT LIKE 'sqlite_%' ORDER BY name`)
+	if err != nil {
+		return nil, err
+	}
+	var tables []string
+	hasEvents, hasArtifacts := false, false
+	for rows.Next() {
+		var name string
+		if err := rows.Scan(&name); err != nil {
+			rows.Close()
+			return nil, err
+		}
+		tables = append(tables, name)
+		hasEvents = hasEvents || name == "events"
+		hasArtifacts = hasArtifacts || name == "run_artifacts"
+	}
+	err = rows.Err()
+	rows.Close()
+	if err != nil {
+		return nil, err
+	}
+	if !hasEvents || !hasArtifacts {
+		return nil, errors.New("không nhận diện được schema SQLite lưu tham chiếu")
+	}
+	var refs []string
+	var total int
+	for _, table := range tables {
+		r, err := db.QueryContext(ctx, `SELECT * FROM "`+strings.ReplaceAll(table, `"`, `""`)+`"`)
+		if err != nil {
+			return nil, err
+		}
+		columns, err := r.Columns()
+		if err != nil {
+			r.Close()
+			return nil, err
+		}
+		values := make([]any, len(columns))
+		targets := make([]any, len(columns))
+		for i := range values {
+			targets[i] = &values[i]
+		}
+		for r.Next() {
+			if err := r.Scan(targets...); err != nil {
+				r.Close()
+				return nil, err
+			}
+			for _, value := range values {
+				var text string
+				switch v := value.(type) {
+				case string:
+					text = v
+				case []byte:
+					text = string(v)
+				default:
+					continue
+				}
+				if !utf8.ValidString(text) || strings.IndexByte(text, 0) >= 0 {
+					r.Close()
+					return nil, errors.New("tham chiếu SQLite không phải văn bản")
+				}
+				total += len(text)
+				if total > 64<<20 {
+					r.Close()
+					return nil, errors.New("tham chiếu SQLite vượt giới hạn khảo sát 64 MiB")
+				}
+				refs = append(refs, text)
+			}
+		}
+		err = r.Err()
+		r.Close()
+		if err != nil {
+			return nil, err
+		}
+	}
+	if err := check(); err != nil {
+		return nil, err
+	}
+	return refs, nil
+}
diff --git a/internal/eval/cleanup_test.go b/internal/eval/cleanup_test.go
new file mode 100644
index 0000000..aa8fd25
--- /dev/null
+++ b/internal/eval/cleanup_test.go
@@ -0,0 +1,156 @@
+package eval
+
+import (
+	"context"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"bint/internal/testutil"
+)
+
+func TestCleanupLockProcess(t *testing.T) {
+	if dir := os.Getenv("BINT_TEST_CLEANUP_LOCK"); dir != "" {
+		unlock, err := acquireBaseLock(context.Background(), dir, false, true)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer unlock()
+		if err := os.WriteFile(os.Getenv("BINT_TEST_CLEANUP_READY"), []byte("ready"), 0600); err != nil {
+			t.Fatal(err)
+		}
+		for {
+			if _, err := os.Stat(os.Getenv("BINT_TEST_CLEANUP_RELEASE")); err == nil {
+				return
+			}
+			time.Sleep(10 * time.Millisecond)
+		}
+	}
+	root := t.TempDir()
+	dir := filepath.Join(root, "bases", "abc.git")
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "data"), make([]byte, 100), 0600); err != nil {
+		t.Fatal(err)
+	}
+	ready, release := filepath.Join(root, "ready"), filepath.Join(root, "release")
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestCleanupLockProcess$")
+	cmd.Env = append(os.Environ(), "BINT_TEST_CLEANUP_LOCK="+dir, "BINT_TEST_CLEANUP_READY="+ready, "BINT_TEST_CLEANUP_RELEASE="+release)
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		_ = os.WriteFile(release, nil, 0600)
+		if err := cmd.Wait(); err != nil {
+			t.Error(err)
+		}
+	}()
+	for {
+		if _, err := os.Stat(ready); err == nil {
+			break
+		}
+		if ctx.Err() != nil {
+			t.Fatal(ctx.Err())
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	unlock, err := acquireBaseLock(ctx, dir, true, false)
+	if unlock != nil {
+		unlock()
+		t.Fatal("lock acquired while held in another process")
+	}
+	if err == nil {
+		t.Fatal("expected busy")
+	}
+	n, _, err := CleanBases(root)
+	if err != nil || n != 0 {
+		t.Fatalf("clean busy: %d %v", n, err)
+	}
+	n, _, err = PruneBases(root, 1, nil)
+	if err != nil || n != 0 {
+		t.Fatalf("prune busy: %d %v", n, err)
+	}
+	waitCtx, stop := context.WithTimeout(ctx, 30*time.Millisecond)
+	defer stop()
+	if unlock, err := acquireBaseLock(waitCtx, dir, false, true); err == nil {
+		unlock()
+		t.Fatal("waiting lock ignored context")
+	}
+}
+
+func TestCleanupPinnedDirectorySurvivesParentReplacement(t *testing.T) {
+	state := t.TempDir()
+	outside := t.TempDir()
+	if err := os.Mkdir(filepath.Join(state, "parent"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(state, "parent", "file"), []byte("old"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	sentinel := filepath.Join(outside, "file")
+	if err := os.WriteFile(sentinel, []byte("sentinel"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	root, err := os.OpenRoot(state)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer root.Close()
+	pinned, err := OpenCleanupDir(root, "parent")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pinned.Close()
+	tree, err := InspectCleanupTree(pinned, "file")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Rename(filepath.Join(state, "parent"), filepath.Join(state, "moved")); err != nil {
+		t.Skipf("open directory rename not available: %v", err)
+	}
+	if err := os.Symlink(outside, filepath.Join(state, "parent")); err != nil {
+		t.Skip(err)
+	}
+	if err := RemoveCleanupTree(pinned, "file", tree); err != nil {
+		t.Fatal(err)
+	}
