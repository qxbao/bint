+}
+
+func TestCleanDoesNotFollowGroupLink(t *testing.T) {
+	ws, now := cleanFixture(t)
+	outside := t.TempDir()
+	old := now.Add(-100 * 24 * time.Hour)
+	sentinel := cleanWrite(t, outside, "20260101T120000.000Z/config.yml", "keep", old)
+	cleanWrite(t, outside, "20260102T120000.000Z/config.yml", "new", old)
