+	root := t.TempDir()
+	name := sha + ".git"
+	dir := filepath.Join(root, "bases", name)
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	old := time.Now().Add(-100 * 24 * time.Hour)
+	if err := os.Chtimes(dir, old, old); err != nil {
+		t.Fatal(err)
+	}
+	eligible, reason := CleanupBaseEligible(context.Background(), repo, name, old, time.Now().Add(-90*24*time.Hour))
+	if !eligible {
+		t.Fatal(reason)
+	}
+	eligible, _ = CleanupBaseEligible(context.Background(), repo, "0000000000000000000000000000000000000000.git", old, time.Now())
+	if eligible {
+		t.Fatal("missing source commit selected")
+	}
+	eligible, _ = CleanupBaseEligible(context.Background(), repo, name, old, old)
+	if eligible {
+		t.Fatal("exact cutoff selected")
+	}
+}
