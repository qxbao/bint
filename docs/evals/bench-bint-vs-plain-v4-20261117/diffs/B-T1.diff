+		t.Fatal(err)
+	}
+}
diff --git a/internal/app/clean_svc.go b/internal/app/clean_svc.go
new file mode 100644
index 0000000..280b796
--- /dev/null
+++ b/internal/app/clean_svc.go
@@ -0,0 +1,223 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"time"
+
+	"bint/internal/eval"
+	"bint/internal/state"
+)
+
+// CleanOptions only permits deletion when Apply is explicitly set.
+type CleanOptions struct {
+	Dir           string
+	Apply         bool `flag:"apply"`
+	DryRun        bool `flag:"dry-run"`
+	OlderThanDays int  `flag:"older-than"`
+}
+
+type CleanItem struct {
+	Path           string
+	Kind           string
+	Reason         string
+	EstimatedBytes int64
+	Outcome        string // keep, selected, removed, error
+	parts          []cleanPart
+}
+type cleanPart struct {
+	rel  string
+	tree eval.CleanupTree
+}
+type CleanResult struct {
+	Root                        string
+	Items                       []CleanItem
+	Selected, Removed           int
+	SelectedBytes, RemovedBytes int64
+}
+
+// Clean never opens SQLite, ingests spool, or synchronizes task documents.
+func Clean(ctx context.Context, opt CleanOptions) (CleanResult, error) {
+	ws, err := OpenWorkspace(ctx, opt.Dir, true)
+	if err != nil {
+		return CleanResult{}, err
+	}
+	info, err := ws.Paths.ReadRepoInfo()
+	if err != nil {
+		return CleanResult{}, err
+	}
+	if state.NormalizePath(info.CommonDir) != state.NormalizePath(ws.Repo.CommonDir) {
+		return CleanResult{}, state.ErrForeignState
+	}
+	return cleanWorkspace(ctx, ws, opt, time.Now().UTC(), nil)
+}
+
+func cleanWorkspace(ctx context.Context, ws *Workspace, opt CleanOptions, now time.Time, beforeApply func()) (CleanResult, error) {
+	result := CleanResult{Root: ws.Paths.Root}
+	if opt.Apply && opt.DryRun {
+		return result, fmt.Errorf("apply và dry-run không dùng cùng nhau")
+	}
+	days := opt.OlderThanDays
+	if days == 0 {
+		days = 90
+	}
+	if days < 1 || days > 106751 {
+		return result, fmt.Errorf("thời hạn phải từ 1 đến 106751 ngày")
+	}
+	// Resolve a legitimate state alias once. Every descendant is opened separately
+	// and checked without following links by OpenCleanupDir.
+	physical, err := filepath.EvalSymlinks(ws.Paths.Root)
+	if err != nil {
+		return result, err
+	}
+	root, err := os.OpenRoot(physical)
+	if err != nil {
+		return result, err
+	}
+	defer root.Close()
+	cutoff := now.Add(-time.Duration(days) * 24 * time.Hour)
+	items, err := collectClean(ctx, ws, root, cutoff, true)
+	if err != nil {
+		return result, err
+	}
+	result.Items = items
+	for _, item := range items {
+		if item.Outcome == "selected" {
+			result.Selected++
+			result.SelectedBytes += item.EstimatedBytes
+		}
+	}
+	if !opt.Apply {
+		return result, nil
+	}
+	if beforeApply != nil {
+		beforeApply()
+	}
+	var failures []error
+	for n := range result.Items {
+		item := &result.Items[n]
+		if item.Outcome != "selected" {
+			continue
+		}
+		if err := ctx.Err(); err != nil {
+			return result, errors.Join(append(failures, err)...)
+		}
+		unlock := func() {}
+		if item.Kind == "cache" {
+			parent, e := eval.OpenCleanupDir(root, filepath.FromSlash("eval-work/bases"))
+			if e != nil {
+				item.Outcome = "keep"
+				item.Reason = e.Error()
+				continue
+			}
+			unlock, err = eval.TryCleanupBaseAt(parent, filepath.Base(item.parts[0].rel), true)
+			parent.Close()
+			if err != nil {
+				item.Outcome = "keep"
+				item.Reason = err.Error()
+				continue
+			}
+		}
+		func() {
+			defer unlock()
+			// Re-read retained evidence and all selection conditions immediately before
+			// EACH item. Never consume a plan saved by an earlier preview invocation.
+			fresh, e := collectClean(ctx, ws, root, cutoff, false)
+			if e != nil {
+				item.Outcome = "error"
+				item.Reason = e.Error()
+				failures = append(failures, e)
+				return
+			}
+			var match *CleanItem
+			for i := range fresh {
+				if fresh[i].Path == item.Path && fresh[i].Kind == item.Kind {
+					match = &fresh[i]
+					break
+				}
+			}
+			if match == nil || match.Outcome != "selected" || !sameCleanParts(item.parts, match.parts) {
+				item.Outcome = "keep"
+				item.Reason = "điều kiện hoặc danh tính đã thay đổi"
+				if match != nil && match.Outcome != "selected" {
+					item.Reason = match.Reason
+				}
+				return
+			}
+			// Verify all members of a trace pair before removing either member.
+			parents := make([]*os.Root, 0, len(item.parts))
+			defer func() {
+				for _, p := range parents {
+					p.Close()
+				}
+			}()
+			for _, part := range item.parts {
+				parent, e := eval.OpenCleanupDir(root, filepath.Dir(part.rel))
+				if e != nil {
+					item.Outcome = "keep"
+					item.Reason = e.Error()
+					return
+				}
+				parents = append(parents, parent)
+				tree, e := eval.InspectCleanupTree(parent, filepath.Base(part.rel))
+				if e != nil || !eval.SameCleanupTree(part.tree, tree) {
+					item.Outcome = "keep"
+					item.Reason = "mục đang thay đổi hoặc có liên kết"
+					return
+				}
+			}
+			for i, part := range item.parts {
+				if e := eval.RemoveCleanupTree(parents[i], filepath.Base(part.rel), part.tree); e != nil {
+					item.Outcome = "error"
+					item.Reason = e.Error()
+					failures = append(failures, fmt.Errorf("%s: %w", item.Path, e))
+					return
+				}
+			}
+			item.Outcome = "removed"
+			result.Removed++
+			result.RemovedBytes += item.EstimatedBytes
+			if item.Kind == "backup" {
+				cleanEmptyBackupDirs(root, filepath.Dir(item.parts[0].rel))
+			}
+		}()
+	}
+	return result, errors.Join(failures...)
+}
+
+func cleanEmptyBackupDirs(root *os.Root, dir string) {
+	for dir != "backups" && dir != "." {
+		parent, err := eval.OpenCleanupDir(root, filepath.Dir(dir))
+		if err != nil {
+			return
+		}
+		// Remove only empty directories, never recursive removal of a snapshot.
+		info, err := parent.Lstat(filepath.Base(dir))
+		if err == nil && info.IsDir() && info.Mode()&os.ModeSymlink == 0 {
+			err = parent.Remove(filepath.Base(dir))
+		} else {
+			parent.Close()
+			return
+		}
+		parent.Close()
+		if err != nil {
+			return
+		}
+		dir = filepath.Dir(dir)
+	}
+}
+
+func sameCleanParts(a, b []cleanPart) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i].rel != b[i].rel || !eval.SameCleanupTree(a[i].tree, b[i].tree) {
+			return false
+		}
+	}
+	return true
+}
