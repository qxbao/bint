+func TestCleanSQLiteInvalidDBKeepsCandidates(t *testing.T) {
+	ws, now, target := cleanReviewBackups(t)
+	cleanWrite(t, ws.Paths.Root, "state.sqlite", "not a database", now)
+	before := cleanSnapshot(t, ws.Paths.Root)
+	r, err := cleanWorkspace(context.Background(), ws, CleanOptions{Apply: true}, now, nil)
+	if err != nil || r.Removed != 0 {
+		t.Fatalf("invalid DB: %d %v", r.Removed, err)
