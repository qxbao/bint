@@ -0,0 +1,58 @@
+package cli
+
+import (
+	"fmt"
+	"text/tabwriter"
+
+	"github.com/spf13/cobra"
+
+	"bint/internal/app"
+)
+
+func newCleanCmd(stdio IO) *cobra.Command {
+	var opt app.CleanOptions
+	cmd := &cobra.Command{
+		Use: "clean", Short: "Xem trước hoặc dọn dữ liệu state cũ của repository hiện tại",
+		Long: "Mặc định chỉ xem trước, giữ 90 ngày. Chỉ --apply mới xoá vĩnh viễn cache tái tạo được, backup dư và cặp hook trace hoàn tất.",
+		Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, args []string) error {
+			if opt.OlderThanDays < 1 || opt.OlderThanDays > 106751 {
+				return usageError{fmt.Errorf("--older-than phải là số ngày nguyên dương, tối đa 106751")}
+			}
+			if opt.Apply && opt.DryRun {
+				return usageError{fmt.Errorf("--apply và --dry-run không dùng cùng nhau")}
+			}
+			dir, err := cwd()
+			if err != nil {
+				return err
+			}
+			opt.Dir = dir
+			result, cleanErr := app.Clean(cmd.Context(), opt)
+			if result.Root != "" {
+				fmt.Fprintf(stdio.Out, "State: %s\n", result.Root)
+				if !opt.Apply {
+					fmt.Fprintln(stdio.Out, "Xem trước — chưa xoá dữ liệu.")
+				}
+				w := tabwriter.NewWriter(stdio.Out, 0, 4, 2, ' ', 0)
+				fmt.Fprintln(w, "Kết quả\tNhóm\tƯớc tính\tĐường dẫn\tLý do")
+				labels := map[string]string{"keep": "giữ", "selected": "chọn", "removed": "đã dọn", "error": "lỗi"}
+				for _, item := range result.Items {
+					fmt.Fprintf(w, "%s\t%s\t%d byte\t%q\t%s\n", labels[item.Outcome], item.Kind, item.EstimatedBytes, item.Path, item.Reason)
+				}
+				_ = w.Flush()
+				fmt.Fprintf(stdio.Out, "Dự kiến: %d mục, %d byte (ước tính logic).\n", result.Selected, result.SelectedBytes)
+				if opt.Apply {
+					fmt.Fprintf(stdio.Out, "Đã dọn: %d mục, %d byte (ước tính logic).\n", result.Removed, result.RemovedBytes)
+				} else {
+					fmt.Fprintln(stdio.Out, "Sau khi xem danh sách, chạy bint clean --apply với cùng --older-than để dọn.")
+				}
+				fmt.Fprintln(stdio.Out, "Chưa dọn: tác vụ, lịch sử/log workflow và eval, SQLite/WAL/SHM, spool, worktree/nhánh Git, tmp, generated/metadata, subagent/binding MCP và profile iso. Tệp khoá và liên kết luôn được giữ.")
+			}
+			return cleanErr
+		},
+	}
+	cmd.Flags().BoolVar(&opt.Apply, "apply", false, "Xoá vĩnh viễn các mục được chọn sau khi kiểm tra lại")
+	cmd.Flags().BoolVar(&opt.DryRun, "dry-run", false, "Chỉ xem trước (mặc định)")
+	cmd.Flags().IntVar(&opt.OlderThanDays, "older-than", 90, "Giữ dữ liệu ít nhất số ngày này (số nguyên dương)")
+	return cmd
+}
