+
+func TestCleanMixedGroupAndConcreteReference(t *testing.T) {
+	ws, now, _ := cleanReviewBackups(t)
+	cleanWrite(t, ws.Paths.Root, "runtime/logs/retained.log", ws.Paths.Backups+"/ must be retained for restoration. Example of a newer backup: backups/20260802T120000.000Z/config.yml", now)
+	before := cleanSnapshot(t, ws.Paths.Root)
+	for _, apply := range []bool{false, true} {
+		result, err := cleanWorkspace(context.Background(), ws, CleanOptions{Apply: apply}, now, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if result.Selected != 0 || result.Removed != 0 {
+			t.Fatalf("group reference lost: selected=%d removed=%d", result.Selected, result.Removed)
+		}
+		if !reflect.DeepEqual(before, cleanSnapshot(t, ws.Paths.Root)) {
+			t.Fatal("changed data referenced by its group")
+		}
+	}
+}
+
+func TestCleanReferenceOccurrences(t *testing.T) {
+	for _, group := range []struct{ kind, root, target, other string }{
+		{"backup", "backups", "backups/20260801T120000.000Z/config.yml", "backups/20260802T120000.000Z/config.yml"},
+		{"cache", "eval-work/bases", "eval-work/bases/" + strings.Repeat("a", 40) + ".git", "eval-work/bases/" + strings.Repeat("b", 40) + ".git"},
+		{"hook-trace", "runtime/hook-trace", "runtime/hook-trace/20260801T120000.000000000Z-codex-tool.in", "runtime/hook-trace/20260802T120000.000000000Z-codex-tool.in"},
+	} {
+		t.Run(group.kind, func(t *testing.T) {
+			ws, _ := cleanFixture(t)
+			item := CleanItem{Kind: group.kind, parts: []cleanPart{{rel: filepath.FromSlash(group.target)}}}
+			for _, tc := range []struct {
+				name, text string
+				want       bool
+			}{
+				{"unrelated_concrete", group.other, false},
+				{"multiple_concrete", group.other + "\n" + group.other, false},
+				{"target", group.target, true},
+				{"group_only", group.root, true},
+				{"group_before_concrete", group.root + "/ is retained. Example: " + group.other, true},
+				{"group_after_concrete", group.other + "; keep " + group.root + "/", true},
+				{"absolute_group", filepath.ToSlash(filepath.Join(ws.Paths.Root, filepath.FromSlash(group.root))) + "/ is retained. Example: " + group.other, true},
+				{"bare_group", group.other + "\nretain `" + group.root + "`", true},
+				{"json_array", `["` + group.other + `","` + group.root + `/"]`, true},
+				{"unresolved_path", group.root + "/unknown; example: " + group.other, true},
+			} {
+				t.Run(tc.name, func(t *testing.T) {
+					if got := cleanReferenced(ws, item, []string{tc.text}); got != tc.want {
+						t.Fatalf("referenced=%v want %v for %q", got, tc.want, tc.text)
+					}
+				})
+			}
+		})
+	}
+}
+
+func TestCleanRetainedAliasReference(t *testing.T) {
+	for _, kind := range []string{"file", "snapshot", "group", "state", "quoted_snapshot", "quoted_group", "sibling", "prefix_sibling"} {
+		t.Run(kind, func(t *testing.T) {
+			ws, now, target := cleanReviewBackups(t)
+			destination := target
+			protected := true
+			switch kind {
+			case "snapshot", "quoted_snapshot":
+				destination = filepath.Dir(target)
+			case "group", "quoted_group":
+				destination = ws.Paths.Backups
+			case "state":
+				destination = ws.Paths.Root
+			case "sibling":
+				destination = filepath.Join(ws.Paths.Backups, "20260802T120000.000Z", "config.yml")
+				protected = false
+			case "prefix_sibling":
+				destination = filepath.Dir(target) + "-other"
+				if err := os.Mkdir(destination, 0700); err != nil {
+					t.Fatal(err)
+				}
+				protected = false
+			}
+			alias := filepath.Join(t.TempDir(), "restore-source")
+			if strings.HasPrefix(kind, "quoted_") {
+				alias = filepath.Join(t.TempDir(), "restore source")
+			}
+			if err := os.Symlink(destination, alias); err != nil {
+				t.Skipf("symlink unavailable: %v", err)
+			}
+			reference := filepath.ToSlash(alias)
+			if strings.HasPrefix(kind, "quoted_") {
+				reference = strconv.Quote(reference)
+			}
+			cleanWrite(t, ws.Paths.Root, "runtime/logs/retained.log", "Restore retained data from "+reference, now)
+			before := cleanSnapshot(t, ws.Paths.Root)
+			preview, err := cleanWorkspace(context.Background(), ws, CleanOptions{}, now, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := 1
+			if protected {
+				want = 0
+			}
+			if preview.Selected != want {
+				t.Fatalf("selected=%d want %d for alias to %s", preview.Selected, want, kind)
+			}
+			if !reflect.DeepEqual(before, cleanSnapshot(t, ws.Paths.Root)) {
+				t.Fatal("preview modified state")
+			}
+			for run := 0; run < 2; run++ {
+				result, err := cleanWorkspace(context.Background(), ws, CleanOptions{Apply: true}, now, nil)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if protected {
+					if result.Removed != 0 || !reflect.DeepEqual(before, cleanSnapshot(t, ws.Paths.Root)) {
+						t.Fatal("modified data referenced by alias")
+					}
+				} else if run == 0 && result.Removed != 1 {
+					t.Fatalf("unrelated alias prevented cleanup: %+v", result)
+				} else if run > 0 && result.Removed != 0 {
+					t.Fatal("second cleanup removed more data")
+				}
+			}
+			if got, err := os.Readlink(alias); err != nil || got != destination {
+				t.Fatal("modified external alias")
+			}
+		})
+	}
+}
+
+func TestCleanCacheAliasReferences(t *testing.T) {
+	for _, kind := range []string{"base", "member_directory", "member_file", "group"} {
+		t.Run(kind, func(t *testing.T) {
+			testutil.Isolate(t)
+			ws, now := cleanFixture(t)
+			ws.Repo.Toplevel = testutil.NewRepo(t, nil)
+			name := testutil.Git(t, ws.Repo.Toplevel, "rev-parse", "HEAD") + ".git"
+			old := now.Add(-100 * 24 * time.Hour)
+			cleanCompleteBase(t, ws, name, old)
+			member := cleanWrite(t, ws.Paths.Root, "eval-work/bases/"+name+"/objects/retained-object", "retained data", old)
+			destination := filepath.Join(ws.Paths.EvalWork, "bases", name)
+			switch kind {
+			case "member_directory":
+				destination = filepath.Dir(member)
+			case "member_file":
+				destination = member
+			case "group":
+				destination = filepath.Dir(destination)
+			}
+			alias := filepath.Join(t.TempDir(), "retained-source")
+			if err := os.Symlink(destination, alias); err != nil {
+				t.Skipf("symlink unavailable: %v", err)
+			}
+			cleanWrite(t, ws.Paths.Root, "runtime/logs/retained.log", filepath.ToSlash(alias), now)
+			before := cleanSnapshot(t, ws.Paths.Root)
+			for _, apply := range []bool{false, true} {
+				r, err := cleanWorkspace(context.Background(), ws, CleanOptions{Apply: apply}, now, nil)
+				if err != nil || r.Selected != 0 || r.Removed != 0 {
+					t.Fatalf("cache reference through %s: selected=%d removed=%d err=%v", kind, r.Selected, r.Removed, err)
+				}
+				if !reflect.DeepEqual(before, cleanSnapshot(t, ws.Paths.Root)) {
+					t.Fatal("modified cache referenced through alias")
+				}
+			}
+		})
+	}
+}
+
+func TestCleanInitializedWorkspaceCanSelectUnusedBackup(t *testing.T) {
+	testutil.Isolate(t)
+	repo := testutil.NewRepo(t, nil)
+	mustInit(t, InitOptions{Dir: repo, Hooks: no()})
+	ws, err := OpenWorkspace(context.Background(), repo, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now().UTC()
+	old := now.Add(-100 * 24 * time.Hour)
+	target := cleanWrite(t, ws.Paths.Root, "backups/20260101T120000.000Z/config.yml", "old", old)
+	cleanWrite(t, ws.Paths.Root, "backups/20260102T120000.000Z/config.yml", "new", old)
+	r, err := cleanWorkspace(context.Background(), ws, CleanOptions{}, now, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.Selected != 1 {
+		t.Fatalf("selected=%d, want unused backup", r.Selected)
+	}
+	if _, err := os.Stat(target); err != nil {
+		t.Fatal("preview removed unused backup")
+	}
+}
