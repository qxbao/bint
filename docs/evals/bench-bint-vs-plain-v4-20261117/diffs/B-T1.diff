+}
+
+func TestCleanSQLiteWALAndEventReferencesDoNotMutateSource(t *testing.T) {
+	ws, now, target := cleanReviewBackups(t)
+	ctx := context.Background()
+	db, err := store.Open(ctx, ws.Paths.DB)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	if _, err := db.DB.Exec(`PRAGMA wal_autocheckpoint=0`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.DB.Exec(`INSERT INTO knowledge_fts(item_id,title,body) VALUES('cleanup-test','retained index','unrelated text')`); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(ws.Paths.Spool, 0700); err != nil {
+		t.Fatal(err)
+	}
+	_, err = spool.Write(ws.Paths.Spool, spool.Event{EventID: "clean-wal-ref", Type: spool.FileRead, Source: "hook:claude", Timestamp: now, Harness: "claude", SessionID: "clean-wal-session", Payload: map[string]any{"paths": []string{target}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := runlog.Ingest(ctx, db, ws.Paths.Spool, now, 0); err != nil {
+		t.Fatal(err)
+	}
+	if i, err := os.Stat(ws.Paths.DB + "-wal"); err != nil || i.Size() == 0 {
+		t.Fatalf("need active WAL: %v", err)
+	}
+	check := func(selected int) {
+		t.Helper()
+		before := cleanSnapshot(t, ws.Paths.Root)
+		r, err := cleanWorkspace(ctx, ws, CleanOptions{}, now, nil)
+		if err != nil || r.Selected != selected {
+			t.Fatalf("preview selected=%d want %d: %v", r.Selected, selected, err)
+		}
+		if !reflect.DeepEqual(before, cleanSnapshot(t, ws.Paths.Root)) {
+			t.Fatal("preview modified source SQLite/WAL/SHM or state")
+		}
+	}
+	check(0)
+	// With the derived artifact removed, the original event payload must still
+	// protect the backup, including while the event exists only in WAL pages.
+	if _, err := db.DB.Exec(`DELETE FROM run_artifacts WHERE path=?`, target); err != nil {
+		t.Fatal(err)
+	}
+	check(0)
+	if _, err := db.DB.Exec(`DELETE FROM events WHERE event_id='clean-wal-ref'`); err != nil {
+		t.Fatal(err)
+	}
