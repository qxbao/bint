new file mode 100644
index 0000000..14ec2ed
--- /dev/null
+++ b/internal/app/clean_collect.go
@@ -0,0 +1,340 @@
+package app
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+
+	"bint/internal/eval"
+)
+
+const cleanBackupTime = "20060102T150405.000Z"
+const cleanTraceTime = "20060102T150405.000000000Z"
+
+var cleanTraceName = regexp.MustCompile(`^(\d{8}T\d{6}\.\d{9}Z)-[A-Za-z0-9_-]+\.(in|out)$`)
+
+func cleanReadDir(root *os.Root, rel string) ([]os.DirEntry, error) {
+	r, err := eval.OpenCleanupDir(root, filepath.FromSlash(rel))
+	if err != nil {
+		return nil, err
+	}
+	defer r.Close()
+	f, err := r.Open(".")
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	entries, err := f.ReadDir(-1)
+	sort.Slice(entries, func(i, j int) bool { return entries[i].Name() < entries[j].Name() })
+	return entries, err
+}
+
+func cleanInspect(root *os.Root, rel string) (cleanPart, error) {
+	rel = filepath.FromSlash(rel)
+	part := cleanPart{rel: rel}
+	parent, err := eval.OpenCleanupDir(root, filepath.Dir(rel))
+	if err != nil {
+		return part, err
+	}
+	defer parent.Close()
+	part.tree, err = eval.InspectCleanupTree(parent, filepath.Base(rel))
+	return part, err
+}
+
+func cleanRead(root *os.Root, rel string) ([]byte, error) {
+	parent, err := eval.OpenCleanupDir(root, filepath.Dir(rel))
+	if err != nil {
+		return nil, err
+	}
+	defer parent.Close()
+	name := filepath.Base(rel)
+	info, err := parent.Lstat(name)
+	if err != nil {
+		return nil, err
+	}
+	if !info.Mode().IsRegular() || info.Size() > 8<<20 {
+		return nil, fmt.Errorf("tệp không thể đọc an toàn: %s", rel)
+	}
+	f, err := parent.Open(name)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	opened, err := f.Stat()
+	if err != nil {
+		return nil, err
+	}
+	if !os.SameFile(info, opened) {
+		return nil, fmt.Errorf("tệp đổi danh tính: %s", rel)
+	}
+	// A bounded read also covers files growing while being read.
+	return cleanReadOpened(f, info)
+}
+
+func cleanReadOpened(f *os.File, info os.FileInfo) ([]byte, error) {
+	b, err := io.ReadAll(io.LimitReader(f, (8<<20)+1))
+	if err != nil {
+		return nil, err
+	}
+	after, err := f.Stat()
+	if err != nil {
+		return nil, err
+	}
+	if len(b) > 8<<20 || !os.SameFile(info, after) || info.Size() != after.Size() || !info.ModTime().Equal(after.ModTime()) {
+		return nil, fmt.Errorf("tệp tham chiếu đang thay đổi hoặc quá lớn")
+	}
+	return b, nil
+}
+
+func collectClean(ctx context.Context, ws *Workspace, root *os.Root, cutoff time.Time, checkBusy bool) ([]CleanItem, error) {
+	var out []CleanItem
+	keep := func(rel, kind, reason string) {
+		part, _ := cleanInspect(root, rel)
+		out = append(out, CleanItem{Path: filepath.Join(ws.Paths.Root, filepath.FromSlash(rel)), Kind: kind, Reason: reason, Outcome: "keep", EstimatedBytes: part.tree.Bytes()})
+	}
+	add := func(rel, kind, reason string, parts []cleanPart, selected bool) {
+		item := CleanItem{Path: filepath.Join(ws.Paths.Root, filepath.FromSlash(rel)), Kind: kind, Reason: reason, Outcome: "keep", parts: parts}
+		for _, p := range parts {
+			item.EstimatedBytes += p.tree.Bytes()
+		}
+		if selected {
+			item.Outcome = "selected"
+		}
+		out = append(out, item)
+	}
+	// Only exact SHA cache names can be newly selected by clean.
+	bases, err := cleanReadDir(root, "eval-work/bases")
+	if err != nil && !os.IsNotExist(err) {
+		keep("eval-work/bases", "cache", err.Error())
+	}
+	for _, entry := range bases {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		rel := "eval-work/bases/" + entry.Name()
+		if entry.Name() == ".locks" {
+			keep(rel, "cache", "tệp khoá được giữ vĩnh viễn")
+			continue
+		}
+		part, e := cleanInspect(root, rel)
+		if e != nil {
+			keep(rel, "cache", e.Error())
+			continue
+		}
+		i := part.tree["."]
+		ok, reason := eval.CleanupBaseEligible(ctx, ws.Repo.Toplevel, entry.Name(), i.ModTime(), cutoff)
+		if !i.IsDir() {
+			ok = false
+			reason = "cache không phải thư mục"
+		}
+		if ok && !cleanBaseComplete(root, rel, entry.Name()) {
+			ok = false
+			reason = "không nhận diện được cache Bint hoàn tất"
+		}
+		if ok && checkBusy {
+			parent, e := eval.OpenCleanupDir(root, filepath.FromSlash("eval-work/bases"))
+			if e != nil {
+				ok = false
+				reason = e.Error()
+			} else {
+				unlock, e := eval.TryCleanupBaseAt(parent, entry.Name(), false)
+				parent.Close()
+				if e != nil {
+					ok = false
+					reason = e.Error()
+				} else {
+					unlock()
+				}
+			}
+		}
+		add(rel, "cache", reason, []cleanPart{part}, ok)
+	}
+	snapshots, err := cleanReadDir(root, "backups")
+	if err != nil && !os.IsNotExist(err) {
+		keep("backups", "backup", err.Error())
+	}
+	type backup struct {
+		rel, key string
+		stamp    time.Time
+		part     cleanPart
+		err      error
+	}
+	var backups []backup
+	newest := map[string]time.Time{}
+	for _, entry := range snapshots {
+		rel := "backups/" + entry.Name()
+		stamp, e := time.Parse(cleanBackupTime, entry.Name())
+		if e != nil || stamp.Format(cleanBackupTime) != entry.Name() || !entry.IsDir() {
+			keep(rel, "backup", "snapshot không đúng định dạng Bint")
+			continue
+		}
+		// Walk using verified handles, never filepath.Walk through a replaced parent.
+		var walk func(string, string) error
+		walk = func(dir, key string) error {
+			entries, e := cleanReadDir(root, dir)
+			if e != nil {
+				return e
+			}
+			for _, child := range entries {
+				r := dir + "/" + child.Name()
+				k := filepath.Join(key, child.Name())
+				if child.IsDir() {
+					if e := walk(r, k); e != nil {
+						keep(r, "backup", e.Error())
+					}
+					continue
+				}
+				part, e := cleanInspect(root, r)
+				backups = append(backups, backup{r, k, stamp, part, e})
+				// Only a verified regular backup can replace the last usable copy.
+				// A broken link or special file is retained but is not a backup.
+				if e == nil && part.tree["."].Mode().IsRegular() && stamp.After(newest[k]) {
+					newest[k] = stamp
+				}
+			}
+			return nil
+		}
+		if e := walk(rel, ""); e != nil {
+			keep(rel, "backup", e.Error())
+		}
+	}
+	for _, b := range backups {
+		if b.err != nil {
+			keep(b.rel, "backup", b.err.Error())
+			continue
+		}
+		age := b.stamp
+		if mt := b.part.tree["."].ModTime(); mt.After(age) {
+			age = mt
+		}
+		ok := age.Before(cutoff) && b.stamp.Before(newest[b.key])
+		reason := "backup dư quá hạn"
+		if !b.stamp.Before(newest[b.key]) {
+			reason = "backup mới nhất của tệp gốc"
+		} else if !age.Before(cutoff) {
+			reason = "chưa quá hạn"
+		}
+		add(b.rel, "backup", reason, []cleanPart{b.part}, ok)
+	}
+	traces, err := cleanReadDir(root, "runtime/hook-trace")
+	if err != nil && !os.IsNotExist(err) {
+		keep("runtime/hook-trace", "hook-trace", err.Error())
+	}
+	seen := map[string]bool{}
+	for _, entry := range traces {
+		rel := "runtime/hook-trace/" + entry.Name()
+		m := cleanTraceName.FindStringSubmatch(entry.Name())
+		if m == nil {
+			keep(rel, "hook-trace", "tên trace không xác định")
+			continue
+		}
+		stem := strings.TrimSuffix(rel, filepath.Ext(rel))
+		if seen[stem] {
+			continue
+		}
+		seen[stem] = true
+		stamp, e := time.Parse(cleanTraceTime, m[1])
+		if e != nil || stamp.Format(cleanTraceTime) != m[1] {
+			keep(rel, "hook-trace", "thời điểm trace không hợp lệ")
+			continue
+		}
+		in, e1 := cleanInspect(root, stem+".in")
+		outPart, e2 := cleanInspect(root, stem+".out")
+		if e1 != nil || e2 != nil {
+			keep(rel, "hook-trace", "cặp trace thiếu hoặc có liên kết")
+			continue
+		}
+		if !in.tree["."].Mode().IsRegular() || !outPart.tree["."].Mode().IsRegular() {
+			keep(rel, "hook-trace", "cặp trace phải gồm hai tệp thường")
+			continue
+		}
+		data, e := cleanRead(root, filepath.FromSlash(stem+".out"))
+		if e != nil || !cleanTraceComplete(data) {
+			add(stem+".in", "hook-trace", "trace chưa có kết quả hoàn tất hợp lệ", []cleanPart{in, outPart}, false)
+			continue
+		}
+		age := stamp
+		for _, p := range []cleanPart{in, outPart} {
+			if mt := p.tree["."].ModTime(); mt.After(age) {
+				age = mt
+			}
+		}
+		ok := age.Before(cutoff)
+		reason := "cặp trace hoàn tất quá hạn"
+		if !ok {
+			reason = "chưa quá hạn"
+		}
+		add(stem+".in", "hook-trace", reason, []cleanPart{in, outPart}, ok)
+	}
+	refs, problem := cleanReferences(ctx, ws, root)
+	for i := range out {
+		item := &out[i]
+		if item.Outcome != "selected" {
+			continue
+		}
+		if problem != "" {
+			item.Outcome = "keep"
+			item.Reason = problem
+			continue
+		}
+		if cleanReferenced(ws, *item, refs) {
+			item.Outcome = "keep"
+			item.Reason = "còn được tài liệu hoặc bằng chứng giữ tham chiếu"
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Path < out[j].Path })
+	return out, ctx.Err()
+}
+
+// A SHA-shaped directory is insufficient proof of ownership. Completed Bint
+// caches have a bare object directory and HEAD pointing at this exact eval-base.
+func cleanBaseComplete(root *os.Root, rel, name string) bool {
+	data, err := cleanRead(root, filepath.FromSlash(rel+"/HEAD"))
+	if err != nil || strings.TrimSpace(string(data)) != "ref: refs/heads/eval-base" {
+		return false
+	}
+	sha := strings.TrimSuffix(name, ".git")
+	data, err = cleanRead(root, filepath.FromSlash(rel+"/refs/heads/eval-base"))
+	if err != nil {
+		data, err = cleanRead(root, filepath.FromSlash(rel+"/packed-refs"))
+		if err != nil {
+			return false
+		}
+		found := false
+		for _, line := range strings.Split(string(data), "\n") {
+			if line == sha+" refs/heads/eval-base" {
+				found = true
+				break
+			}
+		}
+		if !found {
+			return false
+		}
+	} else if strings.TrimSpace(string(data)) != sha {
+		return false
+	}
+	objects, err := eval.OpenCleanupDir(root, filepath.FromSlash(rel+"/objects"))
+	if err != nil {
+		return false
+	}
+	objects.Close()
+	return true
+}
+
+func cleanTraceComplete(data []byte) bool {
+	var record struct {
+		Output    *string `json:"output"`
+		Duration  *int64  `json:"duration_ms"`
+		Skipped   *string `json:"skipped"`
+		Written   *bool   `json:"written"`
+		SpoolFile *string `json:"spool_file"`
+	}
+	return json.Unmarshal(data, &record) == nil && record.Output != nil && record.Duration != nil && *record.Duration >= 0 && record.Skipped != nil && record.Written != nil && record.SpoolFile != nil
+}
diff --git a/internal/app/clean_refs.go b/internal/app/clean_refs.go
new file mode 100644
index 0000000..7ad79a0
--- /dev/null
+++ b/internal/app/clean_refs.go
@@ -0,0 +1,192 @@
+package app
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"slices"
+	"strings"
+	"unicode/utf8"
+
+	"gopkg.in/yaml.v3"
+
+	"bint/internal/eval"
+	"bint/internal/state"
+	"bint/internal/task"
+)
+
+// Scan retained text and an isolated SQLite snapshot, without task ledger sync.
+// Unreadable, opaque or changing evidence fails closed for this invocation.
+func cleanReferences(ctx context.Context, ws *Workspace, root *os.Root) ([]string, string) {
+	var texts []string
+	var scan func(*os.Root, string, bool) error
+	scan = func(r *os.Root, dir string, inState bool) error {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		entries, err := cleanReadDir(r, dir)
+		if os.IsNotExist(err) {
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+		for _, entry := range entries {
+			if err := ctx.Err(); err != nil {
+				return err
+			}
+			rel := filepath.Join(dir, entry.Name())
+			slash := filepath.ToSlash(rel)
+			if inState && (slash == "backups" || slash == "eval-work/bases") {
+				continue
+			}
+			// SQLite's binary files are read through a private snapshot below.
+			if inState && (slash == "state.sqlite" || slash == "state.sqlite-wal" || slash == "state.sqlite-shm") {
+				continue
+			}
+			if entry.Name() == ".git" || strings.HasSuffix(entry.Name(), ".lock") || entry.Name() == ".locks" {
+				continue
+			}
+			if entry.IsDir() {
+				if err := scan(r, rel, inState); err != nil {
+					return err
+				}
+				continue
+			}
+			b, err := cleanRead(r, rel)
+			if err != nil {
+				return err
+			}
+			if !utf8.Valid(b) || strings.IndexByte(string(b), 0) >= 0 {
+				return fmt.Errorf("bằng chứng không phải văn bản: %s", rel)
+			}
+			// Decode both native separators and JSON-escaped Windows separators.
+			text := strings.ReplaceAll(string(b), `\\`, `/`)
+			texts = append(texts, strings.ReplaceAll(text, `\`, `/`))
+			if entry.Name() == task.TicketFile {
+				var ticket task.Ticket
+				if err := yaml.Unmarshal(b, &ticket); err != nil {
+					return err
+				}
+				if err := ticket.Validate(); err != nil {
+					return err
+				}
+				raw, err := cleanRead(r, filepath.Join(filepath.Dir(rel), task.StateFile))
+				if err != nil {
+					return err
+				}
+				var st task.State
+				if err := json.Unmarshal(raw, &st); err != nil {
+					return err
+				}
+				if ticket.ID != st.ID || ticket.ID != filepath.Base(filepath.Dir(rel)) || !slices.Contains(task.Statuses, st.Status) {
+					return fmt.Errorf("tác vụ không khớp định danh")
+				}
+			}
+			if strings.HasSuffix(entry.Name(), ".json") && !json.Valid(b) {
+				return fmt.Errorf("bằng chứng JSON hỏng: %s", rel)
+			}
+		}
+		return nil
+	}
+	if err := scan(root, ".", true); err != nil {
+		return nil, "không đọc đủ tham chiếu; giữ để an toàn: " + err.Error()
+	}
+	dbRefs, err := eval.CleanupSQLiteReferences(ctx, root)
+	if err != nil {
+		return nil, "không đọc đủ tham chiếu SQLite; giữ để an toàn: " + err.Error()
+	}
+	for _, text := range dbRefs {
+		text = strings.ReplaceAll(text, `\\`, `/`)
+		texts = append(texts, strings.ReplaceAll(text, `\`, `/`))
+	}
+	// Include versioned task documents and knowledge/eval evidence from every
+	// configuration root, without importing them into runtime/tasks.
+	for _, repo := range ws.Repo.ConfigRoots() {
+		r, err := os.OpenRoot(repo)
+		if err != nil {
+			return nil, "không đọc được repository tham chiếu: " + err.Error()
+		}
+		err = scan(r, ".bint", false)
+		r.Close()
+		if err != nil {
+			return nil, "không đọc đủ tài liệu repository; giữ để an toàn: " + err.Error()
+		}
+	}
+	return texts, ""
+}
+
+var cleanConcreteReference = map[string]*regexp.Regexp{
+	"cache":      regexp.MustCompile(`eval-work/bases/(?:[0-9a-f]{40}|[0-9a-f]{64})\.git`),
+	"backup":     regexp.MustCompile(`backups/\d{8}T\d{6}\.\d{3}Z`),
+	"hook-trace": regexp.MustCompile(`(?:runtime/)?hook-trace/\d{8}T\d{6}\.\d{9}Z`),
+}
+
+var cleanQuotedReference = regexp.MustCompile("\"[^\"\r\n]*\"|'[^'\r\n]*'|`[^`\r\n]*`")
+
+func cleanReferenceTokens(text string) []string {
+	tokens := strings.FieldsFunc(text, func(r rune) bool { return strings.ContainsRune("\n\r\t \"'`<>()[]{}=,;", r) })
+	// Quoted paths may contain whitespace; keep them intact as well as the
+	// ordinary tokens so an external alias with spaces is still recognized.
+	for _, quoted := range cleanQuotedReference.FindAllString(text, -1) {
+		tokens = append(tokens, quoted[1:len(quoted)-1])
+	}
+	return tokens
+}
+
+// Arguments are normalized by state.NormalizePath, including physical aliases.
+// Rel enforces component boundaries: a prefix sibling is not a containing path.
+func cleanPathContains(parent, child string) bool {
+	rel, err := filepath.Rel(parent, child)
+	return err == nil && (rel == "." || filepath.IsLocal(rel))
+}
+
+func cleanReferenced(ws *Workspace, item CleanItem, texts []string) bool {
+	group := map[string]string{"cache": "eval-work/bases", "backup": "backups", "hook-trace": "runtime/hook-trace"}[item.Kind]
+	stateRoot := state.NormalizePath(ws.Paths.Root)
+	for _, text := range texts {
+		// Classify each group occurrence independently. Concrete paths account
+		// only for their own mentions, never a separate reference to the group.
+		unresolved := cleanConcreteReference[item.Kind].ReplaceAllString(text, "")
+		if strings.Contains(unresolved, group) {
+			return true
+		}
+		tokens := cleanReferenceTokens(text)
+		for _, part := range item.parts {
+			rel := filepath.ToSlash(part.rel)
+			// Protect references to the item OR any ancestor of it within its group.
+			for p := rel; p != "." && p != group; p = filepath.ToSlash(filepath.Dir(p)) {
+				if strings.Contains(text, p) {
+					return true
+				}
+			}
+			abs := filepath.Join(ws.Paths.Root, part.rel)
+			physical := state.NormalizePath(abs)
+			if strings.Contains(text, physical) {
+				return true
+			}
+			// A reference to an ancestor protects this item. A reference inside a
+			// directory item also protects it, since cleanup removes that whole tree.
+			rootInfo := part.tree["."]
+			for _, token := range tokens {
+				if !filepath.IsAbs(token) {
+					continue
+				}
+				reference := state.NormalizePath(token)
+				// Resolve first, so aliases outside state can name its contents.
+				// References are scoped to state; prose separators such as "/"
+				// must not protect every cleanup item via a filesystem ancestor.
+				if !cleanPathContains(stateRoot, reference) {
+					continue
+				}
+				if cleanPathContains(reference, physical) || (rootInfo != nil && rootInfo.IsDir() && cleanPathContains(physical, reference)) {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
