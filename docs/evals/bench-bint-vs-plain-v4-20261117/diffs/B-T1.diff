+		if err := os.Chtimes(p, old, old); err != nil {
+			t.Fatal(err)
+		}
+		if strings.HasPrefix(rel, "20260101") {
+			denied = filepath.Dir(p)
+		}
+	}
+	defer os.Chmod(denied, 0700)
+	if err := os.Chmod(denied, 0500); err != nil {
