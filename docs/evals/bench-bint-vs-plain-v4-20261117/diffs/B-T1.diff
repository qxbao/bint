+	"bint/internal/state"
+	"bint/internal/store"
+	"bint/internal/task"
+	"bint/internal/testutil"
+)
+
+func cleanFixture(t *testing.T) (*Workspace, time.Time) {
+	t.Helper()
+	return &Workspace{Paths: state.At("test", t.TempDir()), Repo: gitrepo.Repo{Toplevel: t.TempDir()}}, time.Date(2026, 11, 17, 12, 0, 0, 0, time.UTC)
+}
+
+func cleanWrite(t *testing.T, root, rel, body string, when time.Time) string {
+	t.Helper()
+	p := filepath.Join(root, filepath.FromSlash(rel))
+	if err := os.MkdirAll(filepath.Dir(p), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(p, []byte(body), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chtimes(p, when, when); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+func cleanCompleteBase(t *testing.T, ws *Workspace, name string, when time.Time) {
+	t.Helper()
+	rel := "eval-work/bases/" + name
+	cleanWrite(t, ws.Paths.Root, rel+"/HEAD", "ref: refs/heads/eval-base\n", when)
+	cleanWrite(t, ws.Paths.Root, rel+"/refs/heads/eval-base", strings.TrimSuffix(name, ".git")+"\n", when)
+	if err := os.MkdirAll(filepath.Join(ws.Paths.EvalWork, "bases", name, "objects"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	dir := filepath.Join(ws.Paths.EvalWork, "bases", name)
+	if err := os.Chtimes(dir, when, when); err != nil {
+		t.Fatal(err)
+	}
+}
+
+type cleanFileState struct {
+	Mode     os.FileMode
+	Size     int64
+	Modified time.Time
+	Body     string
+}
+
+func cleanSnapshot(t *testing.T, root string) map[string]cleanFileState {
+	t.Helper()
+	out := map[string]cleanFileState{}
+	err := filepath.WalkDir(root, func(p string, d os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		i, err := d.Info()
+		if err != nil {
+			return err
+		}
+		body := ""
+		if i.Mode().IsRegular() {
+			b, e := os.ReadFile(p)
+			if e != nil {
+				return e
+			}
+			body = string(b)
+		}
+		out[p] = cleanFileState{i.Mode(), i.Size(), i.ModTime(), body}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return out
+}
+
+func TestCleanPreviewAndApplyRetention(t *testing.T) {
+	ws, now := cleanFixture(t)
+	old := now.Add(-91 * 24 * time.Hour)
+	oldBackup := cleanWrite(t, ws.Paths.Root, "backups/20260818T120000.000Z/config.yml", "old", old)
+	latest := cleanWrite(t, ws.Paths.Root, "backups/20260818T130000.000Z/config.yml", "latest", old)
+	only := cleanWrite(t, ws.Paths.Root, "backups/20260818T120000.000Z/only.yml", "only", old)
+	for _, days := range []int{89, 90, 91, -1} {
+		when := now.Add(-time.Duration(days) * 24 * time.Hour)
+		base := "runtime/hook-trace/" + when.Format("20060102T150405.000000000Z") + "-codex-tool"
+		cleanWrite(t, ws.Paths.Root, base+".in", "{}", when)
+		cleanWrite(t, ws.Paths.Root, base+".out", `{"output":"","duration_ms":1,"skipped":"","written":true,"spool_file":""}`, when)
+	}
+	incomplete := cleanWrite(t, ws.Paths.Root, "runtime/hook-trace/20260818T120000.000000000Z-codex-stop.in", "{}", old)
+	invalid := cleanWrite(t, ws.Paths.Root, "runtime/hook-trace/20260818T130000.000000000Z-codex-stop.out", "{}", old)
+	cleanWrite(t, ws.Paths.Root, "runtime/hook-trace/20260818T130000.000000000Z-codex-stop.in", "{}", old)
+	cleanWrite(t, ws.Paths.Root, "spool/pending.json", `{"pending":true}`, old)
+	db, err := store.Open(context.Background(), ws.Paths.DB)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Close(); err != nil {
+		t.Fatal(err)
+	}
+	before := cleanSnapshot(t, ws.Paths.Root)
+	r, err := cleanWorkspace(context.Background(), ws, CleanOptions{}, now, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.Selected != 2 {
+		t.Fatalf("selected=%d, items=%+v", r.Selected, r.Items)
+	}
+	if after := cleanSnapshot(t, ws.Paths.Root); !reflect.DeepEqual(before, after) {
+		t.Fatal("preview changed state")
+	}
+	r, err = cleanWorkspace(context.Background(), ws, CleanOptions{Apply: true}, now, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.Removed != 2 || r.RemovedBytes != r.SelectedBytes {
+		t.Fatalf("result=%+v", r)
+	}
+	if _, err := os.Lstat(oldBackup); !os.IsNotExist(err) {
+		t.Fatalf("old backup exists: %v", err)
+	}
+	for _, p := range []string{latest, only, incomplete, invalid} {
+		if _, err := os.Lstat(p); err != nil {
+			t.Fatalf("kept %s: %v", p, err)
+		}
+	}
+	r, err = cleanWorkspace(context.Background(), ws, CleanOptions{Apply: true}, now, nil)
+	if err != nil || r.Removed != 0 {
+		t.Fatalf("second apply: %+v %v", r, err)
+	}
+}
+
+func TestCleanReferencesAndUnreadableTask(t *testing.T) {
+	for _, bad := range []bool{false, true} {
+		t.Run(map[bool]string{false: "reference", true: "broken-task"}[bad], func(t *testing.T) {
+			ws, now := cleanFixture(t)
+			old := now.Add(-100 * 24 * time.Hour)
+			p := cleanWrite(t, ws.Paths.Root, "backups/20260801T120000.000Z/config.yml", "old", old)
+			cleanWrite(t, ws.Paths.Root, "backups/20260802T120000.000Z/config.yml", "new", old)
+			if bad {
+				cleanWrite(t, ws.Paths.Root, "runtime/tasks/broken/task.yml", "[invalid", old)
+			} else {
+				cleanWrite(t, ws.Paths.Root, "runtime/logs/kept.log", p, old)
+			}
+			r, err := cleanWorkspace(context.Background(), ws, CleanOptions{Apply: true}, now, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if r.Removed != 0 {
+				t.Fatalf("removed protected data: %+v", r)
+			}
+		})
+	}
+}
+
+func TestCleanKeepsReferencesFromCompletedTask(t *testing.T) {
+	ws, now := cleanFixture(t)
+	old := now.Add(-100 * 24 * time.Hour)
+	target := cleanWrite(t, ws.Paths.Root, "backups/20260801T120000.000Z/config.yml", "old", old)
+	cleanWrite(t, ws.Paths.Root, "backups/20260802T120000.000Z/config.yml", "new", old)
+	ticket, err := task.NewStore(ws.Paths.Runtime).Create(task.Ticket{Goal: "retained evidence"}, task.State{Status: task.StatusDone}, old)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cleanWrite(t, ticket.Dir, "review.md", target, old)
+	before := cleanSnapshot(t, ws.Paths.Root)
+	result, err := cleanWorkspace(context.Background(), ws, CleanOptions{Apply: true}, now, nil)
+	if err != nil || result.Removed != 0 {
+		t.Fatalf("retained task: %d %v", result.Removed, err)
+	}
+	found := false
+	for _, i := range result.Items {
+		if i.Path == target && strings.Contains(i.Reason, "tham chiếu") {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatal("task reference not recognized")
+	}
+	if !reflect.DeepEqual(before, cleanSnapshot(t, ws.Paths.Root)) {
+		t.Fatal("task/evidence changed")
+	}
+}
+
+func TestCleanStateAlias(t *testing.T) {
+	ws, now := cleanFixture(t)
+	physical := ws.Paths.Root
+	old := now.Add(-100 * 24 * time.Hour)
+	target := cleanWrite(t, physical, "backups/20260801T120000.000Z/config.yml", "old", old)
+	cleanWrite(t, physical, "backups/20260802T120000.000Z/config.yml", "new", old)
+	alias := filepath.Join(t.TempDir(), "state")
+	if err := os.Symlink(physical, alias); err != nil {
+		t.Skip(err)
+	}
+	ws.Paths = state.At("test", alias)
+	result, err := cleanWorkspace(context.Background(), ws, CleanOptions{Apply: true}, now, nil)
+	if err != nil || result.Removed != 1 {
+		t.Fatalf("state alias: %d %v", result.Removed, err)
+	}
+	if _, err := os.Stat(target); !os.IsNotExist(err) {
+		t.Fatalf("target not cleaned: %v", err)
+	}
+}
+
+func TestCleanRechecksReplacedParent(t *testing.T) {
+	ws, now := cleanFixture(t)
+	old := now.Add(-100 * 24 * time.Hour)
+	rel := "backups/20260801T120000.000Z/config.yml"
+	cleanWrite(t, ws.Paths.Root, rel, "old", old)
+	cleanWrite(t, ws.Paths.Root, "backups/20260802T120000.000Z/config.yml", "new", old)
+	outside := t.TempDir()
+	sentinel := cleanWrite(t, outside, "config.yml", "sentinel", old)
+	hook := func() {
+		dir := filepath.Dir(filepath.Join(ws.Paths.Root, rel))
+		if err := os.Rename(dir, dir+"-moved"); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Symlink(outside, dir); err != nil {
+			t.Skipf("symlink unavailable: %v", err)
+		}
+	}
+	r, err := cleanWorkspace(context.Background(), ws, CleanOptions{Apply: true}, now, hook)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.Removed != 0 {
+		t.Fatal("removed changed item")
+	}
+	if b, err := os.ReadFile(sentinel); err != nil || string(b) != "sentinel" {
+		t.Fatal("outside data changed")
+	}
+}
+
+func TestCleanRechecksAgeReferencesAndNewest(t *testing.T) {
+	for _, change := range []string{"mtime", "reference", "latest-removed", "file-replaced"} {
+		t.Run(change, func(t *testing.T) {
+			ws, now := cleanFixture(t)
+			old := now.Add(-100 * 24 * time.Hour)
+			rel := "backups/20260801T120000.000Z/config.yml"
+			target := cleanWrite(t, ws.Paths.Root, rel, "old", old)
+			latest := cleanWrite(t, ws.Paths.Root, "backups/20260802T120000.000Z/config.yml", "new", old)
+			hook := func() {
+				switch change {
+				case "mtime":
+					if err := os.Chtimes(target, now, now); err != nil {
+						t.Fatal(err)
+					}
+				case "reference":
+					cleanWrite(t, ws.Paths.Root, "runtime/review.md", target, now)
+				case "latest-removed":
+					if err := os.Remove(latest); err != nil {
+						t.Fatal(err)
+					}
+				case "file-replaced":
+					if err := os.Rename(target, target+".old"); err != nil {
+						t.Fatal(err)
+					}
+					cleanWrite(t, ws.Paths.Root, rel, "replacement", old)
+				}
+			}
+			r, err := cleanWorkspace(context.Background(), ws, CleanOptions{Apply: true}, now, hook)
+			if err != nil || r.Removed != 0 {
+				t.Fatalf("recheck: %d %v", r.Removed, err)
+			}
+			if _, err := os.Stat(target); err != nil {
+				t.Fatalf("target lost: %v", err)
+			}
+		})
+	}
+}
+
+func TestCleanApplyReportsItemFailure(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("chmod does not remove delete rights on Windows")
+	}
+	ws, now := cleanFixture(t)
+	old := now.Add(-100 * 24 * time.Hour)
+	target := cleanWrite(t, ws.Paths.Root, "backups/20260801T120000.000Z/config.yml", "old", old)
+	cleanWrite(t, ws.Paths.Root, "backups/20260802T120000.000Z/config.yml", "new", old)
+	parent := filepath.Dir(target)
+	defer os.Chmod(parent, 0700)
+	hook := func() {
+		if err := os.Chmod(parent, 0500); err != nil {
+			t.Fatal(err)
+		}
+	}
+	r, err := cleanWorkspace(context.Background(), ws, CleanOptions{Apply: true}, now, hook)
+	if err == nil {
+		t.Fatal("deletion failure not returned")
+	}
+	if r.Removed != 0 || r.RemovedBytes != 0 {
+		t.Fatal("failed removal counted")
+	}
+	found := false
+	for _, i := range r.Items {
+		if i.Path == target && i.Outcome == "error" {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatal("missing per-item error")
+	}
+}
+
+func TestCleanCacheAndSymlinks(t *testing.T) {
+	testutil.Isolate(t)
+	ws, now := cleanFixture(t)
+	ws.Repo.Toplevel = testutil.NewRepo(t, nil)
+	sha := testutil.Git(t, ws.Repo.Toplevel, "rev-parse", "HEAD")
+	old := now.Add(-100 * 24 * time.Hour)
+	for _, name := range []string{sha + ".git", strings.Repeat("0", 40) + ".git", sha + ".git.tmp", "unknown"} {
+		p := cleanWrite(t, ws.Paths.Root, "eval-work/bases/"+name+"/data", "cache", old)
+		if err := os.Chtimes(filepath.Dir(p), old, old); err != nil {
+			t.Fatal(err)
+		}
+	}
+	cleanCompleteBase(t, ws, sha+".git", old)
+	lock := cleanWrite(t, ws.Paths.Root, "eval-work/bases/.locks/keep.lock", "pid", old)
+	outside := t.TempDir()
+	sentinel := cleanWrite(t, outside, "sentinel", "keep", old)
+	linked := filepath.Join(ws.Paths.Backups, "20260101T120000.000Z")
+	if err := os.MkdirAll(ws.Paths.Backups, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, linked); err != nil {
+		t.Logf("symlink unavailable: %v", err)
+	}
+	before := cleanSnapshot(t, ws.Paths.Root)
+	r, err := cleanWorkspace(context.Background(), ws, CleanOptions{}, now, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(before, cleanSnapshot(t, ws.Paths.Root)) {
+		t.Fatal("cache preview created a lock or modified state")
+	}
+	if r.Selected != 1 {
+		t.Fatalf("selected=%d", r.Selected)
+	}
+	r, err = cleanWorkspace(context.Background(), ws, CleanOptions{Apply: true}, now, nil)
+	if err != nil || r.Removed != 1 {
+		t.Fatalf("cache cleanup: %d %v", r.Removed, err)
+	}
+	for _, p := range []string{lock, sentinel, filepath.Join(ws.Paths.EvalWork, "bases", sha+".git.tmp", "data")} {
+		if _, err := os.Stat(p); err != nil {
+			t.Fatalf("kept %s: %v", p, err)
+		}
+	}
+}
+
+func TestCleanKeepsUnrecognizedBase(t *testing.T) {
+	testutil.Isolate(t)
