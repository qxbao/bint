+
+func TestCleanCacheBusyInOtherProcess(t *testing.T) {
+	if bases := os.Getenv("BINT_TEST_APP_CLEAN_BASES"); bases != "" {
+		r, err := os.OpenRoot(bases)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer r.Close()
+		unlock, err := eval.TryCleanupBaseAt(r, os.Getenv("BINT_TEST_APP_CLEAN_NAME"), true)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer unlock()
+		if err := os.WriteFile(os.Getenv("BINT_TEST_APP_CLEAN_READY"), nil, 0600); err != nil {
+			t.Fatal(err)
+		}
+		for {
+			if _, err := os.Stat(os.Getenv("BINT_TEST_APP_CLEAN_RELEASE")); err == nil {
+				return
+			}
+			time.Sleep(10 * time.Millisecond)
+		}
+	}
+	testutil.Isolate(t)
+	ws, now := cleanFixture(t)
+	ws.Repo.Toplevel = testutil.NewRepo(t, nil)
+	name := testutil.Git(t, ws.Repo.Toplevel, "rev-parse", "HEAD") + ".git"
+	old := now.Add(-100 * 24 * time.Hour)
+	target := cleanWrite(t, ws.Paths.Root, "eval-work/bases/"+name+"/data", "cache", old)
+	cleanCompleteBase(t, ws, name, old)
+	if err := os.Chtimes(filepath.Dir(target), old, old); err != nil {
+		t.Fatal(err)
+	}
+	ready, release := filepath.Join(ws.Paths.Root, "ready"), filepath.Join(ws.Paths.Root, "release")
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestCleanCacheBusyInOtherProcess$")
+	cmd.Env = append(os.Environ(), "BINT_TEST_APP_CLEAN_BASES="+filepath.Join(ws.Paths.EvalWork, "bases"), "BINT_TEST_APP_CLEAN_NAME="+name, "BINT_TEST_APP_CLEAN_READY="+ready, "BINT_TEST_APP_CLEAN_RELEASE="+release)
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		_ = os.WriteFile(release, nil, 0600)
+		if err := cmd.Wait(); err != nil {
+			t.Error(err)
+		}
+	}()
+	for {
+		if _, err := os.Stat(ready); err == nil {
+			break
+		}
+		if ctx.Err() != nil {
+			t.Fatal(ctx.Err())
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	for _, apply := range []bool{false, true} {
+		result, err := cleanWorkspace(ctx, ws, CleanOptions{Apply: apply}, now, nil)
+		if err != nil || result.Selected != 0 || result.Removed != 0 {
+			t.Fatalf("busy cache: %+v %v", result, err)
+		}
+		found := false
+		for _, i := range result.Items {
+			if strings.Contains(i.Reason, "bận") {
+				found = true
+			}
+		}
+		if !found {
+			t.Fatal("missing busy reason")
+		}
+	}
+	if _, err := os.Stat(target); err != nil {
+		t.Fatal(err)
+	}
+}
