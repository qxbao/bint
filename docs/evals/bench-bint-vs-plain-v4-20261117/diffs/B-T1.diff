+	found := false
+	for _, i := range r.Items {
+		if i.Path == target && strings.Contains(i.Reason, "SQLite") {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatal("missing SQLite safety reason")
+	}
+	if !reflect.DeepEqual(before, cleanSnapshot(t, ws.Paths.Root)) {
+		t.Fatal("modified invalid DB or candidate")
+	}
+}
+
+func TestCleanIncompleteTraceReference(t *testing.T) {
+	ws, now, target := cleanReviewBackups(t)
+	cleanWrite(t, ws.Paths.Root, "runtime/hook-trace/20260801T120000.000000000Z-codex-tool.in", target, now.Add(-100*24*time.Hour))
+	r, err := cleanWorkspace(context.Background(), ws, CleanOptions{Apply: true}, now, nil)
+	if err != nil || r.Removed != 0 {
+		t.Fatalf("incomplete trace reference: %d %v", r.Removed, err)
+	}
+}
+
+func TestCleanSQLiteLinkedWALKeepsData(t *testing.T) {
+	ws, now, target := cleanReviewBackups(t)
+	db, err := store.Open(context.Background(), ws.Paths.DB)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Close(); err != nil {
+		t.Fatal(err)
+	}
+	outside := t.TempDir()
+	sentinel := cleanWrite(t, outside, "wal", "outside sentinel", now)
+	if err := os.Symlink(sentinel, ws.Paths.DB+"-wal"); err != nil {
+		t.Skip(err)
