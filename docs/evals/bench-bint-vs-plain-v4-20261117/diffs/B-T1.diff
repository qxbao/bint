+func cleanReviewBackups(t *testing.T) (*Workspace, time.Time, string) {
+	ws, now := cleanFixture(t)
+	old := now.Add(-100 * 24 * time.Hour)
+	target := cleanWrite(t, ws.Paths.Root, "backups/20260801T120000.000Z/config.yml", "old backup", old)
+	cleanWrite(t, ws.Paths.Root, "backups/20260802T120000.000Z/config.yml", "new backup", old)
+	return ws, now, target
+}
+
+func TestCleanReviewSQLiteReference(t *testing.T) {
+	ws, now, target := cleanReviewBackups(t)
+	ctx := context.Background()
+	if err := os.MkdirAll(ws.Paths.Spool, 0700); err != nil {
+		t.Fatal(err)
+	}
+	db, err := store.Open(ctx, ws.Paths.DB)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = spool.Write(ws.Paths.Spool, spool.Event{EventID: "review-ref", Type: spool.FileRead, Source: "hook:claude", Timestamp: now, Harness: "claude", SessionID: "review-session", Payload: map[string]any{"paths": []string{target}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	before, err := cleanWorkspace(ctx, ws, CleanOptions{}, now, nil)
+	if err != nil || before.Selected != 0 {
+		t.Fatalf("pending ref not protected: %+v %v", before, err)
+	}
+	if _, err := runlog.Ingest(ctx, db, ws.Paths.Spool, now, 0); err != nil {
+		t.Fatal(err)
+	}
+	var count int
+	if err := db.DB.QueryRow("SELECT count(*) FROM run_artifacts WHERE path = ?", target).Scan(&count); err != nil || count != 1 {
+		t.Fatalf("artifact not retained: %d %v", count, err)
+	}
+	if err := db.Close(); err != nil {
+		t.Fatal(err)
+	}
+	result, err := cleanWorkspace(ctx, ws, CleanOptions{Apply: true}, now, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(target); os.IsNotExist(err) {
+		t.Fatalf("deleted backup still referenced by run_artifacts/events after spool ingestion; removed=%d", result.Removed)
+	}
+}
+
+func TestCleanReviewNewestBackupIsSymlink(t *testing.T) {
+	ws, now, target := cleanReviewBackups(t)
+	latest := filepath.Join(ws.Paths.Backups, "20260802T120000.000Z/config.yml")
+	if err := os.Remove(latest); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(filepath.Join(t.TempDir(), "missing"), latest); err != nil {
+		t.Skip(err)
+	}
+	result, err := cleanWorkspace(context.Background(), ws, CleanOptions{Apply: true}, now, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(target); os.IsNotExist(err) {
+		t.Fatalf("deleted sole regular backup because newer invalid symlink counted as newest; removed=%d", result.Removed)
+	}
+}
+
+func TestCleanReviewTraceInputIsDirectory(t *testing.T) {
+	ws, now := cleanFixture(t)
