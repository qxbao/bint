+func TestAbsZero(t *testing.T) {
+	if got := Abs(0); got != 0 {
+		t.Fatalf("Abs(0)=%d", got)
+	}
+}
+
+func TestAbsNegative(t *testing.T) {
+	if got := Abs(-7); got != 7 {
+		t.Fatalf("Abs(-7)=%d", got)
+	}
+}
+
+func TestAbsPositive(t *testing.T) {
