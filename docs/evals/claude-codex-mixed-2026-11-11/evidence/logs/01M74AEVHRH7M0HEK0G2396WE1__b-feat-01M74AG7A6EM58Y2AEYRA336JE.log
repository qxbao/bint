{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/usr/bin/zsh -lc \"sed -n '1,240p' calc.go && sed -n '1,260p' calc_test.go\"", "aggregated_output": "// Package calc có các phép tính số nguyên nhỏ.\npackage calc\n\n// Add trả về tổng hai số.\nfunc Add(a, b int) int { return a + b }\n\n// Negate trả về số đối.\nfunc Negate(a int) int { return -a }\npackage calc\n\nimport \"testing\"\n\nfunc TestAdd(t *testing.T) {\n\tif got := Add(2, 3); got != 5 {\n\t\tt.Fatalf(\"Add(2,3)=%d\", got)\n\t}\n}\n\nfunc TestAddNegative(t *testing.T) {\n\tif got := Add(-2, -3); got != -5 {\n\t\tt.Fatalf(\"Add(-2,-3)=%d\", got)\n\t}\n}\n\nfunc TestNegate(t *testing.T) {\n\tif got := Negate(4); got != -4 {\n\t\tt.Fatalf(\"Negate(4)=%d\", got)\n\t}\n}\n", "exit_code": 0, "status": "completed"}}
