{"type": "item.completed", "item": {"id": "item_2", "type": "command_execution", "command": "/usr/bin/zsh -lc 'git diff 685f67cec969ee3b0b1428779a29a0d3f132fc30'", "aggregated_output": "diff --git a/calc.go b/calc.go\nindex dcf96ad..e1ec799 100644\n--- a/calc.go\n+++ b/calc.go\n@@ -6,3 +6,19 @@ func Add(a, b int) int { return a + b }\n \n // Negate trả về số đối.\n func Negate(a int) int { return -a }\n+\n+// Abs trả về giá trị tuyệt đối. Với math.MinInt, kết quả vẫn là math.MinInt.\n+func Abs(a int) int {\n+\tif a < 0 {\n+\t\treturn -a\n+\t}\n+\treturn a\n+}\n+\n+// Max trả về số lớn hơn trong hai số; nếu bằng nhau thì trả về giá trị đó.\n+func Max(a, b int) int {\n+\tif a > b {\n+\t\treturn a\n+\t}\n+\treturn b\n+}\ndiff --git a/calc_test.go b/calc_test.go\nindex 4e2697e..b89d248 100644\n--- a/calc_test.go\n+++ b/calc_test.go\n@@ -19,3 +19,39 @@ func TestNegate(t *testing.T) {\n \t\tt.Fatalf(\"Negate(4)=%d\", got)\n \t}\n }\n+\n+func TestAbsZero(t *testing.T) {\n+\tif got := Abs(0); got != 0 {\n+\t\tt.Fatalf(\"Abs(0)=%d\", got)\n+\t}\n+}\n+\n+func TestAbsNegative(t *testing.T) {\n+\tif got := Abs(-7); got != 7 {\n+\t\tt.Fatalf(\"Abs(-7)=%d\", got)\n+\t}\n+}\n+\n+func TestAbsPositive(t *testing.T) {\n+\tif got := Abs(7); got != 7 {\n+\t\tt.Fatalf(\"Abs(7)=%d\", got)\n+\t}\n+}\n+\n+func TestMaxSecondLarger(t *testing.T) {\n+\tif got := Max(2, 9); got != 9 {\n+\t\tt.Fatalf(\"Max(2,9)=%d\", got)\n+\t}\n+}\n+\n+func TestMaxFirstLarger(t *testing.T) {\n+\tif got := Max(9, 2); got != 9 {\n+\t\tt.Fatalf(\"Max(9,2)=%d\", got)\n+\t}\n+}\n+\n+func TestMaxEqual(t *testing.T) {\n+\tif got := Max(4, 4); got != 4 {\n+\t\tt.Fatalf(\"Max(4,4)=%d\", got)\n+\t}\n+}\n", "exit_code": 0, "status": "completed"}}
