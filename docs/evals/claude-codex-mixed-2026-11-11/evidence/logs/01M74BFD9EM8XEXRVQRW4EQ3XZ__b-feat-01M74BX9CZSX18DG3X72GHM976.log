c TestAddNegative(t *testing.T) {\n    12\t\tif got := Add(-2, -3); got != -5 {\n    13\t\t\tt.Fatalf(\"Add(-2,-3)=%d\", got)\n    14\t\t}\n    15\t}\n    16\t\n    17\tfunc TestSub(t *testing.T) {\n    18\t\tif got := Sub(5, 3); got != 2 {\n    19\t\t\tt.Fatalf(\"Sub(5,3)=%d\", got)\n    20\t\t}\n    21\t}\n    22\t\n    23\tfunc TestNegate(t *testing.T) {\n    24\t\tif got := Negate(4); got != -4 {\n    25\t\t\tt.Fatalf(\"Negate(4)=%d\", got)\n    26\t\t}\n    27\t}\n    28\t\n    29\tfunc TestAbsZero(t *testing.T) {\n    30\t\tif got := Abs(0); got != 0 {\n    31\t\t\tt.Fatalf(\"Abs(0)=%d\", got)\n    32\t\t}\n    33\t}\n    34\t\n    35\tfunc TestAbsNegative(t *testing.T) {\n    36\t\tif got := Abs(-7); got != 7 {\n    37\t\t\tt.Fatalf(\"Abs(-7)=%d\", got)\n    38\t\t}\n    39\t}\n    40\t\n    41\tfunc TestAbsPositive(t *testing.T) {\n    42\t\tif got := Abs(7); got != 7 {\n    43\t\t\tt.Fatalf(\"Abs(7)=%d\", got)\n    44\t\t}\n    45\t}\n    46\t\n    47\tfunc TestMaxSecondLarger(t *testing.T) {\n    48\t\tif got := Max(2, 9); got != 9 {\n    49\t\t\tt.Fatalf(\"Max(2,9)=%d\", got)\n    50\t\t}\n    51\t}\n    52\t\n    53\tfunc TestMaxFirstLarger(t *testing.T) {\n    54\t\tif got := Max(9, 2); got != 9 {\n    55\t\t\tt.Fatalf(\"Max(9,2)=%d\", got)\n    56\t\t}\n    57\t}\n    58\t\n    59\tfunc TestMaxEqual(t *testing.T) {\n    60\t\tif got := Max(4, 4); got != 4 {\n    61\t\t\tt.Fatalf(\"Max(4,4)=%d\", got)\n    62\t\t}\n    63\t}\n", "exit_code": 0, "status": "completed"}}
