{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/usr/bin/zsh -lc \"sed -n '1,200p' calc.go && sed -n '1,240p' calc_test.go && sed -n '1,100p' go.mod && rg --files migrations\"", "aggregated_output": "// Package calc có các phép tính số nguyên nhỏ.\npackage calc\n\n// Add trả về tổng hai số.\nfunc Add(a, b int) int { return a + b }\n\n// Negate trả về số đối.\nfunc Negate(a int) int { return -a }\n\n// Abs trả về giá trị tuyệt đối. Với math.MinInt, kết quả vẫn là math.MinInt.\nfunc Abs(a int) int {\n\tif a < 0 {\n\t\treturn -a\n\t}\n\treturn a\n}\n\n// Max trả về số lớn hơn trong hai số; nếu bằng nhau thì trả về giá trị đó.\nfunc Max(a, b int) int {\n\tif a > b {\n\t\treturn a\n\t}\n\treturn b\n}\npackage calc\n\nimport \"testing\"\n\nfunc TestAdd(t *testing.T) {\n\tif got := Add(2, 3); got != 5 {\n\t\tt.Fatalf(\"Add(2,3)=%d\", got)\n\t}\n}\n\nfunc TestAddNegative(t *testing.T) {\n\tif got := Add(-2, -3); got != -5 {\n\t\tt.Fatalf(\"Add(-2,-3)=%d\", got)\n\t}\n}\n\nfunc TestNegate(t *testing.T) {\n\tif got := Negate(4); got != -4 {\n\t\tt.Fatalf(\"Negate(4)=%d\", got)\n\t}\n}\n\nfunc TestAbsZero(t *testing.T) {\n\tif got := Abs(0); got != 0 {\n\t\tt.Fatalf(\"Abs(0)=%d\", got)\n\t}\n}\n\nfunc TestAbsNegative(t *testing.T) {\n\tif got := Abs(-7); got != 7 {\n\t\tt.Fatalf(\"Abs(-7)=%d\", got)\n\t}\n}\n\nfunc TestAbsPositive(t *testing.T) {\n\tif got := Abs(7); got != 7 {\n\t\tt.Fatalf(\"Abs(7)=%d\", got)\n\t}\n}\n\nfunc TestMaxSecondLarger(t *testing.T) {\n\tif got := Max(2, 9); got != 9 {\n\t\tt.Fatalf(\"Max(2,9)=%d\", got)\n\t}\n}\n\nfunc TestMaxFirstLarger(t *testing.T) {\n\tif got := Max(9, 2); got != 9 {\n\t\tt.Fatalf(\"Max(9,2)=%d\", got)\n\t}\n}\n\nfunc TestMaxEqual(t *testing.T) {\n\tif got := Max(4, 4); got != 4 {\n\t\tt.Fatalf(\"Max(4,4)=%d\", got)\n\t}\n}\nmodule probe/calc\n\ngo 1.22\nrg: migrations: IO error for operation on migrations: No such file or directory (os error 2)\n", "exit_code": 2, "status": "failed"