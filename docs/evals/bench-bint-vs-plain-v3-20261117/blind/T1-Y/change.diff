+	"time"
+
+	"bint/internal/fslock"
+)
+
+func TestWriteWaitsForCollectorActivityLock(t *testing.T) {testWriteWaitsForCollectorActivityLock(t,false)}
+func TestWriteDenialWaitsForCollectorActivityLock(t *testing.T) {testWriteWaitsForCollectorActivityLock(t,true)}
+func testWriteWaitsForCollectorActivityLock(t *testing.T,denial bool) {
+	root := t.TempDir()
+	dir := filepath.Join(root, "spool")
+	for _, p := range []string{dir, filepath.Join(root, "runtime")} {
+		if err := os.Mkdir(p, 0o700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	f, err := os.OpenFile(filepath.Join(root, "runtime", "cleanup.activity.lock"), os.O_CREATE|os.O_RDWR, 0o600)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	if busy, err := fslock.Try(f, true); err != nil || busy {
+		t.Fatalf("collector lock: busy=%v err=%v", busy, err)
+	}
+	result := make(chan error, 1)
+	go func() {
+		event:=Event{EventID:"guarded",Type:SessionStarted,Source:"test",Timestamp:time.Now(),RunID:"run"}
+ if denial {event.Type=ToolDenied;result<-WriteDenial(dir,event)}else{_,err:=Write(dir,event);result<-err}
+	}()
+	select {
+	case err := <-result:
+		t.Fatalf("spool writer bypassed collector guard: %v", err)
+	case <-time.After(50 * time.Millisecond):
+	}
+	files, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(files) != 0 {
+		t.Fatalf("published spool while collector held exclusive guard: %v", files)
+	}
+	if err := f.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-result:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("writer did not continue after collector released guard")
+	}
+	if denial {events,e:=Denials(dir,"run");if e!=nil||len(events)!=1{t.Fatalf("denial journal %v: %v",events,e)};return}
+ pending, err := Pending(dir)
+	if err != nil || len(pending) != 1 {
+		t.Fatalf("pending %v: %v", pending, err)
+	}
+}
