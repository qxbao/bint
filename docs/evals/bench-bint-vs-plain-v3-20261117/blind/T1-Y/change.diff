+func TestRunShellOwnsKnownDiagnosticLog(t *testing.T) {
+	for _, kind := range []string{"evolve", "revalidate"} {
+		t.Run(kind, func(t *testing.T) {
+			root := t.TempDir()
+			id := ulid.New()
+			log := filepath.Join(root, "runtime", kind, id+".log")
+			res := RunShell(t.Context(), t.TempDir(), "echo diagnostic", time.Second, log, nil)
+			if !res.OK() {
+				t.Fatalf("shell: %+v", res)
+			}
+			files, err := filepath.Glob(filepath.Join(root, "runtime", "cleanup-owners", kind, "*.json"))
+			if err != nil || len(files) != 1 {
+				t.Fatalf("owner markers %v: %v", files, err)
+			}
+			b, err := os.ReadFile(files[0])
+			if err != nil {
+				t.Fatal(err)
+			}
+			var owner struct {
+				ID         string    `json:"id"`
+				FinishedAt time.Time `json:"finished_at"`
+			}
+			if err := json.Unmarshal(b, &owner); err != nil {
+				t.Fatal(err)
+			}
+			if owner.ID != id || owner.FinishedAt.IsZero() {
+				t.Fatalf("owner %+v", owner)
+			}
+		})
+	}
+}
+
+func TestRunShellWaitsForKnownDiagnosticGuard(t *testing.T) {
+	root := t.TempDir()
+	if err := os.Mkdir(filepath.Join(root, "runtime"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	f, err := os.OpenFile(filepath.Join(root, "runtime", "cleanup.activity.lock"), os.O_CREATE|os.O_RDWR, 0o600)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	if busy, err := fslock.Try(f, true); err != nil || busy {
+		t.Fatalf("collector guard: %v %v", busy, err)
+	}
+	log := filepath.Join(root, "runtime", "evolve", ulid.New()+".log")
+	result := make(chan CmdResult, 1)
+	go func() { result <- RunShell(t.Context(), t.TempDir(), "echo diagnostic", time.Second, log, nil) }()
+	select {
+	case r := <-result:
+		t.Fatalf("writer bypassed collector guard: %+v", r)
+	case <-time.After(50 * time.Millisecond):
+	}
+	if _, err := os.Stat(log); !os.IsNotExist(err) {
+		t.Fatalf("log published while collector held guard: %v", err)
+	}
+	if err := f.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case r := <-result:
+		if !r.OK() {
+			t.Fatalf("shell: %+v", r)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("writer never continued")
+	}
+}
+
+func TestRunShellLeavesArbitraryLogOwnershipAlone(t *testing.T) {
+	for _, rel := range []string{"output.log", "runtime/evolve/not-a-bint-id.log", "runtime/other/" + ulid.New() + ".log", "elsewhere/evolve/" + ulid.New() + ".log"} {
