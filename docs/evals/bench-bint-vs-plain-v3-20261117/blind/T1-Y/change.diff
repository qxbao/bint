+	if e != nil {
+		t.Fatal(e)
+	}
+	name := filepath.Join(ws.Paths.Spool, ".tmp-old")
+	if e = os.WriteFile(name, []byte("old"), 0600); e != nil {
+		t.Fatal(e)
+	}
+	old := time.Now().Add(-48 * time.Hour)
+	if e = os.Chtimes(name, old, old); e != nil {
+		t.Fatal(e)
+	}
+	payload := `{"cwd":` + quoteJSON(repo) + `,"session_id":"cleanup-hook-test","hook_event_name":"SessionStart","source":"startup"}`
