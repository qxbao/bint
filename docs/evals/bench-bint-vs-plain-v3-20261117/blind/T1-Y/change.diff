+	}
+	old := time.Now().Add(-48 * time.Hour)
+	temp := filepath.Join(w.Paths.Spool, ".tmp-orphan")
+	if err = os.WriteFile(temp, []byte("orphan"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.Chtimes(temp, old, old); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = StatusNoIngest(ctx, repo); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = os.Stat(temp); err != nil {
+		t.Fatal("read-only status ran cleanup", err)
+	}
+	s, err := w.OpenStore(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	if _, err = w.Ingest(ctx, s, time.Now().Add(25*time.Hour)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = os.Stat(temp); !os.IsNotExist(err) {
+		t.Fatalf("orphan remains: %v", err)
+	}
+	rep, err := StatusNoIngest(ctx, repo)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rep.Cleanup.LastSuccess.IsZero() || rep.Cleanup.Removed < 1 {
+		t.Fatalf("report: %+v", rep.Cleanup)
+	}
+	w.Config.State.Cleanup.Enabled = false
+	if _, err = w.Ingest(ctx, s, time.Now().Add(50*time.Hour)); err != nil {
+		t.Fatal(err)
+	}
+	before, err := maintenance.ReadReport(w.Paths.Root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !before.LastSuccess.Equal(rep.Cleanup.LastSuccess) {
+		t.Fatal("disabled changed marker")
+	}
+}
