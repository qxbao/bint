--- /dev/null
+++ b/internal/mcpgw/rotation_test.go
@@ -0,0 +1,113 @@
+package mcpgw
+
+import (
+	"bytes"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"bint/internal/maintenance/rotatelog"
+)
+
+func TestDaemonOwnsRotatingLog(t *testing.T) {
+	dir := t.TempDir()
+	p := filepath.Join(dir, LogFileName)
+	d := &Daemon{opts: Options{Log: io.Discard}, log: rotatelog.NewLogWriter(p)}
+	// Rotate after the daemon is already alive: retaining its original open
+	// descriptor would send the new message into the backup.
+	if err := os.WriteFile(p, bytes.Repeat([]byte("x"), int(rotatelog.LogMaxBytes)), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	d.logf("after live rotation")
+	got, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(got), "after live rotation") || len(got) > 200 {
+		t.Fatalf("active file did not rotate: bytes=%d", len(got))
+	}
+	backup, err := os.Stat(p + ".1")
+	if err != nil || backup.Size() != rotatelog.LogMaxBytes {
+		t.Fatalf("backup: %v %v", backup, err)
+	}
+}
+
+func TestDetachedDaemonOwnsRotatingLog(t *testing.T) {
+	testutilIsolate(t)
+	dir, err := Dir()
+	if err != nil {
+		t.Fatal(err)
+	}
+	info, started, err := StartDetached(t.Context(), dir, os.Args[0], []string{"__gateway_rotation"}, nil)
+	if err != nil || !started {
+		t.Fatalf("start: %v %v", started, err)
+	}
+	t.Cleanup(func() { _, _ = Stop(t.Context(), dir) })
+	p := filepath.Join(dir, LogFileName)
+	b, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(b), "gateway chạy") {
+		t.Fatalf("daemon PID %d did not persist startup: %q", info.PID, b)
+	}
+	// All subsequent daemon diagnostics must reopen this path, rather than
+	// inheriting the descriptor supplied by StartDetached.
+	if err := os.WriteFile(p, bytes.Repeat([]byte("x"), int(rotatelog.LogMaxBytes)), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	eventually(t, "live detached log rotates", 5*time.Second, func() bool {
+		b, err := os.ReadFile(p)
+		return err == nil && len(b) < 10000 && strings.Contains(string(b), "rotation tick")
+	})
+	if _, err := os.Stat(p + ".1"); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func runRotationTestDaemon() error {
+	d, err := Start(Options{Version: "test"})
+	if err != nil {
+		return err
+	}
+	defer d.Close()
+	ticker := time.NewTicker(20 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-d.Done():
+			return nil
+		case <-ticker.C:
+			d.logf("rotation tick")
+		}
+	}
+}
+
+// The caller-selected state directory may have a physical alias. This test
+// checks the pre-spawn failure path without requiring a loopback listener.
+func TestDetachedGatewayStateAliasReachesSpawn(t *testing.T) {
+	for _, ancestor := range []bool{false, true} {
+		t.Run(map[bool]string{false: "root", true: "ancestor"}[ancestor], func(t *testing.T) {
+			real := t.TempDir()
+			alias := filepath.Join(t.TempDir(), "state-alias")
+			if e := os.Symlink(real, alias); e != nil {
+				t.Skip(e)
+			}
+			dir := alias
+			if ancestor {
+				dir = filepath.Join(alias, "gateway")
+			}
+			missing := filepath.Join(t.TempDir(), "missing-gateway-executable")
+			_, _, e := StartDetached(t.Context(), dir, missing, nil, nil)
+			if e == nil || !strings.Contains(e.Error(), "khởi động ") || strings.Contains(e.Error(), "linked log directory") {
+				t.Fatalf("alias rejected before spawn: %v", e)
+			}
+			if fi, e := os.Stat(filepath.Join(dir, LogFileName)); e != nil || !fi.Mode().IsRegular() {
+				t.Fatalf("alias log not created: %v %v", fi, e)
+			}
+		})
+	}
+}
