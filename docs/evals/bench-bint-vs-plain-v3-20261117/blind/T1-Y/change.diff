+func TestStatusShowsCleanupAndDisabledReason(t *testing.T) {
+	testutil.Isolate(t)
+	asHuman(t)
+	root := testutil.NewRepo(t, map[string]string{"go.mod": "module demo\n"})
+	if out, code := run(t, root, "", "init", "--no-hooks"); code != 0 {
+		t.Fatalf("init %d %s", code, out)
+	}
+	ws, e := app.OpenWorkspace(context.Background(), root, true)
+	if e != nil {
+		t.Fatal(e)
+	}
+	name := filepath.Join(ws.Paths.Spool, ".tmp-old")
+	if e = os.WriteFile(name, []byte("expired"), 0600); e != nil {
+		t.Fatal(e)
+	}
+	old := time.Now().Add(-48 * time.Hour)
+	if e = os.Chtimes(name, old, old); e != nil {
+		t.Fatal(e)
+	}
+	out, code := run(t, root, "", "status")
+	if code != 0 || !strings.Contains(out, "Tự dọn:") || !strings.Contains(out, "byte đã xoá") || !strings.Contains(out, "DB tái sử dụng") {
+		t.Fatalf("status %d %s", code, out)
+	}
+	if _, e = os.Stat(name); !os.IsNotExist(e) {
+		t.Fatalf("old temp retained %v", e)
+	}
+	if e = os.WriteFile(filepath.Join(root, ".bint/local.yml"), []byte("state:\n  cleanup:\n    enabled: false\n"), 0600); e != nil {
+		t.Fatal(e)
+	}
+	out, code = run(t, root, "", "status")
+	if code != 0 || !strings.Contains(out, "disabled") {
+		t.Fatalf("disabled %d %s", code, out)
+	}
+}
