+package app
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"bint/internal/eval"
+	"bint/internal/fslock"
+	"bint/internal/knowledge"
+)
+
+func assertDiagnosticActivityGuard(t *testing.T, stateRoot string, wantBusy bool) {
+	t.Helper()
+	f, err := os.OpenFile(filepath.Join(stateRoot, "runtime", "cleanup.activity.lock"), os.O_CREATE|os.O_RDWR, 0o600)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	busy, err := fslock.Try(f, true)
+	if err != nil || busy != wantBusy {
+		t.Fatalf("activity guard busy=%v want=%v err=%v", busy, wantBusy, err)
+	}
+}
+
+func TestSkillTestProtectsDiagnosticWriter(t *testing.T) {
+	root := skillTestRepo(t, map[string]string{"a.yml": scenarioA})
+	k, err := OpenKnowledge(t.Context(), root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ag := &fakeSkillAgent{reply: func(_ int, req eval.AgentRequest) eval.AgentResult {
+		assertDiagnosticActivityGuard(t, k.Paths.Root, true)
+		return eval.AgentResult{Text: skillTestMarker}
+	}}
+	res, err := SkillTest(t.Context(), root, SkillTestOptions{Name: "demo-skill", Arm: "with", Reps: 1, Yes: true, Agent: ag})
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertDiagnosticActivityGuard(t, k.Paths.Root, false)
+	if res.Report.FinishedAt == "" {
+		t.Fatal("missing completion report")
+	}
+	if _, err := os.Stat(res.Path); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestRevalidateProtectsAndFinishesDiagnosticWriter(t *testing.T) {
+	root, ids, _ := seedKnowledge(t, 1, "diagnostic")
+	k, err := OpenKnowledge(t.Context(), root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	items, _, err := k.Items()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, it := range items {
+		if it.ID == ids[0] {
+			it.Type, it.Status = knowledge.TypeWarning, knowledge.StatusStale
+			if err := k.Store.Save(it); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	var logID string
+	ag := &fakeSkillAgent{reply: func(_ int, req eval.AgentRequest) eval.AgentResult {
+		assertDiagnosticActivityGuard(t, k.Paths.Root, true)
+		logID = strings.TrimSuffix(filepath.Base(req.LogPath), ".log")
+		if err := os.WriteFile(req.LogPath, []byte("diagnostic"), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		return eval.AgentResult{Text: fmt.Sprintf(`{"verdicts":[{"id":%q,"verdict":"valid","reason":"checked"}]}`, ids[0])}
+	}}
+	rep, err := RevalidateKnowledge(t.Context(), k, RevalidateOptions{Refs: ids, Agent: ag})
+	if err != nil || len(rep.Results) != 1 {
+		t.Fatalf("result %+v: %v", rep, err)
+	}
+	assertDiagnosticActivityGuard(t, k.Paths.Root, false)
+	markers, err := filepath.Glob(filepath.Join(k.Paths.Runtime, "cleanup-owners", "revalidate", "*.json"))
+	if err != nil || len(markers) != 1 {
+		t.Fatalf("markers %v: %v", markers, err)
+	}
+	b, err := os.ReadFile(markers[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	var owner struct {
+		ID         string    `json:"id"`
+		FinishedAt time.Time `json:"finished_at"`
+	}
+	if err := json.Unmarshal(b, &owner); err != nil {
+		t.Fatal(err)
+	}
+	if owner.ID != logID || owner.FinishedAt.IsZero() {
+		t.Fatalf("owner %+v", owner)
+	}
+	if _, err := os.Stat(filepath.Join(k.Paths.Runtime, "revalidate", logID+".log")); err != nil {
+		t.Fatal(err)
+	}
+}
