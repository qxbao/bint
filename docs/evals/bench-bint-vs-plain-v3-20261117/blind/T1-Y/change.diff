diff --git a/internal/maintenance/activity.go b/internal/maintenance/activity.go
new file mode 100644
index 0000000..c5b5dd0
--- /dev/null
+++ b/internal/maintenance/activity.go
@@ -0,0 +1,21 @@
+// Package maintenance bounds the lifetime of disposable operational data.
+package maintenance
+
+import (
+	"context"
+	"os"
+
+	"bint/internal/maintenance/activitylock"
+)
+
+var ErrBusy = activitylock.ErrBusy
+
+func openLock(root *os.Root, name string, exclusive bool) (*os.File, error) {
+	return activitylock.TryLock(root, name, exclusive)
+}
+
+// AcquireActivity protects a workflow/evaluation from a concurrent collector.
+// Session drivers also persist their lease while no process holds a handle.
+func AcquireActivity(ctx context.Context, stateRoot string) (func(), error) {
+	return activitylock.Acquire(ctx, stateRoot)
+}
diff --git a/internal/maintenance/activitylock/activity.go b/internal/maintenance/activitylock/activity.go
new file mode 100644
index 0000000..0d3ad16
--- /dev/null
+++ b/internal/maintenance/activitylock/activity.go
@@ -0,0 +1,97 @@
+// Package activitylock coordinates disposable data writers and collectors without
+// database dependencies. A closed handle releases the lock; its inode remains.
+package activitylock
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"bint/internal/fslock"
+)
+
+var ErrBusy = errors.New("maintenance activity lock busy")
+
+// TryLock keeps its inode in place on release. All paths are relative to an
+// opened state root; links to locations outside that root cannot be traversed.
+func TryLock(root *os.Root, name string, exclusive bool) (*os.File, error) {
+	if err := noLinks(root, filepath.Dir(name)); err != nil {
+		return nil, err
+	}
+	if fi, err := root.Lstat(name); err == nil && !fi.Mode().IsRegular() {
+		return nil, errors.New("unsafe lock file")
+	} else if err != nil && !errors.Is(err, os.ErrNotExist) {
+		return nil, err
+	}
+	f, err := root.OpenFile(name, os.O_CREATE|os.O_RDWR, 0600)
+	if err != nil {
+		return nil, err
+	}
+	busy, err := fslock.Try(f, exclusive)
+	if err != nil || busy {
+		f.Close()
+		if err == nil {
+			err = ErrBusy
+		}
+		return nil, err
+	}
+	return f, nil
+}
+
+// Acquire protects a workflow/evaluation from a concurrent collector.
+// Writers acquire this before registering activity, including resume. Session
+// drivers also persist their PendingStep/lease while no process holds a handle.
+func Acquire(ctx context.Context, stateRoot string) (func(), error) {
+	if err := os.MkdirAll(stateRoot, 0700); err != nil {
+		return nil, err
+	}
+	root, err := os.OpenRoot(stateRoot)
+	if err != nil {
+		return nil, err
+	}
+	defer root.Close()
+	if err = root.Mkdir("runtime", 0700); err != nil && !errors.Is(err, os.ErrExist) {
+		return nil, err
+	}
+	for {
+		f, err := TryLock(root, "runtime/cleanup.activity.lock", false)
+		if err == nil {
+			return func() { f.Close() }, nil
+		}
+		if !errors.Is(err, ErrBusy) {
+			return nil, err
+		}
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-time.After(5 * time.Millisecond):
+		}
+	}
+}
+
+// noLinks rejects linked path components before opening a lock relative to a
+// confined root. os.Root also prevents a later replacement from escaping it.
+func noLinks(root *os.Root, name string) error {
+	if name == "." || name == "" {
+		return nil
+	}
+	if !filepath.IsLocal(name) {
+		return errors.New("non-local maintenance path")
+	}
+	part := ""
+	for _, s := range strings.Split(filepath.Clean(name), string(filepath.Separator)) {
+		part = filepath.Join(part, s)
+		fi, err := root.Lstat(part)
+		if err != nil {
+			return err
+		}
+		if fi.Mode()&os.ModeSymlink != 0 || (!fi.IsDir() && part != name) {
+			return fmt.Errorf("unsafe maintenance path %s", part)
+		}
+	}
+	return nil
+}
diff --git a/internal/maintenance/artifact.go b/internal/maintenance/artifact.go
new file mode 100644
index 0000000..775f40b
--- /dev/null
+++ b/internal/maintenance/artifact.go
@@ -0,0 +1,93 @@
+package maintenance
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"time"
+)
+
+type artifactOwner struct {
+	ID         string    `json:"id"`
+	FinishedAt time.Time `json:"finished_at"`
+}
+
+// BeginArtifact invalidates prior completion evidence before reusing a path.
+// Callers hold AcquireActivity from before this call until after finish.
+// A crash before finish leaves no evidence: the collector retains the artifact.
+func BeginArtifact(stateRoot, kind, id string) (finish func(time.Time), err error) {
+	if (kind != "verify" && kind != "bootstrap" && kind != "evolve" && kind != "revalidate" && kind != "cache" && kind != "cache-temp" && kind != "snapshot-temp" && kind != "verify-temp") || id == "" || !filepath.IsLocal(id) || filepath.Base(id) != id {
+		return nil, errors.New("invalid artifact owner")
+	}
+	root, err := os.OpenRoot(stateRoot)
+	if err != nil {
+		return nil, err
+	}
+	defer root.Close()
+	dir := filepath.Join("runtime", "cleanup-owners", kind)
+	if err = root.MkdirAll(dir, 0700); err != nil {
+		return nil, err
+	}
+	if err = noLinks(root, dir); err != nil {
+		return nil, err
+	}
+	sum := sha256.Sum256([]byte(id))
+	name := filepath.Join(dir, hex.EncodeToString(sum[:])+".json")
+	if err = root.Remove(name); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return nil, err
+	}
+	// A durable pending marker makes a restarted verification supersede legacy
+	// YAML completion evidence even if its process dies before touching a log.
+	pending, err := json.Marshal(artifactOwner{ID: id})
+	if err != nil {
+		return nil, err
+	}
+	f, err := root.OpenFile(name, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return nil, err
+	}
+	_, err = f.Write(pending)
+	if err == nil {
+		err = f.Sync()
+	}
+	closeErr := f.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		return nil, err
+	}
+	return func(at time.Time) {
+		r, e := os.OpenRoot(stateRoot)
+		if e != nil {
+			return
+		}
+		defer r.Close()
+		if noLinks(r, dir) != nil {
+			return
+		}
+		b, e := json.Marshal(artifactOwner{id, at})
+		if e != nil {
+			return
+		}
+		tmp := name + ".tmp"
+		f, e := r.OpenFile(tmp, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+		if e != nil {
+			return
+		}
+		_, e = f.Write(b)
+		ce := f.Close()
+		if e == nil {
+			e = ce
+		}
+		if e == nil {
+			e = r.Rename(tmp, name)
+		}
+		if e != nil {
+			_ = r.Remove(tmp)
+		}
+	}, nil
+}
diff --git a/internal/maintenance/bytes_unix.go b/internal/maintenance/bytes_unix.go
new file mode 100644
index 0000000..02b3612
--- /dev/null
+++ b/internal/maintenance/bytes_unix.go
@@ -0,0 +1,16 @@
+//go:build !windows
+
+package maintenance
+
+import (
+	"os"
+	"syscall"
+)
+
+func reclaimedBytes(_ *os.File, info os.FileInfo) (int64, error) {
+	st, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || st.Nlink != 1 {
+		return 0, nil
+	}
+	return st.Blocks * 512, nil
+}
diff --git a/internal/maintenance/bytes_windows.go b/internal/maintenance/bytes_windows.go
new file mode 100644
index 0000000..a23fd57
--- /dev/null
+++ b/internal/maintenance/bytes_windows.go
@@ -0,0 +1,28 @@
+//go:build windows
+
+package maintenance
+
+import (
+	"golang.org/x/sys/windows"
+	"os"
+	"unsafe"
+)
+
+func reclaimedBytes(f *os.File, _ os.FileInfo) (int64, error) {
+	var info struct {
+		AllocationSize int64
+		EndOfFile      int64
+		NumberOfLinks  uint32
+		DeletePending  byte
+		Directory      byte
+	}
+	// FILE_STANDARD_INFO is queried on the verified file handle, not a path that
+	// could have become a junction between discovery and deletion.
+	if err := windows.GetFileInformationByHandleEx(windows.Handle(f.Fd()), windows.FileStandardInfo, (*byte)(unsafe.Pointer(&info)), uint32(unsafe.Sizeof(info))); err != nil {
+		return 0, err
+	}
+	if info.NumberOfLinks != 1 {
+		return 0, nil
+	}
+	return info.AllocationSize, nil
+}
diff --git a/internal/maintenance/collector.go b/internal/maintenance/collector.go
new file mode 100644
index 0000000..701d1d5
--- /dev/null
+++ b/internal/maintenance/collector.go
@@ -0,0 +1,447 @@
+package maintenance
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+)
+
+// Policy specifies retention only for recognised disposable data.
+type Policy struct {
+	Enabled                                        bool
+	Interval, TempTTL                              time.Duration
+	RetentionDays, BackupRetentionDays, BackupKeep int
+}
+
+func DefaultPolicy() Policy { return Policy{true, 24 * time.Hour, 24 * time.Hour, 90, 30, 3} }
+
+// Report counts successfully removed regular files and their allocated bytes.
+// Hardlinks with other references contribute zero reclaimed bytes.
+// SQLite free pages are reported separately: reusable space is not disk freed.
+type Report struct {
+	LastAttempt   time.Time `json:"last_attempt,omitempty"`
+	LastSuccess   time.Time `json:"last_success,omitempty"`
+	NextAttempt   time.Time `json:"next_attempt,omitempty"`
+	Removed       int       `json:"removed"`
+	Bytes         int64     `json:"bytes"`
+	Rows          int64     `json:"rows"`
+	ReusableBytes int64     `json:"reusable_bytes"`
+	Skip          string    `json:"skip,omitempty"`
+	Error         string    `json:"error,omitempty"`
+	Cursor        string    `json:"cursor,omitempty"`
+	OwnerCursor   string    `json:"owner_cursor,omitempty"`
+	DBCursor      string    `json:"db_cursor,omitempty"`
+}
+
+type Options struct {
+	// CasesDir is the selected repository configuration’s evals/cases directory.
+	CasesDir  string
+	Root      string
+	DB        *sql.DB
+	Policy    Policy
+	Now       time.Time
+	Limit     int
+	Budget    time.Duration
+	scanAfter string
+	// Prune is invoked under the activity guard with the protected run set.
+	Prune      func(context.Context, time.Time, map[string]bool, int) (rows, reusable int64, more bool, err error)
+	PruneAfter func(context.Context, time.Time, map[string]bool, int, string) (rows, reusable int64, more bool, cursor string, err error)
+}
+
+type candidate struct {
+	path   string
+	info   fs.FileInfo
+	cutoff time.Time
+}
+type denialOwner struct {
+	finished time.Time
+	info     fs.FileInfo
+}
+
+type owners struct {
+	denials   map[string]denialOwner
+	doneTasks map[string]time.Time
+	protected map[string]bool
+	runs      map[string]time.Time
+	sessions  map[string]time.Time
+	agents    map[string]time.Time
+	batches   map[string]time.Time
+	artifacts map[string]time.Time
+}
+
+func ReadReport(stateRoot string) (Report, error) {
+	root, err := os.OpenRoot(stateRoot)
+	if err != nil {
+		return Report{}, err
+	}
+	defer root.Close()
+	return readReport(root)
+}
+func readReport(root *os.Root) (Report, error) {
+	var rep Report
+	if err := noLinks(root, "runtime"); err != nil {
+		return rep, err
+	}
+	b, err := root.ReadFile("runtime/cleanup.json")
+	if errors.Is(err, os.ErrNotExist) {
+		return rep, nil
+	}
+	if err != nil {
+		return rep, err
+	}
+	err = json.Unmarshal(b, &rep)
+	return rep, err
+}
+func writeReport(root *os.Root, rep Report) error {
+	b, err := json.MarshalIndent(rep, "", "  ")
+	if err != nil {
+		return err
+	}
+	// Atomic replace, under cleanup.lock. Never write through an existing link.
+	if err := noLinks(root, "runtime"); err != nil {
+		return err
+	}
+	f, err := root.OpenFile("runtime/.cleanup.tmp", os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if errors.Is(err, os.ErrExist) {
+		if err = root.Remove("runtime/.cleanup.tmp"); err != nil {
+			return err
+		}
+		f, err = root.OpenFile("runtime/.cleanup.tmp", os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	}
+	if err != nil {
+		return err
+	}
+	_, err = f.Write(append(b, '\n'))
+	if err == nil {
+		err = f.Sync()
+	}
+	cerr := f.Close()
+	if err == nil {
+		err = cerr
+	}
+	if err == nil {
+		err = root.Rename("runtime/.cleanup.tmp", "runtime/cleanup.json")
+	}
+	if err != nil {
+		_ = root.Remove("runtime/.cleanup.tmp")
+	}
+	return err
+}
+
+// Collect is synchronous and bounded. It is called only after successful ingest,
+// never by hooks or by read-only status. Errors are returned in the report only.
+func Collect(ctx context.Context, o Options) (rep Report) {
+	if !o.Policy.Enabled {
+		rep.Skip = "disabled"
+		return
+	}
+	if o.Now.IsZero() {
+		o.Now = time.Now()
+	}
+	if o.Limit <= 0 || o.Limit > 1000 {
+		o.Limit = 1000
+	}
+	if o.Budget <= 0 {
+		o.Budget = 2 * time.Second
+	}
+	if o.Policy.Interval <= 0 || o.Policy.TempTTL <= 0 || o.Policy.RetentionDays < 1 || o.Policy.RetentionDays > 106751 || o.Policy.BackupRetentionDays < 1 || o.Policy.BackupRetentionDays > 106751 || o.Policy.BackupKeep < 1 {
+		rep.Error = "invalid cleanup policy"
+		return
+	}
+	root, err := os.OpenRoot(o.Root)
+	if err != nil {
+		rep.Error = err.Error()
+		return
+	}
+	defer root.Close()
+	if err = noLinks(root, "runtime"); errors.Is(err, os.ErrNotExist) {
+		err = root.Mkdir("runtime", 0700)
+	}
+	if err != nil {
+		rep.Error = err.Error()
+		return
+	}
+	lock, err := openLock(root, "runtime/cleanup.lock", true)
+	if err != nil {
+		rep.Skip = "busy"
+		if !errors.Is(err, ErrBusy) {
+			rep.Error = err.Error()
+		}
+		return
+	}
+	defer lock.Close()
+	prev, err := readReport(root)
+	if err != nil {
+		rep.Error = "cleanup marker: " + err.Error()
+		return
+	}
+	if o.Now.Before(prev.NextAttempt) {
+		prev.Skip = "not_due"
+		return prev
+	}
+	rep = Report{LastAttempt: o.Now, LastSuccess: prev.LastSuccess, Cursor: prev.Cursor, OwnerCursor: prev.OwnerCursor, DBCursor: prev.DBCursor, NextAttempt: o.Now.Add(o.Policy.Interval)}
+	// Persist the attempt BEFORE deleting. A crash/report I/O error must not cause
+	// every following ingest to repeat a destructive sweep.
+	if err = writeReport(root, rep); err != nil {
+		rep.Error = err.Error()
+		return
+	}
+	defer func() {
+		if e := writeReport(root, rep); e != nil {
+			rep.Error = joinError(rep.Error, e)
+		}
+	}()
+	retry := func(reason string, e error) {
+		rep.Skip = reason
+		rep.NextAttempt = o.Now.Add(time.Hour)
+		if e != nil {
+			rep.Error = joinError(rep.Error, e)
+		}
+	}
+	activity, err := openLock(root, "runtime/cleanup.activity.lock", true)
+	if err != nil {
+		retry("active", errWithoutBusy(err))
+		return
+	}
+	defer activity.Close()
+	ctx, cancel := context.WithTimeout(ctx, o.Budget)
+	defer cancel()
+	// Spool writers hold the shared activity guard. An un-ingested file can
+	// reference a session whose DB summary still looks completed after resume.
+	entries, e := readDirs(root, "spool")
+	if e != nil && !strings.Contains(e.Error(), "unsafe maintenance path") {
+		retry("spool", e)
+		return
+	}
+	for _, ent := range entries {
+		if strings.HasSuffix(ent.Name(), ".jsonl") {
+			retry("pending_spool", nil)
+			return
+		}
+	}
+	ownerScan := OwnerScan{After: prev.OwnerCursor, Limit: 128, CasesDir: o.CasesDir}
+	owner, err := readOwners(ctx, root, o.DB, o.Now, &ownerScan)
+	if err != nil {
+		retry("metadata", err)
+		return
+	}
+	rep.OwnerCursor = ownerScan.Next
+	cutoff := o.Now.Add(-time.Duration(o.Policy.RetentionDays) * 24 * time.Hour)
+	// Reserve half the remaining tick for deletion. Discovery may yield a
+	// partial ordered batch; its cursor survives the hourly retry.
+	remaining := o.Budget
+	if deadline, ok := ctx.Deadline(); ok {
+		remaining = time.Until(deadline)
+	}
+	scanCtx, scanCancel := context.WithTimeout(ctx, remaining/2)
+	o.scanAfter = prev.Cursor
+	candidates, err := planFiles(scanCtx, root, o, owner, cutoff)
+	scanCancel()
+	scanMore := errors.Is(err, context.DeadlineExceeded) || errors.Is(err, errScanLimit)
+	if err != nil && !scanMore {
+		retry("scan", err)
+		return
+	}
+	sort.Slice(candidates, func(i, j int) bool { return candidates[i].path < candidates[j].path })
+	count := 0
+	fileMore := scanMore
+	more := ownerScan.More
+	for _, c := range candidates {
+		if c.path <= rep.Cursor {
+			continue
+		}
+		if ctx.Err() != nil || count >= o.Limit {
+			fileMore = true
+			break
+		}
+		rep.Cursor = c.path
+		count++
+		n, e := removeCandidate(root, c)
+		if e != nil {
+			rep.Error = joinError(rep.Error, e)
+			continue
+		}
+		if n >= 0 {
+			rep.Removed++
+			rep.Bytes += n
+		}
+	}
+	if fileMore {
+		rep.OwnerCursor = prev.OwnerCursor
+		more = true
+	} else {
+		rep.Cursor = ""
+	}
+	if o.PruneAfter != nil && ctx.Err() == nil && count < o.Limit {
+		rows, reusable, dbMore, cursor, e := o.PruneAfter(ctx, cutoff, owner.protected, o.Limit-count, prev.DBCursor)
+		rep.Rows = rows
+		rep.ReusableBytes = reusable
+		rep.DBCursor = cursor
+		more = more || dbMore
+		if e != nil {
+			rep.Error = joinError(rep.Error, e)
+		}
+	} else if o.Prune != nil && ctx.Err() == nil && count < o.Limit {
+		rows, reusable, dbMore, e := o.Prune(ctx, cutoff, owner.protected, o.Limit-count)
+		rep.Rows = rows
+		rep.ReusableBytes = reusable
+		more = more || dbMore
+		if e != nil {
+			rep.Error = joinError(rep.Error, e)
+		}
+	}
+	if more || ctx.Err() != nil {
+		retry("budget", ctx.Err())
+		return
+	}
+	if rep.Error != "" {
+		retry("io", nil)
+		return
+	}
+	rep.LastSuccess = o.Now
+	rep.NextAttempt = o.Now.Add(o.Policy.Interval)
+	return
+}
+func errWithoutBusy(e error) error {
+	if errors.Is(e, ErrBusy) {
+		return nil
+	}
+	return e
+}
+func joinError(prev string, err error) string {
+	if err == nil {
+		return prev
+	}
+	if prev == "" {
+		return err.Error()
+	}
+	if len(prev) > 2048 {
+		return prev
+	}
+	return prev + "; " + err.Error()
+}
+
+// noLinks rejects links in every component, including links within the root.
+// os.Root additionally prevents escape when a component is replaced after Lstat.
+func noLinks(root *os.Root, name string) error {
+	if name == "." || name == "" {
+		return nil
+	}
+	if !filepath.IsLocal(name) {
+		return errors.New("non-local maintenance path")
+	}
+	part := ""
+	for _, s := range strings.Split(filepath.Clean(name), string(filepath.Separator)) {
+		part = filepath.Join(part, s)
+		fi, e := root.Lstat(part)
+		if e != nil {
+			return e
+		}
+		if fi.Mode()&os.ModeSymlink != 0 || (!fi.IsDir() && part != name) {
+			return fmt.Errorf("unsafe maintenance path %s", part)
+		}
+	}
+	return nil
+}
+
+func removeCandidate(root *os.Root, c candidate) (int64, error) {
+	if err := noLinks(root, filepath.Dir(c.path)); err != nil {
+		return -1, err
+	}
+	parent, err := root.OpenRoot(filepath.Dir(c.path))
+	if err != nil {
+		return -1, err
+	}
+	defer parent.Close()
+	name := filepath.Base(c.path)
+	fi, err := parent.Lstat(name)
+	if errors.Is(err, os.ErrNotExist) {
+		return -1, nil
+	}
+	if err != nil {
+		return -1, err
+	}
+	if !fi.Mode().IsRegular() || !os.SameFile(fi, c.info) || fi.Size() != c.info.Size() || !fi.ModTime().Equal(c.info.ModTime()) || !fi.ModTime().Before(c.cutoff) {
+		return -1, nil
+	}
+	f, err := parent.Open(name)
+	if err != nil {
+		return -1, err
+	}
+	opened, err := f.Stat()
+	if err != nil {
+		f.Close()
+		return -1, err
+	}
+	if !os.SameFile(fi, opened) {
+		f.Close()
+		return -1, nil
+	}
+	bytes, err := reclaimedBytes(f, opened)
+	f.Close()
+	if err != nil {
+		return -1, err
+	}
+	if err = parent.Remove(name); err != nil {
+		return -1, err
+	}
+	pruneEmptyParents(root, filepath.Dir(c.path))
+	return bytes, nil
+}
+
+// Remove only empty ancestors inside the already-selected disposable surface.
+// Never remove task roots, metadata, or a link encountered during the walk.
+func pruneEmptyParents(root *os.Root, dir string) {
+	for i := 0; i < 128; i++ {
+		p := strings.Split(filepath.ToSlash(dir), "/")
+		allowed := false
+		if len(p) == 3 && p[0] == "spool" && p[1] == "denials" && len(p[2]) == 64 && validSHA(p[2]) {
+			allowed = true
+		}
+		if len(p) >= 3 && p[0] == "backups" {
+			allowed = true
+		}
+		if len(p) == 2 && p[0] == "backups" {
+			_, e := time.Parse("20060102T150405.999999999Z", p[1])
+			allowed = e == nil
+		}
+		if len(p) >= 4 && p[0] == "runtime" && p[1] == "tasks" && p[3] == "logs" {
+			allowed = true
+		}
+		if len(p) >= 4 && p[0] == "runtime" && p[1] == "skill-tests" {
+			allowed = true
+		}
+		if len(p) >= 3 && p[0] == "eval-work" {
+			switch p[1] {
+			case "runs", "logs", "verify", "bootstrap":
+				allowed = true
+			case "bases":
+				allowed = strings.Contains(p[2], ".git.gc") || strings.HasSuffix(p[2], ".git.tmp")
+			case "knowledge":
+				allowed = strings.HasSuffix(p[2], ".tmp")
+			}
+		}
+		if len(p) >= 2 && p[0] == "tmp" && strings.HasPrefix(p[1], "verify-") {
+			allowed = true
+		}
+		if !allowed || noLinks(root, dir) != nil {
+			return
+		}
+		info, e := root.Lstat(dir)
+		if e != nil || !info.IsDir() {
+			return
+		}
+		if e = root.Remove(dir); e != nil {
+			return
+		}
+		dir = filepath.Dir(dir)
+	}
+}
