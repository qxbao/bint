+		t.Fatal(rep)
+	}
+	hasFile(t, root, "runtime/tasks/done/logs/old.log", false)
+	hasFile(t, root, "runtime/tasks/done/logs/link", true)
+}
+func TestCollectBackupPagesKeepThreePerPath(t *testing.T) {
+	root := t.TempDir()
+	now := time.Now().UTC()
+	old := now.Add(-100 * 24 * time.Hour)
+	for stamp := 1; stamp <= 8; stamp++ {
+		for _, name := range []string{"one", "two"} {
+			fixtureFile(t, root, fmt.Sprintf("backups/202601%02dT000000.000Z/%s", stamp, name), "backup", old)
+		}
+	}
+	total := 0
+	for i := 0; i < 7; i++ {
+		r := Collect(context.Background(), Options{Root: root, Now: now.Add(time.Duration(i) * 2 * time.Hour), Policy: DefaultPolicy(), Limit: 2})
+		if r.Error != "" {
+			t.Fatal(r)
+		}
+		if r.Skip != "not_due" {
+			total += r.Removed
+		}
+	}
+	if total != 10 {
+		t.Fatalf("deleted %d want10", total)
+	}
+	for stamp := 6; stamp <= 8; stamp++ {
+		for _, name := range []string{"one", "two"} {
+			hasFile(t, root, fmt.Sprintf("backups/202601%02dT000000.000Z/%s", stamp, name), true)
+		}
+	}
+}
+
+func TestCollectRetentionBoundary(t *testing.T) {
+	root := t.TempDir()
+	now := time.Date(2026, 11, 17, 0, 0, 0, 0, time.UTC)
+	for _, days := range []int{89, 90, 91} {
+		id := fmt.Sprintf("t%d", days)
+		at := now.Add(-time.Duration(days) * 24 * time.Hour)
+		fixtureFile(t, root, "runtime/tasks/"+id+"/state.json", `{"id":"`+id+`","status":"done","updated_at":"`+at.Format(time.RFC3339)+`"}`, at)
+		fixtureFile(t, root, "runtime/tasks/"+id+"/logs/agent.log", "old", at)
+	}
+	r := Collect(context.Background(), Options{Root: root, Now: now, Policy: DefaultPolicy()})
+	if r.Error != "" {
+		t.Fatal(r)
+	}
+	hasFile(t, root, "runtime/tasks/t89/logs/agent.log", true)
+	hasFile(t, root, "runtime/tasks/t90/logs/agent.log", true)
+	hasFile(t, root, "runtime/tasks/t91/logs/agent.log", false)
+}
+
+func TestCollectOwnerBatchWaitsUntilItsFilesDrain(t *testing.T) {
+	root := t.TempDir()
+	now := time.Now().UTC()
+	old := now.Add(-100 * 24 * time.Hour)
+	for i := 0; i < 130; i++ {
+		id := fmt.Sprintf("t%03d", i)
+		fixtureFile(t, root, "runtime/tasks/"+id+"/state.json", `{"id":"`+id+`","status":"done","updated_at":"`+old.Format(time.RFC3339)+`"}`, old)
+		fixtureFile(t, root, "runtime/tasks/"+id+"/logs/agent.log", "old", old)
+	}
+	r := Collect(context.Background(), Options{Root: root, Now: now, Policy: DefaultPolicy(), Limit: 1})
+	if r.Error != "" || r.Removed != 1 || r.OwnerCursor != "" {
+		t.Fatalf("partial batch %+v", r)
+	}
+	r = Collect(context.Background(), Options{Root: root, Now: now.Add(2 * time.Hour), Policy: DefaultPolicy()})
+	if r.Error != "" || r.Removed != 127 || r.OwnerCursor == "" {
+		t.Fatalf("drained first batch %+v", r)
+	}
+	r = Collect(context.Background(), Options{Root: root, Now: now.Add(4 * time.Hour), Policy: DefaultPolicy()})
+	if r.Error != "" || r.Removed != 2 || r.OwnerCursor != "" {
+		t.Fatalf("final batch %+v", r)
+	}
+}
diff --git a/internal/maintenance/denials.go b/internal/maintenance/denials.go
new file mode 100644
index 0000000..68ecb3a
--- /dev/null
+++ b/internal/maintenance/denials.go
@@ -0,0 +1,91 @@
+package maintenance
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"strings"
+	"time"
+
+	"bint/internal/spool"
+)
+
+// readDenialOwner accepts exactly the one-event format written by WriteDenial.
+// The runner consumes denials before emitting workflow.finished. A positively
+// terminal child plus a fully done owner proves that finalization has passed;
+// legacy journals therefore do not need a newly introduced completion marker.
+func readDenialOwner(ctx context.Context, root *os.Root, r *ownerResolver, path, key string) (denialOwner, bool, error) {
+	if e := ctx.Err(); e != nil {
+		return denialOwner{}, false, e
+	}
+	if e := noLinks(root, path); e != nil {
+		if errors.Is(e, os.ErrNotExist) || strings.Contains(e.Error(), "unsafe maintenance path") {
+			return denialOwner{}, false, nil
+		}
+		return denialOwner{}, false, e
+	}
+	fi, e := root.Lstat(path)
+	if e != nil {
+		return denialOwner{}, false, e
+	}
+	const maxDenialBytes = 4 << 20
+	if !fi.Mode().IsRegular() || fi.Size() <= 0 || fi.Size() > maxDenialBytes {
+		return denialOwner{}, false, nil
+	}
+	f, e := root.Open(path)
+	if e != nil {
+		return denialOwner{}, false, e
+	}
+	defer f.Close()
+	opened, e := f.Stat()
+	if e != nil {
+		return denialOwner{}, false, e
+	}
+	if !os.SameFile(fi, opened) {
+		return denialOwner{}, false, nil
+	}
+	dec := json.NewDecoder(io.LimitReader(f, maxDenialBytes+1))
+	var ev spool.Event
+	if dec.Decode(&ev) != nil || ev.Validate() != nil || ev.Type != spool.ToolDenied || ev.RunID == "" {
+		return denialOwner{}, false, nil
+	}
+	var extra any
+	if dec.Decode(&extra) != io.EOF {
+		return denialOwner{}, false, nil
+	}
+	sum := sha256.Sum256([]byte(ev.RunID))
+	if hex.EncodeToString(sum[:]) != key {
+		return denialOwner{}, false, nil
+	}
+	row, e := r.loadRun(ctx, ev.RunID)
+	if e != nil {
+		return denialOwner{}, false, e
+	}
+	// A standalone harness session or unknown workflow does not establish that
+	// workflow endStep processed this journal, even if its session has ended.
+	if row.task == "" || row.workflow == "" || row.workflow == "session" {
+		return denialOwner{}, false, nil
+	}
+	safe, e := r.run(ctx, ev.RunID, "")
+	if e != nil || !safe {
+		return denialOwner{}, false, e
+	}
+	end, ok := parseTime(row.finished)
+	if !ok {
+		return denialOwner{}, false, nil
+	}
+	taskEnd := r.taskEnds[row.task]
+	if taskEnd.IsZero() {
+		return denialOwner{}, false, nil
+	}
+	for _, at := range []time.Time{taskEnd, ev.Timestamp} {
+		if at.After(end) {
+			end = at
+		}
+	}
+	return denialOwner{finished: end, info: fi}, true, nil
+}
