+func waitSafetyPath(ctx context.Context, path string) error {
+	ticker := time.NewTicker(5 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		if _, err := os.Stat(path); err == nil {
+			return nil
+		} else if !os.IsNotExist(err) {
+			return err
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-ticker.C:
+		}
+	}
+}
+
+// The child holds the actual fslock during its first tick. The parent must
+// observe busy, then observe not_due after the child's marker is committed.
+func TestRetentionSafetyCollectorAcrossProcesses(t *testing.T) {
+	const childEnv = "BINT_RETENTION_SAFETY_CHILD"
+	now := time.Date(2026, 11, 17, 0, 0, 0, 0, time.UTC)
+	if root := os.Getenv(childEnv); root != "" {
+		rep := Collect(context.Background(), Options{Root: root, Policy: DefaultPolicy(), Now: now, Budget: 10 * time.Second, Prune: func(ctx context.Context, _ time.Time, _ map[string]bool, _ int) (int64, int64, bool, error) {
+			if err := os.WriteFile(filepath.Join(root, "child-ready"), []byte("ready"), 0600); err != nil {
+				return 0, 0, false, err
+			}
+			return 0, 0, false, waitSafetyPath(ctx, filepath.Join(root, "child-release"))
+		}})
+		b, err := json.Marshal(rep)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(root, "child-report.json"), b, 0600); err != nil {
+			t.Fatal(err)
+		}
+		if rep.Error != "" {
+			t.Fatal(rep)
+		}
+		return
+	}
+	root := t.TempDir()
+	old := now.AddDate(0, 0, -100)
+	fixtureFile(t, root, "spool/.tmp-first", "expired", old)
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestRetentionSafetyCollectorAcrossProcesses$", "-test.count=1")
+	cmd.Env = append(os.Environ(), childEnv+"="+root)
+	var output bytes.Buffer
+	cmd.Stdout = &output
+	cmd.Stderr = &output
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer cmd.Process.Kill()
+	waited := make(chan error, 1)
+	go func() { waited <- cmd.Wait() }()
+	if err := waitSafetyPath(ctx, filepath.Join(root, "child-ready")); err != nil {
+		t.Fatal(err)
+	}
+	rep := Collect(context.Background(), Options{Root: root, Policy: DefaultPolicy(), Now: now})
+	if rep.Skip != "busy" || rep.Error != "" {
+		t.Fatalf("parallel collector bypassed process lock: %+v", rep)
+	}
+	if err := os.WriteFile(filepath.Join(root, "child-release"), []byte("release"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-waited; err != nil {
+		t.Fatalf("child collector: %v\n%s", err, output.String())
+	}
+	b, err := os.ReadFile(filepath.Join(root, "child-report.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var child Report
+	if err := json.Unmarshal(b, &child); err != nil {
+		t.Fatal(err)
+	}
+	if child.Removed != 1 || !child.LastSuccess.Equal(now) {
+		t.Fatalf("first process failed collection: %+v", child)
+	}
+	fixtureFile(t, root, "spool/.tmp-next", "must wait", old)
+	rep = Collect(context.Background(), Options{Root: root, Policy: DefaultPolicy(), Now: now.Add(time.Hour)})
+	if rep.Skip != "not_due" {
+		t.Fatalf("cross-process due gate missing: %+v; child=%s", rep, fmt.Sprint(child))
+	}
+	hasFile(t, root, "spool/.tmp-next", true)
+}
