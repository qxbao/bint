+package maintenance
+
+import (
+	"bint/internal/store"
+	"bint/internal/ulid"
+	"context"
+	"crypto/sha256"
+	"database/sql"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+)
+
+type taskOwner struct {
+	ID          string          `json:"id"`
+	Status      string          `json:"status"`
+	UpdatedAt   string          `json:"updated_at"`
+	Runs        []string        `json:"runs"`
+	Runner      json.RawMessage `json:"runner"`
+	PendingStep json.RawMessage `json:"pending_step"`
+	AgentRuns   []struct {
+		AgentID string `json:"agent_id"`
+		RunID   string `json:"run_id"`
+	} `json:"agent_runs"`
+}
+
+// OwnerScan partitions retained metadata independently of disposable-file scans.
+// Unvisited owners are never assumed safe. Next is empty after a full cycle.
+type OwnerScan struct {
+	CasesDir string
+	After    string
+	Limit    int
+	Next     string
+	More     bool
+}
+
+func readDirs(root *os.Root, name string) ([]os.DirEntry, error) {
+	if e := noLinks(root, name); e != nil {
+		if errors.Is(e, os.ErrNotExist) {
+			return nil, nil
+		}
+		return nil, e
+	}
+	f, e := root.Open(name)
+	if e != nil {
+		return nil, e
+	}
+	defer f.Close()
+	entries, err := f.ReadDir(-1)
+	sort.Slice(entries, func(i, j int) bool { return entries[i].Name() < entries[j].Name() })
+	return entries, err
+}
+func parseTime(s string) (time.Time, bool) {
+	t, e := time.Parse(time.RFC3339Nano, s)
+	return t, e == nil && !t.IsZero()
+}
+func nonnull(b json.RawMessage) bool { return len(b) > 0 && string(b) != "null" }
+func localOwner(id string) bool      { return id != "" && filepath.IsLocal(id) && filepath.Base(id) == id }
+
+type ownerRun struct{ id, task, parent, status, finished, harness, session, workflow string }
+type ownerResolver struct {
+	root                    *os.Root
+	db                      *sql.DB
+	tasks                   map[string]taskOwner
+	taskEnds                map[string]time.Time
+	taskSafe                map[string]bool
+	runRows                 map[string]ownerRun
+	runSafe                 map[string]bool
+	leasedTasks, leasedRuns map[string]bool
+}
+
+func newOwnerResolver(ctx context.Context, root *os.Root, db *sql.DB, now time.Time) (*ownerResolver, error) {
+	r := &ownerResolver{root: root, db: db, tasks: map[string]taskOwner{}, taskEnds: map[string]time.Time{}, taskSafe: map[string]bool{}, runRows: map[string]ownerRun{}, runSafe: map[string]bool{}, leasedTasks: map[string]bool{}, leasedRuns: map[string]bool{}}
+	entries, e := readDirs(root, "runtime/locks")
+	if e != nil {
+		return nil, e
+	}
+	for _, ent := range entries {
+		if e := ctx.Err(); e != nil {
+			return nil, e
+		}
+		if !strings.HasSuffix(ent.Name(), ".lease.json") {
+			continue
+		}
+		name := filepath.Join("runtime/locks", ent.Name())
+		if e := noLinks(root, name); e != nil {
+			return nil, e
+		}
+		b, e := root.ReadFile(name)
+		if e != nil {
+			return nil, e
+		}
+		var ls struct {
+			Leases []struct {
+				Task  string `json:"task"`
+				RunID string `json:"run_id"`
+				Until string `json:"until"`
+			} `json:"leases"`
+		}
+		if e := json.Unmarshal(b, &ls); e != nil {
+			return nil, e
+		}
+		for _, l := range ls.Leases {
+			end, ok := parseTime(l.Until)
+			if !ok || now.Before(end) {
+				r.leasedTasks[l.Task] = true
+				r.leasedRuns[l.RunID] = true
+			}
+		}
+	}
+	return r, nil
+}
+func (r *ownerResolver) loadTask(ctx context.Context, id string) (taskOwner, error) {
+	if t, ok := r.tasks[id]; ok {
+		return t, nil
+	}
+	if !localOwner(id) {
+		return taskOwner{}, nil
+	}
+	if e := ctx.Err(); e != nil {
+		return taskOwner{}, e
+	}
+	name := filepath.Join("runtime/tasks", id, "state.json")
+	if e := noLinks(r.root, name); e != nil {
+		if errors.Is(e, os.ErrNotExist) {
+			return taskOwner{}, nil
+		}
+		return taskOwner{}, e
+	}
+	b, e := r.root.ReadFile(name)
+	if e != nil {
+		return taskOwner{}, e
+	}
+	var t taskOwner
+	if json.Unmarshal(b, &t) != nil || t.ID != id || t.Status == "" {
+		return taskOwner{}, fmt.Errorf("unknown task owner %s", id)
+	}
+	r.tasks[id] = t
+	return t, nil
+}
+func (r *ownerResolver) loadRun(ctx context.Context, id string) (ownerRun, error) {
+	if row, ok := r.runRows[id]; ok {
+		return row, nil
+	}
+	if r.db == nil {
+		return ownerRun{}, nil
+	}
+	var row ownerRun
+	e := store.RunValidationDB(ctx, r.db).QueryRowContext(ctx, `SELECT run_id,COALESCE(task_id,''),COALESCE(parent_run_id,''),status,COALESCE(finished_at,''),COALESCE(harness,''),COALESCE(harness_session_id,''),COALESCE(workflow,'') FROM runs WHERE run_id=?`, id).Scan(&row.id, &row.task, &row.parent, &row.status, &row.finished, &row.harness, &row.session, &row.workflow)
+	if errors.Is(e, sql.ErrNoRows) {
+		return ownerRun{}, nil
+	}
+	if e != nil {
+		return row, e
+	}
+	r.runRows[id] = row
+	return row, nil
+}
+func finishedRun(row ownerRun) bool {
+	_, ok := parseTime(row.finished)
+	return row.id != "" && ok && (row.status == "completed" || row.status == "failed" || row.status == "cancelled")
+}
+
+// taskState checks local activity without traversing run ownership. Shared
+// session edges are followed by disposable below, so a legitimate task/run
+// back-reference is not mistaken for an unfinished task.
+func (r *ownerResolver) taskState(ctx context.Context, id string) (taskOwner, bool, error) {
+	t, e := r.loadTask(ctx, id)
+	if e != nil {
+		return t, false, e
+	}
+	end, ok := parseTime(t.UpdatedAt)
+	if t.ID == "" || t.Status != "done" || !ok || nonnull(t.Runner) || nonnull(t.PendingStep) || r.leasedTasks[id] {
+		return t, false, nil
+	}
+	if r.db != nil {
+		var unsafe bool
+		e = store.RunValidationDB(ctx, r.db).QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM runs WHERE task_id=? AND (status IN ('created','running','interrupted') OR finished_at IS NULL OR julianday(finished_at) IS NULL) LIMIT 1)`, id).Scan(&unsafe)
+		if e != nil || unsafe {
+			return t, false, e
+		}
+	}
+	r.taskEnds[id] = end
+	return t, true, nil
+}
+
+func (r *ownerResolver) sessionLinks(ctx context.Context, id string) ([]string, bool, error) {
+	var linked string
+	e := store.RunValidationDB(ctx, r.db).QueryRowContext(ctx, `SELECT COALESCE(json_group_array(task),'[]') FROM (SELECT json_extract(payload,'$.task_id') AS task FROM events INDEXED BY events_type WHERE event_type IN ('task.linked','task.status') AND run_id=? AND json_valid(payload) AND json_extract(payload,'$.task_id') IS NOT NULL LIMIT 1001)`, id).Scan(&linked)
+	if e != nil {
+		return nil, false, e
+	}
+	var tasks []string
+	if e = json.Unmarshal([]byte(linked), &tasks); e != nil {
+		return nil, false, e
+	}
+	if len(tasks) > 1000 {
+		return nil, false, nil
+	}
+	var pending bool
+	e = store.RunValidationDB(ctx, r.db).QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM events e INDEXED BY events_type WHERE e.event_type='subagent.stopped' AND e.run_id=? AND json_valid(e.payload) AND COALESCE(json_extract(e.payload,'$.agent_id'),'')<>'' AND NOT EXISTS(SELECT 1 FROM events f INDEXED BY events_type WHERE f.run_id=e.run_id AND f.event_type='workflow.finished' AND json_valid(f.payload) AND json_extract(f.payload,'$.agent_id')=json_extract(e.payload,'$.agent_id') AND json_extract(f.payload,'$.status') IN ('completed','failed','cancelled')) LIMIT 1)`, id).Scan(&pending)
+	if e != nil {
+		return nil, false, e
+	}
+	return tasks, !pending, nil
+}
+
+type ownershipNode struct{ task, run, impliedTask string }
+
+// disposable validates the reachable ownership component. Every task and run
+// must be positively finished; revisiting an already checked node is expected
+// for multiple tasks sharing a session. No temporary false result is cached.
+func (r *ownerResolver) disposable(ctx context.Context, first ownershipNode) (bool, error) {
+	queue := []ownershipNode{first}
+	seenTasks := map[string]bool{}
+	seenRuns := map[string]bool{}
+	for len(queue) > 0 {
+		if e := ctx.Err(); e != nil {
+			return false, e
+		}
+		// Malformed huge components are retained within the tick's bounded budget.
+		if len(seenTasks)+len(seenRuns) > 1000 {
+			return false, nil
+		}
+		node := queue[0]
+		queue = queue[1:]
+		if node.task != "" {
+			if seenTasks[node.task] {
+				continue
+			}
+			seenTasks[node.task] = true
+			t, safe, e := r.taskState(ctx, node.task)
+			if e != nil || !safe {
+				return false, e
+			}
+			ids := append([]string{}, t.Runs...)
+			for _, a := range t.AgentRuns {
+				ids = append(ids, a.RunID)
+			}
+			for _, id := range ids {
+				if r.leasedRuns[id] {
+					return false, nil
+				}
+				if r.db != nil {
+					queue = append(queue, ownershipNode{run: id, impliedTask: node.task})
+				}
+			}
+			continue
+		}
+		key := node.run + "\x00" + node.impliedTask
+		if seenRuns[key] {
+			continue
+		}
+		seenRuns[key] = true
+		if node.run == "" || r.leasedRuns[node.run] {
+			return false, nil
+		}
+		row, e := r.loadRun(ctx, node.run)
+		if e != nil || !finishedRun(row) {
+			return false, e
+		}
+		task := row.task
+		if task == "" {
+			task = node.impliedTask
+		}
+		session := row.workflow == "session" && row.harness != "" && row.session != ""
+		if task == "" && (!session || len(r.leasedTasks) > 0 || len(r.leasedRuns) > 0) {
+			return false, nil
+		}
+		if task != "" {
+			queue = append(queue, ownershipNode{task: task})
+		}
+		if node.impliedTask != "" && node.impliedTask != task {
+			queue = append(queue, ownershipNode{task: node.impliedTask})
+		}
+		if session {
+			tasks, safe, e := r.sessionLinks(ctx, row.id)
+			if e != nil || !safe {
+				return false, e
+			}
+			for _, id := range tasks {
+				if id != "" {
+					queue = append(queue, ownershipNode{task: id})
+				}
+			}
+		}
+		if row.parent != "" {
+			queue = append(queue, ownershipNode{run: row.parent})
+		}
+	}
+	return true, nil
+}
+
+func (r *ownerResolver) task(ctx context.Context, id string) (bool, error) {
+	if safe, ok := r.taskSafe[id]; ok {
+		return safe, nil
+	}
+	safe, e := r.disposable(ctx, ownershipNode{task: id})
+	if e == nil {
+		r.taskSafe[id] = safe
+	}
+	return safe, e
+}
+func (r *ownerResolver) run(ctx context.Context, id, impliedTask string) (bool, error) {
+	return r.disposable(ctx, ownershipNode{run: id, impliedTask: impliedTask})
+}
+
+// NewRunValidator validates actual SQL candidates independently of the current
+// discovery partition. Unassociated runs remain unknown and retain their detail.
+// Use one returned callback per serial collector tick under ActivityGuard.
+func NewRunValidator(stateRoot string, db *sql.DB, now time.Time) store.RunValidator {
+	var resolver *ownerResolver
+	return func(ctx context.Context, id, _, _ string) (bool, error) {
+		root, e := os.OpenRoot(stateRoot)
+		if e != nil {
+			return false, e
+		}
+		defer root.Close()
+		if resolver == nil {
+			resolver, e = newOwnerResolver(ctx, root, db, now)
+			if e != nil {
+				return false, e
+			}
+		}
+		resolver.root = root
+		if safe, ok := resolver.runSafe[id]; ok {
+			return safe, nil
+		}
+		safe, e := resolver.run(ctx, id, "")
+		if e == nil {
+			resolver.runSafe[id] = safe
+		}
+		return safe, e
+	}
+}
+
+func readOwners(ctx context.Context, root *os.Root, db *sql.DB, now time.Time, scans ...*OwnerScan) (owners, error) {
+	o := owners{denials: map[string]denialOwner{}, doneTasks: map[string]time.Time{}, protected: map[string]bool{}, runs: map[string]time.Time{}, sessions: map[string]time.Time{}, agents: map[string]time.Time{}, batches: map[string]time.Time{}, artifacts: map[string]time.Time{}}
+	r, e := newOwnerResolver(ctx, root, db, now)
+	if e != nil {
+		return o, e
+	}
+	for id := range r.leasedRuns {
+		o.protected[id] = true
+	}
+	scan := &OwnerScan{Limit: 128}
+	if len(scans) > 0 && scans[0] != nil {
+		scan = scans[0]
+	}
+	if scan.Limit <= 0 {
+		scan.Limit = 128
+	}
+	scan.More = false
+	scan.Next = ""
+	type entry struct{ key, kind, id, path string }
+	var entries []entry
+	ents, e := readDirs(root, "runtime/tasks")
+	if e != nil {
+		return o, e
+	}
+	for _, ent := range ents {
+		if ent.IsDir() {
+			entries = append(entries, entry{key: "task/" + ent.Name(), kind: "task", id: ent.Name()})
+		}
+	}
+	for _, kind := range []string{"verify", "bootstrap", "evolve", "revalidate", "cache", "cache-temp", "snapshot-temp", "verify-temp"} {
+		dir := filepath.Join("runtime/cleanup-owners", kind)
+		ents, e := readDirs(root, dir)
+		if e != nil {
+			return o, e
+		}
+		for _, ent := range ents {
+			if !ent.IsDir() && strings.HasSuffix(ent.Name(), ".json") {
+				entries = append(entries, entry{key: "artifact/" + kind + "/" + ent.Name(), kind: kind, path: filepath.Join(dir, ent.Name())})
+			}
+		}
+	}
+	// Denial journal directories encode a hash, not the run ID. Discover actual
+	// producer-format files and resolve each payload's owner in the bounded batch.
+	denialDirs, e := readDirs(root, "spool/denials")
+	if e != nil {
+		if !strings.Contains(e.Error(), "unsafe maintenance path") {
+			return o, e
+		}
+	}
+	for _, dir := range denialDirs {
+		if !dir.IsDir() || len(dir.Name()) != 64 || !validSHA(dir.Name()) {
+			continue
+		}
+		rel := filepath.Join("spool/denials", dir.Name())
+		files, e := readDirs(root, rel)
+		if e != nil {
+			if strings.Contains(e.Error(), "unsafe maintenance path") {
+				continue
+			}
+			return o, e
+		}
+		for _, file := range files {
+			name := file.Name()
+			if file.IsDir() || !strings.HasSuffix(name, ".jsonl") || !ulid.Valid(strings.TrimSuffix(name, ".jsonl")) {
+				continue
+			}
+			entries = append(entries, entry{key: "denial/" + dir.Name() + "/" + name, kind: "denial", id: dir.Name(), path: filepath.Join(rel, name)})
+		}
+	}
+	// Legacy verify logs/workdirs predate cleanup completion markers. Their
+	// case/candidate Verification record supplies positive completion evidence.
+	verifyEntries, e := readDirs(root, "eval-work/verify")
+	if e != nil {
+		return o, e
+	}
+	verifyIDs := map[string]bool{}
+	for _, ent := range verifyEntries {
+		id := ent.Name()
+		if !ent.IsDir() {
+			if !strings.HasSuffix(id, ".log") {
+				continue
+			}
+			id = strings.TrimSuffix(id, ".log")
+		}
+		if localOwner(id) {
+			verifyIDs[id] = true
+		}
+	}
+	for id := range verifyIDs {
+		entries = append(entries, entry{key: "legacy-verify/" + id, kind: "legacy-verify", id: id})
+	}
+	// These filenames are reversible run/batch IDs. Resolve only actual paths by
+	// primary key; unrelated durable SQLite history is never enumerated.
+	for _, dir := range []string{"runtime/session-steps", "runtime/mcp-runs", "mcp"} {
+		ents, e := readDirs(root, dir)
+		if e != nil {
+			if strings.Contains(e.Error(), "unsafe maintenance path") {
+				continue
+			}
+			return o, e
+		}
+		for _, ent := range ents {
+			if !ent.IsDir() && strings.HasSuffix(ent.Name(), ".json") {
+				id := strings.TrimSuffix(ent.Name(), ".json")
+				entries = append(entries, entry{key: "run/" + dir + "/" + id, kind: "run", id: id})
+			}
+		}
+	}
+	for _, dir := range []string{"eval-work/runs", "eval-work/logs"} {
+		ents, e := readDirs(root, dir)
+		if e != nil {
+			return o, e
+		}
+		for _, ent := range ents {
+			if ent.IsDir() {
+				entries = append(entries, entry{key: "batch/" + dir + "/" + ent.Name(), kind: "batch", id: ent.Name()})
+			}
+		}
+	}
+	if db != nil && (scan.After < "session0") {
+		// Session hashes are intentionally one-way. Only discover their DB
+		// identity when corresponding filesystem categories actually exist.
+		contextFiles, e := readDirs(root, "runtime/context")
+		if e != nil {
+			return o, e
+		}
+		traceFiles, e := readDirs(root, "runtime/hook-trace")
+		if e != nil {
+			return o, e
+		}
+		if len(contextFiles) > 0 || len(traceFiles) > 0 {
+			after := ""
+			if strings.HasPrefix(scan.After, "session/") {
+				after = strings.TrimPrefix(scan.After, "session/")
+			}
+			rows, e := db.QueryContext(ctx, `SELECT run_id FROM runs WHERE run_id>? AND workflow='session' ORDER BY run_id LIMIT ?`, after, scan.Limit+1)
+			if e != nil {
+				return o, e
+			}
+			for rows.Next() {
+				var id string
+				if e := rows.Scan(&id); e != nil {
+					rows.Close()
+					return o, e
+				}
+				entries = append(entries, entry{key: "session/" + id, kind: "session", id: id})
+			}
+			e = rows.Err()
+			rows.Close()
+			if e != nil {
+				return o, e
+			}
+		}
+	}
+	sort.Slice(entries, func(i, j int) bool { return entries[i].key < entries[j].key })
+	count := 0
+	for _, ent := range entries {
+		if ent.key <= scan.After {
+			continue
+		}
+		if count >= scan.Limit {
+			scan.More = true
+			break
+		}
+		if e := ctx.Err(); e != nil {
+			return o, e
+		}
+		count++
+		scan.Next = ent.key
+		switch ent.kind {
+		case "denial":
+			if db == nil {
+				continue
+			}
+			denial, ok, e := readDenialOwner(ctx, root, r, ent.path, ent.id)
+			if e != nil {
+				return o, e
+			}
+			if ok {
+				o.denials[ent.path] = denial
+			}
+		case "legacy-verify":
+			end, ok, e := legacyVerificationEnd(ctx, root, scan.CasesDir, ent.id)
+			if e != nil {
+				return o, e
+			}
+			if ok {
+				o.artifacts["verify/"+ent.id] = end
+			}
+		case "task":
+			safe, e := r.task(ctx, ent.id)
+			if e != nil {
+				return o, e
+			}
+			t := r.tasks[ent.id]
+			if safe {
+				o.doneTasks[ent.id] = r.taskEnds[ent.id]
+			}
+			ids := append([]string{}, t.Runs...)
+			for _, a := range t.AgentRuns {
+				ids = append(ids, a.RunID)
+			}
+			for _, id := range ids {
+				if !safe {
+					o.protected[id] = true
+					continue
+				}
+				row, e := r.loadRun(ctx, id)
+				if e != nil {
+					return o, e
+				}
+				if finishedRun(row) {
+					end, _ := parseTime(row.finished)
+					o.runs[id] = end
+					if row.harness != "" && row.session != "" {
+						sum := sha256.Sum256([]byte(row.harness + "\x00" + row.session))
+						o.sessions[hex.EncodeToString(sum[:])[:24]] = end
+					}
+				}
+			}
+			if safe {
+				for _, a := range t.AgentRuns {
+					if end, ok := o.runs[a.RunID]; ok {
+						if r.taskEnds[t.ID].After(end) {
+							end = r.taskEnds[t.ID]
+						}
+						o.agents[a.AgentID] = end
+					}
+				}
+			}
+		case "run", "session":
+			if db == nil {
+				continue
+			}
+			safe, e := r.run(ctx, ent.id, "")
+			if e != nil {
+				return o, e
+			}
+			if safe {
+				row := r.runRows[ent.id]
+				end, _ := parseTime(row.finished)
+				o.runs[ent.id] = end
+				if row.harness != "" && row.session != "" {
+					sum := sha256.Sum256([]byte(row.harness + "\x00" + row.session))
+					o.sessions[hex.EncodeToString(sum[:])[:24]] = end
+				}
+			} else {
+				o.protected[ent.id] = true
+			}
+		case "batch":
+			if db == nil {
+				continue
+			}
+			var end string
+			e := db.QueryRowContext(ctx, `SELECT finished_at FROM eval_batches WHERE batch_id=? AND status IN ('completed','failed','cancelled','budget_exhausted') AND finished_at IS NOT NULL AND NOT EXISTS(SELECT 1 FROM evaluation_runs er WHERE er.batch_id=eval_batches.batch_id AND (er.status='running' OR er.finished_at IS NULL))`, ent.id).Scan(&end)
+			if errors.Is(e, sql.ErrNoRows) {
+				continue
+			}
+			if e != nil {
+				return o, e
+			}
+			if at, ok := parseTime(end); ok {
+				o.batches[ent.id] = at
+			}
+		default:
+			if noLinks(root, ent.path) != nil {
+				continue
+			}
+			b, e := root.ReadFile(ent.path)
+			if e != nil {
+				return o, e
+			}
+			var a artifactOwner
+			if json.Unmarshal(b, &a) == nil && localOwner(a.ID) && !a.FinishedAt.IsZero() {
+				o.artifacts[ent.kind+"/"+a.ID] = a.FinishedAt
+			}
+		}
+	}
+	if !scan.More {
+		scan.Next = ""
+	}
+	return o, nil
+}
