+	release()
+	release = nil
+	if err := cmd.Wait(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(marker); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestEvalProtectsFilesDuringBatchCallback(t *testing.T) {
+	testutil.Isolate(t)
+	root := testutil.NewRepo(t, map[string]string{"app.txt": "v1\n"})
+	env, _, db := testEnv(t, root)
+	called := false
+	_, err := Run(context.Background(), env, db, RunOptions{
+		Agent: &CommandAgent{Command: "true"},
+		OnBatch: func(string) error {
+			called = true
+			f, err := os.OpenFile(filepath.Join(filepath.Dir(env.WorkRoot), "runtime", "cleanup.activity.lock"), os.O_RDWR, 0o600)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer f.Close()
+			if busy, err := fslock.Try(f, true); err != nil || !busy {
+				t.Errorf("collector should be busy after batch registration: busy=%v err=%v", busy, err)
+			}
+			return nil
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !called {
+		t.Fatal("batch callback was not called")
+	}
+}
+
+func TestBaseCleanRetainsCacheWhenLockCannotBeOpened(t *testing.T) {
+	root := filepath.Join(t.TempDir(), "eval-work")
+	base := filepath.Join(root, "bases", "known.git")
+	if err := os.MkdirAll(base, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(base, "data"), []byte("keep"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(root, ".base-locks"), []byte("blocked"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := CleanBases(root); err == nil {
+		t.Fatal("expected lock error")
+	}
+	if _, err := os.Stat(filepath.Join(base, "data")); err != nil {
+		t.Fatal("unprotected cache was removed:", err)
+	}
+}
