+package maintenance
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"bint/internal/spool"
+	"bint/internal/store"
+)
+
+func denialFixture(t *testing.T, root, run string, at time.Time) string {
+	t.Helper()
+	dir := filepath.Join(root, "spool")
+	if err := spool.WriteDenial(dir, spool.Event{SchemaVersion: spool.SchemaVersion, EventID: "denied", Type: spool.ToolDenied, RunID: run, Timestamp: at, Source: "hook"}); err != nil {
+		t.Fatal(err)
+	}
+	key := sha256.Sum256([]byte(run))
+	files, e := spool.Pending(filepath.Join(dir, "denials", hex.EncodeToString(key[:])))
+	if e != nil || len(files) == 0 {
+		t.Fatalf("denials %v %v", files, e)
+	}
+	path := files[len(files)-1]
+	if e = os.Chtimes(path, at, at); e != nil {
+		t.Fatal(e)
+	}
+	rel, e := filepath.Rel(root, path)
+	if e != nil {
+		t.Fatal(e)
+	}
+	return rel
+}
+func denialRun(t *testing.T, root string, s *store.Store, old time.Time) {
+	t.Helper()
+	reviewTask(t, root, "done", "done", old, []string{"child"})
+	safetyExec(t, s, `INSERT INTO runs(run_id,task_id,workflow,status,finished_at) VALUES('child','done','b-feat','completed',?)`, store.FormatTime(old))
+}
+func TestCollectExpiredProcessedDenial(t *testing.T) {
+	root := t.TempDir()
+	now := time.Date(2026, 11, 17, 0, 0, 0, 0, time.UTC)
+	old := now.AddDate(0, 0, -100)
+	s := safetyStore(t, root)
+	denialRun(t, root, s, old)
+	name := denialFixture(t, root, "child", old)
+	rep := Collect(context.Background(), Options{Root: root, DB: s.DB, Policy: DefaultPolicy(), Now: now})
+	if rep.Error != "" || rep.Removed != 1 || rep.LastSuccess.IsZero() {
+		t.Fatalf("expired processed denial not collected: %+v", rep)
+	}
+	hasFile(t, root, name, false)
+	hasFile(t, root, "runtime/tasks/done/state.json", true)
+	rep = Collect(context.Background(), Options{Root: root, DB: s.DB, Policy: DefaultPolicy(), Now: now.Add(25 * time.Hour)})
+	if rep.Error != "" || rep.Removed != 0 {
+		t.Fatal(rep)
+	}
+}
+func TestCollectDenialRequiresFinishedOwnersAndExpiredEvidence(t *testing.T) {
+	for _, tc := range []string{"active-task", "runner", "pending-step", "live-lease", "active-run", "interrupted-run", "unknown-run", "unknown-workflow", "standalone-session", "fresh-file", "fresh-event", "fresh-run-end", "fresh-task-end", "boundary", "invalid-event", "wrong-run-hash"} {
+		t.Run(tc, func(t *testing.T) {
+			root := t.TempDir()
+			now := time.Date(2026, 11, 17, 0, 0, 0, 0, time.UTC)
+			old := now.AddDate(0, 0, -100)
+			s := safetyStore(t, root)
+			denialRun(t, root, s, old)
+			name := denialFixture(t, root, "child", old)
+			switch tc {
+			case "active-task":
+				reviewTask(t, root, "done", "in_progress", old, []string{"child"})
+			case "runner", "pending-step":
+				var state map[string]any
+				b, e := os.ReadFile(filepath.Join(root, "runtime/tasks/done/state.json"))
+				if e != nil {
+					t.Fatal(e)
+				}
+				if e = json.Unmarshal(b, &state); e != nil {
+					t.Fatal(e)
+				}
+				if tc == "runner" {
+					state["runner"] = map[string]any{"pid": 1}
+				} else {
+					state["pending_step"] = map[string]any{"lease_until": now.Add(time.Hour).Format(time.RFC3339)}
+				}
+				b, _ = json.Marshal(state)
+				fixtureFile(t, root, "runtime/tasks/done/state.json", string(b), old)
+			case "live-lease":
+				fixtureFile(t, root, "runtime/locks/test.lease.json", `{"leases":[{"task":"done","run_id":"child","until":"`+now.Add(time.Hour).Format(time.RFC3339)+`"}]}`, old)
+			case "active-run":
+				safetyExec(t, s, `UPDATE runs SET status='running' WHERE run_id='child'`)
+			case "interrupted-run":
+				safetyExec(t, s, `UPDATE runs SET status='interrupted' WHERE run_id='child'`)
+			case "unknown-run":
+				safetyExec(t, s, `DELETE FROM runs WHERE run_id='child'`)
+			case "unknown-workflow":
+				safetyExec(t, s, `UPDATE runs SET workflow=NULL WHERE run_id='child'`)
+			case "standalone-session":
+				safetyExec(t, s, `UPDATE runs SET workflow='session' WHERE run_id='child'`)
+			case "fresh-file":
+				if e := os.Chtimes(filepath.Join(root, name), now, now); e != nil {
+					t.Fatal(e)
+				}
+			case "fresh-event":
+				ev := spool.Event{SchemaVersion: 1, EventID: "new", Type: spool.ToolDenied, RunID: "child", Timestamp: now, Source: "hook"}
+				b, _ := json.Marshal(ev)
+				fixtureFile(t, root, name, string(b), old)
+			case "fresh-run-end":
+				safetyExec(t, s, `UPDATE runs SET finished_at=? WHERE run_id='child'`, store.FormatTime(now))
+			case "fresh-task-end":
+				reviewTask(t, root, "done", "done", now, []string{"child"})
+			case "boundary":
+				at := now.AddDate(0, 0, -90)
+				if e := os.Chtimes(filepath.Join(root, name), at, at); e != nil {
+					t.Fatal(e)
+				}
+			case "invalid-event":
+				fixtureFile(t, root, name, "broken", old)
+			case "wrong-run-hash":
+				ev := spool.Event{SchemaVersion: 1, EventID: "new", Type: spool.ToolDenied, RunID: "someone-else", Timestamp: old, Source: "hook"}
+				b, _ := json.Marshal(ev)
+				fixtureFile(t, root, name, string(b), old)
+			}
+			rep := Collect(context.Background(), Options{Root: root, DB: s.DB, Policy: DefaultPolicy(), Now: now})
+			if rep.Error != "" {
+				t.Fatal(rep)
+			}
+			hasFile(t, root, name, true)
+		})
+	}
+}
+func TestCollectDenialBatchAndSymlinks(t *testing.T) {
+	root := t.TempDir()
+	now := time.Date(2026, 11, 17, 0, 0, 0, 0, time.UTC)
+	old := now.AddDate(0, 0, -100)
+	s := safetyStore(t, root)
+	denialRun(t, root, s, old)
+	var names []string
+	for i := 0; i < 4; i++ {
+		names = append(names, denialFixture(t, root, "child", old))
+	}
+	total := 0
+	for i := 0; i < 5; i++ {
+		rep := Collect(context.Background(), Options{Root: root, DB: s.DB, Policy: DefaultPolicy(), Now: now.Add(time.Duration(i) * 2 * time.Hour), Limit: 1})
+		if rep.Error != "" {
+			t.Fatal(rep)
+		}
+		if rep.Skip != "not_due" {
+			total += rep.Removed
+		}
+	}
+	if total != 4 {
+		t.Fatalf("denial pagination removed %d want4", total)
+	}
+	for _, name := range names {
+		hasFile(t, root, name, false)
+	}
+	// An unrecognised sibling and a linked journal never nominate deletion paths.
+	external := t.TempDir()
+	fixtureFile(t, external, "keep.jsonl", "keep", old)
+	key := sha256.Sum256([]byte("child"))
+	dir := filepath.Join(root, "spool/denials", hex.EncodeToString(key[:]))
+	if e := os.MkdirAll(dir, 0700); e != nil {
+		t.Fatal(e)
+	}
+	if e := os.Symlink(filepath.Join(external, "keep.jsonl"), filepath.Join(dir, "linked.jsonl")); e != nil {
+		t.Skip(e)
+	}
+	fixtureFile(t, root, filepath.Join("spool/denials", hex.EncodeToString(key[:]), "unknown.txt"), "keep", old)
+	rep := Collect(context.Background(), Options{Root: root, DB: s.DB, Policy: DefaultPolicy(), Now: now.Add(48 * time.Hour)})
+	if rep.Error != "" {
+		t.Fatal(rep)
+	}
+	hasFile(t, external, "keep.jsonl", true)
+	hasFile(t, root, filepath.Join("spool/denials", hex.EncodeToString(key[:]), "unknown.txt"), true)
+}
diff --git a/internal/maintenance/files.go b/internal/maintenance/files.go
new file mode 100644
index 0000000..79a20cc
--- /dev/null
+++ b/internal/maintenance/files.go
@@ -0,0 +1,527 @@
+package maintenance
+
+import (
+	"bint/internal/ulid"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+)
+
+var errScanLimit = errors.New("cleanup scan batch full")
+
+func planFiles(ctx context.Context, root *os.Root, o Options, owner owners, cutoff time.Time) (out []candidate, err error) {
+	defer func() {
+		if errors.Is(err, context.DeadlineExceeded) || errors.Is(err, errScanLimit) {
+			err = errScanLimit
+		}
+	}()
+	add := func(name string, limit time.Time) error {
+		if name <= o.scanAfter {
+			return nil
+		}
+		if len(out) >= o.Limit+1 {
+			return errScanLimit
+		}
+		if e := ctx.Err(); e != nil {
+			return e
+		}
+		if e := noLinks(root, name); e != nil {
+			if errors.Is(e, os.ErrNotExist) {
+				return nil
+			}
+			return nil
+		} // links are retained
+		fi, e := root.Lstat(name)
+		if errors.Is(e, os.ErrNotExist) {
+			return nil
+		}
+		if e != nil {
+			return e
+		}
+		if fi.Mode().IsRegular() && fi.ModTime().Before(limit) {
+			out = append(out, candidate{name, fi, limit})
+		}
+		return nil
+	}
+	// walk never follows a symlink. Every deletion revalidates identity and age.
+	walk := func(name string, limit time.Time) error {
+		if e := noLinks(root, name); e != nil {
+			if errors.Is(e, os.ErrNotExist) {
+				return nil
+			}
+			return nil
+		}
+		var found []candidate
+		err := fs.WalkDir(root.FS(), filepath.ToSlash(name), func(path string, d fs.DirEntry, e error) error {
+			if e != nil {
+				return e
+			}
+			if e = ctx.Err(); e != nil {
+				return e
+			}
+			local := filepath.FromSlash(path)
+			if d.IsDir() && local < o.scanAfter && !strings.HasPrefix(o.scanAfter, local+string(filepath.Separator)) {
+				return fs.SkipDir
+			}
+			if !d.IsDir() && local <= o.scanAfter {
+				return nil
+			}
+			if len(found)+len(out) >= o.Limit+1 {
+				return errScanLimit
+			}
+			if d.Type()&os.ModeSymlink != 0 {
+				return nil
+			}
+			if d.IsDir() {
+				return nil
+			}
+			fi, e := d.Info()
+			if e != nil {
+				return e
+			}
+			if !fi.Mode().IsRegular() || !fi.ModTime().Before(limit) {
+				return nil
+			}
+			found = append(found, candidate{filepath.FromSlash(path), fi, limit})
+			return nil
+		})
+		out = append(out, found...)
+		return err
+	}
+	for _, task := range orderedKeys(owner.doneTasks) {
+		end := owner.doneTasks[task]
+		if end.Before(cutoff) {
+			if e := walk(filepath.Join("runtime/tasks", task, "logs"), cutoff); e != nil {
+				return out, e
+			}
+		}
+	}
+	for _, spec := range []struct {
+		dir, ext string
+		end      map[string]time.Time
+	}{{"runtime/context", ".ids", owner.sessions}, {"runtime/subagents", ".json", owner.agents}, {"runtime/session-steps", ".json", owner.runs}, {"runtime/mcp-runs", ".json", owner.runs}, {"mcp", ".json", owner.runs}} {
+		ents, e := readDirs(root, spec.dir)
+		if e != nil {
+			if strings.Contains(e.Error(), "unsafe maintenance path") {
+				continue
+			}
+			return out, e
+		}
+		for _, ent := range ents {
+			key := strings.TrimSuffix(ent.Name(), spec.ext)
+			if key == ent.Name() {
+				continue
+			}
+			end, ok := spec.end[key]
+			if ok && end.Before(cutoff) {
+				if e := add(filepath.Join(spec.dir, ent.Name()), cutoff); e != nil {
+					return out, e
+				}
+			}
+		}
+	}
+	// Skill-test reports are durable summaries; only their sibling log tree expires.
+	skills, e := readDirs(root, "runtime/skill-tests")
+	if e != nil {
+		return out, e
+	}
+	for _, skill := range skills {
+		if !skill.IsDir() {
+			continue
+		}
+		dir := filepath.Join("runtime/skill-tests", skill.Name())
+		ents, e := readDirs(root, dir)
+		if e != nil {
+			return out, e
+		}
+		for _, ent := range ents {
+			if !strings.HasSuffix(ent.Name(), ".json") {
+				continue
+			}
+			name := filepath.Join(dir, ent.Name())
+			if noLinks(root, name) != nil {
+				continue
+			}
+			b, e := root.ReadFile(name)
+			if e != nil {
+				return out, e
+			}
+			var report struct {
+				Status     string `json:"status"`
+				FinishedAt string `json:"finished_at"`
+			}
+			if json.Unmarshal(b, &report) != nil {
+				continue
+			}
+			end, ok := parseTime(report.FinishedAt)
+			if !ok || !end.Before(cutoff) {
+				continue
+			}
+			switch report.Status {
+			case "completed", "cancelled", "quota":
+				if e = walk(filepath.Join(dir, strings.TrimSuffix(ent.Name(), ".json")), cutoff); e != nil {
+					return out, e
+				}
+			}
+		}
+	}
+	// Trace input carries the session identity; an unpaired/unparseable output is
+	// not evidence of a finished owner and is retained.
+	traces, e := readDirs(root, "runtime/hook-trace")
+	if e != nil {
+		return out, e
+	}
+	for _, ent := range traces {
+		if !strings.HasSuffix(ent.Name(), ".in") {
+			continue
+		}
+		name := filepath.Join("runtime/hook-trace", ent.Name())
+		if noLinks(root, name) != nil {
+			continue
+		}
+		b, e := root.ReadFile(name)
+		if e != nil {
+			return out, e
+		}
+		var input struct {
+			SessionID string `json:"session_id"`
+		}
+		if json.Unmarshal(b, &input) != nil || input.SessionID == "" {
+			continue
+		}
+		for _, harness := range []string{"claude", "codex", "antigravity"} {
+			if !strings.Contains(ent.Name(), "-"+harness+"-") {
+				continue
+			}
+			sum := sha256.Sum256([]byte(harness + "\x00" + input.SessionID))
+			end, ok := owner.sessions[hex.EncodeToString(sum[:])[:24]]
+			if ok && end.Before(cutoff) {
+				if e = add(name, cutoff); e != nil {
+					return out, e
+				}
+				if e = add(strings.TrimSuffix(name, ".in")+".out", cutoff); e != nil {
+					return out, e
+				}
+			}
+		}
+	}
+	// Shell snapshots without a reversible session identity are retained.
+
+	for _, batch := range orderedKeys(owner.batches) {
+		end := owner.batches[batch]
+		if !filepath.IsLocal(batch) || strings.ContainsAny(batch, "/\\") {
+			continue
+		}
+		if end.Before(cutoff) {
+			for _, dir := range []string{"runs", "logs"} {
+				if e := walk(filepath.Join("eval-work", dir, batch), cutoff); e != nil {
+					return out, e
+				}
+			}
+		}
+	}
+	for _, spec := range []struct {
+		dir    string
+		limit  time.Time
+		accept func(string) bool
+	}{
+		{"spool", o.Now.Add(-o.Policy.TempTTL), func(n string) bool { return strings.HasPrefix(n, ".tmp-") }},
+		{"spool/rejected", cutoff, func(n string) bool { return strings.HasSuffix(n, ".jsonl") }},
+	} {
+		ents, e := readDirs(root, spec.dir)
+		if e != nil {
+			if strings.Contains(e.Error(), "unsafe maintenance path") {
+				continue
+			}
+			return out, e
+		}
+		for _, ent := range ents {
+			if spec.accept(ent.Name()) {
+				if e := add(filepath.Join(spec.dir, ent.Name()), spec.limit); e != nil {
+					return out, e
+				}
+			}
+		}
+	}
+	// The discovery batch validated each denial payload against its hashed run
+	// owner. Keep that exact file identity through planning and removal.
+	names := make([]string, 0, len(owner.denials))
+	for name := range owner.denials {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		if name <= o.scanAfter {
+			continue
+		}
+		if e := ctx.Err(); e != nil {
+			return out, e
+		}
+		if len(out) >= o.Limit+1 {
+			return out, errScanLimit
+		}
+		d := owner.denials[name]
+		if d.finished.Before(cutoff) && d.info.ModTime().Before(cutoff) {
+			out = append(out, candidate{name, d.info, cutoff})
+		}
+	}
+	// Completed verify/bootstrap paths use owner-written evidence. Legacy
+	// snapshots already contain completion metadata; their knowledge is retained.
+	entries, e := readDirs(root, "eval-work/knowledge")
+	if e != nil {
+		return out, e
+	}
+	for _, ent := range entries {
+		if !ent.IsDir() || !validSHA(ent.Name()) {
+			continue
+		}
+		name := filepath.Join("eval-work/knowledge", ent.Name(), "meta.json")
+		if noLinks(root, name) != nil {
+			continue
+		}
+		b, e := root.ReadFile(name)
+		if e != nil {
+			continue
+		}
+		var meta struct {
+			CreatedAt  string `json:"created_at"`
+			DurationMS int64  `json:"duration_ms"`
+		}
+		if json.Unmarshal(b, &meta) == nil && meta.DurationMS >= 0 {
+			if start, ok := parseTime(meta.CreatedAt); ok {
+				owner.artifacts["bootstrap/"+ent.Name()] = start.Add(time.Duration(meta.DurationMS) * time.Millisecond)
+			}
+		}
+	}
+	for _, key := range orderedKeys(owner.artifacts) {
+		end := owner.artifacts[key]
+		if !end.Before(cutoff) {
+			continue
+		}
+		kind, id, _ := strings.Cut(key, "/")
+		if !filepath.IsLocal(id) || filepath.Base(id) != id {
+			continue
+		}
+		switch kind {
+		case "evolve", "revalidate":
+			if e := add(filepath.Join("runtime", kind, id+".log"), cutoff); e != nil {
+				return out, e
+			}
+		case "verify":
+			if e := add(filepath.Join("eval-work/verify", id+".log"), cutoff); e != nil {
+				return out, e
+			}
+			if e := walk(filepath.Join("eval-work/verify", id), cutoff); e != nil {
+				return out, e
+			}
+		case "bootstrap":
+			if e := walk(filepath.Join("eval-work/bootstrap", id), cutoff); e != nil {
+				return out, e
+			}
+			if e := walk(filepath.Join("eval-work/logs/bootstrap", id), cutoff); e != nil {
+				return out, e
+			}
+		}
+	}
+	// Cache/temp removal is safe only under the exclusive activity guard: all
+	// clone, verify and bootstrap writers acquire its shared counterpart first.
+	for _, spec := range []struct {
+		dir    string
+		limit  time.Time
+		accept func(string) bool
+	}{
+		{"tmp", o.Now.Add(-o.Policy.TempTTL), func(n string) bool { return strings.HasPrefix(n, "verify-") }},
+		{"eval-work/bases", cutoff, func(n string) bool {
+			base, suffix, ok := strings.Cut(n, ".git.gc")
+			return ok && validSHA(base) && (suffix == "" || validRetiredSuffix(suffix))
+		}},
+		{"eval-work/bases", cutoff, func(n string) bool { return strings.HasSuffix(n, ".git") && validSHA(strings.TrimSuffix(n, ".git")) }},
+		{"eval-work/bases", o.Now.Add(-o.Policy.TempTTL), func(n string) bool {
+			return strings.HasSuffix(n, ".git.tmp") && validSHA(strings.TrimSuffix(n, ".git.tmp"))
+		}},
+		{"eval-work/knowledge", o.Now.Add(-o.Policy.TempTTL), func(n string) bool { return strings.HasSuffix(n, ".tmp") && validSHA(strings.TrimSuffix(n, ".tmp")) }},
+	} {
+		ents, e := readDirs(root, spec.dir)
+		if e != nil {
+			return out, e
+		}
+		for _, ent := range ents {
+			if ent.IsDir() && spec.accept(ent.Name()) {
+				dir := filepath.Join(spec.dir, ent.Name())
+				if strings.Contains(ent.Name(), ".git.gc") && spec.dir == "eval-work/bases" {
+					if e := walk(dir, spec.limit); e != nil {
+						return out, e
+					}
+					continue
+				}
+				fi, e := root.Lstat(dir)
+				if e != nil {
+					return out, e
+				}
+				kind, id := "", ""
+				switch spec.dir {
+				case "eval-work/bases":
+					kind = "cache"
+					id = strings.TrimSuffix(ent.Name(), ".git")
+					if strings.HasSuffix(ent.Name(), ".tmp") {
+						kind = "cache-temp"
+						id = strings.TrimSuffix(ent.Name(), ".git.tmp")
+					}
+				case "eval-work/knowledge":
+					kind = "snapshot-temp"
+					id = strings.TrimSuffix(ent.Name(), ".tmp")
+				case "tmp":
+					kind = "verify-temp"
+					id = ent.Name()
+				}
+				used := fi.ModTime()
+				if recorded, ok := owner.artifacts[kind+"/"+id]; ok {
+					used = recorded
+				}
+				if used.Before(spec.limit) {
+					// Persist original use time before removals change parent directory mtime.
+					// Cache writers invalidate/update this record before their next use.
+					finish, e := BeginArtifact(o.Root, kind, id)
+					if e != nil {
+						return out, e
+					}
+					finish(used)
+					if spec.dir == "eval-work/bases" && strings.HasSuffix(ent.Name(), ".git") {
+						// Retire the cache atomically before bounded file deletion. A later
+						// clone sees either the intact original or no cache, never a partial one.
+						retired := dir + ".gc"
+						if _, e := root.Lstat(retired); e == nil {
+							retired = dir + ".gc-" + ulid.New()
+						} else if !errors.Is(e, os.ErrNotExist) {
+							return out, e
+						}
+						if e = root.Rename(dir, retired); e != nil {
+							return out, e
+						}
+						dir = retired
+					}
+					if e = walk(dir, spec.limit); e != nil {
+						return out, e
+					}
+				}
+			}
+		}
+	}
+	// Discover backups in path order and validate each against newer snapshots.
+	// This avoids retaining an in-memory grouping of the entire archive before
+	// producing the first deletion; three newer occurrences are enough evidence.
+	ents, e := readDirs(root, "backups")
+	if e != nil {
+		return out, e
+	}
+	type snapshot struct {
+		name  string
+		stamp time.Time
+	}
+	var snapshots []snapshot
+	for _, ent := range ents {
+		if !ent.IsDir() {
+			continue
+		}
+		stamp, e := time.Parse("20060102T150405.999999999Z", ent.Name())
+		if e == nil && noLinks(root, filepath.Join("backups", ent.Name())) == nil {
+			snapshots = append(snapshots, snapshot{ent.Name(), stamp})
+		}
+	}
+	sort.Slice(snapshots, func(i, j int) bool { return snapshots[i].name < snapshots[j].name })
+	limit := o.Now.Add(-time.Duration(o.Policy.BackupRetentionDays) * 24 * time.Hour)
+	for i, snapshot := range snapshots {
+		if !snapshot.stamp.Before(limit) {
+			continue
+		}
+		dir := filepath.Join("backups", snapshot.name)
+		if dir < o.scanAfter && !strings.HasPrefix(o.scanAfter, dir+string(filepath.Separator)) {
+			continue
+		}
+		e = fs.WalkDir(root.FS(), filepath.ToSlash(dir), func(path string, d fs.DirEntry, e error) error {
+			if e != nil {
+				return e
+			}
+			if e = ctx.Err(); e != nil {
+				return e
+			}
+			local := filepath.FromSlash(path)
+			if d.IsDir() {
+				if local < o.scanAfter && !strings.HasPrefix(o.scanAfter, local+string(filepath.Separator)) {
+					return fs.SkipDir
+				}
+				return nil
+			}
+			if local <= o.scanAfter || d.Type()&os.ModeSymlink != 0 {
+				return nil
+			}
+			fi, e := d.Info()
+			if e != nil {
+				return e
+			}
+			if !fi.Mode().IsRegular() || !fi.ModTime().Before(limit) {
+				return nil
+			}
+			rel, e := filepath.Rel(dir, local)
+			if e != nil {
+				return e
+			}
+			newer := 0
+			for j := len(snapshots) - 1; j > i && newer < o.Policy.BackupKeep; j-- {
+				if e = ctx.Err(); e != nil {
+					return e
+				}
+				name := filepath.Join("backups", snapshots[j].name, rel)
+				if noLinks(root, name) != nil {
+					continue
+				}
+				info, e := root.Lstat(name)
+				if e == nil && info.Mode().IsRegular() {
+					newer++
+				}
+			}
+			if newer >= o.Policy.BackupKeep {
+				return add(local, limit)
+			}
+			return nil
+		})
+		if e != nil {
+			return out, e
+		}
+	}
+
+	return out, nil
+}
+
+func validSHA(s string) bool {
+	if len(s) != 40 && len(s) != 64 {
+		return false
+	}
+	for _, r := range s {
+		if !(r >= '0' && r <= '9' || r >= 'a' && r <= 'f') {
+			return false
+		}
+	}
+	return true
+}
+
+func validRetiredSuffix(s string) bool {
+	return strings.HasPrefix(s, "-") && ulid.Valid(strings.TrimPrefix(s, "-"))
+}
+
+func orderedKeys(m map[string]time.Time) []string {
+	out := make([]string, 0, len(m))
+	for key := range m {
+		out = append(out, key)
+	}
+	sort.Strings(out)
+	return out
+}
diff --git a/internal/maintenance/legacy_verify.go b/internal/maintenance/legacy_verify.go
new file mode 100644
index 0000000..e72799f
--- /dev/null
+++ b/internal/maintenance/legacy_verify.go
@@ -0,0 +1,156 @@
+package maintenance
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"gopkg.in/yaml.v3"
+)
+
+// legacyVerificationEnd uses the verification summary already stored by eval
+// before cleanup owner markers were introduced. The caller must hold the
+// exclusive activity guard and enumerate actual eval-work/verify paths, rather
+// than allowing case documents to nominate arbitrary deletion targets.
+func legacyVerificationEnd(ctx context.Context, root *os.Root, casesDir, id string) (time.Time, bool, error) {
+	if !localOwner(id) {
+		return time.Time{}, false, nil
+	}
+	if err := ctx.Err(); err != nil {
+		return time.Time{}, false, err
+	}
+	// New owner evidence (including a pending or unreadable record) supersedes
+	// all legacy summaries. An interrupted repeat verification must not revive
+	// the completion evidence of a prior run.
+	sum := sha256.Sum256([]byte(id))
+	name := filepath.Join("runtime/cleanup-owners/verify", hex.EncodeToString(sum[:])+".json")
+	if _, err := root.Lstat(name); err == nil {
+		return time.Time{}, false, nil
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return time.Time{}, false, err
+	}
+	if _, err := root.Lstat(name + ".tmp"); err == nil {
+		return time.Time{}, false, nil
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return time.Time{}, false, err
+	}
+	if casesDir != "" {
+		// Open the known repository root, allowing its physical alias, then reject
+		// links in every descendant. Opening CasesDir directly would follow a
+		// .bint/evals/cases junction before validation.
+		casesDir = filepath.Clean(casesDir)
+		if filepath.Base(casesDir) != "cases" || filepath.Base(filepath.Dir(casesDir)) != "evals" || filepath.Base(filepath.Dir(filepath.Dir(casesDir))) != ".bint" {
+			return time.Time{}, false, nil
+		}
+		repoRoot, err := os.OpenRoot(filepath.Dir(filepath.Dir(filepath.Dir(casesDir))))
+		if err != nil {
+			if !errors.Is(err, os.ErrNotExist) {
+				return time.Time{}, false, err
+			}
+		} else {
+			at, valid, found, readErr := readLegacyVerification(ctx, repoRoot, filepath.Join(".bint/evals/cases", id+".yml"), id)
+			repoRoot.Close()
+			// Match eval.Store.Get's preference for a reviewed case. A present case
+			// without valid completion evidence must not fall back to an older copy.
+			if readErr != nil || found {
+				return at, valid, readErr
+			}
+		}
+	}
+	at, valid, _, err := readLegacyVerification(ctx, root, filepath.Join("eval/candidates", id+".yml"), id)
+	return at, valid, err
+}
+
+func readLegacyVerification(ctx context.Context, root *os.Root, path, id string) (at time.Time, valid, found bool, err error) {
+	if err = ctx.Err(); err != nil {
+		return
+	}
+	// Links and non-regular files are not valid case records; retain the log.
+	// Root additionally prevents a substituted ancestor escaping the known root.
+	if e := noLinks(root, path); e != nil {
+		if errors.Is(e, os.ErrNotExist) {
+			return
+		}
+		if strings.Contains(e.Error(), "unsafe maintenance path") {
+			found = true
+			return
+		}
+		err = e
+		return
+	}
+	fi, e := root.Lstat(path)
+	if errors.Is(e, os.ErrNotExist) {
+		return
+	}
+	if e != nil {
+		err = e
+		return
+	}
+	found = true
+	if !fi.Mode().IsRegular() || fi.Size() > 1<<20 {
+		return
+	}
+	f, e := root.Open(path)
+	if e != nil {
+		err = e
+		return
+	}
+	defer f.Close()
+	opened, e := f.Stat()
+	if e != nil {
+		err = e
+		return
+	}
+	if !os.SameFile(fi, opened) {
+		return
+	}
+	data, e := io.ReadAll(io.LimitReader(f, (1<<20)+1))
+	if e != nil {
+		err = e
+		return
+	}
+	if len(data) > 1<<20 {
+		return
+	}
+	var record struct {
+		Schema int    `yaml:"schema"`
+		ID     string `yaml:"id"`
+		Status string `yaml:"status"`
+		Source struct {
+			Commit string `yaml:"commit"`
+			Base   string `yaml:"base"`
+		} `yaml:"source"`
+		Verification *struct {
+			Status     string `yaml:"status"`
+			VerifiedAt string `yaml:"verified_at"`
+		} `yaml:"verification"`
+	}
+	dec := yaml.NewDecoder(bytes.NewReader(data))
+	if dec.Decode(&record) != nil {
+		return
+	}
+	var extra any
+	if dec.Decode(&extra) != io.EOF {
+		return
+	}
+	if record.Schema != 1 || record.ID != id || record.Source.Commit == "" || record.Source.Base == "" || record.Verification == nil {
+		return
+	}
+	if record.Status != "approved" && record.Status != "rejected" {
+		return
+	}
+	switch record.Verification.Status {
+	case "verified", "failed", "error":
+	default:
+		return
+	}
+	at, valid = parseTime(record.Verification.VerifiedAt)
+	return
+}
diff --git a/internal/maintenance/legacy_verify_test.go b/internal/maintenance/legacy_verify_test.go
new file mode 100644
index 0000000..f37a05f
--- /dev/null
+++ b/internal/maintenance/legacy_verify_test.go
@@ -0,0 +1,233 @@
+package maintenance
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func legacyCaseFixture(id, status, verification, at string) string {
+	return "schema: 1\nid: " + id + "\nstatus: " + status + "\nsource:\n  commit: 0123456789abcdef\n  base: fedcba9876543210\nprompt: example\ntest_files: [test.go]\nsource_files: [main.go]\nverification:\n  status: " + verification + "\n  verified_at: " + at + "\n"
+}
+
+func TestCollectLegacyVerificationRetainsCaseRecord(t *testing.T) {
+	for _, verification := range []string{"verified", "failed", "error"} {
+		t.Run(verification, func(t *testing.T) {
+			root := t.TempDir()
+			now := time.Date(2026, 11, 17, 0, 0, 0, 0, time.UTC)
+			old := now.Add(-100 * 24 * time.Hour)
+			id := "c0123456789ab"
+			fixtureFile(t, root, "eval/candidates/"+id+".yml", legacyCaseFixture(id, "rejected", verification, old.Format(time.RFC3339)), old)
+			fixtureFile(t, root, "eval-work/verify/"+id+".log", "old diagnostics", old)
+			r := Collect(context.Background(), Options{Root: root, Policy: DefaultPolicy(), Now: now})
+			if r.Error != "" || r.Removed != 1 {
+				t.Fatalf("legacy verification not collected: %+v", r)
+			}
+			hasFile(t, root, "eval-work/verify/"+id+".log", false)
+			hasFile(t, root, "eval/candidates/"+id+".yml", true)
+		})
+	}
+}
+
+func TestLegacyVerificationEvidence(t *testing.T) {
+	now := time.Date(2026, 11, 17, 0, 0, 0, 0, time.UTC)
+	old := now.Add(-100 * 24 * time.Hour)
+	id := "c0123456789ab"
+	for _, tc := range []struct {
+		name, body string
+		want       bool
+	}{
+		{"rejected failed", legacyCaseFixture(id, "rejected", "failed", old.Format(time.RFC3339)), true},
+		{"pending candidate", legacyCaseFixture(id, "candidate", "verified", old.Format(time.RFC3339)), false},
+		{"running verification", legacyCaseFixture(id, "approved", "running", old.Format(time.RFC3339)), false},
+		{"invalid timestamp", legacyCaseFixture(id, "approved", "failed", "yesterday"), false},
+		{"mismatched id", legacyCaseFixture("another", "approved", "failed", old.Format(time.RFC3339)), false},
+		{"broken yaml", "id: [broken", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			root := t.TempDir()
+			fixtureFile(t, root, "eval/candidates/"+id+".yml", tc.body, old)
+			opened, e := os.OpenRoot(root)
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer opened.Close()
+			at, ok, e := legacyVerificationEnd(context.Background(), opened, "", id)
+			if e != nil || ok != tc.want {
+				t.Fatalf("got %v,%v,%v want recognised=%v", at, ok, e, tc.want)
+			}
+		})
+	}
+}
+
+func TestLegacyVerificationProjectCaseAndNewEvidence(t *testing.T) {
+	root := t.TempDir()
+	repo := t.TempDir()
+	now := time.Date(2026, 11, 17, 0, 0, 0, 0, time.UTC)
+	old := now.Add(-100 * 24 * time.Hour)
+	id := "c0123456789ab"
+	dir := filepath.Join(repo, ".bint/evals/cases")
+	fixtureFile(t, repo, ".bint/evals/cases/"+id+".yml", legacyCaseFixture(id, "approved", "verified", old.Format(time.RFC3339)), old)
+	opened, e := os.OpenRoot(root)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer opened.Close()
+	at, ok, e := legacyVerificationEnd(context.Background(), opened, dir, id)
+	if e != nil || !ok || !at.Equal(old) {
+		t.Fatalf("project verification: %v,%v,%v", at, ok, e)
+	}
+	sum := sha256.Sum256([]byte(id))
+	name := "runtime/cleanup-owners/verify/" + hex.EncodeToString(sum[:]) + ".json"
+	for _, body := range []string{`{"id":"` + id + `","finished_at":"` + now.Format(time.RFC3339) + `"}`, `{"id":"` + id + `"}`, "broken"} {
+		fixtureFile(t, root, name, body, now)
+		if _, ok, e = legacyVerificationEnd(context.Background(), opened, dir, id); e != nil || ok {
+			t.Fatalf("legacy evidence overrode owner %q: ok=%v err=%v", body, ok, e)
+		}
+	}
+}
+
+func TestLegacyVerificationRejectsSymlinks(t *testing.T) {
+	root := t.TempDir()
+	outside := t.TempDir()
+	old := time.Now().UTC().Add(-100 * 24 * time.Hour)
+	id := "c0123456789ab"
+	fixtureFile(t, outside, id+".yml", legacyCaseFixture(id, "approved", "verified", old.Format(time.RFC3339)), old)
+	if e := os.MkdirAll(filepath.Join(root, "eval"), 0700); e != nil {
+		t.Fatal(e)
+	}
+	if e := os.Symlink(outside, filepath.Join(root, "eval/candidates")); e != nil {
+		t.Skip(e)
+	}
+	opened, e := os.OpenRoot(root)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer opened.Close()
+	if _, ok, e := legacyVerificationEnd(context.Background(), opened, "", id); e != nil || ok {
+		t.Fatalf("followed candidate directory link: %v %v", ok, e)
+	}
+	repo := t.TempDir()
