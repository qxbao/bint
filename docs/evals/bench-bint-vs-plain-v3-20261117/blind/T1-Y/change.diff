--- /dev/null
+++ b/internal/maintenance/log.go
@@ -0,0 +1,19 @@
+package maintenance
+
+import "bint/internal/maintenance/rotatelog"
+
+// Logging remains available to collector callers; hook and gateway writers use
+// the database-free rotatelog package directly.
+const (
+	LogMaxBytes     = rotatelog.LogMaxBytes
+	LogBackups      = rotatelog.LogBackups
+	LogMaxLineBytes = rotatelog.LogMaxLineBytes
+)
+
+type LogWriter = rotatelog.LogWriter
+
+func NewLogWriter(path string) *LogWriter   { return rotatelog.NewLogWriter(path) }
+func AppendLog(path string, p []byte) error { return rotatelog.AppendLog(path, p) }
+func ReadLogTail(path string, maxBytes int64) ([]byte, error) {
+	return rotatelog.ReadLogTail(path, maxBytes)
+}
diff --git a/internal/maintenance/log_test.go b/internal/maintenance/log_test.go
new file mode 100644
index 0000000..7008c4a
--- /dev/null
+++ b/internal/maintenance/log_test.go
@@ -0,0 +1,200 @@
+package maintenance
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestLogRotationBoundaryAndBoundedWrite(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "hook-errors.log")
+	if err := os.WriteFile(p, bytes.Repeat([]byte("x"), int(LogMaxBytes)-2), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	w := NewLogWriter(p)
+	if _, err := w.Write([]byte("a\n")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(p + ".1"); !os.IsNotExist(err) {
+		t.Fatalf("rotated before crossing boundary: %v", err)
+	}
+	if _, err := w.Write([]byte("fresh\n")); err != nil {
+		t.Fatal(err)
+	}
+	if got, _ := os.ReadFile(p); string(got) != "fresh\n" {
+		t.Fatalf("fresh line: %q", got)
+	}
+	if got, _ := os.Stat(p + ".1"); got == nil || got.Size() != LogMaxBytes {
+		t.Fatalf("backup: %v", got)
+	}
+	large := bytes.Repeat([]byte("a"), LogMaxLineBytes*3)
+	if n, err := w.Write(large); err != nil || n != len(large) {
+		t.Fatalf("bounded write: %d %v", n, err)
+	}
+	if got, _ := os.Stat(p); got.Size() > LogMaxLineBytes+6 {
+		t.Fatalf("unbounded line: %d", got.Size())
+	}
+}
+
+func TestLogRotationThreeBackups(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "gateway.log")
+	w := NewLogWriter(p)
+	for i := 0; i < 6; i++ {
+		if err := os.WriteFile(p, bytes.Repeat([]byte(fmt.Sprint(i)), int(LogMaxBytes)), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := w.Write([]byte("fresh\n")); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for i := 1; i <= LogBackups; i++ {
+		if _, err := os.Stat(fmt.Sprintf("%s.%d", p, i)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err := os.Stat(p + ".4"); !os.IsNotExist(err) {
+		t.Fatalf("extra backup: %v", err)
+	}
+}
+
+func TestLogRotationErrorStillAppends(t *testing.T) {
+	dir := t.TempDir()
+	p := filepath.Join(dir, "gateway.log")
+	if err := os.WriteFile(p, bytes.Repeat([]byte("x"), int(LogMaxBytes)), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	// A directory in a backup slot is an I/O failure, not an expendable backup.
+	if err := os.Mkdir(p+".1", 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := NewLogWriter(p).Write([]byte("fresh\n")); err != nil {
+		t.Fatal(err)
+	}
+	f, err := os.Open(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	if _, err := f.Seek(-6, 2); err != nil {
+		t.Fatal(err)
+	}
+	b := make([]byte, 6)
+	if _, err := f.Read(b); err != nil {
+		t.Fatal(err)
+	}
+	if string(b) != "fresh\n" {
+		t.Fatalf("lost fresh line: %q", b)
+	}
+}
+
+func TestLogRefusesSymlinks(t *testing.T) {
+	for _, slot := range []string{"active", "lock", "backup", "directory"} {
+		t.Run(slot, func(t *testing.T) {
+			dir, outside := t.TempDir(), t.TempDir()
+			target := filepath.Join(outside, "target")
+			if err := os.WriteFile(target, []byte("untouched"), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			p := filepath.Join(dir, "gateway.log")
+			link, dest := p, target
+			switch slot {
+			case "lock":
+				link = filepath.Join(dir, ".gateway.log.lock")
+			case "backup":
+				link = p + ".1"
+			case "directory":
+				link, dest = filepath.Join(dir, "linked"), outside
+				p = filepath.Join(link, "target")
+			}
+			if err := os.Symlink(dest, link); err != nil {
+				t.Skipf("symlink unavailable: %v", err)
+			}
+			if slot == "backup" {
+				if err := os.WriteFile(p, bytes.Repeat([]byte("x"), int(LogMaxBytes)), 0o600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			_, err := NewLogWriter(p).Write([]byte("fresh\n"))
+			if slot != "backup" && err == nil {
+				t.Fatal("followed symlink")
+			}
+			if got, _ := os.ReadFile(target); string(got) != "untouched" {
+				t.Fatalf("changed target: %q", got)
+			}
+			if _, err := os.Lstat(link); err != nil {
+				t.Fatalf("removed link: %v", err)
+			}
+		})
+	}
+}
+
+func TestReadLogTailBoundedAndRefusesLink(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "gateway.log")
+	if err := os.WriteFile(p, []byte("long-prefix fresh\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	got, err := ReadLogTail(p, 6)
+	if err != nil || string(got) != "fresh\n" {
+		t.Fatalf("tail %q: %v", got, err)
+	}
+	link := filepath.Join(t.TempDir(), "link")
+	if err := os.Symlink(p, link); err != nil {
+		t.Skipf("symlink unavailable: %v", err)
+	}
+	if _, err := ReadLogTail(link, 6); err == nil {
+		t.Fatal("read through symlink")
+	}
+}
+
+func TestLogConcurrentProcesses(t *testing.T) {
+	if p := os.Getenv("BINT_TEST_LOG_PATH"); p != "" {
+		prefix := os.Getenv("BINT_TEST_LOG_PREFIX")
+		for i := 0; i < 100; i++ {
+			if _, err := NewLogWriter(p).Write([]byte(fmt.Sprintf("%s-%03d\n", prefix, i))); err != nil {
+				t.Fatal(err)
+			}
+		}
+		return
+	}
+	p := filepath.Join(t.TempDir(), "hook-errors.log")
+	// Cross the real 10 MiB boundary while writers from distinct processes race.
+	if err := os.WriteFile(p, append(bytes.Repeat([]byte("x"), int(LogMaxBytes)-20), '\n'), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	var cmds []*exec.Cmd
+	for i := 0; i < 4; i++ {
+		cmd := exec.Command(os.Args[0], "-test.run=^TestLogConcurrentProcesses$")
+		cmd.Env = append(os.Environ(), "BINT_TEST_LOG_PATH="+p, fmt.Sprintf("BINT_TEST_LOG_PREFIX=p%d", i))
+		cmd.Stdout, cmd.Stderr = &bytes.Buffer{}, &bytes.Buffer{}
+		if err := cmd.Start(); err != nil {
+			t.Fatal(err)
+		}
+		cmds = append(cmds, cmd)
+	}
+	for _, cmd := range cmds {
+		if err := cmd.Wait(); err != nil {
+			t.Fatalf("child: %v %s %s", err, cmd.Stdout, cmd.Stderr)
+		}
+	}
+	var all strings.Builder
+	for i := 0; i <= LogBackups; i++ {
+		name := p
+		if i > 0 {
+			name = fmt.Sprintf("%s.%d", p, i)
+		}
+		b, _ := os.ReadFile(name)
+		all.Write(b)
+	}
+	for i := 0; i < 4; i++ {
+		for j := 0; j < 100; j++ {
+			line := fmt.Sprintf("p%d-%03d\n", i, j)
+			if n := strings.Count(all.String(), line); n != 1 {
+				t.Fatalf("line %q occurs %d times", line, n)
+			}
+		}
+	}
+}
