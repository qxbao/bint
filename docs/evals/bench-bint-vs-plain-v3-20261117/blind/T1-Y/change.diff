+
+func TestOwnerDiscoveryDoesNotReadUnrelatedRunHistory(t *testing.T) {
+	root := t.TempDir()
+	now := time.Date(2026, 11, 17, 0, 0, 0, 0, time.UTC)
+	old := now.AddDate(0, 0, -100)
+	s := safetyStore(t, root)
+	// Large durable history is intentionally never deleted. A taskless history
+	// must not consume the collector's Go owner discovery budget on every tick.
+	safetyExec(t, s, `WITH RECURSIVE n(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM n WHERE x<100000) INSERT INTO runs(run_id,status,finished_at) SELECT 'history-'||x,'completed','2026-01-01T00:00:00.000Z' FROM n`)
+	safetyTask(t, root, old, []string{"child"})
+	safetyExec(t, s, `INSERT INTO runs(run_id,task_id,status,finished_at) VALUES('child','done','completed','2026-01-01T00:00:00.000Z')`)
+	fixtureFile(t, root, "spool/.tmp-expired", "temp", old)
+	rep := Collect(context.Background(), Options{Root: root, DB: s.DB, Policy: DefaultPolicy(), Now: now, Budget: 2 * time.Second})
+	if rep.Error != "" || rep.Removed != 2 {
+		t.Fatalf("unrelated durable history prevented disposal: %+v", rep)
+	}
+	hasFile(t, root, "runtime/tasks/done/logs/agent.log", false)
+	hasFile(t, root, "spool/.tmp-expired", false)
+	var count int
+	if err := s.DB.QueryRow(`SELECT count(*) FROM runs`).Scan(&count); err != nil || count != 100001 {
+		t.Fatalf("durable run history changed: %d %v", count, err)
+	}
+}
+
+func TestOwnerDiscoveryPartitionsTaskMetadata(t *testing.T) {
+	root := t.TempDir()
+	now := time.Date(2026, 11, 17, 0, 0, 0, 0, time.UTC)
+	old := now.AddDate(0, 0, -100)
+	for _, id := range []string{"a", "b", "c"} {
+		fixtureFile(t, root, "runtime/tasks/"+id+"/state.json", `{"id":"`+id+`","status":"done","updated_at":"2026-01-01T00:00:00Z"}`, old)
+	}
+	r, err := os.OpenRoot(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer r.Close()
+	scan := &OwnerScan{Limit: 1}
+	seen := map[string]bool{}
+	for tick := 0; tick < 4; tick++ {
+		o, err := readOwners(context.Background(), r, nil, now, scan)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(o.doneTasks) != 1 {
+			t.Fatalf("unbounded task scan: %+v", o.doneTasks)
+		}
+		for id := range o.doneTasks {
+			seen[id] = true
+		}
+		if !scan.More {
+			break
+		}
+		scan = &OwnerScan{After: scan.Next, Limit: 1}
+	}
+	if len(seen) != 3 {
+		t.Fatalf("metadata scan did not progress: %+v", seen)
+	}
+}
+
+func TestLazyRunValidatorProtectsUnselectedTaskAndAncestor(t *testing.T) {
+	root := t.TempDir()
+	now := time.Date(2026, 11, 17, 0, 0, 0, 0, time.UTC)
+	old := now.AddDate(0, 0, -100)
+	s := safetyStore(t, root)
+	fixtureFile(t, root, "runtime/tasks/active/state.json", `{"id":"active","status":"in_progress","updated_at":"2026-01-01T00:00:00Z","runs":["parent"]}`, old)
+	fixtureFile(t, root, "runtime/tasks/done/state.json", `{"id":"done","status":"done","updated_at":"2026-01-01T00:00:00Z","runs":["child"]}`, old)
+	safetyExec(t, s, `INSERT INTO runs(run_id,task_id,status,finished_at) VALUES('parent','active','completed','2026-01-01T00:00:00.000Z')`)
+	safetyExec(t, s, `INSERT INTO runs(run_id,task_id,parent_run_id,status,finished_at) VALUES('child','done','parent','completed','2026-01-01T00:00:00.000Z')`)
+	v := NewRunValidator(root, s.DB, now)
+	if ok, err := v(context.Background(), "child", "done", "parent"); err != nil || ok {
+		t.Fatalf("protected ancestor ignored: %v %v", ok, err)
+	}
+	if ok, err := v(context.Background(), "unknown", "", " "); err != nil || ok {
+		t.Fatalf("unknown owner allowed: %v %v", ok, err)
+	}
+}
+
+func TestLazyRunValidatorDeletesWithSingleConnection(t *testing.T) {
+	root := t.TempDir()
+	now := time.Date(2026, 11, 17, 0, 0, 0, 0, time.UTC)
+	old := now.AddDate(0, 0, -100)
+	safetyTask(t, root, old, []string{"child"})
+	s := safetyStore(t, root)
+	s.DB.SetMaxOpenConns(1)
+	safetyExec(t, s, `INSERT INTO runs(run_id,task_id,status,finished_at) VALUES('child','done','completed','2026-01-01T00:00:00.000Z')`)
+	safetyExec(t, s, `INSERT INTO events(event_id,run_id,event_type,source,timestamp,schema_version,ingested_at) VALUES('event','child','test','test','2026-01-01T00:00:00.000Z',1,'2026-01-01T00:00:00.000Z')`)
+	rep := Collect(context.Background(), Options{Root: root, DB: s.DB, Policy: DefaultPolicy(), Now: now, Budget: 2 * time.Second, PruneAfter: func(ctx context.Context, cutoff time.Time, protected map[string]bool, limit int, after string) (int64, int64, bool, string, error) {
+		r, err := s.PruneDetailsAfter(ctx, cutoff, protected, limit, after, NewRunValidator(root, s.DB, now))
+		return r.Events + r.ContextUsages + r.KnowledgeCitations + r.RunSkillUsages, r.FreePagesAfter * r.PageSize, r.More, r.Cursor, err
+	}})
+	if rep.Error != "" || rep.Rows != 1 {
+		t.Fatalf("single-connection validator failed to prune: %+v", rep)
+	}
+	var count int
+	if err := s.DB.QueryRow(`SELECT count(*) FROM events`).Scan(&count); err != nil || count != 0 {
+		t.Fatalf("actual event retained: %d %v", count, err)
+	}
+}
+
+func TestLazyRunValidatorCompletedSessionAndPendingSubagent(t *testing.T) {
+	for _, pending := range []bool{false, true} {
+		t.Run(map[bool]string{false: "finished", true: "unadopted-agent"}[pending], func(t *testing.T) {
+			root := t.TempDir()
+			now := time.Date(2026, 11, 17, 0, 0, 0, 0, time.UTC)
+			old := now.AddDate(0, 0, -100)
+			s := safetyStore(t, root)
+			s.DB.SetMaxOpenConns(1)
+			safetyExec(t, s, `INSERT INTO runs(run_id,workflow,status,harness,harness_session_id,finished_at) VALUES('session','session','completed','claude','old','2026-01-01T00:00:00.000Z')`)
+			safetyExec(t, s, `INSERT INTO events(event_id,run_id,event_type,source,timestamp,payload,schema_version,ingested_at) VALUES('event','session','file.read','hook','2026-01-01T00:00:00.000Z','{}',1,'2026-01-01T00:00:00.000Z')`)
+			if pending {
+				safetyExec(t, s, `INSERT INTO events(event_id,run_id,event_type,source,timestamp,payload,schema_version,ingested_at) VALUES('agent','session','subagent.stopped','hook','2026-01-01T00:00:00.000Z','{"agent_id":"unadopted"}',1,'2026-01-01T00:00:00.000Z')`)
+			}
+			hash := sha256.Sum256([]byte("claude\x00old"))
+			idsPath := "runtime/context/" + hex.EncodeToString(hash[:])[:24] + ".ids"
+			fixtureFile(t, root, idsPath, "session memory", old)
+			rep := Collect(context.Background(), Options{Root: root, DB: s.DB, Policy: DefaultPolicy(), Now: now, PruneAfter: func(ctx context.Context, cutoff time.Time, protected map[string]bool, limit int, after string) (int64, int64, bool, string, error) {
+				r, err := s.PruneDetailsAfter(ctx, cutoff, protected, limit, after, NewRunValidator(root, s.DB, now))
+				return r.Events + r.ContextUsages + r.KnowledgeCitations + r.RunSkillUsages, 0, r.More, r.Cursor, err
+			}})
+			if rep.Error != "" {
+				t.Fatal(rep)
+			}
+			hasFile(t, root, idsPath, pending)
+			want := int64(1)
+			if pending {
+				want = 0
+			}
+			if rep.Rows != want {
+				t.Fatalf("pending=%v report=%+v", pending, rep)
+			}
+		})
+	}
+}
+
+func TestLazyRunValidatorStandaloneSessionRetainedWithLiveLease(t *testing.T) {
+	root := t.TempDir()
+	now := time.Date(2026, 11, 17, 0, 0, 0, 0, time.UTC)
+	old := now.AddDate(0, 0, -100)
+	s := safetyStore(t, root)
+	safetyExec(t, s, `INSERT INTO runs(run_id,workflow,status,harness,harness_session_id,finished_at) VALUES('session','session','completed','claude','old','2026-01-01T00:00:00.000Z')`)
+	fixtureFile(t, root, "runtime/locks/external.lease.json", `{"leases":[{"task":"active","run_id":"driver","until":"2026-11-17T01:00:00Z"}]}`, old)
+	fixtureFile(t, root, "spool/.tmp-old", "unrelated expired temp", old)
+	validate := NewRunValidator(root, s.DB, now)
+	if ok, err := validate(context.Background(), "session", "", ""); err != nil || ok {
+		t.Fatalf("external driver gap exposed parent session: %v %v", ok, err)
+	}
+	rep := Collect(context.Background(), Options{Root: root, DB: s.DB, Policy: DefaultPolicy(), Now: now})
+	if rep.Error != "" || rep.Removed != 1 {
+		t.Fatalf("lease needlessly stopped unrelated file collection: %+v", rep)
+	}
+	hasFile(t, root, "spool/.tmp-old", false)
+}
