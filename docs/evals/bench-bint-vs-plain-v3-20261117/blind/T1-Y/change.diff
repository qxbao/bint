@@ -0,0 +1,56 @@
+package eval
+
+import (
+	"context"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"bint/internal/maintenance"
+	"bint/internal/ulid"
+)
+
+// beginDiagnosticLog owns only Bint's unique evolve/revalidation log names.
+// General subprocess logs retain their caller's lifecycle. Keeping this at the
+// process boundary preserves concrete agent types used for budget enforcement.
+func beginDiagnosticLog(ctx context.Context, logPath string) (func(), error) {
+	noop := func() {}
+	if logPath == "" {
+		return noop, nil
+	}
+	abs, err := filepath.Abs(logPath)
+	if err != nil {
+		return noop, nil
+	}
+	name := filepath.Base(abs)
+	if filepath.Ext(name) != ".log" {
+		return noop, nil
+	}
+	id := strings.TrimSuffix(name, ".log")
+	if !ulid.Valid(id) {
+		return noop, nil
+	}
+	kindDir := filepath.Dir(abs)
+	kind := filepath.Base(kindDir)
+	if kind != "evolve" && kind != "revalidate" {
+		return noop, nil
+	}
+	runtimeDir := filepath.Dir(kindDir)
+	if filepath.Base(runtimeDir) != "runtime" {
+		return noop, nil
+	}
+	stateRoot := filepath.Dir(runtimeDir)
+	release, err := maintenance.AcquireActivity(ctx, stateRoot)
+	if err != nil {
+		return nil, err
+	}
+	finish, err := maintenance.BeginArtifact(stateRoot, kind, id)
+	if err != nil {
+		release()
+		return nil, err
+	}
+	return func() {
+		finish(time.Now())
+		release()
+	}, nil
+}
