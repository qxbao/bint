+			}
+			for _, id := range []string{"A", "B"} {
+				hasFile(t, root, "runtime/tasks/"+id+"/logs/old.log", active)
+			}
+		})
+	}
+}
diff --git a/internal/maintenance/rotatelog/alias_test.go b/internal/maintenance/rotatelog/alias_test.go
new file mode 100644
index 0000000..ee9eb0d
--- /dev/null
+++ b/internal/maintenance/rotatelog/alias_test.go
@@ -0,0 +1,198 @@
+package rotatelog
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+)
+
+func TestChosenRootAliasPinsLogOperations(t *testing.T) {
+	for _, ancestor := range []bool{false, true} {
+		t.Run(fmt.Sprint(ancestor), func(t *testing.T) {
+			real := t.TempDir()
+			alias := filepath.Join(t.TempDir(), "state-alias")
+			if e := os.Symlink(real, alias); e != nil {
+				t.Skip(e)
+			}
+			dir := alias
+			physical := real
+			if ancestor {
+				dir = filepath.Join(alias, "gateway")
+				physical = filepath.Join(real, "gateway")
+				if e := os.Mkdir(physical, 0700); e != nil {
+					t.Fatal(e)
+				}
+			}
+			w, e := OpenLogWriter(dir, "gateway.log")
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer w.Close()
+			// Retarget the selected alias after opening. The writer must stay on its
+			// chosen directory, including rotation slots and error-tail reads.
+			outside := t.TempDir()
+			if e = os.Remove(alias); e != nil {
+				t.Fatal(e)
+			}
+			if e = os.Symlink(outside, alias); e != nil {
+				t.Fatal(e)
+			}
+			if e = os.WriteFile(filepath.Join(physical, "gateway.log"), bytes.Repeat([]byte("x"), int(LogMaxBytes)), 0600); e != nil {
+				t.Fatal(e)
+			}
+			if _, e = w.Write([]byte("fresh\n")); e != nil {
+				t.Fatal(e)
+			}
+			tail, e := w.ReadTail(6)
+			if e != nil || string(tail) != "fresh\n" {
+				t.Fatalf("tail %q: %v", tail, e)
+			}
+			got, e := os.ReadFile(filepath.Join(physical, "gateway.log"))
+			if e != nil || string(got) != "fresh\n" {
+				t.Fatalf("selected log %q: %v", got, e)
+			}
+			if fi, e := os.Stat(filepath.Join(physical, "gateway.log.1")); e != nil || fi.Size() != LogMaxBytes {
+				t.Fatalf("selected rotation: %v %v", fi, e)
+			}
+			if _, e = os.Stat(filepath.Join(outside, "gateway.log")); !os.IsNotExist(e) {
+				t.Fatalf("followed replaced alias: %v", e)
+			}
+		})
+	}
+}
+func TestChosenRootRejectsLinkedLogSlots(t *testing.T) {
+	for _, slot := range []string{"gateway.log", ".gateway.log.lock", "gateway.log.1"} {
+		t.Run(slot, func(t *testing.T) {
+			real, outside := t.TempDir(), t.TempDir()
+			target := filepath.Join(outside, "target")
+			if e := os.WriteFile(target, []byte("keep"), 0600); e != nil {
+				t.Fatal(e)
+			}
+			alias := filepath.Join(t.TempDir(), "state-alias")
+			if e := os.Symlink(real, alias); e != nil {
+				t.Skip(e)
+			}
+			if e := os.Symlink(target, filepath.Join(real, slot)); e != nil {
+				t.Skip(e)
+			}
+			if slot == "gateway.log.1" {
+				if e := os.WriteFile(filepath.Join(real, "gateway.log"), bytes.Repeat([]byte("x"), int(LogMaxBytes)), 0600); e != nil {
+					t.Fatal(e)
+				}
+			}
+			w, e := OpenLogWriter(alias, "gateway.log")
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer w.Close()
+			_, e = w.Write([]byte("fresh\n"))
+			if slot != "gateway.log.1" && e == nil {
+				t.Fatal("followed linked log/lock")
+			}
+			if slot == "gateway.log" {
+				if _, e = w.ReadTail(10); e == nil {
+					t.Fatal("followed linked log while tailing")
+				}
+			}
+			if got, e := os.ReadFile(target); e != nil || string(got) != "keep" {
+				t.Fatalf("changed link target %q %v", got, e)
+			}
+		})
+	}
+}
+func TestChosenRootRejectsRelativeTraversalAndDirectories(t *testing.T) {
+	root := t.TempDir()
+	for _, name := range []string{"", ".", "..", "../escape.log", filepath.Join("nested", "log"), filepath.Join(root, "absolute.log")} {
+		if w, e := OpenLogWriter(root, name); e == nil {
+			w.Close()
+			t.Fatalf("accepted %q", name)
+		}
+	}
+	// The legacy path API keeps its original strict directory semantics.
+	alias := filepath.Join(t.TempDir(), "alias")
+	if e := os.Symlink(root, alias); e != nil {
+		t.Skip(e)
+	}
+	if _, e := NewLogWriter(filepath.Join(alias, "log")).Write([]byte("line")); e == nil || !strings.Contains(e.Error(), "linked log directory") {
+		t.Fatalf("legacy path trust expanded: %v", e)
+	}
+}
+
+func TestPhysicalAndAliasWritersShareRotationLock(t *testing.T) {
+	root := t.TempDir()
+	alias := filepath.Join(t.TempDir(), "alias")
+	if e := os.Symlink(root, alias); e != nil {
+		t.Skip(e)
+	}
+	path := filepath.Join(root, "gateway.log")
+	if e := os.WriteFile(path, append(bytes.Repeat([]byte("x"), int(LogMaxBytes)-20), '\n'), 0600); e != nil {
+		t.Fatal(e)
+	}
+	var writers []*LogWriter
+	for i := 0; i < 4; i++ {
+		dir := root
+		if i%2 != 0 {
+			dir = alias
+		}
+		w, e := OpenLogWriter(dir, "gateway.log")
+		if e != nil {
+			t.Fatal(e)
+		}
+		defer w.Close()
+		writers = append(writers, w)
+	}
+	var wg sync.WaitGroup
+	errs := make(chan error, len(writers))
+	start := make(chan struct{})
+	for i, w := range writers {
+		wg.Add(1)
+		go func(i int, w *LogWriter) {
+			defer wg.Done()
+			<-start
+			for j := 0; j < 100; j++ {
+				if _, e := w.Write([]byte(fmt.Sprintf("writer-%d-%03d\n", i, j))); e != nil {
+					errs <- e
+					return
+				}
+			}
+		}(i, w)
+	}
+	close(start)
+	wg.Wait()
+	close(errs)
+	for e := range errs {
+		t.Fatal(e)
+	}
+	var data strings.Builder
+	for i := 0; i <= LogBackups; i++ {
+		name := path
+		if i > 0 {
+			name = fmt.Sprintf("%s.%d", path, i)
+		}
+		b, e := os.ReadFile(name)
+		if e != nil && !os.IsNotExist(e) {
+			t.Fatal(e)
+		}
+		data.Write(b)
+	}
+	for i := 0; i < 4; i++ {
+		for j := 0; j < 100; j++ {
+			line := fmt.Sprintf("writer-%d-%03d\n", i, j)
+			if n := strings.Count(data.String(), line); n != 1 {
+				t.Fatalf("%q count %d", line, n)
+			}
+		}
+	}
+	physical, e := os.Stat(filepath.Join(root, ".gateway.log.lock"))
+	if e != nil {
+		t.Fatal(e)
+	}
+	aliased, e := os.Stat(filepath.Join(alias, ".gateway.log.lock"))
+	if e != nil || !os.SameFile(physical, aliased) {
+		t.Fatalf("lock identity differs: %v", e)
+	}
+}
diff --git a/internal/maintenance/rotatelog/log.go b/internal/maintenance/rotatelog/log.go
new file mode 100644
index 0000000..21f9e5c
--- /dev/null
+++ b/internal/maintenance/rotatelog/log.go
@@ -0,0 +1,353 @@
+// Package rotatelog provides bounded diagnostic logging without database dependencies.
+package rotatelog
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"bint/internal/fslock"
+)
+
+const (
+	LogMaxBytes     int64 = 10 << 20
+	LogBackups            = 3
+	LogMaxLineBytes       = 64 << 10
+)
+
+// LogWriter reopens the current file for every append. Its permanent lock file
+// serializes rotation and append across processes, including long-lived owners.
+// No SQLite connection or repository maintenance runs on this path.
+type LogWriter struct {
+	path   string
+	mu     sync.Mutex
+	root   *os.Root
+	name   string
+	closed bool
+}
+
+func NewLogWriter(path string) *LogWriter {
+	if abs, err := filepath.Abs(path); err == nil {
+		path = abs
+	}
+	return &LogWriter{path: path}
+}
+
+// OpenLogWriter accepts aliases only for the caller-selected state root. It
+// pins that directory handle for this writer's lifetime. The log, rotation slots
+// and lock remain single relative filenames and may not be links. Call Close
+// when the hook invocation or daemon ends.
+func OpenLogWriter(stateRoot, name string) (*LogWriter, error) {
+	if name == "" || name == "." || !filepath.IsLocal(name) || filepath.Base(name) != name {
+		return nil, fmt.Errorf("log name must be a single local filename: %q", name)
+	}
+	before, err := os.Stat(stateRoot)
+	if err != nil {
+		return nil, err
+	}
+	if !before.IsDir() {
+		return nil, fmt.Errorf("log root is not a directory: %s", stateRoot)
+	}
+	root, err := os.OpenRoot(stateRoot)
+	if err != nil {
+		return nil, err
+	}
+	after, err := root.Stat(".")
+	if err != nil || !os.SameFile(before, after) {
+		root.Close()
+		return nil, fmt.Errorf("log root changed while opening %s", stateRoot)
+	}
+	return &LogWriter{root: root, name: name}, nil
+}
+
+// Ensure validates the log and lock slots and creates an empty current log.
+// Startup uses this before spawning the daemon, without adding a fake line.
+func (w *LogWriter) Ensure() error {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.closed {
+		return os.ErrClosed
+	}
+	if w.root != nil {
+		return appendLog(w.root, w.name, nil)
+	}
+	return AppendLog(w.path, nil)
+}
+
+func (w *LogWriter) Close() error {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.closed {
+		return nil
+	}
+	w.closed = true
+	if w.root != nil {
+		return w.root.Close()
+	}
+	return nil
+}
+
+// ReadTail reads diagnostics from the same pinned directory as writes. The
+// active log is revalidated and reopened, so aliases changed later cannot
+// redirect startup diagnostics to another directory.
+func (w *LogWriter) ReadTail(maxBytes int64) ([]byte, error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.closed {
+		return nil, os.ErrClosed
+	}
+	if maxBytes <= 0 {
+		return nil, nil
+	}
+	if w.root != nil {
+		return readLogTail(w.root, w.name, maxBytes)
+	}
+	return ReadLogTail(w.path, maxBytes)
+}
+
+// ReadLogTail reads only the requested suffix and applies the writer's path
+// checks, so a startup error cannot reveal a substituted symlink target.
+func ReadLogTail(path string, maxBytes int64) ([]byte, error) {
+	if maxBytes <= 0 {
+		return nil, nil
+	}
+	r, err := logOpenDir(filepath.Dir(path))
+	if err != nil {
+		return nil, err
+	}
+	defer r.Close()
+	return readLogTail(r, filepath.Base(path), maxBytes)
+}
+
+func readLogTail(r *os.Root, name string, maxBytes int64) ([]byte, error) {
+	f, err := logOpenFile(r, name, os.O_RDONLY)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	info, err := f.Stat()
+	if err != nil {
+		return nil, err
+	}
+	if info.Size() > maxBytes {
+		if _, err := f.Seek(info.Size()-maxBytes, io.SeekStart); err != nil {
+			return nil, err
+		}
+	}
+	return io.ReadAll(io.LimitReader(f, maxBytes))
+}
+
+// Write bounds each diagnostic write. Rotation errors are best effort: a fresh
+// diagnostic is appended to the current file even when a backup cannot move.
+func (w *LogWriter) Write(p []byte) (int, error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.closed {
+		return 0, os.ErrClosed
+	}
+	n := len(p)
+	if n == 0 {
+		return 0, nil
+	}
+	if len(p) > LogMaxLineBytes {
+		const suffix = " [truncated]\n"
+		p = append(append([]byte(nil), p[:LogMaxLineBytes-len(suffix)]...), suffix...)
+	}
+	var err error
+	if w.root != nil {
+		err = appendLog(w.root, w.name, p)
+	} else {
+		err = AppendLog(w.path, p)
+	}
+	if err != nil {
+		return 0, err
+	}
+	return n, nil
+}
+
+// AppendLog appends a bounded write with the same policy as LogWriter.Write.
+func AppendLog(path string, p []byte) error {
+	if len(p) > LogMaxLineBytes {
+		_, err := NewLogWriter(path).Write(p)
+		return err
+	}
+	r, err := logOpenDir(filepath.Dir(path))
+	if err != nil {
+		return err
+	}
+	defer r.Close()
+	return appendLog(r, filepath.Base(path), p)
+}
+
+func appendLog(r *os.Root, name string, p []byte) error {
+	lock, err := logOpenFile(r, "."+name+".lock", os.O_CREATE|os.O_RDWR)
+	if err != nil {
+		return err
+	}
+	defer lock.Close() // Never unlink the inode used by concurrent writers.
+	deadline := time.Now().Add(time.Second)
+	for {
+		busy, err := fslock.Try(lock, true)
+		if err != nil {
+			return err
+		}
+		if !busy {
+			break
+		}
+		if time.Now().After(deadline) {
+			return errors.New("log writer busy")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	f, err := logOpenFile(r, name, os.O_CREATE|os.O_WRONLY|os.O_APPEND)
+	if err != nil {
+		return err
+	}
+	info, err := f.Stat()
+	if err != nil {
+		f.Close()
+		return err
+	}
+	if info.Size()+int64(len(p)) > LogMaxBytes {
+		// Windows cannot rename a file held open without delete sharing. Close
+		// before moving and reopen while still owning the stable lock.
+		f.Close()
+		_ = logRotate(r, name)
+		f, err = logOpenFile(r, name, os.O_CREATE|os.O_WRONLY|os.O_APPEND)
+		if err != nil {
+			return err
+		}
+	}
+	defer f.Close()
+	_, err = f.Write(p)
+	return err
+}
+
+func logRotate(r *os.Root, name string) error {
+	// Validate every slot before changing any of them. A link or directory is
+	// not an owned log backup and must never be followed, removed or replaced.
+	for i := 0; i <= LogBackups; i++ {
+		n := name
+		if i > 0 {
+			n = fmt.Sprintf("%s.%d", name, i)
+		}
+		if err := logRegular(r, n); err != nil {
+			return err
+		}
+	}
+	for i := LogBackups; i >= 1; i-- {
+		dest := fmt.Sprintf("%s.%d", name, i)
+		src := name
+		if i > 1 {
+			src = fmt.Sprintf("%s.%d", name, i-1)
+		}
+		if _, err := r.Lstat(src); os.IsNotExist(err) {
+			continue
+		} else if err != nil {
+			return err
+		}
+		if err := logRegular(r, src); err != nil {
+			return err
+		}
+		if err := logRegular(r, dest); err != nil {
+			return err
+		}
+		if err := r.Rename(src, dest); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func logRegular(r *os.Root, name string) error {
+	info, err := r.Lstat(name)
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	if !info.Mode().IsRegular() {
+		return fmt.Errorf("refuse non-regular log file %s", name)
+	}
+	return nil
+}
+
+func logOpenFile(r *os.Root, name string, flags int) (*os.File, error) {
+	before, err := r.Lstat(name)
+	if err != nil && !os.IsNotExist(err) {
+		return nil, err
+	}
+	if err == nil && !before.Mode().IsRegular() {
+		return nil, fmt.Errorf("refuse non-regular log file %s", name)
+	}
+	// O_EXCL for a missing file prevents a newly inserted symlink from being
+	// followed between Lstat and open. Retry only after validating its identity.
+	if os.IsNotExist(err) {
+		if flags&os.O_CREATE == 0 {
+			return nil, err
+		}
+		f, err := r.OpenFile(name, flags|os.O_EXCL, 0o600)
+		if os.IsExist(err) {
+			return logOpenFile(r, name, flags)
+		}
+		return f, err
+	}
+	f, err := r.OpenFile(name, flags, 0o600)
+	if err != nil {
+		return nil, err
+	}
+	after, err := f.Stat()
+	if err != nil || !os.SameFile(before, after) {
+		f.Close()
+		return nil, fmt.Errorf("log file changed while opening %s", name)
+	}
+	return f, nil
+}
+
+// Open the directory one component at a time and verify the handle against
+// Lstat. os.Root then confines all log operations to that verified directory,
+// including if its pathname is moved while a process waits for the lock.
+func logOpenDir(path string) (*os.Root, error) {
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		return nil, err
+	}
+	volume := filepath.VolumeName(abs)
+	r, err := os.OpenRoot(volume + string(filepath.Separator))
+	if err != nil {
+		return nil, err
+	}
+	for _, component := range strings.Split(strings.TrimPrefix(abs, volume+string(filepath.Separator)), string(filepath.Separator)) {
+		if component == "" {
+			continue
+		}
+		before, err := r.Lstat(component)
+		if err != nil {
+			r.Close()
+			return nil, err
+		}
+		if !before.IsDir() || before.Mode()&os.ModeSymlink != 0 {
+			r.Close()
+			return nil, fmt.Errorf("refuse linked log directory %s", component)
+		}
+		next, err := r.OpenRoot(component)
+		if err != nil {
+			r.Close()
+			return nil, err
+		}
+		after, err := next.Stat(".")
+		r.Close()
+		if err != nil || !os.SameFile(before, after) {
+			next.Close()
+			return nil, fmt.Errorf("log directory changed while opening %s", component)
+		}
+		r = next
+	}
+	return r, nil
+}
