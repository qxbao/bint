+				t.Fatalf("claimed arbitrary log: %v", err)
+			}
+		})
+	}
+}
+
+func TestRestrictedAgentWaitsForKnownDiagnosticGuard(t *testing.T) {
+	t.Setenv("CODEX_HOME", t.TempDir())
+	root := t.TempDir()
+	if err := os.Mkdir(filepath.Join(root, "runtime"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	f, err := os.OpenFile(filepath.Join(root, "runtime", "cleanup.activity.lock"), os.O_CREATE|os.O_RDWR, 0o600)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	if busy, err := fslock.Try(f, true); err != nil || busy {
+		t.Fatalf("collector guard: %v %v", busy, err)
+	}
+	log := filepath.Join(root, "runtime", "evolve", ulid.New()+".log")
+	work := t.TempDir()
+	result := make(chan AgentResult, 1)
+	go func() {
+		result <- (&CodexRestrictedAgent{Binary: "bint-no-such-codex-binary", Model: "fixture"}).Run(t.Context(), AgentRequest{Dir: work, LogPath: log, Timeout: time.Second})
+	}()
+	select {
+	case r := <-result:
+		t.Fatalf("restricted agent bypassed guard: %+v", r)
+	case <-time.After(50 * time.Millisecond):
