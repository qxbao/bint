@@ -0,0 +1,241 @@
+package store
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// RetentionResult reports committed detail deletions separately from database
+// pages available for reuse. Pages are not bytes released to the filesystem.
+type RetentionResult struct {
+	Events             int64  `json:"events"`
+	ContextUsages      int64  `json:"context_usages"`
+	KnowledgeCitations int64  `json:"knowledge_citations"`
+	RunSkillUsages     int64  `json:"run_skill_usages"`
+	PageSize           int64  `json:"page_size"`
+	PageCount          int64  `json:"page_count"`
+	FreePagesBefore    int64  `json:"free_pages_before"`
+	FreePagesAfter     int64  `json:"free_pages_after"`
+	More               bool   `json:"more"`
+	Cursor             string `json:"cursor,omitempty"`
+}
+
+// RunValidator positively establishes whether a candidate run's durable owner
+// is disposable. False retains the row; an error aborts the whole transaction.
+type RunValidator func(context.Context, string, string, string) (bool, error)
+
+// QueryRower is the read side needed to validate a candidate's DB ownership.
+type QueryRower interface {
+	QueryRowContext(context.Context, string, ...any) *sql.Row
+}
+type validationDBKey struct{}
+
+// RunValidationDB returns the retention transaction while a validator runs. It
+// avoids borrowing a second connection (and deadlocking single-connection DBs).
+func RunValidationDB(ctx context.Context, fallback *sql.DB) QueryRower {
+	if q, ok := ctx.Value(validationDBKey{}).(QueryRower); ok {
+		return q
+	}
+	return fallback
+}
+
+// PruneDetails removes at most limit diagnostic rows in one atomic transaction.
+// Both the detail and its positively finished run must predate cutoff. Unknown,
+// interrupted, and protected runs, including details without a run, are kept.
+// All summary, business, evaluation, and rollback tables remain untouched.
+//
+// DELETE makes pages reusable by SQLite. This path never runs full VACUUM or
+// removes the database's WAL/SHM files, so it stays suitable for a bounded tick.
+func (s *Store) PruneDetails(ctx context.Context, cutoff time.Time, protectedIDs map[string]bool, limit int, validators ...RunValidator) (RetentionResult, error) {
+	return s.PruneDetailsAfter(ctx, cutoff, protectedIDs, limit, "", validators...)
+}
+
+// PruneDetailsAfter continues a bounded scan, including past rows whose owners
+// a validator retained. Persist Cursor only after a successful committed call.
+func (s *Store) PruneDetailsAfter(ctx context.Context, cutoff time.Time, protectedIDs map[string]bool, limit int, after string, validators ...RunValidator) (RetentionResult, error) {
+	if cutoff.IsZero() || limit < 1 {
+		return RetentionResult{}, fmt.Errorf("retention requires a cutoff and positive row limit")
+	}
+	// Enforce the collector's per-tick bound even for a mistaken caller.
+	limit = min(limit, 1000)
+	startTable, startRow := 0, int64(0)
+	if after != "" {
+		parts := strings.Split(after, ":")
+		if len(parts) != 2 {
+			return RetentionResult{}, fmt.Errorf("invalid retention cursor")
+		}
+		var err error
+		startTable, err = strconv.Atoi(parts[0])
+		if err != nil || startTable < 0 || startTable > 3 {
+			return RetentionResult{}, fmt.Errorf("invalid retention cursor")
+		}
+		startRow, err = strconv.ParseInt(parts[1], 10, 64)
+		if err != nil || startRow < 0 {
+			return RetentionResult{}, fmt.Errorf("invalid retention cursor")
+		}
+	}
+	protected := make([]string, 0, len(protectedIDs))
+	for id, keep := range protectedIDs {
+		if keep {
+			protected = append(protected, id)
+		}
+	}
+	encoded, err := json.Marshal(protected)
+	if err != nil {
+		return RetentionResult{}, err
+	}
+	conn, err := s.DB.Conn(ctx)
+	if err != nil {
+		return RetentionResult{}, err
+	}
+	defer conn.Close()
+	// The normal store timeout is ten seconds. A maintenance tick must yield
+	// quickly to writers rather than consuming the interactive command's budget.
+	var busyTimeout int
+	if err := conn.QueryRowContext(ctx, `PRAGMA busy_timeout`).Scan(&busyTimeout); err != nil {
+		return RetentionResult{}, err
+	}
+	if _, err := conn.ExecContext(ctx, `PRAGMA busy_timeout=50`); err != nil {
+		return RetentionResult{}, err
+	}
+	defer func() {
+		_, _ = conn.ExecContext(context.Background(), fmt.Sprintf(`PRAGMA busy_timeout=%d`, busyTimeout))
+	}()
+	if _, err := conn.ExecContext(ctx, `PRAGMA foreign_keys=ON`); err != nil {
+		return RetentionResult{}, err
+	}
+	tx, err := conn.BeginTx(ctx, nil)
+	if err != nil {
+		return RetentionResult{}, err
+	}
+	defer tx.Rollback()
+	failure := func(err error) (RetentionResult, error) {
+		if ctx.Err() != nil {
+			err = ctx.Err()
+		}
+		return RetentionResult{}, fmt.Errorf("prune run details: %w", err)
+	}
+	var result RetentionResult
+	if err := tx.QueryRowContext(ctx, `PRAGMA page_size`).Scan(&result.PageSize); err != nil {
+		return failure(err)
+	}
+	if err := tx.QueryRowContext(ctx, `PRAGMA freelist_count`).Scan(&result.FreePagesBefore); err != nil {
+		return failure(err)
+	}
+	tables := []struct {
+		name, timestamp string
+		count           *int64
+	}{
+		{"events", "timestamp", &result.Events},
+		{"context_usages", "created_at", &result.ContextUsages},
+		{"knowledge_citations", "created_at", &result.KnowledgeCitations},
+		{"run_skill_usages", "created_at", &result.RunSkillUsages},
+	}
+	remaining := int64(limit)
+	for index, table := range tables {
+		if index < startTable {
+			continue
+		}
+		rowAfter := int64(0)
+		if index == startTable {
+			rowAfter = startRow
+		}
+		// Fixed table/column identifiers only. JSON avoids SQLite's parameter
+		// limit for repositories with many protected sessions.
+		eligible := fmt.Sprintf(`SELECT d.rowid,r.run_id,COALESCE(r.task_id,''),COALESCE(r.parent_run_id,'') FROM %s AS d JOIN runs AS r ON r.run_id=d.run_id
+			WHERE r.status IN ('completed','failed','cancelled')
+			AND r.finished_at < ? AND strftime('%%Y-%%m-%%dT%%H:%%M:%%fZ',r.finished_at)=r.finished_at
+			AND d.%s < ? AND strftime('%%Y-%%m-%%dT%%H:%%M:%%fZ',d.%s)=d.%s
+			AND NOT EXISTS(SELECT 1 FROM json_each(?) AS p WHERE p.value=r.run_id)
+			AND d.rowid > ? ORDER BY d.rowid LIMIT ?`, table.name, table.timestamp, table.timestamp, table.timestamp)
+		if table.name == "events" {
+			// These compact events are durable ownership/provenance records. Later
+			// ticks and resumed tasks must still resolve every linked task and agent.
+			// Keeping them also preserves runlog's agent-event adoption mapping.
+			eligible = strings.Replace(eligible, "AND d.rowid > ?", `AND d.event_type NOT IN ('task.linked','task.status','workflow.finished','subagent.stopped') AND d.rowid > ?`, 1)
+		}
+		rows, err := tx.QueryContext(ctx, eligible, FormatTime(cutoff), FormatTime(cutoff), string(encoded), rowAfter, remaining+1)
+		if err != nil {
+			return failure(err)
+		}
+		type detail struct {
+			row               int64
+			run, task, parent string
+		}
+		var details []detail
+		for rows.Next() {
+			var d detail
+			if err := rows.Scan(&d.row, &d.run, &d.task, &d.parent); err != nil {
+				rows.Close()
+				return failure(err)
+			}
+			details = append(details, d)
+		}
+		err = rows.Err()
+		rows.Close()
+		if err != nil {
+			return failure(err)
+		}
+		if int64(len(details)) > remaining {
+			details = details[:remaining]
+			result.More = true
+		}
+		var approved []int64
+		for _, d := range details {
+			remaining--
+			result.Cursor = fmt.Sprintf("%d:%d", index, d.row)
+			keep := false
+			for _, validate := range validators {
+				if validate == nil {
+					continue
+				}
+				ok, err := validate(context.WithValue(ctx, validationDBKey{}, tx), d.run, d.task, d.parent)
+				if err != nil {
+					return failure(err)
+				}
+				if !ok {
+					keep = true
+					break
+				}
+			}
+			if !keep {
+				approved = append(approved, d.row)
+			}
+		}
+		if len(approved) > 0 {
+			ids, err := json.Marshal(approved)
+			if err != nil {
+				return failure(err)
+			}
+			deleted, err := tx.ExecContext(ctx, `DELETE FROM `+table.name+` WHERE rowid IN (SELECT value FROM json_each(?))`, string(ids))
+			if err != nil {
+				return failure(err)
+			}
+			*table.count, err = deleted.RowsAffected()
+			if err != nil {
+				return failure(err)
+			}
+		}
+		if result.More {
+			break
+		}
+	}
+	if !result.More {
+		result.Cursor = ""
+	}
+	if err := tx.QueryRowContext(ctx, `PRAGMA page_count`).Scan(&result.PageCount); err != nil {
+		return failure(err)
+	}
+	if err := tx.QueryRowContext(ctx, `PRAGMA freelist_count`).Scan(&result.FreePagesAfter); err != nil {
+		return failure(err)
+	}
+	if err := tx.Commit(); err != nil {
+		return failure(err)
+	}
+	return result, nil
+}
diff --git a/internal/store/retention_test.go b/internal/store/retention_test.go
new file mode 100644
index 0000000..c3dfadf
--- /dev/null
+++ b/internal/store/retention_test.go
@@ -0,0 +1,358 @@
+package store
+
+import (
+	"context"
+	"database/sql/driver"
+	"errors"
+	"fmt"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"modernc.org/sqlite"
+)
+
+var retentionCutoff = time.Date(2026, 8, 19, 0, 0, 0, 0, time.UTC)
+
+func retentionStore(t *testing.T) *Store {
+	t.Helper()
+	s, err := Open(context.Background(), filepath.Join(t.TempDir(), "state.sqlite"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { s.Close() })
+	return s
+}
+
+func retentionExec(t *testing.T, s *Store, query string, args ...any) {
+	t.Helper()
+	if _, err := s.DB.Exec(query, args...); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func retentionRun(t *testing.T, s *Store, id, status string, finished any) {
+	t.Helper()
+	retentionExec(t, s, `INSERT INTO runs(run_id,status,finished_at) VALUES(?,?,?)`, id, status, finished)
+}
+
+func retentionDetails(t *testing.T, s *Store, id string, run any, timestamp string, payload string) {
+	t.Helper()
+	retentionExec(t, s, `INSERT INTO events(event_id,run_id,event_type,source,timestamp,payload,schema_version,ingested_at) VALUES(?,?,'test','test',?,?,1,?)`, id, run, timestamp, payload, timestamp)
+	retentionExec(t, s, `INSERT INTO context_usages(usage_id,run_id,event_id,channel,item_id,created_at) VALUES(?,?,?,'cli','knowledge',?)`, id, run, id, timestamp)
+	retentionExec(t, s, `INSERT INTO knowledge_citations(citation_id,run_id,event_id,item_id,created_at) VALUES(?,?,?,'knowledge',?)`, id, run, id, timestamp)
+	retentionExec(t, s, `INSERT INTO run_skill_usages(usage_id,run_id,event_id,skill,created_at) VALUES(?,?,?,'skill',?)`, id, run, id, timestamp)
+}
+
+func retentionCount(t *testing.T, s *Store, table string) int64 {
+	t.Helper()
+	var count int64
+	if err := s.DB.QueryRow("SELECT count(*) FROM " + table).Scan(&count); err != nil {
+		t.Fatal(err)
+	}
+	return count
+}
+
+// Removing the completed-run, age, or protection predicates must expose the
+// active, resumed, unknown, and boundary fixtures below to an unsafe deletion.
+func TestPruneDetailsEligibilityAndPreservedData(t *testing.T) {
+	s := retentionStore(t)
+	old := "2026-01-01T00:00:00.000Z"
+	boundary := "2026-08-19T00:00:00.000Z"
+	for _, run := range []struct {
+		id, status string
+		finish     any
+	}{
+		{"old", "completed", old}, {"protected", "completed", old},
+		{"running", "running", old}, {"created", "created", nil},
+		{"interrupted", "interrupted", old}, {"unknown", "completed", nil},
+		{"malformed", "completed", "broken"}, {"boundary", "completed", boundary},
+		{"recent", "completed", "2026-08-20T00:00:00.000Z"},
+		{"failed", "failed", old}, {"cancelled", "cancelled", old},
+	} {
+		retentionRun(t, s, run.id, run.status, run.finish)
+		retentionDetails(t, s, run.id, run.id, old, "{}")
+	}
+	retentionDetails(t, s, "null-run", nil, old, "{}")
+	retentionDetails(t, s, "new-detail", "old", boundary, "{}")
+	retentionExec(t, s, `INSERT INTO run_steps(step_id,run_id,name,status) VALUES('step','old','test','completed')`)
+	retentionExec(t, s, `INSERT INTO run_artifacts(artifact_id,run_id,kind,path,first_seen_at,last_seen_at) VALUES('artifact','old','file','keep',?,?)`, old, old)
+	retentionExec(t, s, `INSERT INTO outcome_signals(signal_id,run_id,kind,polarity,strength,source,dedup_key,observed_at) VALUES('signal','old','tests','positive','strong','cli','signal',?)`, old)
+	retentionExec(t, s, `INSERT INTO observations(observation_id,run_id,event_id,kind,title,created_at) VALUES('observation','old','old','test','keep',?)`, old)
+	result, err := s.PruneDetails(context.Background(), retentionCutoff, map[string]bool{"protected": true}, 1000)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Events != 3 || result.ContextUsages != 3 || result.KnowledgeCitations != 3 || result.RunSkillUsages != 3 || result.More {
+		t.Fatalf("unexpected report: %+v", result)
+	}
+	for _, table := range []string{"events", "context_usages", "knowledge_citations", "run_skill_usages"} {
+		if n := retentionCount(t, s, table); n != 10 {
+			t.Fatalf("%s has %d rows, want 10 protected/new rows", table, n)
+		}
+	}
+	for _, table := range []string{"run_steps", "run_artifacts", "outcome_signals", "observations"} {
+		if n := retentionCount(t, s, table); n != 1 {
+			t.Fatalf("%s lost durable data: %d", table, n)
+		}
+	}
+	if n := retentionCount(t, s, "runs"); n != 11 {
+		t.Fatalf("runs lost: %d", n)
+	}
+	rows, err := s.DB.Query(`PRAGMA foreign_key_check`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	if rows.Next() {
+		t.Fatal("retention left a foreign-key violation")
+	}
+	if err := rows.Err(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// A global row budget must apply across all tables; following ticks must make
+// progress even when there are more old events than fit in one transaction.
+func TestPruneDetailsBoundedAndRepeatable(t *testing.T) {
+	s := retentionStore(t)
+	old := "2026-01-01T00:00:00.000Z"
+	retentionRun(t, s, "old", "completed", old)
+	for i := range 5 {
+		retentionDetails(t, s, fmt.Sprint(i), "old", old, "{}")
+	}
+	var deleted int64
+	for tick := range 10 {
+		result, err := s.PruneDetails(context.Background(), retentionCutoff, nil, 3)
+		if err != nil {
+			t.Fatal(err)
+		}
+		n := result.Events + result.ContextUsages + result.KnowledgeCitations + result.RunSkillUsages
+		if n > 3 {
+			t.Fatalf("tick %d exceeded row budget: %+v", tick, result)
+		}
+		deleted += n
+		if !result.More {
+			break
+		}
+	}
+	if deleted != 20 {
+		t.Fatalf("deleted %d rows, want 20", deleted)
+	}
+	result, err := s.PruneDetails(context.Background(), retentionCutoff, nil, 3)
+	if err != nil || result.More || result.Events != 0 {
+		t.Fatalf("not idempotent: %+v %v", result, err)
+	}
+}
+
+// Cancel from a real SQLite trigger after deletion begins, rather than merely
+// cancelling before the transaction opens. Every table must remain unchanged.
+func TestPruneDetailsCancellationRollsBack(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	name := fmt.Sprintf("retention_cancel_%d", time.Now().UnixNano())
+	if err := sqlite.RegisterScalarFunction(name, 0, func(*sqlite.FunctionContext, []driver.Value) (driver.Value, error) {
+		cancel()
+		return nil, nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	s := retentionStore(t)
+	old := "2026-01-01T00:00:00.000Z"
+	retentionRun(t, s, "old", "completed", old)
+	retentionDetails(t, s, "old", "old", old, "{}")
+	retentionExec(t, s, `CREATE TRIGGER retention_cancel AFTER DELETE ON events BEGIN SELECT `+name+`(); END`)
+	result, err := s.PruneDetails(ctx, retentionCutoff, nil, 1000)
+	if err == nil || !errors.Is(err, context.Canceled) {
+		t.Fatalf("want cancellation, got %+v %v", result, err)
+	}
+	if result.Events != 0 || result.ContextUsages != 0 {
+		t.Fatalf("reported rolled-back deletes: %+v", result)
+	}
+	for _, table := range []string{"events", "context_usages", "knowledge_citations", "run_skill_usages"} {
+		if n := retentionCount(t, s, table); n != 1 {
+			t.Fatalf("%s was not rolled back: %d", table, n)
+		}
+	}
+}
+
+// A failure in a later table must roll back deletes already made in events.
+func TestPruneDetailsSQLFailureRollsBack(t *testing.T) {
+	s := retentionStore(t)
+	old := "2026-01-01T00:00:00.000Z"
+	retentionRun(t, s, "old", "completed", old)
+	retentionDetails(t, s, "old", "old", old, "{}")
+	retentionExec(t, s, `CREATE TRIGGER retention_abort BEFORE DELETE ON context_usages BEGIN SELECT RAISE(ABORT,'injected retention failure'); END`)
+	result, err := s.PruneDetails(context.Background(), retentionCutoff, nil, 1000)
+	if err == nil || result.Events != 0 {
+		t.Fatalf("want transactional failure, got %+v %v", result, err)
+	}
+	if n := retentionCount(t, s, "events"); n != 1 {
+		t.Fatal("earlier event delete committed")
+	}
+}
+
+func TestPruneDetailsMakesPagesReusable(t *testing.T) {
+	s := retentionStore(t)
+	old := "2026-01-01T00:00:00.000Z"
+	retentionRun(t, s, "old", "completed", old)
+	payload := strings.Repeat("x", 64*1024)
+	for i := range 40 {
+		retentionDetails(t, s, fmt.Sprint(i), "old", old, payload)
+	}
+	result, err := s.PruneDetails(context.Background(), retentionCutoff, nil, 1000)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.FreePagesAfter <= result.FreePagesBefore || result.PageSize <= 0 || result.PageCount <= result.FreePagesAfter {
+		t.Fatalf("deleted payload pages were not reported reusable: %+v", result)
+	}
+	for i := range 40 {
+		retentionDetails(t, s, "new-"+fmt.Sprint(i), "old", old, payload)
+	}
+	var pages, free int64
+	if err := s.DB.QueryRow(`PRAGMA page_count`).Scan(&pages); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.DB.QueryRow(`PRAGMA freelist_count`).Scan(&free); err != nil {
+		t.Fatal(err)
+	}
+	if pages > result.PageCount+2 || free >= result.FreePagesAfter {
+		t.Fatalf("SQLite failed to reuse pages: after prune=%+v, rewritten pages=%d free=%d", result, pages, free)
+	}
+	t.Logf("page size=%d; prune page count=%d, freelist %d -> %d; rewritten page count=%d, freelist=%d", result.PageSize, result.PageCount, result.FreePagesBefore, result.FreePagesAfter, pages, free)
+}
+
+func TestPruneDetailsYieldsToBusyWriter(t *testing.T) {
+	s := retentionStore(t)
+	ctx := context.Background()
+	writer, err := s.DB.Conn(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer writer.Close()
+	// Warm a second connection before holding the write lock. Connection setup
+	// belongs to Store.Open, not the maintenance transaction's lock policy.
+	other, err := s.DB.Conn(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	other.Close()
+	tx, err := writer.BeginTx(ctx, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tx.Rollback()
+	done := make(chan error, 1)
+	go func() {
+		_, err := s.PruneDetails(ctx, retentionCutoff, nil, 1000)
+		done <- err
+	}()
+	select {
+	case err := <-done:
+		if err == nil || !isBusy(err) {
+			t.Fatalf("want nonblocking busy result, got %v", err)
+		}
+	case <-time.After(time.Second):
+		tx.Rollback()
+		<-done
+		t.Fatal("maintenance waited over a second for an active writer")
+	}
+}
+
+func TestPruneDetailsRejectsUnsafeBounds(t *testing.T) {
+	s := retentionStore(t)
+	for _, tc := range []struct {
+		cutoff time.Time
+		limit  int
+	}{
+		{retentionCutoff, 0}, {retentionCutoff, -1}, {time.Time{}, 1000},
+	} {
+		if _, err := s.PruneDetails(context.Background(), tc.cutoff, nil, tc.limit); err == nil {
+			t.Fatalf("accepted unsafe retention bounds: %+v", tc)
+		}
+	}
+}
+
+func TestPruneDetailsValidatorAndCursor(t *testing.T) {
+	s := retentionStore(t)
+	old := "2026-01-01T00:00:00.000Z"
+	retentionRun(t, s, "protected", "completed", old)
+	retentionRun(t, s, "disposable", "completed", old)
+	for i := range 4 {
+		retentionDetails(t, s, fmt.Sprint(i), "protected", old, "{}")
+	}
+	retentionDetails(t, s, "last", "disposable", old, "{}")
+	validate := func(_ context.Context, run, _, _ string) (bool, error) { return run == "disposable", nil }
+	cursor := ""
+	var removed int64
+	for tick := range 30 {
+		r, err := s.PruneDetailsAfter(context.Background(), retentionCutoff, nil, 2, cursor, validate)
+		if err != nil {
+			t.Fatal(err)
+		}
+		removed += r.Events + r.ContextUsages + r.KnowledgeCitations + r.RunSkillUsages
+		cursor = r.Cursor
+		if !r.More {
+			break
+		}
+		if tick == 29 {
+			t.Fatal("protected candidate owners blocked cursor progress")
+		}
+	}
+	if removed != 4 {
+		t.Fatalf("deleted %d details, want only disposable run's four rows", removed)
+	}
+	if n := retentionCount(t, s, "events"); n != 4 {
+		t.Fatalf("protected events lost: %d", n)
+	}
+}
+
+func TestPruneDetailsValidatorErrorRollsBack(t *testing.T) {
+	s := retentionStore(t)
+	old := "2026-01-01T00:00:00.000Z"
+	retentionRun(t, s, "old", "completed", old)
+	retentionDetails(t, s, "old", "old", old, "{}")
+	injected := errors.New("owner metadata unreadable")
+	calls := 0
+	r, err := s.PruneDetails(context.Background(), retentionCutoff, nil, 1000, func(context.Context, string, string, string) (bool, error) {
+		calls++
+		if calls == 2 {
+			return false, injected
+		}
+		return true, nil
+	})
+	if !errors.Is(err, injected) || r.Events != 0 {
+		t.Fatalf("validator error did not fail closed atomically: %+v %v", r, err)
+	}
+	if n := retentionCount(t, s, "events"); n != 1 {
+		t.Fatal("event deleted despite validator error")
+	}
+}
+
+func TestPruneDetailsKeepsOwnershipProvenance(t *testing.T) {
+	s := retentionStore(t)
+	old := "2026-01-01T00:00:00.000Z"
+	retentionRun(t, s, "session", "completed", old)
+	// Compact ownership events survive even callers without a filesystem owner
+	// validator. Their retrieval statistics are ordinary disposable details.
+	for i, kind := range []string{"task.linked", "task.status", "workflow.finished", "subagent.stopped", "file.read"} {
+		id := fmt.Sprintf("e%d", i)
+		retentionDetails(t, s, id, "session", old, `{}`)
+		retentionExec(t, s, `UPDATE events SET event_type=? WHERE event_id=?`, kind, id)
+	}
+	r, e := s.PruneDetails(context.Background(), retentionCutoff, nil, 1000)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if r.Events != 1 || r.ContextUsages != 5 || r.KnowledgeCitations != 5 || r.RunSkillUsages != 5 {
+		t.Fatalf("unexpected pruning %+v", r)
+	}
+	for _, kind := range []string{"task.linked", "task.status", "workflow.finished", "subagent.stopped"} {
+		var n int
+		if e = s.DB.QueryRow(`SELECT count(*) FROM events WHERE event_type=?`, kind).Scan(&n); e != nil || n != 1 {
+			t.Fatalf("ownership %s lost: %d %v", kind, n, e)
+		}
+	}
