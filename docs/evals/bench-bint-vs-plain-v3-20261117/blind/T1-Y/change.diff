+
+func TestWorkflowWritersWaitForCollector(t *testing.T) {
+	root := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(root, "runtime"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	f, err := os.OpenFile(filepath.Join(root, "runtime", "cleanup.activity.lock"), os.O_CREATE|os.O_RDWR, 0o600)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	if busy, err := fslock.Try(f, true); err != nil || busy {
+		t.Fatalf("collector lock: %v, %v", busy, err)
+	}
+	e := &Env{Tasks: task.NewStore(filepath.Join(root, "runtime"))}
+	r := &Runner{Env: e}
+	for name, call := range map[string]func(context.Context) error{
+		"run":  func(ctx context.Context) error { _, err := r.Run(ctx, RunOptions{}); return err },
+		"next": func(ctx context.Context) error { _, err := r.Next(ctx, NextOptions{TaskRef: "missing"}); return err },
+		"complete": func(ctx context.Context) error {
+			_, err := r.Complete(ctx, CompleteOptions{TaskRef: "missing"})
+			return err
+		},
+		"abort": func(ctx context.Context) error { _, err := r.Abort(ctx, "missing", "test"); return err },
+		"set-status": func(ctx context.Context) error {
+			_, _, err := e.SetStatus(ctx, "missing", task.StatusDone, TransitionOptions{})
+			return err
+		},
+		"verify": func(ctx context.Context) error { _, _, err := e.verify(ctx, "missing", "test", false); return err },
+	} {
+		t.Run(name, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+			defer cancel()
+			if err := call(ctx); !errors.Is(err, context.DeadlineExceeded) {
+				t.Fatalf("writer must acquire activity before task access, got %v", err)
+			}
+		})
+	}
+}
+
+func TestRunnerProtectsFilesWhileAgentRuns(t *testing.T) {
+	h := newHarness(t)
+	previous := h.behave
+	h.behave = func(ctx context.Context, step string, e *Env, id string) error {
+		p := filepath.Join(filepath.Dir(e.Tasks.Dir), "cleanup.activity.lock")
+		f, err := os.OpenFile(p, os.O_CREATE|os.O_RDWR, 0o600)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer f.Close()
+		if busy, err := fslock.Try(f, true); err != nil || !busy {
+			t.Errorf("collector should be busy during agent callback: busy=%v err=%v", busy, err)
+		}
+		return previous(ctx, step, e, id)
+	}
+	if _, err := h.runner().Run(context.Background(), RunOptions{Workflow: StepReq, Request: "Plan an update"}); err != nil {
+		t.Fatal(err)
+	}
+}
