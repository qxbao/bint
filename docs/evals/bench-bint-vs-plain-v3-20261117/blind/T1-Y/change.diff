new file mode 100644
index 0000000..b6a58cf
--- /dev/null
+++ b/internal/app/maintenance.go
@@ -0,0 +1,40 @@
+package app
+
+import (
+	"context"
+	"fmt"
+	"path/filepath"
+	"time"
+
+	"bint/internal/maintenance"
+	"bint/internal/store"
+)
+
+func (w *Workspace) cleanup(ctx context.Context, s *store.Store, now time.Time) {
+	if !w.Paths.Initialized() {
+		return
+	}
+	c := w.Config.State.Cleanup
+	interval, _ := time.ParseDuration(c.Interval)
+	ttl, _ := time.ParseDuration(c.TempTTL)
+	rep := maintenance.Collect(ctx, maintenance.Options{Root: w.Paths.Root, DB: s.DB, Now: now, CasesDir: filepath.Join(filepath.Dir(w.Sources.Project), "evals", "cases"),
+		Policy: maintenance.Policy{Enabled: c.Enabled, Interval: interval, TempTTL: ttl, RetentionDays: c.RetentionDays, BackupRetentionDays: c.BackupRetentionDays, BackupKeep: c.BackupKeep},
+		PruneAfter: func(ctx context.Context, cutoff time.Time, protected map[string]bool, limit int, after string) (int64, int64, bool, string, error) {
+			r, e := s.PruneDetailsAfter(ctx, cutoff, protected, limit, after, maintenance.NewRunValidator(w.Paths.Root, s.DB, now))
+			return r.Events + r.ContextUsages + r.KnowledgeCitations + r.RunSkillUsages, r.FreePagesAfter * r.PageSize, r.More, r.Cursor, e
+		}})
+	w.cleanupResult = &rep
+}
+func (w *Workspace) cleanupReport() maintenance.Report {
+	if w.cleanupResult != nil {
+		return *w.cleanupResult
+	}
+	rep, err := maintenance.ReadReport(w.Paths.Root)
+	if err != nil {
+		rep.Error = fmt.Sprint(err)
+	}
+	if !w.Config.State.Cleanup.Enabled {
+		rep.Skip = "disabled"
+	}
+	return rep
+}
