@@ -0,0 +1,14 @@
+package workflow
+
+import (
+	"context"
+	"path/filepath"
+
+	"bint/internal/maintenance"
+)
+
+// acquireActivity precedes task registration/resume and spans agent callbacks.
+// Session-driver leases protect the intervals between Next and Complete calls.
+func (e *Env) acquireActivity(ctx context.Context) (func(), error) {
+	return maintenance.AcquireActivity(ctx, filepath.Dir(filepath.Dir(e.Tasks.Dir)))
+}
