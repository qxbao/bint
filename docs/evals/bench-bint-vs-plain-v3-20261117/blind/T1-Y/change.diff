+package config
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestCleanupConfigAcceptsPolicy(t *testing.T) {
+	cfg := Default()
+	err := Decode(strings.NewReader(`state:
+  cleanup:
+    enabled: false
+    interval: 12h
+    retention_days: 1
+    temp_ttl: 1ns
+    backup_retention_days: 2
+    backup_keep: 1
+`), &cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cfg.Validate(); err != nil {
+		t.Fatal(err)
+	}
+	if got := cfg.State.Cleanup; got != (StateCleanup{Enabled: false, Interval: "12h", RetentionDays: 1, TempTTL: "1ns", BackupRetentionDays: 2, BackupKeep: 1}) {
+		t.Fatalf("policy lost during decoding: %+v", got)
+	}
+}
+
+func TestCleanupConfigDefaultsForExistingConfig(t *testing.T) {
+	cfg := Default()
+	if err := Decode(strings.NewReader("state:\n  dir: auto\n"), &cfg); err != nil {
+		t.Fatal(err)
+	}
+	want := StateCleanup{Enabled: true, Interval: "24h", RetentionDays: 90, TempTTL: "24h", BackupRetentionDays: 30, BackupKeep: 3}
+	if cfg.State.Cleanup != want {
+		t.Fatalf("policy = %+v, want %+v", cfg.State.Cleanup, want)
+	}
+}
+
+func TestCleanupConfigLayersKeepDisabled(t *testing.T) {
+	for _, disabledLayer := range []string{"global", "project", "local"} {
+		t.Run(disabledLayer, func(t *testing.T) {
+			global := t.TempDir()
+			t.Setenv("BINT_CONFIG_HOME", global)
+			root := t.TempDir()
+			if err := os.MkdirAll(filepath.Join(root, DirName), 0o755); err != nil {
+				t.Fatal(err)
+			}
+			for _, layer := range []struct{ name, path, policy string }{
+				{"global", filepath.Join(global, FileName), "    backup_keep: 5\n"},
+				{"project", ProjectPath(root), "    retention_days: 42\n"},
+				{"local", LocalPath(root), "    interval: 6h\n"},
+			} {
+				policy := layer.policy
+				if layer.name == disabledLayer {
+					policy += "    enabled: false\n"
+				}
+				if err := os.WriteFile(layer.path, []byte("state:\n  cleanup:\n"+policy), 0o600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			cfg, _, err := Load(root, true)
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := StateCleanup{Enabled: false, Interval: "6h", RetentionDays: 42, TempTTL: "24h", BackupRetentionDays: 30, BackupKeep: 5}
+			if cfg.State.Cleanup != want {
+				t.Fatalf("merged policy = %+v, want %+v", cfg.State.Cleanup, want)
+			}
+		})
+	}
+}
+
+func TestCleanupConfigRejectsInvalidPolicy(t *testing.T) {
+	for _, tc := range []struct {
+		key, value string
+	}{
+		{"interval", `""`},
+		{"interval", "0s"},
+		{"interval", "-1s"},
+		{"interval", "1d"},
+		{"interval", "2562048h"},
+		{"temp_ttl", `""`},
+		{"temp_ttl", "0s"},
+		{"temp_ttl", "-1s"},
+		{"temp_ttl", "tomorrow"},
+		{"temp_ttl", "2562048h"},
+		{"retention_days", "0"},
+		{"retention_days", "-1"},
+		{"retention_days", "106752"},
+		{"backup_retention_days", "0"},
+		{"backup_retention_days", "-1"},
+		{"backup_retention_days", "106752"},
+		{"backup_keep", "0"},
+		{"backup_keep", "-1"},
+	} {
+		t.Run(tc.key+"="+tc.value, func(t *testing.T) {
+			cfg := Default()
+			if err := Decode(strings.NewReader("state:\n  cleanup:\n    "+tc.key+": "+tc.value+"\n"), &cfg); err != nil {
+				t.Fatal(err)
+			}
+			if err := cfg.Validate(); err == nil || !strings.Contains(err.Error(), "state.cleanup."+tc.key) {
+				t.Fatalf("want validation error for %s, got %v", tc.key, err)
+			}
+		})
+	}
+}
+
+func TestCleanupConfigAcceptsDurationLimits(t *testing.T) {
+	cfg := Default()
+	if err := Decode(strings.NewReader(`state:
+  cleanup:
+    interval: 2562047h47m16.854775807s
+    retention_days: 106751
+    temp_ttl: 1ns
+    backup_retention_days: 106751
+    backup_keep: 1
+`), &cfg); err != nil {
+		t.Fatal(err)
+	}
+	if err := cfg.Validate(); err != nil {
+		t.Fatal(err)
+	}
+}
