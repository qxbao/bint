index 0000000..9b90619
--- /dev/null
+++ b/internal/redact/redact_test.go
@@ -0,0 +1,136 @@
+package redact
+
+import (
+	"bytes"
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestTextCredentialsAndUsefulFields(t *testing.T) {
+	for _, in := range []string{
+		"Authorization: Bearer private-value",
+		"Authorization: Basic private-value",
+		"https://example.test/?refresh_token=private-value&ok=true",
+		`--client-secret "private-value"`,
+		`--message ignored --api-key private-value`,
+		`api_key=private-value`,
+		`{"password":"private-value","input_tokens":17}`,
+		`{"message":"password=\"private-value\"","output_tokens":3}`,
+		`password: 'private-value'`,
+	} {
+		got := Text(in)
+		if strings.Contains(got, "private-value") || !strings.Contains(got, "***") {
+			t.Errorf("credential leaked for %q", in)
+		}
+		if json.Valid([]byte(in)) && !json.Valid([]byte(got)) {
+			t.Error("redaction invalidated JSON")
+		}
+	}
+	for _, in := range []string{"test passed\n", `{"input_tokens":17,"output_tokens":3,"message":"done"}`, "PATH=/usr/bin count=42"} {
+		if got := Text(in); got != in {
+			t.Errorf("safe diagnostics changed: %q", got)
+		}
+	}
+}
+
+func TestWriterEverySplitAndFinalFragment(t *testing.T) {
+	const input = "Authorization: Bearer private-value\nraw env-value\npassword=final-value"
+	const want = "Authorization: *** ***\nraw ***\npassword=***"
+	for split := 0; split <= len(input); split++ {
+		var out bytes.Buffer
+		w := New("env-value").Writer(&out)
+		for _, part := range []string{input[:split], input[split:]} {
+			if n, err := w.Write([]byte(part)); err != nil || n != len(part) {
+				t.Fatalf("write: %d %v", n, err)
+			}
+		}
+		if err := w.Flush(); err != nil {
+			t.Fatal(err)
+		}
+		if out.String() != want {
+			t.Errorf("split %d: %q", split, out.String())
+		}
+	}
+}
+
+func TestWriterDropsOversizedLineWithoutLeakingSuffix(t *testing.T) {
+	for _, newline := range []string{"", "\nnext line\n"} {
+		var out bytes.Buffer
+		w := New("private-value").Writer(&out)
+		for _, part := range []string{strings.Repeat("x", maxLine-4), "private-", "value", newline} {
+			if _, err := w.Write([]byte(part)); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if err := w.Flush(); err != nil {
+			t.Fatal(err)
+		}
+		if got := out.String(); got != "[bint: oversized log line omitted]"+newline {
+			t.Errorf("oversized line leaked or next line lost: %d bytes", len(got))
+		}
+	}
+}
+
+func TestEnvironmentValuesAndOverlaps(t *testing.T) {
+	r := New(EnvValues([]string{"SERVICE_PASSWORD=abcdef", "API_TOKEN=abc", "PWD=/repo", "PATH=/bin", "EMPTY_TOKEN="})...)
+	// PWD is the working-directory environment variable, not a password.
+	if got := r.Text("abcdef abc /repo /bin"); got != "*** *** /repo /bin" {
+		t.Errorf("known credentials or safe env values handled incorrectly: %q", got)
+	}
+}
+
+func TestCommandValuesRedactUnlabelledOutput(t *testing.T) {
+	for _, command := range []string{
+		`tool --password private-value`,
+		`tool --api-key="private-value"`,
+		`PASSWORD='private-value' tool`,
+		`curl -H 'Authorization: Bearer private-value' https://example.test`,
+		`curl https://u:private-value@example.test`,
+	} {
+		if got := New(CommandValues(command)...).Text("server echoed private-value"); got != "server echoed ***" {
+			t.Errorf("command credential not recognized: %q", command)
+		}
+	}
+}
+
+func TestKnownValueDoesNotHideCredentialLabel(t *testing.T) {
+	for _, values := range [][]string{{"Bearer"}, {"pass"}, {"abc\ndef"}} {
+		r := New(values...)
+		for _, in := range []string{"Authorization: Bearer private-value", "password=private-value"} {
+			if strings.Contains(r.Text(in), "private-value") {
+				t.Error("known value replacement hid a credential label")
+			}
+		}
+	}
+}
+
+func TestWriterRedactsMultilineKnownCredential(t *testing.T) {
+	var out bytes.Buffer
+	w := New("first-private\nsecond-private").Writer(&out)
+	if _, err := w.Write([]byte("first-private\nsecond-private\n")); err != nil {
+		t.Fatal(err)
+	}
+	if err := w.Flush(); err != nil {
+		t.Fatal(err)
+	}
+	if got := out.String(); got != "***\n***\n" {
+		t.Errorf("multiline credential leaked: %q", got)
+	}
+}
+
+func TestKnownNumericCredentialInJSON(t *testing.T) {
+	got := New("123456").Text(`{"value":123456,"input_tokens":17}`)
+	if strings.Contains(got, "123456") || !json.Valid([]byte(got)) || !strings.Contains(got, `"input_tokens":17`) {
+		t.Errorf("numeric credential leaked or safe JSON changed: %s", got)
+	}
+}
+
+func TestKnownCredentialWithDelimiters(t *testing.T) {
+	for _, secret := range []string{`foo&bar`, `foo,bar`, `foo"bar`, `foo bar`} {
+		got := New(secret).Text("password=" + secret)
+		if got != "password=***" {
+			t.Errorf("known credential was only partly redacted: %q", got)
+		}
+	}
+}
diff --git a/internal/redact/writer.go b/internal/redact/writer.go
new file mode 100644
index 0000000..509ff86
--- /dev/null
+++ b/internal/redact/writer.go
@@ -0,0 +1,88 @@
+package redact
+
+import (
+	"bytes"
+	"io"
+	"sync"
+)
+
+const maxLine = 1 << 20
+
+// Writer buffers a stream until a complete line is available, so a credential
+// split across Write calls never reaches the destination. Use one Writer per
+// stream, a synchronized shared destination, and Flush after the process exits.
+type Writer struct {
+	mu       sync.Mutex
+	out      io.Writer
+	scrub    *Scrubber
+	buf      []byte
+	dropping bool
+}
+
+func (r *Scrubber) Writer(out io.Writer) *Writer { return &Writer{out: out, scrub: r} }
+
+// Streams gives stdout and stderr independent line buffers and serializes their
+// writes to a shared destination. One stream cannot terminate the other's line.
+func (r *Scrubber) Streams(out io.Writer) (stdout, stderr *Writer) {
+	sink := &lockedWriter{out: out}
+	return r.Writer(sink), r.Writer(sink)
+}
+
+type lockedWriter struct {
+	mu  sync.Mutex
+	out io.Writer
+}
+
+func (w *lockedWriter) Write(p []byte) (int, error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	return w.out.Write(p)
+}
+
+func (w *Writer) Write(p []byte) (int, error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	n := len(p)
+	for len(p) > 0 {
+		part, rest, complete := bytes.Cut(p, []byte{'\n'})
+		if !w.dropping {
+			if len(w.buf)+len(part) > maxLine {
+				// Discard the whole oversized line rather than leaking a partial
+				// credential at a truncation boundary. Memory stays bounded.
+				w.buf = nil
+				w.dropping = true
+			} else {
+				w.buf = append(w.buf, part...)
+			}
+		}
+		if complete {
+			if err := w.flush(true); err != nil {
+				return 0, err
+			}
+		}
+		p = rest
+	}
+	return n, nil
+}
+
+func (w *Writer) Flush() error {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	return w.flush(false)
+}
+
+func (w *Writer) flush(newline bool) error {
+	if len(w.buf) == 0 && !w.dropping && !newline {
+		return nil
+	}
+	s := "[bint: oversized log line omitted]"
+	if !w.dropping {
+		s = w.scrub.Text(string(w.buf))
+	}
+	if newline {
+		s += "\n"
+	}
+	w.buf, w.dropping = w.buf[:0], false
+	_, err := io.WriteString(w.out, s)
+	return err
+}
