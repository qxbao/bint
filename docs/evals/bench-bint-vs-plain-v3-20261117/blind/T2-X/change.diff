@@ -0,0 +1,46 @@
+package mcpgw
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+
+	"bint/internal/config"
+	"bint/internal/testutil"
+)
+
+func TestCodegraphIndexOutputRedactsCredentials(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("POSIX shell fixture")
+	}
+	testutil.Isolate(t)
+	bin := filepath.Join(t.TempDir(), "codegraph")
+	script := "#!/bin/sh\nif [ \"$1\" = --version ]; then\n  printf '%s' \"$INDEX_TOKEN\"\nelse\n  printf 'raw %s\\n' \"$INDEX_TOKEN\"\n  printf 'password='\n  printf '\\n' >&2\n  printf 'output-credential\\n'\nfi\n"
+	if err := os.WriteFile(bin, []byte(script), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	secrets := filepath.Join(t.TempDir(), "secrets.env")
+	if err := os.WriteFile(secrets, []byte("INDEX_TOKEN=known-credential\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := config.SaveMachineMCP(config.MachineMCP{Version: 1, SecretsFile: secrets, Services: map[string]config.Registration{
+		"codegraph": {Command: bin, EnvNames: []string{"INDEX_TOKEN"}},
+	}}); err != nil {
+		t.Fatal(err)
+	}
+	var log bytes.Buffer
+	root := testutil.NewRepo(t, map[string]string{"README.md": "test\n"})
+	if _, err := CodegraphInit(t.Context(), root, &log); err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(log.String(), "known-credential") || strings.Contains(log.String(), "output-credential") || !strings.Contains(log.String(), "raw ***") {
+		t.Error("codegraph output was not redacted")
+	}
+	warning := CodegraphVersionWarning(t.Context(), bin, config.Registration{Command: "absent-wrapper", Version: "1.0"}, []string{"INDEX_TOKEN=known-credential"})
+	if strings.Contains(warning, "known-credential") || !strings.Contains(warning, "***") {
+		t.Error("version warning contains a credential")
+	}
+}
