+func TestRunProcessRedactsLogsAndTail(t *testing.T) {
+	if os.Getenv("BINT_LOG_FIXTURE") == "1" {
+		os.Stdout.WriteString("Authorization: Bear")
+		os.Stdout.WriteString("er split-credential\n")
+		os.Stdout.WriteString("raw " + os.Getenv("BINT_TEST_TOKEN") + "\n")
+		os.Stdout.WriteString("raw header-credential&private-suffix\n")
+		os.Stderr.WriteString(`{"password":"json-credential","input_tokens":17}` + "\n")
+		os.Stdout.WriteString("password=final-credential")
+		os.Exit(0)
+	}
+	bin, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var stdout bytes.Buffer
+	log := filepath.Join(t.TempDir(), "output.log")
+	res := runProcess(t.Context(), t.TempDir(), bin,
+		[]string{"-test.run=^TestRunProcessRedactsLogsAndTail$", "--", "--password=header-credential&private-suffix"},
+		30*time.Second, log, append(os.Environ(), "BINT_LOG_FIXTURE=1", "BINT_TEST_TOKEN=env-credential"), nil, &stdout)
+	if !res.OK() {
+		t.Fatalf("subprocess failed: %v", res.Err)
+	}
+	raw, err := os.ReadFile(log)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, secret := range []string{"header-credential", "private-suffix", "split-credential", "env-credential", "json-credential", "final-credential"} {
+		if strings.Contains(string(raw), secret) || strings.Contains(res.Tail, secret) {
+			t.Errorf("credential persisted in log or diagnostic tail: %s", secret)
+		}
+	}
+	if !strings.Contains(string(raw), `"input_tokens":17`) || !strings.Contains(string(raw), "***") {
+		t.Error("safe diagnostics or redaction markers lost")
+	}
+	want := "Authorization: Bearer split-credential\nraw env-credential\nraw header-credential&private-suffix\npassword=final-credential"
+	if stdout.String() != want {
+		t.Error("redaction changed the parser's stdout")
+	}
+}
