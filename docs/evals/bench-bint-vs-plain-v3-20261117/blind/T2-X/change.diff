diff --git a/internal/redact/redact.go b/internal/redact/redact.go
new file mode 100644
index 0000000..25e9b99
--- /dev/null
+++ b/internal/redact/redact.go
@@ -0,0 +1,235 @@
+// Package redact removes recognizable credentials from diagnostic copies of
+// data. It must not be used on input passed to commands or protocol parsers.
+package redact
+
+import (
+	"encoding/json"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+const valuePattern = `("(?:\\.|[^"\\])*"|'[^']*'|[^\s"'\\,;}\]&]+)`
+const keyPattern = `(?:[A-Za-z_][A-Za-z0-9_-]*)?(?:password|passwd|pwd|token|secret|api[-_]?key|access[-_]?key|access[-_]?key[-_]?id|private[-_]?key|credentials?|authorization|cookie|auth)`
+
+var (
+	assign = regexp.MustCompile(`(?i)\b(` + keyPattern + `)(["']?[ \t]*[=:][ \t]*)` + valuePattern)
+	flags  = regexp.MustCompile(`(?i)(--?(` + keyPattern + `)[ \t]+)` + valuePattern)
+	auth   = regexp.MustCompile(`(?i)\b((?:bearer|basic)[ \t]+)[^\s"'\\,;}\]]+`)
+	url    = regexp.MustCompile(`(://)[^/\s:@]+:[^/\s@]+@`)
+)
+
+// SensitiveKey recognizes credential names without confusing token usage counts
+// (input_tokens, output_tokens) with credentials.
+func SensitiveKey(key string) bool {
+	key = strings.ToLower(strings.NewReplacer("_", "", "-", "").Replace(key))
+	for _, suffix := range []string{"password", "passwd", "pwd", "token", "secret", "apikey", "accesskey", "accesskeyid", "privatekey", "credential", "credentials", "authorization", "cookie", "auth"} {
+		if strings.HasSuffix(key, suffix) {
+			return true
+		}
+	}
+	return false
+}
+
+// EnvValues takes only credential values from the effective child environment.
+func EnvValues(env []string) []string {
+	var values []string
+	for _, entry := range env {
+		k, v, ok := strings.Cut(entry, "=")
+		if ok && v != "" && k != "PWD" && k != "OLDPWD" && SensitiveKey(k) {
+			values = append(values, v)
+		}
+	}
+	return values
+}
+
+// CommandValues also protects unlabelled echoes of credentials supplied in
+// command flags, assignments, authorization headers or URL userinfo.
+func CommandValues(command string) []string {
+	var values []string
+	for _, pattern := range []*regexp.Regexp{assign, flags, auth, url} {
+		for _, m := range pattern.FindAllStringSubmatch(command, -1) {
+			var v string
+			switch pattern {
+			case assign, flags:
+				v = m[3]
+				if pattern == assign && strings.EqualFold(m[1], "authorization") && (strings.EqualFold(v, "Bearer") || strings.EqualFold(v, "Basic")) {
+					continue // the scheme is not the credential; auth captures the value
+				}
+				if len(v) >= 2 && v[0] == '\'' && v[len(v)-1] == '\'' {
+					v = v[1 : len(v)-1]
+				} else if unquoted, err := strconv.Unquote(v); err == nil {
+					v = unquoted
+				}
+			case auth:
+				v = strings.TrimPrefix(m[0], m[1])
+			case url:
+				_, v, _ = strings.Cut(strings.TrimSuffix(strings.TrimPrefix(m[0], "://"), "@"), ":")
+			}
+			if v != "" {
+				values = append(values, v)
+			}
+		}
+	}
+	return values
+}
+
+// ArgValues uses actual argument boundaries so quoted characters, spaces and
+// delimiters inside a flag's value cannot leave a partially known credential.
+func ArgValues(args []string) []string {
+	var values []string
+	for i, arg := range args {
+		key, value, assigned := strings.Cut(strings.TrimLeft(arg, "-"), "=")
+		if !SensitiveKey(key) {
+			continue
+		}
+		if assigned {
+			values = append(values, value)
+		} else if strings.HasPrefix(arg, "-") && i+1 < len(args) {
+			values = append(values, args[i+1])
+		}
+	}
+	return values
+}
+
+// Scrubber is immutable and safe to share between output streams.
+type Scrubber struct {
+	literals *strings.Replacer
+	values   []string
+}
+
+func New(values ...string) *Scrubber {
+	values = append([]string(nil), values...)
+	// Output is buffered per line. Protect each nonempty fragment of known
+	// multiline credentials too (for example private keys echoed by a tool).
+	for _, v := range append([]string(nil), values...) {
+		if strings.ContainsAny(v, "\r\n") {
+			values = append(values, strings.FieldsFunc(v, func(r rune) bool { return r == '\r' || r == '\n' })...)
+		}
+	}
+	// Longest match first, with a single replacement pass: short credentials
+	// must not leave the suffix of an overlapping longer credential behind.
+	sort.Slice(values, func(i, j int) bool { return len(values[i]) > len(values[j]) })
+	var pairs []string
+	for _, v := range values {
+		if v != "" {
+			pairs = append(pairs, v, "***")
+		}
+	}
+	return &Scrubber{literals: strings.NewReplacer(pairs...), values: values}
+}
+
+var defaultScrubber = New()
+
+func Text(s string) string { return defaultScrubber.Text(s) }
+
+// Text redacts before any caller truncates the result. Valid JSON is traversed
+// so escaped strings and nested credential fields remain safe and valid JSON.
+// Unchanged data retains its original formatting.
+func (r *Scrubber) Text(s string) string {
+	trimmed := strings.TrimSpace(s)
+	if strings.HasPrefix(trimmed, "{") || strings.HasPrefix(trimmed, "[") {
+		var v any
+		dec := json.NewDecoder(strings.NewReader(s))
+		dec.UseNumber()
+		if json.Valid([]byte(s)) && dec.Decode(&v) == nil {
+			changed := false
+			v = r.walk(v, &changed)
+			if changed {
+				b, _ := json.Marshal(v)
+				return string(b)
+			}
+			return s
+		}
+	}
+	return r.plain(s)
+}
+
+func (r *Scrubber) walk(v any, changed *bool) any {
+	switch x := v.(type) {
+	case map[string]any:
+		for k, val := range x {
+			if SensitiveKey(k) {
+				x[k] = "***"
+				*changed = true
+			} else {
+				x[k] = r.walk(val, changed)
+			}
+		}
+	case []any:
+		for i, val := range x {
+			x[i] = r.walk(val, changed)
+		}
+	case string:
+		safe := r.Text(x)
+		if safe != x {
+			*changed = true
+		}
+		return safe
+	case json.Number:
+		if r.literals.Replace(string(x)) != string(x) {
+			*changed = true
+			return "***"
+		}
+	}
+	return v
+}
+
+func (r *Scrubber) plain(s string) string {
+	type span struct{ start, end int }
+	var spans []span
+	// Find every match in the original text, then merge overlapping spans.
+	// Sequential replacements can hide labels or replace only a prefix of a
+	// known password containing delimiters, leaving its suffix exposed.
+	for _, pattern := range []*regexp.Regexp{assign, flags} {
+		for _, m := range pattern.FindAllStringSubmatchIndex(s, -1) {
+			start, end := m[6], m[7]
+			if end-start >= 2 && (s[start] == '"' || s[start] == '\'') && s[end-1] == s[start] {
+				start++
+				end--
+			}
+			spans = append(spans, span{start, end})
+		}
+	}
+	for _, m := range auth.FindAllStringSubmatchIndex(s, -1) {
+		spans = append(spans, span{m[3], m[1]})
+	}
+	for _, m := range url.FindAllStringSubmatchIndex(s, -1) {
+		spans = append(spans, span{m[3], m[1] - 1})
+	}
+	for _, value := range r.values {
+		if value == "" {
+			continue
+		}
+		for offset := 0; offset < len(s); {
+			i := strings.Index(s[offset:], value)
+			if i < 0 {
+				break
+			}
+			start := offset + i
+			spans = append(spans, span{start, start + len(value)})
+			offset = start + len(value)
+		}
+	}
+	if len(spans) == 0 {
+		return s
+	}
+	sort.Slice(spans, func(i, j int) bool { return spans[i].start < spans[j].start })
+	var out strings.Builder
+	last := 0
+	for i := 0; i < len(spans); i++ {
+		start, end := spans[i].start, spans[i].end
+		for i+1 < len(spans) && spans[i+1].start <= end {
+			i++
+			if spans[i].end > end {
+				end = spans[i].end
+			}
+		}
+		out.WriteString(s[last:start])
+		out.WriteString("***")
+		last = end
+	}
+	out.WriteString(s[last:])
+	return out.String()
+}
diff --git a/internal/redact/redact_test.go b/internal/redact/redact_test.go
