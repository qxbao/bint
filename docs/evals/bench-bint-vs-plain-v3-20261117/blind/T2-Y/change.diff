index 0000000..dc9c6e0
--- /dev/null
+++ b/internal/runlog/redact_test.go
@@ -0,0 +1,143 @@
+package runlog
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"bint/internal/spool"
+	"bint/internal/store"
+)
+
+func TestLegacySpoolRedactedBeforeSQLiteAndDerivedFields(t *testing.T) {
+	s, dir := setup(t)
+	ctx := context.Background()
+	ts := time.Date(2026, 11, 17, 1, 0, 0, 0, time.UTC)
+	e := spool.Event{SchemaVersion: 1, EventID: "legacy-event", Type: spool.WorkflowFinished, Source: "test", Timestamp: ts, RunID: "legacy-run", Payload: map[string]any{
+		"status": "completed", "end_reason": "password=fake-end-password", "result_summary": "token=fake-summary-token", "password": "fake-json-password", "input_tokens": 42, "output_tokens": 13, "cost_usd": 0.75, "nested": map[string]any{"secret": "fake-nested-secret"}, "nothing": nil}}
+	b, _ := json.Marshal(e)
+	if err := os.WriteFile(filepath.Join(dir, "legacy.jsonl"), append(b, '\n'), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	res, err := Ingest(ctx, s, dir, ts, 0)
+	if err != nil || res.Events != 1 {
+		t.Fatalf("ingest: %+v %v", res, err)
+	}
+	var payload, reason, summary string
+	var inputs, outputs int
+	var cost float64
+	if err := s.DB.QueryRow(`SELECT e.payload, r.end_reason, r.result_summary, r.input_tokens, r.output_tokens, r.cost_usd FROM events e JOIN runs r USING(run_id) WHERE e.event_id='legacy-event'`).Scan(&payload, &reason, &summary, &inputs, &outputs, &cost); err != nil {
+		t.Fatal(err)
+	}
+	for _, secret := range []string{"fake-end-password", "fake-summary-token", "fake-json-password", "fake-nested-secret"} {
+		if strings.Contains(payload+reason+summary, secret) {
+			t.Fatalf("SQLite leaked %s", secret)
+		}
+	}
+	if inputs != 42 || outputs != 13 || cost != 0.75 {
+		t.Fatalf("metrics changed: %d %d %v", inputs, outputs, cost)
+	}
+	var got map[string]any
+	if err := json.Unmarshal([]byte(payload), &got); err != nil || got["nothing"] != nil {
+		t.Fatalf("payload invalid: %s, %v", payload, err)
+	}
+	// New database and WAL pages must never receive a raw credential.
+	entries, err := os.ReadDir(filepath.Dir(dir))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, entry := range entries {
+		if !strings.HasPrefix(entry.Name(), "state.sqlite") || entry.IsDir() {
+			continue
+		}
+		data, err := os.ReadFile(filepath.Join(filepath.Dir(dir), entry.Name()))
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, secret := range []string{"fake-end-password", "fake-summary-token", "fake-json-password", "fake-nested-secret"} {
+			if strings.Contains(string(data), secret) {
+				t.Fatalf("%s leaked %s", entry.Name(), secret)
+			}
+		}
+	}
+	// A legacy DB remains untouched while Bint reads expose only a redacted copy.
+	raw := `{"password":"fake-legacy-read","input_tokens":42}`
+	if _, err := s.DB.Exec(`UPDATE events SET payload=? WHERE event_id='legacy-event'`, raw); err != nil {
+		t.Fatal(err)
+	}
+	rows, err := RunEvents(ctx, s.DB, e.RunID)
+	if err != nil || len(rows) != 1 || strings.Contains(rows[0].Payload, "fake-legacy-read") || rows[0].Timestamp != store.FormatTime(ts) {
+		t.Fatalf("legacy read: %+v %v", rows, err)
+	}
+	if err := s.DB.QueryRow(`SELECT payload FROM events WHERE event_id='legacy-event'`).Scan(&payload); err != nil || payload != raw {
+		t.Fatalf("legacy source modified: %s %v", payload, err)
+	}
+}
+
+func TestReviewLegacyNumericCredentialRedactedBeforeSQLite(t *testing.T) {
+	s, dir := setup(t)
+	ctx := context.Background()
+	now := time.Now().UTC()
+	ev := spool.Event{SchemaVersion: 1, EventID: "numeric-event", Type: spool.WorkflowFinished, Source: "test", Timestamp: now, RunID: "numeric-run", Payload: map[string]any{"status": "completed", "password": 123456, "input_tokens": 42}}
+	b, err := json.Marshal(ev)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "numeric.jsonl"), append(b, '\n'), 0600); err != nil {
+		t.Fatal(err)
+	}
+	result, err := Ingest(ctx, s, dir, now, 0)
+	if err != nil || result.Events != 1 {
+		t.Fatalf("ingest: %+v %v", result, err)
+	}
+	var payload string
+	var input int
+	if err := s.DB.QueryRow(`SELECT e.payload,r.input_tokens FROM events e JOIN runs r USING(run_id) WHERE event_id='numeric-event'`).Scan(&payload, &input); err != nil {
+		t.Fatal(err)
+	}
+	var got map[string]any
+	if err := json.Unmarshal([]byte(payload), &got); err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(payload, "123456") || got["password"] != "***" || input != 42 {
+		t.Fatalf("numeric event leaked or metrics changed: %s %d", payload, input)
+	}
+}
+
+func TestSignalsAndLegacyRunDiagnosticsAreRedactedCopies(t *testing.T) {
+	s, _ := setup(t)
+	ctx := context.Background()
+	if _, err := s.DB.Exec(`INSERT INTO runs(run_id,status,end_reason,result_summary) VALUES ('legacy-run','completed',?,?)`, "password=fake-legacy-end", "token=fake-legacy-summary"); err != nil {
+		t.Fatal(err)
+	}
+	sig := Signal{RunID: "legacy-run", Kind: SignalVerify, Positive: true, Strength: "strong", Source: "test", Detail: "curl --token fake-signal-token", DedupKey: "signal-id", ObservedAt: "2026-11-17T01:00:00Z"}
+	if err := UpsertSignal(ctx, s.DB, sig); err != nil {
+		t.Fatal(err)
+	}
+	var detail string
+	if err := s.DB.QueryRow(`SELECT detail FROM outcome_signals`).Scan(&detail); err != nil || strings.Contains(detail, "fake-signal-token") {
+		t.Fatalf("stored signal: %q %v", detail, err)
+	}
+	if _, err := s.DB.Exec(`UPDATE outcome_signals SET detail=?`, "password=fake-legacy-signal"); err != nil {
