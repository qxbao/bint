+func TestCommandAgentPromptIsTemporaryAndErrorRedacted(t *testing.T) {
+	bin, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if os.Getenv("BINT_COMMAND_REDACT_FIXTURE") == "1" {
+		path := os.Getenv("BINT_EVAL_PROMPT_FILE")
+		prompt, err := os.ReadFile(path)
+		if err != nil {
+			os.Exit(2)
+		}
+		_ = json.NewEncoder(os.Stdout).Encode(map[string]any{"type": "result", "is_error": true, "api_error_status": 429,
+			"result": "quota exceeded token=" + os.Getenv("FIXTURE_API_TOKEN"), "num_turns": 2,
+			"prompt": string(prompt), "prompt_path": path})
+		os.Exit(1)
+	}
+	secret := "fixture-command-" + strings.Repeat("long", 80)
+	logDir := t.TempDir()
+	command := fmt.Sprintf("%q -test.run=^TestCommandAgentPromptIsTemporaryAndErrorRedacted$", filepath.ToSlash(bin))
+	r := (&CommandAgent{Command: command}).Run(context.Background(), AgentRequest{
+		Dir: t.TempDir(), LogPath: filepath.Join(logDir, "agent.log"), Prompt: "password=" + secret,
+		Env: []string{"BINT_COMMAND_REDACT_FIXTURE=1", "FIXTURE_API_TOKEN=" + secret}, Timeout: 10 * time.Second})
+	if !r.QuotaHit || r.ExitCode != 1 || r.NumTurns == nil || *r.NumTurns != 2 {
+		t.Fatalf("error classification changed: %+v", r)
+	}
+	for _, diagnostic := range []string{r.Error, r.Infra} {
+		if strings.Contains(diagnostic, "fixture-command") || strings.Contains(diagnostic, strings.Repeat("long", 8)) {
+			t.Fatal("agent error leaked credential or truncated credential")
+		}
+	}
+	entries, err := os.ReadDir(logDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, e := range entries {
+		if e.Name() != "agent.log" {
+			t.Errorf("operational prompt left in log directory: %s", e.Name())
+		}
+	}
+	data, err := os.ReadFile(filepath.Join(logDir, "agent.log"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bytes.Contains(data, []byte("fixture-command")) || bytes.Contains(data, []byte(strings.Repeat("long", 8))) {
+		t.Fatal("agent log leaked the operational prompt or reported credential")
+	}
+	var record struct {
+		PromptPath string `json:"prompt_path"`
+	}
+	seenPrompt := false
+	for _, row := range bytes.Split(data, []byte{'\n'}) {
+		if json.Unmarshal(row, &record) == nil && record.PromptPath != "" {
+			seenPrompt = true
+			if filepath.Dir(record.PromptPath) == logDir {
+				t.Fatal("prompt execution input was created inside diagnostics")
+			}
+			if _, err := os.Stat(record.PromptPath); !os.IsNotExist(err) {
+				t.Errorf("temporary prompt still exists: %v", err)
+			}
+		}
+	}
+	if !seenPrompt {
+		t.Fatal("fixture did not report its operational prompt path")
+	}
+}
