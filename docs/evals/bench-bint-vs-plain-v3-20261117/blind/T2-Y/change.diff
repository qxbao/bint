+package cli
+
+import (
+	"bint/internal/app"
+	"bint/internal/config"
+	"bint/internal/testutil"
+	"bytes"
+	"context"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestCLIUsageErrorRedactsSecret(t *testing.T) {
+	var out, errOut bytes.Buffer
+	code := Execute(context.Background(), []string{"password=cli-fake-secret"}, IO{In: strings.NewReader(""), Out: &out, Err: &errOut})
+	if code != ExitUsage {
+		t.Fatalf("code=%d", code)
+	}
+	if strings.Contains(out.String()+errOut.String(), "cli-fake-secret") {
+		t.Fatalf("leak %s %s", out.String(), errOut.String())
+	}
+}
+
+func TestReviewMCPCheckMasksManagementDiagnostics(t *testing.T) {
+	testutil.Isolate(t)
+	reg := config.Registration{Command: filepath.Join(t.TempDir(), "password=review-mcp-secret", "missing-binary")}
+	if err := config.SaveMachineMCP(config.MachineMCP{Services: map[string]config.Registration{"codegraph": reg}}); err != nil {
+		t.Fatal(err)
+	}
+	results, err := app.MCPCheck(context.Background(), t.TempDir(), app.MCPCheckOptions{Service: "codegraph"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(results) != 1 || results[0].Status != app.MCPStatusFail {
+		t.Fatalf("check behavior: %#v", results)
+	}
+	if strings.Contains(results[0].Detail, "review-mcp-secret") {
+		t.Error("service DTO leaked")
+	}
+	for _, args := range [][]string{{"mcp", "check", "codegraph"}, {"mcp", "check", "codegraph", "--json"}} {
+		var out, errOut bytes.Buffer
+		code := Execute(context.Background(), args, IO{In: strings.NewReader(""), Out: &out, Err: &errOut})
+		if code != ExitError {
+			t.Fatalf("unexpected exit %d: %s", code, errOut.String())
+		}
+		if strings.Contains(out.String()+errOut.String(), "review-mcp-secret") {
+			t.Errorf("CLI leaked: %s %s", out.String(), errOut.String())
+		}
+	}
+	var out bytes.Buffer
+	printMCPCheck(IO{Out: &out}, app.MCPCheckResult{Service: "codegraph", Status: app.MCPStatusFail, Detail: "password=detail-secret", Extra: []string{"token=extra-secret"}, Warnings: []string{"password=warning-secret"}})
+	for _, secret := range []string{"detail-secret", "extra-secret", "warning-secret"} {
+		if strings.Contains(out.String(), secret) {
+			t.Errorf("diagnostic printer leaked %s", secret)
+		}
+	}
+}
