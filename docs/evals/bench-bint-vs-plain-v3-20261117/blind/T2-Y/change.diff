diff --git a/internal/app/task_redaction_test.go b/internal/app/task_redaction_test.go
new file mode 100644
index 0000000..c9235cb
--- /dev/null
+++ b/internal/app/task_redaction_test.go
@@ -0,0 +1,102 @@
+package app
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"bint/internal/task"
+)
+
+const taskSvcSecret = "task-svc-secret-12345"
+
+func seedLegacyTaskCommand(t *testing.T, ws *TaskWS, id string) *task.Task {
+	t.Helper()
+	tk, err := ws.Tasks.Load(id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := filepath.Join(tk.Dir, task.TicketFile)
+	b, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b = bytes.ReplaceAll(b, []byte("git --version"), []byte("check --token "+taskSvcSecret))
+	if err := os.WriteFile(p, b, 0600); err != nil {
+		t.Fatal(err)
+	}
+	return tk
+}
+
+func TestTaskServiceRedactsLegacyDisplayAndArtifact(t *testing.T) {
+	ws, _, id := taskRepo(t)
+	tk := seedLegacyTaskCommand(t, ws, id)
+	original := "password=" + taskSvcSecret + "\n"
+	p := tk.ArtifactPath("plan")
+	if err := os.WriteFile(p, []byte(original), 0600); err != nil {
+		t.Fatal(err)
+	}
+	ctx := context.Background()
+	detail, err := ShowTask(ctx, ws, TaskShowOptions{Ref: id, NoReconcile: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, _ := json.Marshal(detail)
+	if bytes.Contains(b, []byte(taskSvcSecret)) {
+		t.Error("detail leaked legacy command")
+	}
+	list, err := ListTasks(ctx, ws, TaskListOptions{All: true, NoReconcile: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, _ = json.Marshal(list)
+	if bytes.Contains(b, []byte(taskSvcSecret)) {
+		t.Error("list leaked legacy command")
+	}
+	txt, err := ReadTaskArtifact(TaskArtifact{Exists: true, Path: p})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(txt, taskSvcSecret) {
+		t.Error("artifact leaked")
+	}
+	raw, _ := os.ReadFile(p)
+	if string(raw) != original {
+		t.Fatal("legacy artifact changed during read")
+	}
+	loaded, err := ws.Tasks.Load(id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(loaded.Ticket.Verify.Command, taskSvcSecret) {
+		t.Fatal("display redaction changed operational command")
+	}
+}
+
+func TestTaskServiceRejectsLegacyCommandBeforeApprovalAndVerify(t *testing.T) {
+	ws, _, id := taskRepo(t)
+	seedLegacyTaskCommand(t, ws, id)
+	ctx := context.Background()
+	for name, run := range map[string]func() error{
+		"plan approval": func() error { _, err := PlanTaskApprove(ctx, ws, TaskApproveOptions{Ref: id}); return err },
+		"approval":      func() error { _, _, err := ApproveTask(ctx, ws, TaskApproveOptions{Ref: id}); return err },
+		"verify":        func() error { _, err := VerifyTask(ctx, ws, TaskVerifyOptions{Ref: id}); return err },
+	} {
+		t.Run(name, func(t *testing.T) {
+			err := run()
+			if err == nil {
+				t.Fatal("unsafe command accepted")
+			}
+			if strings.Contains(err.Error(), taskSvcSecret) {
+				t.Fatal("error echoed credential")
+			}
+			if !strings.Contains(err.Error(), "credential") {
+				t.Fatalf("wrong rejection: %v", err)
+			}
+		})
+	}
+}
