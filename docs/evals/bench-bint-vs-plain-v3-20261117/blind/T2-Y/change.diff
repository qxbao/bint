+   if strings.Contains(out.String(),"round2-json-secret"){t.Fatalf("JSON leak at split %d: %q",split,out.String())}
+   if !json.Valid(out.Bytes())||!strings.Contains(out.String(),"42"){t.Fatalf("JSON/metrics lost: %q",out.String())}
+  }
+ }
+ var out bytes.Buffer;w:=NewWriter(&out,New());s:="{\n\"token\":\n\"round2-json-secret\"\n}\n"
+ for i:=range []byte(s){_,_=w.Write([]byte{s[i]})};_=w.Flush()
+ if strings.Contains(out.String(),"round2-json-secret"){t.Fatal("byte writes leaked JSON")}
+}
