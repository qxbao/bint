+func TestAgentErrorsRedactedBeforeTruncationAndAfterClassification(t *testing.T) {
+	secret := "fixture-parser-" + strings.Repeat("long", 100)
+	policy := redact.New(secret)
+	message := "usage limit reached credential echo " + secret
+	for _, harness := range []string{"claude", "codex", "agy"} {
+		t.Run(harness, func(t *testing.T) {
+			var r AgentResult
+			switch harness {
+			case "claude":
+				b, _ := json.Marshal(map[string]any{"type": "result", "is_error": true, "result": message, "num_turns": 4})
+				parseClaudeJSON(b, &r, policy)
+			case "codex":
+				b, _ := json.Marshal(map[string]any{"type": "turn.failed", "error": map[string]string{"message": message}})
+				r.Error, _ = codexStreamErrors(b, &r, policy)
+			case "agy":
+				b, _ := json.Marshal(map[string]any{"status": "ERROR", "error": message, "num_turns": 4})
+				parseAgyJSON(b, &r, policy)
+			}
+			if strings.Contains(r.Error+r.Infra, "fixture-parser") || strings.Contains(r.Error+r.Infra, strings.Repeat("long", 8)) || !strings.Contains(r.Error, "***") {
+				t.Fatal("parser truncated or exposed an original credential")
+			}
+			if harness != "agy" && !r.QuotaHit {
+				t.Fatal("error classification lost original quota message")
+			}
+		})
+	}
+	// Classification must use the raw message even when it is itself a known
+	// credential and the safe public message therefore contains only a mask.
+	raw := "usage limit reached"
+	var r AgentResult
+	b, _ := json.Marshal(map[string]any{"type": "turn.failed", "message": raw, "error": raw})
+	r.Error, _ = codexStreamErrors(b, &r, redact.New(raw))
+	if !r.QuotaHit || strings.Contains(r.Error+r.Infra, raw) {
+		t.Fatal("classification ran on scrubbed data or exposed the known value")
+	}
+}
