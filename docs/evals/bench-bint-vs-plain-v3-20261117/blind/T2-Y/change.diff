diff --git a/internal/runlog/redact.go b/internal/runlog/redact.go
new file mode 100644
index 0000000..41f0dde
--- /dev/null
+++ b/internal/runlog/redact.go
@@ -0,0 +1,30 @@
+package runlog
+
+import (
+	"encoding/json"
+	"io"
+	"os"
+	"strings"
+
+	"bint/internal/redact"
+)
+
+// Decode before redacting so JSON escapes cannot hide keys or values. UseNumber
+// retains large integer IDs and metrics rather than rounding them through float64.
+func redactPayload(raw string) string {
+	d := json.NewDecoder(strings.NewReader(raw))
+	d.UseNumber()
+	var value any
+	if d.Decode(&value) != nil {
+		return `{"diagnostic":"invalid payload omitted"}`
+	}
+	var extra any
+	if d.Decode(&extra) != io.EOF {
+		return `{"diagnostic":"invalid payload omitted"}`
+	}
+	b, err := json.Marshal(redact.FromEnv(os.Environ()).Value(value))
+	if err != nil {
+		return `{"diagnostic":"invalid payload omitted"}`
+	}
+	return string(b)
+}
diff --git a/internal/runlog/redact_test.go b/internal/runlog/redact_test.go
