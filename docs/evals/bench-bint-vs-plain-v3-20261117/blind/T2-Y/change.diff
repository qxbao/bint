+func TestTaskReviewAndOutcomesLegacyReads(t *testing.T) {
+	s := newStore(t)
+	tk, err := s.Create(Ticket{Goal: "g"}, State{}, time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	rev := Review{TaskID: tk.State.ID, Rounds: []ReviewRound{{Summary: taskSensitive, Findings: []Finding{{Title: taskSensitive, Evidence: taskSensitive}}}}}
+	outcomes := Outcomes{TaskID: tk.State.ID, Records: []OutcomeRecord{{Reason: taskSensitive}}}
+	for name, v := range map[string]any{ReviewFile: rev, OutcomeFile: outcomes} {
+		b, _ := json.Marshal(v)
+		if err := os.WriteFile(filepath.Join(tk.Dir, name), b, 0600); err != nil {
