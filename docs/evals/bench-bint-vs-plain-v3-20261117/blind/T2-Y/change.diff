diff --git a/internal/redact/shell.go b/internal/redact/shell.go
new file mode 100644
index 0000000..767e24f
--- /dev/null
+++ b/internal/redact/shell.go
@@ -0,0 +1,157 @@
+package redact
+
+import (
+	"regexp"
+	"strings"
+)
+
+// A shell value is a whole word, including adjacent quoted/unquoted fragments,
+// escaped spaces and commas. Matching a single quoted fragment is unsafe both
+// for masking and for deciding whether a command is only an env reference.
+var assignmentStart = regexp.MustCompile(`(?i)(["']?)(\b` + keyPattern + `)(["']?[ \t]*[:=][ \t]*)`)
+
+// Shell removes quotes and escapes from flag names too. Keep the raw prefix
+// offsets for masking, but classify the complete literal name after unquoting.
+func flagPrefixes(s string)[][]int {
+ var prefixes [][]int
+ for i:=0;i<len(s);i++ {
+  if s[i]!='-'{continue}
+  j:=i+1;if j<len(s)&&s[j]=='-'{j++}
+  outer:=shellQuoteAt(s,i);wrapperOpen:=outer!=0
+  var quote byte;var name strings.Builder
+  for ;j<len(s);j++ {
+   c:=s[j]
+   if c=='\\'&&quote!='\'' {if j+1==len(s){break};j++;name.WriteByte(s[j]);continue}
+   if c=='=' {if SensitiveName(name.String()){prefixes=append(prefixes,[]int{i,j+1})};break}
+   if quote!=0 {if c==quote{quote=0}else{name.WriteByte(c)};continue}
+   if wrapperOpen&&c==outer {wrapperOpen=false;continue}
+   if c=='"'||c=='\'' {quote=c;continue}
+   if c==' '||c=='\t' {if SensitiveName(name.String()){end:=j;for end<len(s)&&(s[end]==' '||s[end]=='\t'){end++};prefixes=append(prefixes,[]int{i,end})};break}
+   if !((c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='_'||c=='-'){break}
+   name.WriteByte(c)
+  }
+ }
+ return prefixes
+}
+
+func shellWord(s string, start int) (end int, incomplete bool) {
+	outer := shellQuoteAt(s, start)
+	wrapperOpen := outer != 0
+	var quote byte
+	escapedQuote := false
+	for i := start; i < len(s); i++ {
+		c := s[i]
+		if quote!='\''&&(c=='`'||(c=='$'&&i+1<len(s)&&s[i+1]=='(')) {
+			end,open:=shellExpansion(s,i,0);if open{return len(s),true};i=end-1;continue
+		}
+		if c == '\\' && quote != '\'' {
+			if i+1 == len(s) {
+				return len(s), true
+			}
+			if outer != 0 && s[i+1] == outer {
+				if escapedQuote && quote == outer {
+					quote = 0
+					escapedQuote = false
+				} else if quote == 0 {
+					quote = outer
+					escapedQuote = true
+				}
+			}
+			i++
+			continue
+		}
+		if quote != 0 {
+			if c == quote {
+				quote = 0
+			}
+			continue
+		}
+		if wrapperOpen && c == outer {
+			wrapperOpen = false
+			continue
+		}
+		if c == '"' || c == '\'' {
+			quote = c
+			continue
+		}
+		if !wrapperOpen && strings.ContainsRune(" \t\r\n;&|<>()", rune(c)) {
+			return i, false
+		}
+	}
+	return len(s), quote != 0 || wrapperOpen
+}
+
+func shellQuoteAt(s string, end int) byte {
+	var quote byte
+	for i := 0; i < end; i++ {
+		c := s[i]
+		if quote!='\''&&(c=='`'||(c=='$'&&i+1<len(s)&&s[i+1]=='(')){next,_:=shellExpansion(s,i,0);i=next-1;continue}
+		if c == '\\' && quote != '\'' {
+			i++
+			continue
+		}
+		if quote != 0 {
+			if c == quote {
+				quote = 0
+			}
+			continue
+		}
+		if c == '"' || c == '\'' {
+			quote = c
+		}
+	}
+	return quote
+}
+
+func shellValues(s string, prefixes [][]int, allowRefs bool) string {
+	var out strings.Builder
+	cursor := 0
+	for _, idx := range prefixes {
+		if idx[0] < cursor {
+			continue
+		}
+		start := idx[1]
+		valueStart := start
+		for _, scheme := range []string{"bearer ", "basic "} {
+			if strings.HasPrefix(strings.ToLower(s[start:]), scheme) {
+				valueStart = start + len(scheme)
+				break
+			}
+		}
+		end, _ := shellWord(s, valueStart)
+		if end == start {
+			continue
+		}
+		out.WriteString(s[cursor:start])
+		if allowRefs && reference(s[start:end]) {
+			out.WriteString(s[start:end])
+		} else {
+			out.WriteString(Mask)
+			if outer := shellQuoteAt(s, valueStart); outer != 0 {
+				out.WriteByte(outer)
+			}
+		}
+		cursor = end
+	}
+	out.WriteString(s[cursor:])
+	return out.String()
+}
+
+// The streaming writer uses the same shell word boundary as Text/CommandSafe,
+// so a newline inside a quote is never mistaken for a complete record.
+func incompleteShellValue(s string) bool {
+	for _, prefixes := range [][][]int{assignmentStart.FindAllStringIndex(s,-1), flagPrefixes(s)} {
+		cursor := 0
+		for _, idx := range prefixes {
+			if idx[0] < cursor {
+				continue
+			}
+			end, open := shellWord(s, idx[1])
+			if open {
+				return true
+			}
+			cursor = end
+		}
+	}
+	return false
+}
diff --git a/internal/redact/shell_expansion.go b/internal/redact/shell_expansion.go
new file mode 100644
index 0000000..10e5368
--- /dev/null
+++ b/internal/redact/shell_expansion.go
@@ -0,0 +1,23 @@
+package redact
+
+// Return the end of an entire command/arithmetic substitution, including nested
+// substitutions and their quotes. The diagnostic value must never be cut at a
+// parenthesis or whitespace inside it. Incomplete/excessively nested input stays
+// buffered (and the Writer's size bound fails closed).
+func shellExpansion(s string,start,level int)(int,bool) {
+ if level>=64{return len(s),true}
+ backtick:=s[start]=='`';i:=start+1
+ depth:=1;if !backtick{i++}
+ var quote byte
+ for ;i<len(s);i++ {
+  c:=s[i]
+  if c=='\\'&&quote!='\'' {i++;continue}
+  if quote=='\'' {if c=='\''{quote=0};continue}
+  if backtick&&c=='`'{return i+1,false}
+  if c=='`'||(c=='$'&&i+1<len(s)&&s[i+1]=='(') {end,open:=shellExpansion(s,i,level+1);if open{return len(s),true};i=end-1;continue}
+  if quote=='"' {if c=='"'{quote=0};continue}
+  if c=='\''||c=='"' {quote=c;continue}
+  if !backtick {if c=='(' {depth++};if c==')'{depth--;if depth==0{return i+1,false}}}
+ }
+ return len(s),true
+}
