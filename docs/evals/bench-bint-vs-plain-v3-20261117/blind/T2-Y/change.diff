+func TestEvalPersistenceAndLegacyDiagnosticsRedacted(t *testing.T) {
+	ctx := context.Background()
+	s, err := store.Open(ctx, filepath.Join(t.TempDir(), "eval.sqlite"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	const secret = "fake-eval-persistence-credential"
+	b := Batch{BatchID: "batch-redact", Status: "running", Harness: "command", LeakageMode: "strict", Arms: []string{"none"}, CaseIDs: []string{"case"}, StartedAt: "2026-11-17T00:00:00Z", Notes: []string{"password=" + secret}}
+	if err := createBatch(ctx, s.DB, b); err != nil {
+		t.Fatal(err)
+	}
+	a := AttemptRow{AttemptID: "attempt-redact", BatchID: b.BatchID, CaseID: "case", Arm: "none", Harness: "command", CaseFingerprint: "fp", StartedAt: b.StartedAt}
+	if err := startAttempt(ctx, s.DB, a); err != nil {
+		t.Fatal(err)
+	}
+	input, output := int64(17), int64(9)
+	cost := .125
+	a.Status, a.Error, a.InputTokens, a.OutputTokens, a.CostUSD = "failed", "token="+secret, &input, &output, &cost
+	if err := finishAttempt(ctx, s.DB, a); err != nil {
+		t.Fatal(err)
+	}
+	var notes, message string
+	if err := s.DB.QueryRowContext(ctx, `SELECT notes FROM eval_batches WHERE batch_id=?`, b.BatchID).Scan(&notes); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.DB.QueryRowContext(ctx, `SELECT error FROM evaluation_runs WHERE attempt_id=?`, a.AttemptID).Scan(&message); err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(notes+message, secret) || !strings.Contains(notes+message, "***") {
+		t.Fatal("raw credential persisted in eval diagnostics")
+	}
+	// Existing databases remain unchanged on disk, but reads must be safe.
+	if _, err := s.DB.ExecContext(ctx, `UPDATE evaluation_runs SET error=? WHERE attempt_id=?`, "token="+secret, a.AttemptID); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.DB.ExecContext(ctx, `UPDATE eval_batches SET notes=? WHERE batch_id=?`, `["password=`+secret+`"]`, b.BatchID); err != nil {
+		t.Fatal(err)
+	}
+	read, err := Attempts(ctx, s.DB, "batch_id=?", b.BatchID)
+	if err != nil || len(read) != 1 {
+		t.Fatalf("read attempts: %v, %d", err, len(read))
+	}
+	batch, err := GetBatch(ctx, s.DB, b.BatchID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(read[0].Error+strings.Join(batch.Notes, ""), secret) {
+		t.Fatal("legacy credential exposed on read")
+	}
+	if read[0].InputTokens == nil || *read[0].InputTokens != input || read[0].OutputTokens == nil || *read[0].OutputTokens != output || read[0].CostUSD == nil || *read[0].CostUSD != cost || read[0].StartedAt != b.StartedAt || read[0].AttemptID != a.AttemptID {
+		t.Fatal("redaction changed identifiers, numeric usage, or time")
+	}
+}
