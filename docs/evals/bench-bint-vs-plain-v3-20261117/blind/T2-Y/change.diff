+package app
+
+import (
+	"bytes"
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"bint/internal/config"
+	"bint/internal/eval"
+	"bint/internal/mcpgw"
+	"bint/internal/skills"
+	"bint/internal/testutil"
+)
+
+func TestSkillAnswerDiagnosticRedactsAfterGrading(t *testing.T) {
+	secret := "skill-answer-secret-12345"
+	answer := "password=" + secret
+	agent := &fakeSkillAgent{reply: func(int, eval.AgentRequest) eval.AgentResult { return eval.AgentResult{Text: answer} }}
+	logRoot := t.TempDir()
+	run, quota := runSkillTestOnce(context.Background(), agent, config.Default(), &skills.CustomSkill{}, eval.SkillScenario{Name: "scenario", Expect: []eval.ExpectRule{{Contains: &secret}}}, eval.SkillArmWithout, 1, "prompt", logRoot)
+	if quota || !run.Complied {
+		t.Fatalf("grading must use original answer: %+v", run)
+	}
+	b, err := os.ReadFile(filepath.Join(logRoot, "scenario", "without-1", "answer.txt"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bytes.Contains(b, []byte(secret)) {
+		t.Fatal("answer diagnostic leaked")
+	}
+	agent.reply = func(int, eval.AgentRequest) eval.AgentResult { return eval.AgentResult{Error: answer} }
+	run, _ = runSkillTestOnce(context.Background(), agent, config.Default(), &skills.CustomSkill{}, eval.SkillScenario{Name: "scenario"}, eval.SkillArmWithout, 2, "prompt", logRoot)
+	if strings.Contains(run.Error, secret) {
+		t.Fatal("run error leaked")
+	}
+}
+
+func TestMCPDetachedStartupFailureLogRedacted(t *testing.T) {
+	testutil.Isolate(t)
+	secret := "mcp-startup-secret-12345"
+	t.Setenv("BINT_STATE_DIR", filepath.Join(t.TempDir(), "password="+secret))
+	t.Setenv(mcpgw.DetachedLogEnv, "1")
+	dir, err := mcpgw.Dir()
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Fail before listening: a directory cannot be opened as the lock file.
+	if err := os.MkdirAll(filepath.Join(dir, mcpgw.LockFileName), 0700); err != nil {
+		t.Fatal(err)
+	}
+	_, err = MCPGatewayStart(context.Background(), "test", MCPGatewayStartOptions{Foreground: true}, nil, nil)
+	if err == nil {
+		t.Fatal("expected startup failure")
+	}
+	b, err := os.ReadFile(filepath.Join(dir, mcpgw.LogFileName))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(b) == 0 {
+		t.Fatal("startup error diagnostic lost")
+	}
+	if bytes.Contains(b, []byte(secret)) {
+		t.Fatal("startup error diagnostic leaked")
+	}
+}
+
+func TestMCPGatewayLegacyLogRedacted(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "gateway.log")
+	secret := "gateway-legacy-secret-12345"
+	original := "2026-11-17T00:00:00Z codegraph (partition): password=" + secret + "\n"
+	if err := os.WriteFile(path, []byte(original), 0600); err != nil {
+		t.Fatal(err)
+	}
+	lines, err := mcpGatewayLogLines(path, "codegraph", 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(lines) != 1 || strings.Contains(lines[0], secret) {
+		t.Fatalf("unsafe legacy log: %q", lines)
+	}
+	b, _ := os.ReadFile(path)
+	if string(b) != original {
+		t.Fatal("read rewrote legacy log")
+	}
+}
