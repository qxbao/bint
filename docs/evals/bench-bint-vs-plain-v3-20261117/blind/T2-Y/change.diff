@@ -0,0 +1,24 @@
+package redact
+
+import (
+	"net/url"
+	"regexp"
+)
+
+var queryParameter = regexp.MustCompile(`([?&])([^?&=\s"'<>]+)=([^&\s"'<>]*)`)
+
+// Decode parameter names for classification only. Preserve the raw URL, order,
+// duplicate keys and unrelated values; operational URLs are never rewritten.
+func querySecrets(s string, allowRefs bool) string {
+	return queryParameter.ReplaceAllStringFunc(s, func(m string) string {
+		g := queryParameter.FindStringSubmatch(m)
+		name, err := url.QueryUnescape(g[2])
+		if err != nil || !SensitiveName(name) {
+			return m
+		}
+		if allowRefs && reference(g[3]) {
+			return m
+		}
+		return g[1] + g[2] + "=" + Mask
+	})
+}
diff --git a/internal/redact/writer.go b/internal/redact/writer.go
new file mode 100644
index 0000000..5bdd4e6
--- /dev/null
+++ b/internal/redact/writer.go
@@ -0,0 +1,151 @@
+package redact
+
+import (
+	"bytes"
+	"io"
+	"regexp"
+	"strings"
+	"sync"
+)
+
+const MaxLine = 64 * 1024
+const OmittedLine = "[redacted: diagnostic line exceeds 64 KiB]\n"
+
+// Writer retains incomplete lines, including bytes split inside UTF-8 or JSON
+// escapes. Flush must be called at EOF, also on cancellation and process errors.
+// Oversized lines are discarded in full; no unfiltered prefix is emitted.
+type Writer struct {
+	mu          sync.Mutex
+	dst         io.Writer
+	policy      *Policy
+	pending     []byte
+	dropping    bool
+	discardRest bool // an oversized unfinished quoted/block record has no safe boundary
+	err         error
+}
+
+func NewWriter(dst io.Writer, p *Policy) *Writer {
+	if p == nil {
+		p = FromEnv(nil)
+	}
+	return &Writer{dst: dst, policy: p}
+}
+
+func (w *Writer) Write(b []byte) (int, error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.err != nil {
+		return 0, w.err
+	}
+	n := len(b)
+	if w.discardRest {
+		return n, nil
+	}
+	for len(b) > 0 {
+		i := bytes.IndexByte(b, '\n')
+		end := len(b)
+		if i >= 0 {
+			end = i + 1
+		}
+		part := b[:end]
+		b = b[end:]
+		if !w.dropping {
+			if len(w.pending)+len(part) > MaxLine {
+				keep := MaxLine - len(w.pending)
+				w.pending = append(w.pending, part[:keep]...)
+				if w.incomplete() {
+					w.pending = nil
+					w.discardRest = true
+					_, w.err = io.WriteString(w.dst, OmittedLine)
+					return n, w.err
+				}
+				w.pending = nil
+				w.dropping = true
+			} else {
+				w.pending = append(w.pending, part...)
+			}
+		}
+		if i >= 0 && (w.dropping || !w.incomplete()) {
+			if w.dropping {
+				_, w.err = io.WriteString(w.dst, OmittedLine)
+			} else {
+				_, w.err = io.WriteString(w.dst, w.policy.recordText(string(w.pending)))
+			}
+			w.pending = nil
+			w.dropping = false
+			if w.err != nil {
+				return n - len(b), w.err
+			}
+		}
+	}
+	return n, nil
+}
+
+var blockStart = regexp.MustCompile(`(?im)^([ \t]*(?:-[ \t]+)?)["']?(` + keyPattern + `)["']?:[^\n]*\n`)
+
+func (w *Writer) incomplete() bool {
+	s := string(w.pending)
+	if incompleteJSON(s){return true}
+	if incompleteShellValue(s) {
+		return true
+	}
+	for _, idx := range blockStart.FindAllStringSubmatchIndex(s, -1) {
+		indent := idx[3] - idx[2]
+		tail := s[idx[1]:]
+		closed := false
+		for _, line := range strings.Split(tail, "\n") {
+			if strings.TrimSpace(line) == "" {
+				continue
+			}
+			n := len(line) - len(strings.TrimLeft(line, " \t"))
+			if n <= indent {
+				closed = true
+				break
+			}
+		}
+		if !closed {
+			return true
+		}
+	}
+	for _, secret := range w.policy.values {
+		if !strings.Contains(secret, "\n") {
+			continue
+		}
+		for i := 1; i < len(secret); i++ {
+			if strings.HasSuffix(s, secret[:i]) {
+				return true
+			}
+		}
+	}
+	return false
+}
+func (w *Writer) Flush() error {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.err != nil {
+		return w.err
+	}
+	if w.dropping {
+		_, w.err = io.WriteString(w.dst, OmittedLine)
+	} else if len(w.pending) > 0 {
+		_, w.err = io.WriteString(w.dst, w.policy.recordText(string(w.pending)))
+	}
+	w.pending = nil
+	w.dropping = false
+	return w.err
+}
+func (w *Writer) Close() error { return w.Flush() }
+
+type lockedWriter struct {
+	mu  sync.Mutex
+	dst io.Writer
+}
+
+func (w *lockedWriter) Write(p []byte) (int, error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	return w.dst.Write(p)
+}
+
+// SyncWriter lets separate stdout/stderr record buffers share a single sink.
+func SyncWriter(dst io.Writer) io.Writer { return &lockedWriter{dst: dst} }
diff --git a/internal/redact/yaml.go b/internal/redact/yaml.go
