diff --git a/internal/mcpgw/redact_test.go b/internal/mcpgw/redact_test.go
new file mode 100644
index 0000000..3c1c229
--- /dev/null
+++ b/internal/mcpgw/redact_test.go
@@ -0,0 +1,84 @@
+package mcpgw
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestScrubSecretsUsesCompleteValuesBeforeTruncating(t *testing.T) {
+	if got := ScrubSecrets("failed ab", []string{"ab"}, 500); got != "failed ***" {
+		t.Fatalf("short credential leaked: %q", got)
+	}
+	if got := ScrubSecrets(`{"outer":{"api_key":"fake-json-mcp-key"},"input_tokens":42}`, nil, 500); strings.Contains(got, "fake-json-mcp-key") || !strings.Contains(got, "42") {
+		t.Fatalf("structured diagnostic: %q", got)
+	}
+	if got := ScrubSecrets("bad password='"+strings.Repeat("x", 500)+"'", nil, 20); strings.Contains(got, "xxx") {
+		t.Fatalf("cut before scrub: %q", got)
+	}
+}
+
+func TestLegacyGatewayTailRedactsBeforeCutAndKeepsSource(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "gateway.log")
+	raw := "error password='" + strings.Repeat("fake-legacy-tail", 100) + "'\n"
+	if err := os.WriteFile(path, []byte(raw), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	got := logTail(path)
+	if strings.Contains(got, "fake-legacy-tail") || !strings.Contains(got, "***") {
+		t.Fatalf("unsafe legacy tail: %q", got)
+	}
+	b, err := os.ReadFile(path)
+	if err != nil || string(b) != raw {
+		t.Fatal("legacy source changed")
+	}
+}
+
+func TestDaemonLogRedactsLabelledAndKnownCredentials(t *testing.T) {
+	t.Setenv("BINT_DIAGNOSTIC_TOKEN", "fake-known-daemon-token")
+	var b bytes.Buffer
+	d := &Daemon{opts: Options{Log: &b}}
+	d.logf("error: %s", "password=fake-daemon-password and fake-known-daemon-token")
+	if strings.Contains(b.String(), "fake-daemon-password") || strings.Contains(b.String(), "fake-known-daemon-token") {
+		t.Fatalf("unsafe daemon log: %q", b.String())
+	}
+}
+
+func TestStdioDiagnosticStreamRedactsChunksAndPreservesRPC(t *testing.T) {
+	ctx, cancel := context.WithTimeout(t.Context(), 10*time.Second)
+	defer cancel()
+	const secret = "fake-chunked-mcp-secret"
+	u, err := startStdio(ctx, stdioCfg{gen: 1, path: osArgs0(), args: []string{"__fake_upstream", "stderrchunk=1"}, env: append(os.Environ(), "JIRA_MCP_PASSWORD="+secret), secretVals: []string{secret}, maxFrame: DefaultMaxFrame, queue: DefaultWriteQueue})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer u.stop()
+	eventually(t, "redacted stderr", 5*time.Second, func() bool { return strings.Contains(u.stderr.Lines(), "warn ***") })
+	if strings.Contains(u.stderr.Lines(), secret) {
+		t.Fatalf("tail contains raw credential: %q", u.stderr.Lines())
+	}
+	r, err := u.call(ctx, "session-id", "tools/call", json.RawMessage(`{"name":"fake_tool","arguments":{"echo":"`+secret+`"}}`), true, nil)
+	if err != nil || !strings.Contains(string(r.result), secret) {
+		t.Fatalf("operational RPC was changed: %s %v", r.result, err)
+	}
+}
+
+func TestDetachedStartupNeverCopiesUncontrolledOutput(t *testing.T) {
+	dir := t.TempDir()
+	_, _, err := StartDetached(t.Context(), dir, osArgs0(), []string{"__unsafe_gateway_start"}, nil)
+	if err == nil {
+		t.Fatal("unsafe fake child unexpectedly started")
+	}
+	data, readErr := os.ReadFile(filepath.Join(dir, LogFileName))
+	if readErr != nil && !os.IsNotExist(readErr) {
+		t.Fatal(readErr)
+	}
+	if strings.Contains(string(data)+err.Error(), "fake-detached-stdout") || strings.Contains(string(data)+err.Error(), "fake-detached-stderr") {
+		t.Fatalf("uncontrolled child output retained: %q %v", data, err)
+	}
+}
