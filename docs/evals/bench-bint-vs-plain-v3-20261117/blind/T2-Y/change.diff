+func TestProgressAndTruncatedDiagnosticsRedacted(t *testing.T) {
+	secret := "fixture-workflow-" + strings.Repeat("long", 100)
+	var output strings.Builder
+	r := Runner{Logf: func(format string, values ...any) { fmt.Fprintf(&output, format, values...) }}
+	r.logf("verify command: %s", "tool --password='"+secret+"'")
+	if strings.Contains(output.String(), "fixture-workflow") || !strings.Contains(output.String(), "***") {
+		t.Fatal("workflow progress leaked credential")
+	}
+	value := truncate("token="+secret, 25)
+	if strings.Contains(value, "fixture-workflow") || !strings.Contains(value, "***") {
+		t.Fatal("workflow truncated credential before redaction")
+	}
+}
+
+func TestCodegraphLogRedactsSplitOutputAndEOF(t *testing.T) {
+	h := newHarness(t)
+	r := h.runner()
+	const secret = "fake-codegraph-split-credential"
+	t.Setenv("FIXTURE_API_TOKEN", secret)
+	setCodegraphSeams(t, func(_ context.Context, _ string, out io.Writer) (mcpgw.CodegraphInitResult, error) {
+		for _, part := range []string{"token=", secret[:9], secret[9:]} {
+			if _, err := io.WriteString(out, part); err != nil {
+				return mcpgw.CodegraphInitResult{}, err
+			}
+		}
+		return mcpgw.CodegraphInitResult{Action: "created", Warning: "password=" + secret}, nil
+	}, nil)
+	log := filepath.Join(t.TempDir(), "codegraph.log")
+	notes, err := r.initOriginIndex(context.Background(), h.root, log)
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(log)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(data)+strings.Join(notes, ""), secret) || !strings.Contains(string(data), "***") {
+		t.Fatal("codegraph diagnostics leaked credential or omitted EOF flush")
+	}
+}
+
+func TestLegacyCredentialCommandRejectedBeforeVerifyAndApprove(t *testing.T) {
+	h := newHarness(t)
+	r := h.runner()
+	tk := h.newDo(r, NewTaskOptions{})
+	const secret = "fake-legacy-verify-credential"
+	// Simulate a pre-policy task; public task writers now reject this input.
+	tk.Ticket.Verify.Command = "printf executed > leak-marker; tool --token " + secret
+	raw, err := yaml.Marshal(tk.Ticket)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(tk.Dir, task.TicketFile), raw, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	r.Cfg.Security.RequireApprovalForCommands = false
+	if _, _, err := r.VerifyWith(context.Background(), tk.State.ID, ""); err == nil || strings.Contains(err.Error(), secret) {
+		t.Fatalf("unsafe verification was accepted or exposed the credential: %v", err)
+	}
+	if _, err := os.Stat(filepath.Join(h.root, "leak-marker")); !os.IsNotExist(err) {
+		t.Fatal("legacy credential command ran before rejection")
+	}
+	if _, _, err := r.ApproveWith(tk.State.ID, ApproveInput{}); err == nil || strings.Contains(err.Error(), secret) {
+		t.Fatalf("unsafe approval was accepted or exposed the credential: %v", err)
+	}
+}
+
+func TestCredentialSetupRejectedBeforeWorktreeCreation(t *testing.T) {
+	h := newHarness(t).wtHarness()
+	r := h.runner()
+	tk := h.newDo(r, NewTaskOptions{})
+	const secret = "fake-setup-credential"
+	r.Cfg.Workflow.Worktree.SetupCommand = "tool --password " + secret
+	if _, _, err := r.ApproveWith(tk.State.ID, ApproveInput{}); err == nil || strings.Contains(err.Error(), secret) {
+		t.Fatalf("unsafe setup approval was accepted or exposed the credential: %v", err)
+	}
+	r.Cfg.Security.RequireApprovalForCommands = false
+	rs := &runState{t: tk, res: &Result{}}
+	if r.ensureWorktree(context.Background(), rs) {
+		t.Fatal("unsafe setup was accepted")
+	}
+	if _, err := os.Stat(r.WorktreePath(tk.State.ID)); !os.IsNotExist(err) {
+		t.Fatal("worktree created before credential command rejection")
+	}
+	if len(h.calls) != 0 {
+		t.Fatal("agent ran before credential command rejection")
+	}
+}
