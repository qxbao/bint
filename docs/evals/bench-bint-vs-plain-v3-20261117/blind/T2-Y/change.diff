+package task
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+const taskSecret = "task-secret-abcdef"
+const taskSensitive = "password=" + taskSecret
+
+func assertTaskSafe(t *testing.T, dir string) {
+	t.Helper()
+	err := filepath.WalkDir(dir, func(path string, d os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if d.IsDir() {
+			return nil
+		}
+		b, err := os.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		if bytes.Contains(b, []byte(taskSecret)) {
+			t.Errorf("secret persisted in %s", filepath.Base(path))
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestTaskRedactsPersistenceAndLegacyReads(t *testing.T) {
+	s := newStore(t)
+	now := time.Now()
+	tk, err := s.Create(Ticket{Goal: taskSensitive, Request: taskSensitive, Verify: Verify{Command: "true", Criteria: []string{taskSensitive}}, Constraints: []string{taskSensitive}}, State{Reason: taskSensitive}, now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range ArtifactNames() {
+		if _, err := tk.WriteArtifact(name, taskSensitive); err != nil {
+			t.Fatal(err)
+		}
+	}
+	_, err = s.Update(tk.State.ID, now, func(tk *Task) error {
+		tk.State.Errors = append(tk.State.Errors, ErrorRecord{Message: taskSensitive})
+		tk.State.Criteria = append(tk.State.Criteria, CriterionCheck{Index: 1, Met: true, Evidence: taskSensitive})
+		_, err := tk.AddRound(Submission{Summary: taskSensitive, Findings: []Finding{{Title: taskSensitive, Evidence: taskSensitive, Body: taskSensitive}}}, "tester", "", Now(now))
+		if err != nil {
+			return err
+		}
+		return tk.AppendOutcomes(OutcomeRecord{Finding: tk.State.ID + ".1", Outcome: OutcomeDeferred, Reason: taskSensitive})
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertTaskSafe(t, tk.Dir)
+	// Simulate old task files; reading must never rewrite the source.
+	old, err := os.ReadFile(filepath.Join(tk.Dir, TicketFile))
+	if err != nil {
+		t.Fatal(err)
+	}
+	legacy := bytes.ReplaceAll(old, []byte("***"), []byte(taskSecret))
+	if err := os.WriteFile(filepath.Join(tk.Dir, TicketFile), legacy, 0600); err != nil {
+		t.Fatal(err)
+	}
+	loaded, err := s.Load(tk.State.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(loaded.Ticket.Goal, taskSecret) {
+		t.Fatal("legacy goal leaked")
+	}
+	got, _ := os.ReadFile(filepath.Join(tk.Dir, TicketFile))
+	if !bytes.Equal(got, legacy) {
+		t.Fatal("legacy source changed during read")
+	}
+}
+
+func TestTaskRejectsLiteralCommandWithoutEcho(t *testing.T) {
+	s := newStore(t)
+	_, err := s.Create(Ticket{Goal: "g", Verify: Verify{Command: "check --token " + taskSecret}}, State{}, time.Now())
+	if err == nil {
+		t.Fatal("literal credential command accepted")
+	}
+	if strings.Contains(err.Error(), taskSecret) {
+		t.Fatal("error echoes credential")
+	}
+	tk, err := s.Create(Ticket{Goal: "g", Verify: Verify{Command: `check --token "$API_TOKEN"`}}, State{}, time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if tk.Ticket.Verify.Command != `check --token "$API_TOKEN"` {
+		t.Fatal("env command changed")
+	}
+	_, err = s.Update(tk.State.ID, time.Now(), func(tk *Task) error { tk.Ticket.Verify.Command = "check --password=" + taskSecret; return nil })
+	if err == nil {
+		t.Fatal("update accepted literal credential")
+	}
+	b, _ := os.ReadFile(filepath.Join(tk.Dir, TicketFile))
+	if bytes.Contains(b, []byte(taskSecret)) {
+		t.Fatal("rejected command saved")
+	}
+}
+
+func TestReviewRejectsConcatenatedAndEncodedCredentialBeforeTaskWrite(t *testing.T) {
+	for _, cmd := range []string{`curl --token="${API_TOKEN}"literal-suffix`, `curl 'https://host/?api%5Fkey=encoded-secret'`, `curl --password='first'"second"`, `curl --password=first,second`} {
+		s := newStore(t)
+		_, err := s.Create(Ticket{Goal: "review", Verify: Verify{Command: cmd}}, State{}, time.Now())
+		if err == nil {
+			t.Fatalf("credential command saved: %s", cmd)
+		}
+		entries, readErr := os.ReadDir(s.Dir)
+		if readErr != nil {
+			t.Fatal(readErr)
+		}
+		if len(entries) != 0 {
+			t.Fatal("rejected credential command wrote task files")
+		}
+		for _, part := range []string{"literal-suffix", "encoded-secret", "first", "second"} {
+			if strings.Contains(err.Error(), part) {
+				t.Fatal("rejection echoed credential")
+			}
+		}
+	}
+}
