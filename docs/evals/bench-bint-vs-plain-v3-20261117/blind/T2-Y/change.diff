+ r:=&rig{t:t};r.m=tasks.New(tasks.Options{Dir:root,ReadOnly:true,Loader:func(context.Context,string,bool)(tasks.Data,error){return tasks.Data{Root:root,Tasks:[]*task.Task{tk.Redacted()}},nil},Runs:runs})
