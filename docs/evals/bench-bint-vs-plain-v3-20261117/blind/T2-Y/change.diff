+	stateRoot := os.Getenv("BINT_STATE_DIR")
+	var dir string
+	_ = filepath.WalkDir(stateRoot, func(p string, d os.DirEntry, e error) error {
+		if e == nil && d.IsDir() && d.Name() == id {
+			dir = p
+		}
+		return nil
+	})
+	if dir == "" {
+		t.Fatalf("task directory missing under %s; show=%s", stateRoot, view)
+	}
+	ticketPath := filepath.Join(dir, task.TicketFile)
+	raw, err := os.ReadFile(ticketPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	seeded := strings.Replace(string(raw), "goal: ordinary task", `goal: 'password="legacy-cli-secret"'`, 1)
+	if seeded == string(raw) {
+		t.Fatalf("goal fixture missing: %s", raw)
+	}
+	if err := os.WriteFile(ticketPath, []byte(seeded), 0600); err != nil {
+		t.Fatal(err)
+	}
+	for _, args := range [][]string{{"task", "show", id}, {"task", "show", id, "--json"}, {"task", "list"}, {"task", "list", "--json"}} {
+		out, _, code := runSplit(t, root, "", args...)
+		if code != 0 {
+			t.Fatalf("%v: %d %s", args, code, out)
+		}
+		if strings.Contains(out, "legacy-cli-secret") {
+			t.Fatalf("%v leaked: %s", args, out)
+		}
+		if args[len(args)-1] == "--json" && !json.Valid([]byte(out)) {
+			t.Fatalf("invalid JSON: %s", out)
+		}
+	}
+	after, _ := os.ReadFile(ticketPath)
+	if string(after) != seeded {
+		t.Fatal("legacy task file was rewritten on read")
+	}
+}
