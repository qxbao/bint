+// A real child process exercises exec's independently copied stdout/stderr,
+// arbitrary Write boundaries, and EOF/timeout flushing without a model or network.
+func TestRunProcessRedactsDiagnosticsKeepsProtocol(t *testing.T) {
+	if mode := os.Getenv("BINT_REDACT_FIXTURE"); mode != "" {
+		secret := os.Getenv("FIXTURE_API_TOKEN")
+		var wg sync.WaitGroup
+		wg.Add(2)
+		go func() {
+			defer wg.Done()
+			fmt.Fprintf(os.Stdout, `{"type":"result","result":%q,"num_turns":3,"total_cost_usd":0.125,"usage":{"input_tokens":17,"output_tokens":9}}`+"\n", secret)
+		}()
+		go func() {
+			defer wg.Done()
+			for _, c := range "password=" + secret + "\n" {
+				fmt.Fprint(os.Stderr, string(c))
+			}
+			fmt.Fprint(os.Stderr, strings.Repeat("x", 70*1024)+" token="+secret+"\n")
+			fmt.Fprint(os.Stderr, "last token="+secret)
+		}()
+		wg.Wait()
+		if mode == "timeout" {
+			time.Sleep(time.Minute)
+		}
+		os.Exit(7)
+	}
+	bin, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, mode := range []string{"exit", "timeout"} {
+		t.Run(mode, func(t *testing.T) {
+			secret := "fixture-é-token-" + strings.Repeat("long", 80)
+			headerSecret := "fixture-header-" + strings.Repeat("arg", 100)
+			logPath := filepath.Join(t.TempDir(), "agent.log")
+			var stdout bytes.Buffer
+			timeout := 10 * time.Second
+			if mode == "timeout" {
+				timeout = 500 * time.Millisecond
+			}
+			r := runProcess(context.Background(), t.TempDir(), bin,
+				[]string{"-test.run=^TestRunProcessRedactsDiagnosticsKeepsProtocol$", "--", "--token", headerSecret}, timeout, logPath,
+				append(os.Environ(), "BINT_REDACT_FIXTURE="+mode, "FIXTURE_API_TOKEN="+secret), nil, &stdout)
+			if mode == "exit" && (r.ExitCode != 7 || r.TimedOut || r.Err != nil) {
+				t.Fatalf("exit behavior changed: %+v", r.CmdResult)
+			}
+			if mode == "timeout" && (!r.TimedOut || r.ExitCode != -1) {
+				t.Fatalf("timeout behavior changed: %+v", r.CmdResult)
+			}
+			var parsed AgentResult
+			parseClaudeJSON(stdout.Bytes(), &parsed)
+			if parsed.Text != secret || parsed.CostUSD == nil || *parsed.CostUSD != .125 || parsed.InputTokens == nil || *parsed.InputTokens != 17 || parsed.OutputTokens == nil || *parsed.OutputTokens != 9 || parsed.NumTurns == nil || *parsed.NumTurns != 3 {
+				t.Fatalf("raw protocol or usage changed: %+v", parsed)
+			}
+			log, err := os.ReadFile(logPath)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, diagnostic := range []string{string(log), r.Tail} {
+				if strings.Contains(diagnostic, "fixture-é-token") || strings.Contains(diagnostic, "fixture-header") || strings.Contains(diagnostic, strings.Repeat("long", 8)) {
+					t.Fatal("credential or truncated credential leaked into diagnostics")
+				}
+				if !strings.Contains(diagnostic, "***") {
+					t.Fatal("diagnostic did not contain redacted values")
+				}
+			}
+			if len(log) > 16*1024 {
+				t.Fatalf("oversize diagnostic line was retained (%d bytes)", len(log))
+			}
+		})
+	}
+	t.Run("live", func(t *testing.T) {
+		const secret = "fixture-live-output-credential"
+		var out bytes.Buffer
+		command := fmt.Sprintf("%q -test.run=^TestRunProcessRedactsDiagnosticsKeepsProtocol$", filepath.ToSlash(bin))
+		r := RunShellLive(context.Background(), t.TempDir(), command, 10*time.Second, &out,
+			append(os.Environ(), "BINT_REDACT_FIXTURE=exit", "FIXTURE_API_TOKEN="+secret))
+		if r.ExitCode != 7 || r.Err != nil || r.TimedOut {
+			t.Fatalf("live execution behavior changed: %+v", r)
+		}
+		if strings.Contains(out.String(), secret) || !strings.Contains(out.String(), "***") || out.Len() > 16*1024 {
+			t.Fatal("live output leaked a credential or retained oversized line")
+		}
+		discarded := RunShellLive(context.Background(), t.TempDir(), command, 10*time.Second, nil,
+			append(os.Environ(), "BINT_REDACT_FIXTURE=exit", "FIXTURE_API_TOKEN="+secret))
+		if discarded.ExitCode != 7 || discarded.Err != nil {
+			t.Fatalf("nil live sink changed execution behavior: %+v", discarded)
+		}
+	})
+}
