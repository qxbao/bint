+func TestRound2DocumentsAndFrontMatterAreAllRedacted(t *testing.T) {
+ for _,s:=range []string{
+  "---\ntitle: ordinary\n---\npassword=round2-secret\nkeep body\n",
+  "message: ordinary\n---\ntoken: round2-secret\nkeep: body\n",
+  "password: round2-secret\n---\nmessage: keep body\n",
+  "---\npassword: round2-secret\n---\n# Heading\nkeep body\n",
+  "message: ordinary\n...\n---\npassword: round2-secret\nkeep: body\n",
+ } {
+  got:=New().Text(s)
+  if strings.Contains(got,"round2-secret"){t.Errorf("document leak: %q",got)}
+  if !strings.Contains(got,"keep")||!strings.Contains(got,"body"){t.Errorf("lost following document: %q",got)}
+  if next:=New().Text(got);next!=got{t.Errorf("not idempotent: %q -> %q",got,next)}
+ }
+ ordinary:="---\ntitle: ordinary\n---\n# Body\nkeep everything\n"
+ if got:=New().Text(ordinary);got!=ordinary{t.Fatalf("ordinary document changed: %q",got)}
+}
+
+func TestRound2WriterKeepsWholeJSONBeforeRedacting(t *testing.T) {
+ for _,s:=range []string{"{\n\"token\":\n\"round2-json-secret\",\n\"input_tokens\":42\n}\n", "[\n{\n\"password\":\n\"round2-json-secret\"\n},\n{\"input_tokens\":42}\n]\n"} {
+  for split:=0;split<=len(s);split++ {
+   var out bytes.Buffer;w:=NewWriter(&out,New())
