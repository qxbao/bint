index 0000000..c83c524
--- /dev/null
+++ b/internal/redact/yaml.go
@@ -0,0 +1,105 @@
+package redact
+
+import (
+	"io"
+	"regexp"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+)
+
+var documentMarker=regexp.MustCompile(`(?m)^(?:---|\.\.\.)[ \t]*(?:#[^\r\n]*)?\r?(?:\n|$)`)
+
+// Treat every YAML document and the Markdown body after front matter as
+// independent diagnostic content. Delimiters and all following bytes survive;
+// decoding the first YAML document is never authority to return the whole input.
+func(p *Policy)documentText(s string)(string,bool) {
+ markers:=documentMarker.FindAllStringIndex(s,-1)
+ if len(markers)==0{return "",false}
+ var out strings.Builder;cursor:=0
+ for _,m:=range markers {out.WriteString(p.Text(s[cursor:m[0]]));out.WriteString(s[m[0]:m[1]]);cursor=m[1]}
+ out.WriteString(p.Text(s[cursor:]));return out.String(),true
+}
+
+// YAML scalars can have anchors, tags, spaces and indented continuations even
+// without a block indicator. Parse a complete diagnostic record before masking
+// it, and retain the original bytes if none of its scalar values changed.
+func (p *Policy) yamlText(s string) (string, bool) {
+	if !strings.Contains(s, ":") {
+		return "", false
+	}
+	var doc yaml.Node
+	decoder:=yaml.NewDecoder(strings.NewReader(s))
+	if decoder.Decode(&doc) != nil || len(doc.Content) != 1 {
+		return "", false
+	}
+	var following yaml.Node
+	if decoder.Decode(&following)!=io.EOF{return "",false}
+	root := doc.Content[0]
+	if root.Kind != yaml.MappingNode && root.Kind != yaml.SequenceNode {
+		return "", false
+	}
+	if root.Kind == yaml.MappingNode {
+		for i := 0; i+1 < len(root.Content); i += 2 {
+			key := root.Content[i]
+			if key.Style == 0 && strings.ContainsAny(key.Value, "\"'\\") {
+				return "", false
+			}
+		}
+	}
+	changed := p.yamlNode(root)
+	if !changed {
+		return s, true
+	}
+	b, err := yaml.Marshal(&doc)
+	if err != nil {
+		return "[redacted invalid diagnostic YAML]", true
+	}
+	out := string(b)
+	if !strings.HasSuffix(s, "\n") {
+		out = strings.TrimSuffix(out, "\n")
+	}
+	return out, true
+}
+
+func (p *Policy) yamlNode(n *yaml.Node) bool {
+	changed := false
+	for _, comment := range []*string{&n.HeadComment, &n.LineComment, &n.FootComment} {
+		if safe := p.Text(*comment); safe != *comment {
+			*comment = safe
+			changed = true
+		}
+	}
+	switch n.Kind {
+	case yaml.MappingNode:
+		for i := 0; i+1 < len(n.Content); i += 2 {
+			key, value := n.Content[i], n.Content[i+1]
+			if SensitiveName(key.Value) {
+				if value.Kind != yaml.ScalarNode || value.Value != Mask || value.Tag != "!!str" {
+					anchor := value.Anchor
+					*value = yaml.Node{Kind: yaml.ScalarNode, Tag: "!!str", Value: Mask, Anchor: anchor}
+					changed = true
+				}
+			} else if !identityKey(key.Value) && p.yamlNode(value) {
+				changed = true
+			}
+			if !schemaKey(key.Value) && p.yamlNode(key) {
+				changed = true
+			}
+		}
+	case yaml.SequenceNode:
+		for _, v := range n.Content {
+			if p.yamlNode(v) {
+				changed = true
+			}
+		}
+	case yaml.ScalarNode:
+		if n.Tag == "!!str" {
+			if text := p.Text(n.Value); text != n.Value {
+				n.Value = text
+				changed = true
+			}
+		}
+	}
+	return changed
+}
