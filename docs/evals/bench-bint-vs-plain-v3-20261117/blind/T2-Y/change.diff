+func TestReviewWriterMultilineShellAndSequenceEverySplit(t *testing.T) {
+	for _, s := range []string{
+		"curl --password \"first\nsecond\"\nnormal\n",
+		"curl --password='first\nsecond'\nnormal\n",
+		"- token: |\n    sequence-secret\n- count: 42\n",
+		"items:\n  - password: >\n      sequence-secret\n  - count: 42\n",
+	} {
+		for split := 0; split <= len(s); split++ {
+			var out bytes.Buffer
+			w := NewWriter(&out, New())
+			_, _ = w.Write([]byte(s[:split]))
+			_, _ = w.Write([]byte(s[split:]))
+			if err := w.Flush(); err != nil {
+				t.Fatal(err)
+			}
+			for _, part := range []string{"first", "second", "sequence-secret"} {
+				if strings.Contains(out.String(), part) {
+					t.Fatalf("split %d input %q leaked %q", split, s, out.String())
