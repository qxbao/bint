+func TestReviewRunShellKeepsMultilineSecretsOutOfLogAndTail(t *testing.T) {
+	if os.Getenv("BINT_REVIEW_STREAM_FIXTURE") == "1" {
+		fmt.Fprint(os.Stdout, os.Getenv("BINT_REVIEW_OUTPUT"))
+		os.Exit(0)
+	}
+	bin, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	command := fmt.Sprintf("%q -test.run=^TestReviewRunShellKeepsMultilineSecretsOutOfLogAndTail$", filepath.ToSlash(bin))
+	for _, output := range []string{"curl --password \"first\nsecond\"\nnormal\n", "- token: |\n    sequence-secret\n- count: 42\n", "curl --password='first'\"second\"\nnormal\n"} {
+		log := filepath.Join(t.TempDir(), "review.log")
+		r := RunShell(context.Background(), t.TempDir(), command, 10*time.Second, log, append(os.Environ(), "BINT_REVIEW_STREAM_FIXTURE=1", "BINT_REVIEW_OUTPUT="+output))
+		if !r.OK() {
+			t.Fatalf("execution changed: %+v", r)
+		}
+		b, err := os.ReadFile(log)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, text := range []string{string(b), r.Tail} {
+			for _, secret := range []string{"first", "second", "sequence-secret"} {
+				if strings.Contains(text, secret) {
+					t.Fatalf("process diagnostic leak: %q", text)
+				}
+			}
+		}
+		if !strings.Contains(r.Tail, "normal") && !strings.Contains(r.Tail, "count: 42") {
+			t.Fatalf("ordinary diagnostic lost: %q", r.Tail)
+		}
+	}
+}
