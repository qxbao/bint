+	var b bytes.Buffer
+	w := NewWriter(&b, New())
+	_, _ = w.Write([]byte(strings.Repeat("x", 70*1024) + "token=hidden\nnormal\n"))
+	_ = w.Close()
+	if strings.Contains(b.String(), "hidden") || strings.Contains(b.String(), strings.Repeat("x", 100)) {
+		t.Fatal("oversized raw line stored")
