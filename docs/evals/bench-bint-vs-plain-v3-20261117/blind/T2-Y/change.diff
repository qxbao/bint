+// Legacy executable commands remain operational input in RAM, while display
+// copies conceal them and validation prevents executing/approving them.
+func TestTaskLegacyCommandDisplayAndImport(t *testing.T) {
+	s := newStore(t)
+	tk, err := s.Create(Ticket{Goal: "g", Verify: Verify{Command: "true"}}, State{}, time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	tk.Ticket.Verify.Command = "check --token " + taskSecret
+	raw, err := encodeTicket(tk.Ticket)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(tk.Dir, TicketFile), raw, 0600); err != nil {
+		t.Fatal(err)
+	}
+	loaded, err := s.Load(tk.State.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(loaded.Ticket.Verify.Command, taskSecret) {
+		t.Fatal("operational command silently changed")
+	}
+	if loaded.Ticket.Validate() == nil {
+		t.Fatal("legacy command accepted for execution")
+	}
+	display := loaded.Redacted()
+	b, _ := json.Marshal(display)
+	if bytes.Contains(b, []byte(taskSecret)) {
+		t.Fatal("legacy command leaked in display")
+	}
+	var state State
+	state.ID, state.Status = tk.State.ID, StatusCreated
+	st, _ := json.Marshal(state)
+	target := t.TempDir()
+	if err := s.importBundle(target, "", bundle{TicketFile: raw, StateFile: st}); err == nil {
+		t.Fatal("imported unsafe executable command")
+	}
+	entries, err := os.ReadDir(target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(entries) != 0 {
+		t.Fatal("unsafe import wrote files before rejection")
+	}
+}
