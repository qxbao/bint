+package evolvesvc
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"bint/internal/evolve"
+)
+
+func TestCycleDiagnosticsRedactedAndNumericCostsPreserved(t *testing.T) {
+	e, _ := fixture(t)
+	saveProposed(t, e, "ep_redact", evolve.StatusProposed)
+	secret := "cycle-secret-12345"
+	sensitive := "password=" + secret
+	runner := &fakeRunner{evaluate: func(EvaluateOptions) (*EvaluateResult, error) {
+		return &EvaluateResult{Verdict: evolve.Verdict{Verdict: evolve.VerdictSupported, Detail: sensitive}}, errors.New(sensitive)
+	}}
+	var log strings.Builder
+	report, err := Cycle(context.Background(), e, CycleOptions{BudgetUSD: 10, NoPropose: true, MaxProposals: 1, Parallel: 1, Runner: runner, Log: &log})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(log.String(), secret) {
+		t.Error("progress log leaked")
+	}
+	b, _ := json.Marshal(report)
+	if bytes.Contains(b, []byte(secret)) {
+		t.Error("report DTO leaked")
+	}
+	b, err = os.ReadFile(filepath.Join(e.K.Paths.Runtime, "evolve", "cycles", report.ID+".json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bytes.Contains(b, []byte(secret)) {
+		t.Error("cycle snapshot leaked")
+	}
+	if report.BudgetUSD != 10 || report.SpentUSD != 0 || len(report.Steps) != 2 {
+		t.Fatalf("numeric/flow behavior changed: %+v", report)
+	}
+}
