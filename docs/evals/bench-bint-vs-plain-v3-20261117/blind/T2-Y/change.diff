new file mode 100644
index 0000000..8d557a0
--- /dev/null
+++ b/internal/redact/json.go
@@ -0,0 +1,34 @@
+package redact
+
+import (
+ "encoding/json"
+ "strings"
+)
+
+// JSON layout does not depend on indentation: a value may start on the next
+// line at column zero. Retain the root container, tracking strings and escapes,
+// until its closing delimiter rather than treating a line as a record.
+func jsonRecord(s string)bool {
+ s=strings.TrimLeft(s," \t\r\n")
+ if len(s)==0{return false}
+ if s[0]=='{'{return true}
+ if s[0]!='['{return false}
+ rest:=strings.TrimLeft(s[1:]," \t\r\n")
+ if len(rest)==0{return true}
+ return strings.ContainsRune(`[{"-0123456789tfn]`,rune(rest[0]))
+}
+
+func incompleteJSON(s string)bool {
+ if !jsonRecord(s){return false}
+ depth:=0;quoted,escaped:=false,false
+ for _,c:=range s {
+  if quoted {if escaped{escaped=false;continue};if c=='\\'{escaped=true}else if c=='"'{quoted=false};continue}
+  switch c {case '"':quoted=true;case '{','[':depth++;case '}',']':depth--}
+ }
+ return depth>0||quoted
+}
+
+func(p *Policy)recordText(s string)string {
+ if jsonRecord(s)&&!json.Valid([]byte(strings.TrimSpace(s))){return "[redacted: incomplete or invalid JSON diagnostic]\n"}
+ return p.Text(s)
+}
diff --git a/internal/redact/redact.go b/internal/redact/redact.go
new file mode 100644
index 0000000..01c043a
--- /dev/null
+++ b/internal/redact/redact.go
@@ -0,0 +1,370 @@
+// Package redact protects diagnostic copies. Never use its output as an
+// executable command or as the input to an agent protocol parser.
+package redact
+
+import (
+	"encoding/json"
+	"net/url"
+	"os"
+	"reflect"
+	"regexp"
+	"sort"
+	"strings"
+)
+
+const Mask = "***"
+
+// Policy contains only in-memory credential values. It is immutable after New.
+type Policy struct{ values []string }
+
+func New(secrets ...string) *Policy {
+	seen := map[string]bool{}
+	for _, s := range secrets {
+		if s == "" {
+			continue
+		}
+		seen[s] = true
+		b, _ := json.Marshal(s)
+		seen[string(b[1:len(b)-1])] = true
+		seen[url.QueryEscape(s)] = true
+		seen[url.PathEscape(s)] = true
+	}
+	p := &Policy{}
+	for v := range seen {
+		if v != "" && v != Mask {
+			p.values = append(p.values, v)
+		}
+	}
+	sort.Slice(p.values, func(i, j int) bool { return len(p.values[i]) > len(p.values[j]) })
+	return p
+}
+
+// SensitiveName recognizes credential names, including namespaced environment
+// names, without confusing token counts or RPC progressToken with credentials.
+func SensitiveName(name string) bool {
+	n := strings.ReplaceAll(strings.ToLower(name), "-", "_")
+	for _, k := range []string{"password", "passwd", "token", "access_token", "refresh_token", "api_key", "apikey", "secret", "client_secret", "authorization", "auth"} {
+		if n == k || strings.HasSuffix(n, "_"+k) {
+			return true
+		}
+	}
+	return false
+}
+
+func FromEnv(env []string) *Policy {
+	var secrets []string
+	for _, kv := range env {
+		k, v, ok := strings.Cut(kv, "=")
+		if ok && SensitiveName(k) && v != "" {
+			secrets = append(secrets, v)
+		}
+	}
+	return New(secrets...)
+}
+
+// Text uses the current process credential environment as well as labelled rules.
+func Text(s string) string { return FromEnv(os.Environ()).Text(s) }
+
+const keyPattern = `(?:[a-z_][a-z0-9_]*_)?(?:password|passwd|token|access[_-]token|refresh[_-]token|api[_-]?key|secret|client[_-]secret|authorization|auth)`
+
+var (
+	// Values may contain escaped quotes and physical newlines. This is deliberately
+	// applied to complete diagnostic records, before truncation or serialization.
+	header        = regexp.MustCompile(`(?i)(\bauthorization[ \t]*:[ \t]*)(?:bearer|basic)[ \t]+[^\r\n"']+`)
+	authScheme    = regexp.MustCompile(`(?i)(\b(?:bearer|basic)[ \t]+)((?:\$\{[A-Za-z_][A-Za-z0-9_]*\}|[^\s"'<>;,}])+)`)
+	userinfo      = regexp.MustCompile(`(://)([^/\s@"']+)@`)
+	yamlBlock     = regexp.MustCompile(`(?i)^(.*?["']?(\b` + keyPattern + `)["']?:[ \t]*)(?:[!&][^\s]+[ \t]+)*[|>][-+0-9]*[^\n]*\n?$`)
+	yamlDecorated = regexp.MustCompile(`(?i)^([ \t]*["']?([a-z_][a-z0-9_-]*)["']?:[ \t]*)(?:[!&][^\s]+[ \t]+)+[^\n]*(\n?)$`)
+	envRef        = regexp.MustCompile(`^(?:\$[A-Za-z_][A-Za-z0-9_]*|\$\{[A-Za-z_][A-Za-z0-9_]*\}|\$env:[A-Za-z_][A-Za-z0-9_]*|%[A-Za-z_][A-Za-z0-9_]*%)$`)
+)
+
+func reference(s string) bool {
+	s = strings.Trim(s, "\"'")
+	if scheme, v, ok := strings.Cut(s, " "); ok && (strings.EqualFold(scheme, "Bearer") || strings.EqualFold(scheme, "Basic")) {
+		s = strings.TrimSpace(v)
+	}
+	return envRef.MatchString(s)
+}
+
+func labelled(s string, allowRefs bool) string {
+	s = querySecrets(s, allowRefs)
+	s = redactBlocks(s)
+	s = header.ReplaceAllStringFunc(s, func(m string) string {
+		g := header.FindStringSubmatch(m)
+		if allowRefs {
+			v := strings.TrimSpace(m[len(g[1]):])
+			_, v, _ = strings.Cut(v, " ")
+			if reference(v) {
+				return m
+			}
+		}
+		return g[1] + Mask
+	})
+	s = shellValues(s, assignmentStart.FindAllStringIndex(s,-1), allowRefs)
+	s = shellValues(s, flagPrefixes(s), allowRefs)
+	s = authScheme.ReplaceAllStringFunc(s, func(m string) string {
+		g := authScheme.FindStringSubmatch(m)
+		if allowRefs && reference(g[2]) {
+			return m
+		}
+		return g[1] + Mask
+	})
+	s = userinfo.ReplaceAllStringFunc(s, func(m string) string {
+		g := userinfo.FindStringSubmatch(m)
+		if !strings.Contains(g[2], ":") {
+			return m
+		}
+		if allowRefs {
+			_, pw, _ := strings.Cut(g[2], ":")
+			if reference(pw) {
+				return m
+			}
+		}
+		return g[1] + Mask + "@"
+	})
+	return s
+}
+
+func redactBlocks(s string) string {
+	lines := strings.SplitAfter(s, "\n")
+	var out strings.Builder
+	for i := 0; i < len(lines); i++ {
+		line := lines[i]
+		if g := yamlDecorated.FindStringSubmatch(line); len(g) > 0 && SensitiveName(g[2]) {
+			out.WriteString(g[1] + Mask + g[3])
+			continue
+		}
+		g := yamlBlock.FindStringSubmatch(line)
+		if len(g) == 0 || !SensitiveName(g[2]) {
+			out.WriteString(line)
+			continue
+		}
+		indent := len(line) - len(strings.TrimLeft(line, " \t"))
+		out.WriteString(g[1] + Mask)
+		if strings.HasSuffix(line, "\n") {
+			out.WriteByte('\n')
+		}
+		for i+1 < len(lines) {
+			next := lines[i+1]
+			n := len(next) - len(strings.TrimLeft(next, " \t"))
+			if strings.TrimSpace(next) != "" && n <= indent {
+				break
+			}
+			i++
+		}
+	}
+	return out.String()
+}
+
+func (p *Policy) Text(s string) string {
+	if out,ok:=p.documentText(s);ok{return out}
+	trimmed := strings.TrimSpace(s)
+	if strings.HasPrefix(trimmed, "{") || strings.HasPrefix(trimmed, "[") {
+		var v any
+		dec := json.NewDecoder(strings.NewReader(trimmed))
+		dec.UseNumber()
+		if json.Valid([]byte(trimmed)) && dec.Decode(&v) == nil {
+			clean := p.Value(v)
+			if reflect.DeepEqual(v, clean) {
+				return s
+			}
+			if b, err := json.Marshal(clean); err == nil {
+				start := strings.Index(s, trimmed)
+				return s[:start] + string(b) + s[start+len(trimmed):]
+			}
+		}
+	}
+	if out, changed := p.yamlText(s); changed {
+		return out
+	}
+	s = labelled(s, true)
+	// Replace all values in one pass: inserted masks must not themselves be
+	// rewritten by a shorter credential value.
+	if len(p.values) > 0 {
+		pairs := make([]string, 0, len(p.values)*2)
+		for _, v := range p.values {
+			pairs = append(pairs, v, Mask)
+		}
+		s = strings.NewReplacer(pairs...).Replace(s)
+	}
+	original := s
+	for i := 0; i < 4; i++ {
+		decoded := strings.NewReplacer(`\"`, `"`, `\'`, `'`).Replace(s)
+		if decoded == s {
+			break
+		}
+		if safe := labelled(decoded, true); safe != decoded {
+			return safe
+		}
+		sNext := strings.ReplaceAll(s, `\\`, `\`)
+		if sNext == s {
+			break
+		}
+		s = sNext
+	}
+	return labelled(original, true)
+}
+
+// CommandSafe rejects literals rather than silently changing what will run.
+// Only complete environment references are exempt; interpolated literal values
+// are rejected. Error callers must name the field, never echo the command.
+func CommandSafe(command string) bool {
+	probe := strings.ReplaceAll(command, Mask, "__bint_literal_mask__")
+	for i := 0; i < 4; i++ {
+		decoded := strings.NewReplacer(`\"`, `"`, `\'`, `'`, `\\`, `\`).Replace(probe)
+		if decoded == probe {
+			break
+		}
+		if labelled(decoded, true) != decoded {
+			return false
+		}
+		probe = decoded
+	}
+	if labelled(probe, true) != probe {
+		return false
+	}
+	p := FromEnv(os.Environ())
+	for _, v := range p.values {
+		if strings.Contains(command, v) {
+			return false
+		}
+	}
+	return true
+}
+
+// Value copies a structured diagnostic value, preserving numeric types and null.
+func (p *Policy) Value(v any) any {
+	if v == nil {
+		return nil
+	}
+	return p.copy(reflect.ValueOf(v), "").Interface()
+}
+
+// Copy is intended for display DTOs only, never operational configuration.
+func Copy[T any](v T) T {
+	if any(v) == nil {
+		return v
+	}
+	return FromEnv(os.Environ()).Value(v).(T)
+}
+
+func (p *Policy) copy(v reflect.Value, key string) reflect.Value {
+	if !v.IsValid() {
+		return v
+	}
+	if v.Type() == reflect.TypeOf(json.Number("")) {
+		return v
+	}
+	switch v.Kind() {
+	case reflect.Interface:
+		if v.IsNil() {
+			return reflect.Zero(v.Type())
+		}
+		out := reflect.New(v.Type()).Elem()
+		if SensitiveName(key) {
+			out.Set(reflect.ValueOf(Mask))
+			return out
+		}
+		out.Set(p.copy(v.Elem(), key))
+		return out
+	case reflect.String:
+		out := reflect.New(v.Type()).Elem()
+		s := v.String()
+		if SensitiveName(key) && s != "" {
+			s = Mask
+		} else if !identityKey(key) {
+			s = p.Text(s)
+		}
+		out.SetString(s)
+		return out
+	case reflect.Map:
+		if v.IsNil() {
+			return reflect.Zero(v.Type())
+		}
+		out := reflect.MakeMapWithSize(v.Type(), v.Len())
+		it := v.MapRange()
+		for it.Next() {
+			k := it.Key()
+			outKey := k
+			name := ""
+			if k.Kind() == reflect.String {
+				name = k.String()
+				if !schemaKey(name) {
+					outKey = reflect.New(k.Type()).Elem()
+					outKey.SetString(p.Text(name))
+				}
+			}
+			out.SetMapIndex(outKey, p.copy(it.Value(), name))
+		}
+		return out
+	case reflect.Slice:
+		if v.IsNil() {
+			return reflect.Zero(v.Type())
+		}
+		if v.Type() == reflect.TypeOf(json.RawMessage{}) {
+			var x any
+			dec := json.NewDecoder(strings.NewReader(string(v.Bytes())))
+			dec.UseNumber()
+			if dec.Decode(&x) == nil {
+				b, err := json.Marshal(p.Value(x))
+				if err == nil {
+					return reflect.ValueOf(json.RawMessage(b))
+				}
+			}
+			return reflect.ValueOf(json.RawMessage(`"[redacted invalid JSON]"`))
+		}
+		out := reflect.MakeSlice(v.Type(), v.Len(), v.Len())
+		for i := 0; i < v.Len(); i++ {
+			out.Index(i).Set(p.copy(v.Index(i), key))
+		}
+		return out
+	case reflect.Array:
+		out := reflect.New(v.Type()).Elem()
+		for i := 0; i < v.Len(); i++ {
+			out.Index(i).Set(p.copy(v.Index(i), key))
+		}
+		return out
+	case reflect.Pointer:
+		if v.IsNil() {
+			return reflect.Zero(v.Type())
+		}
+		out := reflect.New(v.Type().Elem())
+		out.Elem().Set(p.copy(v.Elem(), key))
+		return out
+	case reflect.Struct:
+		out := reflect.New(v.Type()).Elem()
+		out.Set(v)
+		for i := 0; i < v.NumField(); i++ {
+			f := v.Type().Field(i)
+			if f.PkgPath != "" {
+				continue
+			}
+			name := strings.Split(f.Tag.Get("json"), ",")[0]
+			if name == "" {
+				name = strings.Split(f.Tag.Get("yaml"), ",")[0]
+			}
+			if name == "" {
+				name = f.Name
+			}
+			out.Field(i).Set(p.copy(v.Field(i), name))
+		}
+		return out
+	}
+	return v
+}
+
+func identityKey(key string) bool {
+	n := strings.ToLower(key)
+	return n == "id" || strings.HasSuffix(n, "_id") || strings.HasSuffix(key, "ID") || n == "progresstoken" || n == "timestamp" || n == "ts" || strings.HasSuffix(n, "_at")
+}
+
+func schemaKey(key string) bool {
+	if identityKey(key) {
+		return true
+	}
+	switch strings.ToLower(key) {
+	case "input_tokens", "output_tokens", "total_tokens", "password", "passwd", "token", "access_token", "refresh_token", "api_key", "api-key", "secret", "client_secret", "authorization", "auth":
+		return true
+	}
+	return false
+}
diff --git a/internal/redact/redact_test.go b/internal/redact/redact_test.go
new file mode 100644
index 0000000..5599dee
--- /dev/null
+++ b/internal/redact/redact_test.go
@@ -0,0 +1,252 @@
+package redact
+
+import (
+	"bytes"
+	"encoding/json"
+	"gopkg.in/yaml.v3"
+	"net/url"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestTextPolicy(t *testing.T) {
+	p := New()
+	cases := []struct{ in, want string }{
+		{`curl -v --password 'two words'`, `curl -v --password ***`},
+		{`go --password='two words' --token=abc --api-key "a b"`, `go --password=*** --token=*** --api-key ***`},
+		{`API_KEY=abc MODE=fast INPUT_TOKENS=42`, `API_KEY=*** MODE=fast INPUT_TOKENS=42`},
+		{`{"outer":{"password":"a\"b","access_token":"xyz"},"input_tokens":12,"progressToken":"rpc-1"}`, `{"outer":{"password":"***","access_token":"***"},"input_tokens":12,"progressToken":"rpc-1"}`},
+		{"outer:\n  client_secret: 'two words'\n  count: 8", "outer:\n  client_secret: ***\n  count: 8"},
+		{"Authorization: Bearer abcd\nX-Count: 4", "Authorization: ***\nX-Count: 4"},
+		{`curl -H 'Authorization: Basic YWJjZA=='`, `curl -H 'Authorization: ***'`},
+		{`https://user:password@example.com/p?token=abc&limit=3`, `https://***@example.com/p?token=***&limit=3`},
+		{"token: |\n  first secret\n  second secret\ncount: 3", "token: ***\ncount: 3"},
+		{"token: \"first\nsecond\"\ncount: 3", "token: ***\ncount: 3"},
+		{`normal text tiếng Việt input_tokens=22 output_tokens=8 progressToken=rpc MODE=fast`, `normal text tiếng Việt input_tokens=22 output_tokens=8 progressToken=rpc MODE=fast`},
+	}
+	for _, c := range cases {
+		if got := p.Text(c.in); got != c.want {
+			var a, b any
+			if json.Unmarshal([]byte(got), &a) != nil || json.Unmarshal([]byte(c.want), &b) != nil || !reflect.DeepEqual(a, b) {
+				// YAML is re-encoded only when a value changes; compare parsed
+				// meaning while keeping the literal safe expected value independent.
+				var ya, yb any
+				wantYAML := strings.ReplaceAll(c.want, ": ***", ": '***'")
+				if yaml.Unmarshal([]byte(got), &ya) == nil && yaml.Unmarshal([]byte(wantYAML), &yb) == nil && reflect.DeepEqual(ya, yb) {
+					continue
+				}
+				t.Errorf("input %q: got %q want %q", c.in, got, c.want)
+			}
+		}
+		if got := p.Text(p.Text(c.in)); got != p.Text(c.in) {
+			t.Errorf("not idempotent: %q", got)
+		}
+	}
+}
+
+func TestKnownValuesAndValueCopy(t *testing.T) {
+	secret := "x/\"é a?"
+	p := New(secret, "longer-credential", "longer")
+	raw, _ := json.Marshal(secret)
+	for _, v := range []string{secret, string(raw[1 : len(raw)-1]), url.QueryEscape(secret), url.PathEscape(secret)} {
+		if strings.Contains(p.Text("prefix "+v+" suffix"), v) {
+			t.Errorf("known value leaked: %q", v)
+		}
+	}
+	src := map[string]any{"outer": []any{map[string]any{"password": "secret"}, "--token=another"}, "input_tokens": float64(42), "id": "01ABC", "nil": nil}
+	got := p.Value(src).(map[string]any)
+	want := map[string]any{"outer": []any{map[string]any{"password": "***"}, "--token=***"}, "input_tokens": float64(42), "id": "01ABC", "nil": nil}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("copy: %#v", got)
+	}
+	if src["outer"].([]any)[0].(map[string]any)["password"] != "secret" {
+		t.Fatal("mutated input")
+	}
+	if got := p.Text("longer-credential"); got != "***" {
+		t.Fatal(got)
+	}
+}
+
+func TestWriterEverySplitAndOversize(t *testing.T) {
+	in := "normal tiếng Việt\n{\"token\":\"split-secret\",\"input_tokens\":19}\nlast --password='two words'"
+	for split := 0; split <= len(in); split++ {
+		var b bytes.Buffer
+		w := NewWriter(&b, New())
+		_, _ = w.Write([]byte(in[:split]))
+		_, _ = w.Write([]byte(in[split:]))
+		if err := w.Flush(); err != nil {
+			t.Fatal(err)
+		}
+		if strings.Contains(b.String(), "split-secret") || strings.Contains(b.String(), "two words") {
+			t.Fatalf("split %d leaked: %q", split, b.String())
