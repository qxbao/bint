new file mode 100644
index 0000000..b59d994
--- /dev/null
+++ b/internal/task/redaction.go
@@ -0,0 +1,70 @@
+package task
+
+import (
+	"bytes"
+	"encoding/json"
+	"reflect"
+
+	"bint/internal/redact"
+)
+
+// sanitizeTicket leaves the operational command intact. It must be validated
+// before persistence or execution; a redacted command must never be executed.
+func sanitizeTicket(t Ticket) Ticket {
+	command := t.Verify.Command
+	t = redact.Copy(t)
+	t.Verify.Command = command
+	return t
+}
+
+// Redacted returns a display copy, including the command. Use the original
+// Ticket and Validate when approving or executing a command.
+func (t Ticket) Redacted() Ticket { return redact.Copy(t) }
+
+// Redacted returns a display copy, without changing operational data in RAM.
+func (t *Task) Redacted() *Task { return redact.Copy(t) }
+
+// normalized provides the same safe snapshot for hashing, writing and import.
+// Unchanged files retain their exact formatting, including user comments.
+func (b bundle) normalized() (bundle, error) {
+	out := make(bundle, len(b))
+	for name, data := range b {
+		out[name] = data
+		switch name {
+		case TicketFile:
+			ticket, err := decodeTicket(data)
+			if err != nil {
+				return nil, err
+			}
+			if err := ticket.Validate(); err != nil {
+				return nil, err
+			}
+			safe := sanitizeTicket(ticket)
+			if !reflect.DeepEqual(ticket, safe) || redact.Text(string(data)) != string(data) {
+				encoded, err := encodeTicket(safe)
+				if err != nil {
+					return nil, err
+				}
+				out[name] = encoded
+			}
+		case StateFile, ReviewFile, OutcomeFile:
+			var value any
+			dec := json.NewDecoder(bytes.NewReader(data))
+			dec.UseNumber()
+			if err := dec.Decode(&value); err != nil {
+				return nil, err
+			}
+			safe := redact.Copy(value)
+			if !reflect.DeepEqual(value, safe) {
+				encoded, err := json.MarshalIndent(safe, "", "  ")
+				if err != nil {
+					return nil, err
+				}
+				out[name] = append(encoded, '\n')
+			}
+		default:
+			out[name] = []byte(redact.Text(string(data)))
+		}
+	}
+	return out, nil
+}
