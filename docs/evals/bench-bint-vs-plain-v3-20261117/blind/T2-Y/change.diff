+		`TOKEN="${API_TOKEN}"literal-suffix cmd`,
+		`curl --password='first'"second"`,
+		`curl --password="first"'second'`,
+		`curl --password=first,second`,
+		`TOKEN=first,second cmd`,
+		`curl --password=first\ second`,
+		`curl --token=''literal-suffix`,
+		`curl "--token=${API_TOKEN}"literal-suffix`,
+		`curl "--password=first second"`,
+	} {
+		t.Run(s, func(t *testing.T) {
+			if CommandSafe(s) {
