+	if err != nil || strings.Contains(run.EndReason.String, "fake-legacy-end") {
+		t.Fatalf("run read: %+v %v", run, err)
+	}
+	meta, err := GetRunMeta(ctx, s.DB, sig.RunID)
+	if err != nil || strings.Contains(meta.ResultSummary.String, "fake-legacy-summary") {
+		t.Fatalf("meta read: %+v %v", meta, err)
+	}
+	if err := s.DB.QueryRow(`SELECT detail FROM outcome_signals`).Scan(&detail); err != nil || detail != "password=fake-legacy-signal" {
+		t.Fatalf("legacy signal modified: %q %v", detail, err)
+	}
+}
