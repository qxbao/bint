+package redact
+
+type diagnosticError struct {
+	cause error
+	text  string
+}
+
+func (e *diagnosticError) Error() string { return e.text }
+func (e *diagnosticError) Unwrap() error { return e.cause }
+
+// Error preserves error identity for errors.Is/As while masking its public text.
+func Error(err error) error {
+	if err == nil {
+		return nil
+	}
+	return &diagnosticError{cause: err, text: Text(err.Error())}
+}
