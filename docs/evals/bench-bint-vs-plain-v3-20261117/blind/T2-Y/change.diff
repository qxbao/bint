+func TestTaskLedgerNormalizesSecretSnapshot(t *testing.T) {
+	root := t.TempDir()
+	s := newStore(t)
+	s.Ledger, s.Root = true, root
+	tk, err := s.Create(Ticket{Goal: taskSensitive}, State{Reason: taskSensitive}, time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := tk.WriteArtifact("plan", taskSensitive); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.exportErr(tk); err != nil {
+		t.Fatal(err)
+	}
+	assertTaskSafe(t, root)
+	treeDir := filepath.Join(root, filepath.FromSlash(LedgerRel(tk.State.ID)))
+	b, _, err := readTree(treeDir, tk.State.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Old and new redacted forms must hash identically.
+	raw := make(bundle)
+	for name, value := range b {
+		raw[name] = bytes.ReplaceAll(value, []byte("***"), []byte(taskSecret))
+	}
+	if raw.hash() != b.hash() {
+		t.Fatal("redaction produces ledger conflict")
+	}
+	for i := 0; i < 2; i++ {
+		rep, err := s.Sync(false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if rep.Count("unchanged") != 1 {
+			t.Fatalf("redaction destabilized sync: %+v", rep)
+		}
+	}
+	if err := s.importBundle(tk.Dir, root, raw); err != nil {
+		t.Fatal(err)
+	}
+	assertTaskSafe(t, tk.Dir)
+}
