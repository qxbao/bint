+package config
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestStateRetentionConfig(t *testing.T) {
+	cfg := Default()
+	if cfg.State.RetentionDays != 30 {
+		t.Fatalf("default retention: %+v", cfg.State)
+	}
+	for _, days := range []int{-1, 36501} {
+		cfg.State.RetentionDays = days
+		if err := cfg.Validate(); err == nil || !strings.Contains(err.Error(), "state.retention_days") {
+			t.Fatalf("invalid %d: %v", days, err)
+		}
+	}
+	for _, days := range []int{0, 7, 30, 36500} {
+		cfg.State.RetentionDays = days
+		if err := cfg.Validate(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	cfg = Default()
+	if err := Decode(strings.NewReader("state:\n  retention_days: 0\n"), &cfg); err != nil {
+		t.Fatal(err)
+	}
+	if cfg.State.RetentionDays != 0 {
+		t.Fatal("cannot disable retention")
+	}
+}
