+package cli
+
+import (
+	"fmt"
+
+	"bint/internal/app"
+	"github.com/spf13/cobra"
+)
+
+func newGCCmd(stdio IO) *cobra.Command {
+	var dry, asJSON bool
+	c := &cobra.Command{
+		Use:   "gc",
+		Short: "Dọn dữ liệu phụ quá hạn của repository hiện tại",
+		Long: `Dọn bản sao lưu, spool bị từ chối, dấu vết hook và thư mục/nhật ký của đợt đánh giá đã kết thúc.
+Tuổi giữ theo state.retention_days (mặc định 30; 0 = tắt). Giữ nguyên SQLite,
+tri thức, phiếu tác vụ, worktree, profile iso và snapshot. Không nạp spool đang chờ.
+Tự dọn tối đa mỗi 24 giờ khi nạp sự kiện; --dry-run liệt kê trước khi xoá.`,
+		Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			dir, err := cwd()
+			if err != nil {
+				return err
+			}
+			res, err := app.CollectState(cmd.Context(), dir, dry)
+			if err != nil {
+				return err
+			}
+			if asJSON {
+				return writeIndentedJSON(stdio, res)
+			}
+			if res.Disabled {
+				fmt.Fprintln(stdio.Out, "Đã tắt dọn dữ liệu phụ (state.retention_days: 0).")
+				return nil
+			}
+			for _, item := range res.Items {
+				fmt.Fprintf(stdio.Out, "  %s (%d byte)\n", item.Path, item.Bytes)
+			}
+			if dry {
+				fmt.Fprintf(stdio.Out, "Sẽ dọn %d mục, %d byte; chưa xoá dữ liệu.\n", len(res.Items), res.Bytes)
+			} else {
+				fmt.Fprintf(stdio.Out, "Đã dọn %d mục, %d byte.\n", len(res.Items), res.Bytes)
+			}
+			return nil
+		},
+	}
+	c.Flags().BoolVar(&dry, "dry-run", false, "chỉ liệt kê, không xoá dữ liệu")
+	c.Flags().BoolVar(&asJSON, "json", false, "xuất JSON")
+	return c
+}
