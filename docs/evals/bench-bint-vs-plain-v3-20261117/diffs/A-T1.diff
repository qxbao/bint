new file mode 100644
index 0000000..e81cac3
--- /dev/null
+++ b/internal/app/gc.go
@@ -0,0 +1,37 @@
+package app
+
+import (
+	"context"
+	"database/sql"
+	"net/url"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"bint/internal/stategc"
+)
+
+// CollectState dọn dữ liệu phụ của repository hiện tại, không nạp/xoá spool
+// đang chờ. dry chỉ liệt kê; không cập nhật lịch dọn tự động.
+func CollectState(ctx context.Context, dir string, dry bool) (stategc.Result, error) {
+	w, err := OpenWorkspace(ctx, dir, true)
+	if err != nil {
+		return stategc.Result{}, err
+	}
+	// Không migration, nạp spool hay chuyển journal trong cả chế độ xem trước.
+	dbPath := filepath.ToSlash(w.Paths.DB)
+	if !strings.HasPrefix(dbPath, "/") {
+		dbPath = "/" + dbPath
+	}
+	query := "mode=ro&_pragma=query_only(1)&_pragma=busy_timeout(1000)"
+	if !dry {
+		query = "mode=rw&_pragma=busy_timeout(1000)"
+	}
+	u := url.URL{Scheme: "file", Path: dbPath, RawQuery: query}
+	db, err := sql.Open("sqlite", u.String())
+	if err != nil {
+		return stategc.Result{}, err
+	}
+	defer db.Close()
+	return stategc.Collect(ctx, db, w.Paths, time.Now(), w.Config.State.RetentionDays, dry, false)
+}
