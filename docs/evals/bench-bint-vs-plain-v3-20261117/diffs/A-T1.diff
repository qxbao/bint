diff --git a/internal/stategc/gc.go b/internal/stategc/gc.go
new file mode 100644
index 0000000..952d61f
--- /dev/null
+++ b/internal/stategc/gc.go
@@ -0,0 +1,243 @@
+// Package stategc dọn dữ liệu phụ trong thư mục trạng thái của một repository.
+package stategc
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path"
+	"strings"
+	"time"
+
+	"bint/internal/fslock"
+	"bint/internal/state"
+	"bint/internal/store"
+)
+
+var ErrBusy = errors.New("đang có tiến trình khác dọn dữ liệu")
+
+type Item struct {
+	Path  string `json:"path"` // tương đối với thư mục trạng thái
+	Bytes int64  `json:"bytes"`
+}
+
+type Result struct {
+	Items    []Item `json:"items"`
+	Bytes    int64  `json:"bytes"`
+	DryRun   bool   `json:"dry_run"`
+	Disabled bool   `json:"disabled"`
+}
+
+// Collect chỉ dọn những cây đã biết là dữ liệu phụ. auto giới hạn một lần mỗi
+// 24 giờ; dry không ghi tệp khoá, thời điểm dọn hay nạp spool.
+func Collect(ctx context.Context, db *sql.DB, p state.Paths, now time.Time, days int, dry, auto bool) (Result, error) {
+	res := Result{Items: []Item{}, DryRun: dry, Disabled: days == 0}
+	if days < 0 || days > 36500 {
+		return res, fmt.Errorf("state.retention_days: cần từ 0 đến 36500")
+	}
+	if days == 0 {
+		return res, nil
+	}
+	r, err := os.OpenRoot(p.Root)
+	if err != nil {
+		return res, err
+	}
+	defer r.Close()
+	var lock *os.File
+	if !dry {
+		// Không theo symlink ở tệp khoá, kể cả liên kết tới một tệp khác trong state.
+		if info, err := r.Lstat("gc.lock"); err == nil && !info.Mode().IsRegular() {
+			return res, fmt.Errorf("gc.lock không phải tệp thường")
+		} else if err != nil && !errors.Is(err, fs.ErrNotExist) {
+			return res, err
+		}
+		lock, err = r.OpenFile("gc.lock", os.O_CREATE|os.O_RDWR, 0o600)
+		if err != nil {
+			return res, err
+		}
+		defer lock.Close()
+		busy, err := fslock.Try(lock, true)
+		if err != nil {
+			return res, err
+		}
+		if busy {
+			return res, ErrBusy
+		}
+		if auto {
+			buf := make([]byte, 128)
+			n, _ := lock.ReadAt(buf, 0)
+			if last, err := time.Parse(time.RFC3339Nano, strings.TrimSpace(string(buf[:n]))); err == nil && now.Sub(last) < 24*time.Hour {
+				return res, nil
+			}
+		}
+	}
+	cutoff := now.AddDate(0, 0, -days)
+	type candidate struct{ name, batchID string }
+	var candidates []candidate
+	for _, dir := range []string{"backups", "spool/rejected", "runtime/hook-trace"} {
+		ok, err := plainPath(r, dir)
+		if err != nil {
+			return res, err
+		}
+		if !ok {
+			continue
+		}
+		entries, err := fs.ReadDir(r.FS(), dir)
+		if err != nil {
+			return res, err
+		}
+		for _, e := range entries {
+			candidates = append(candidates, candidate{name: path.Join(dir, e.Name())})
+		}
+	}
+	// Né thư mục bootstrap/snapshot; chỉ ID đợt có trạng thái kết thúc rõ ràng
+	// mới đủ điều kiện. Không lấy log_dir tuyệt đối từ cơ sở dữ liệu để xoá.
+	rows, err := db.QueryContext(ctx, `SELECT batch_id FROM eval_batches b
+		WHERE status IN ('completed','failed','cancelled','interrupted','budget_exhausted')
+		AND finished_at < ? AND finished_at != ''
+		AND NOT EXISTS (SELECT 1 FROM evaluation_runs a WHERE a.batch_id=b.batch_id AND a.status='running')
+		ORDER BY batch_id`, store.FormatTime(cutoff))
+	if err != nil {
+		return res, err
+	}
+	for rows.Next() {
+		var id string
+		if err := rows.Scan(&id); err != nil {
+			rows.Close()
+			return res, err
+		}
+		if id == "" || id == "." || id == ".." || strings.ContainsAny(id, "/\\:") {
+			continue
+		}
+		for _, dir := range []string{"eval-work/runs", "eval-work/logs"} {
+			// "bootstrap" là vùng tên riêng của eval, không phải ID đợt.
+			if id != "bootstrap" {
+				candidates = append(candidates, candidate{name: path.Join(dir, id), batchID: id})
+			}
+		}
+	}
+	err = rows.Err()
+	rows.Close()
+	if err != nil {
+		return res, err
+	}
+	for _, item := range candidates {
+		name := item.name
+		if err := ctx.Err(); err != nil {
+			return res, err
+		}
+		ok, err := plainPath(r, name)
+		if err != nil {
+			return res, err
+		}
+		if !ok {
+			continue
+		}
+		bytes, old, err := collectTree(ctx, db, r, name, item.batchID, cutoff, dry)
+		if err != nil {
+			return res, err
+		}
+		if !old {
+			continue
+		}
+		res.Items = append(res.Items, Item{Path: name, Bytes: bytes})
+		res.Bytes += bytes
+	}
+	if auto && !dry {
+		if err := lock.Truncate(0); err != nil {
+			return res, err
+		}
+		if _, err := lock.WriteAt([]byte(now.UTC().Format(time.RFC3339Nano)+"\n"), 0); err != nil {
+			return res, err
+		}
+	}
+	return res, nil
+}
+
+// collectTree giữ khoá ghi SQLite trong lúc kiểm tra lại và xoá cây đánh giá.
+// Resume phải UPDATE trạng thái trước khi chạy agent, nên không thể chen giữa
+// lần kiểm tra cuối và RemoveAll. Dry-run chỉ đọc, không cần khoá ghi.
+func collectTree(ctx context.Context, db *sql.DB, r *os.Root, name, batchID string, cutoff time.Time, dry bool) (int64, bool, error) {
+	if batchID != "" {
+		conn, err := db.Conn(ctx)
+		if err != nil {
+			return 0, false, err
+		}
+		defer conn.Close()
+		if !dry {
+			if _, err := conn.ExecContext(ctx, "BEGIN IMMEDIATE"); err != nil {
+				return 0, false, err
+			}
+			defer conn.ExecContext(context.WithoutCancel(ctx), "ROLLBACK")
+		}
+		var eligible bool
+		err = conn.QueryRowContext(ctx, `SELECT EXISTS (SELECT 1 FROM eval_batches b
+			WHERE batch_id=? AND status IN ('completed','failed','cancelled','interrupted','budget_exhausted')
+			AND finished_at < ? AND finished_at != ''
+			AND NOT EXISTS (SELECT 1 FROM evaluation_runs a WHERE a.batch_id=b.batch_id AND a.status='running'))`,
+			batchID, store.FormatTime(cutoff)).Scan(&eligible)
+		if err != nil || !eligible {
+			return 0, false, err
+		}
+	}
+	bytes, old, err := oldTree(ctx, r, name, cutoff)
+	if err != nil || !old {
+		return 0, false, err
+	}
+	if !dry {
+		if err := r.RemoveAll(name); err != nil {
+			return 0, false, err
+		}
+	}
+	return bytes, true, nil
+}
+
+// plainPath từ chối mọi symlink trong đường dẫn, không chỉ mục cuối.
+func plainPath(r *os.Root, name string) (bool, error) {
+	parts := strings.Split(name, "/")
+	for i := range parts {
+		info, err := r.Lstat(strings.Join(parts[:i+1], "/"))
+		if errors.Is(err, fs.ErrNotExist) {
+			return false, nil
+		}
+		if err != nil {
+			return false, err
+		}
+		if info.Mode()&os.ModeSymlink != 0 {
+			return false, nil
+		}
+	}
+	return true, nil
+}
+
+// oldTree yêu cầu cả thư mục lẫn mọi mục con đều cũ; không đi theo symlink.
+func oldTree(ctx context.Context, r *os.Root, name string, cutoff time.Time) (int64, bool, error) {
+	var bytes int64
+	stop := errors.New("còn dữ liệu mới hoặc liên kết")
+	err := fs.WalkDir(r.FS(), name, func(_ string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		info, err := d.Info()
+		if err != nil {
+			return err
+		}
+		if (!info.IsDir() && !info.Mode().IsRegular()) || !info.ModTime().Before(cutoff) {
+			return stop
+		}
+		if info.Mode().IsRegular() {
+			bytes += info.Size()
+		}
+		return nil
+	})
+	if errors.Is(err, stop) || errors.Is(err, fs.ErrNotExist) {
+		return 0, false, nil
+	}
+	return bytes, err == nil, err
+}
diff --git a/internal/stategc/gc_test.go b/internal/stategc/gc_test.go
new file mode 100644
index 0000000..8b166a4
--- /dev/null
+++ b/internal/stategc/gc_test.go
@@ -0,0 +1,270 @@
+package stategc
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"bint/internal/fslock"
+	"bint/internal/state"
+	"bint/internal/store"
+)
+
+func fixture(t *testing.T) (state.Paths, *store.Store, time.Time) {
+	t.Helper()
+	p := state.At("test", t.TempDir())
+	s, err := store.Open(context.Background(), p.DB)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { s.Close() })
+	return p, s, time.Date(2026, 11, 17, 12, 0, 0, 0, time.UTC)
+}
+
+func file(t *testing.T, root, rel string, at time.Time) {
+	t.Helper()
+	p := filepath.Join(root, rel)
+	if err := os.MkdirAll(filepath.Dir(p), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(p, []byte("data"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chtimes(p, at, at); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func batch(t *testing.T, s *store.Store, id, status string, at time.Time) {
+	t.Helper()
+	_, err := s.DB.Exec(`INSERT INTO eval_batches
+	(batch_id,status,harness,leakage_mode,arms,repeats,case_ids,prompt_version,seed,started_at,finished_at)
+	VALUES (?,?,'claude','strict','[]',1,'[]',1,1,?,?)`, id, status, store.FormatTime(at), store.FormatTime(at))
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestCollectDryRunAndProtectedState(t *testing.T) {
+	p, s, now := fixture(t)
+	old := now.AddDate(0, 0, -31)
+	batch(t, s, "done", "completed", old)
+	batch(t, s, "active", "running", old)
+	batch(t, s, "recent", "completed", now)
+	batch(t, s, "attempt-active", "completed", old)
+	_, err := s.DB.Exec(`INSERT INTO evaluation_runs
+	(attempt_id,batch_id,case_id,case_fingerprint,arm,repeat_index,status,harness,started_at)
+	VALUES ('a','attempt-active','c','f','none',1,'running','claude',?)`, store.FormatTime(old))
+	if err != nil {
+		t.Fatal(err)
+	}
+	remove := []string{"backups/config.bak", "spool/rejected/bad.jsonl", "runtime/hook-trace/old.in",
+		"eval-work/runs/done/a/work", "eval-work/logs/done/a/agent.log"}
+	keep := []string{"spool/pending.jsonl", "runtime/tasks/t/task.yml", "worktrees/t/code.go",
+		"eval-work/runs/active/a/work", "eval-work/logs/recent/a/log", "eval-work/logs/unknown/log",
+		"eval-work/runs/attempt-active/a/work", "eval-work/snapshots/s/knowledge.json", "generated/inspect.json"}
+	for _, rel := range append(append([]string{}, remove...), keep...) {
+		file(t, p.Root, rel, old)
+	}
+	// Directory timestamps alone are insufficient, but must be old for eligible trees.
+	for _, rel := range []string{"eval-work/runs/done", "eval-work/runs/done/a", "eval-work/logs/done", "eval-work/logs/done/a"} {
+		if err := os.Chtimes(filepath.Join(p.Root, rel), old, old); err != nil {
+			t.Fatal(err)
+		}
+	}
+	file(t, p.Root, "backups/new.bak", now)
+	file(t, p.Root, "backups/boundary.bak", now.AddDate(0, 0, -30))
+	keep = append(keep, "backups/new.bak", "backups/boundary.bak")
+	r, err := Collect(context.Background(), s.DB, p, now, 30, true, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(r.Items) != 5 || r.Bytes != 20 {
+		t.Fatalf("dry run: %+v", r)
+	}
+	for _, rel := range remove {
+		if _, err := os.Stat(filepath.Join(p.Root, rel)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err := os.Stat(filepath.Join(p.Root, "gc.lock")); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("dry run created lock: %v", err)
+	}
+	r, err = Collect(context.Background(), s.DB, p, now, 30, false, false)
+	if err != nil || len(r.Items) != 5 {
+		t.Fatalf("collect: %+v %v", r, err)
+	}
+	for _, rel := range remove {
+		if _, err := os.Stat(filepath.Join(p.Root, rel)); !errors.Is(err, os.ErrNotExist) {
+			t.Errorf("not removed %s: %v", rel, err)
+		}
+	}
+	for _, rel := range keep {
+		if _, err := os.Stat(filepath.Join(p.Root, rel)); err != nil {
+			t.Errorf("not preserved %s: %v", rel, err)
+		}
+	}
+	var n int
+	if err := s.DB.QueryRow(`SELECT count(*) FROM eval_batches`).Scan(&n); err != nil || n != 4 {
+		t.Fatalf("metrics changed: %d %v", n, err)
+	}
+}
+
+func TestRecentDescendantPreservesBatchTree(t *testing.T) {
+	p, s, now := fixture(t)
+	old := now.AddDate(0, 0, -31)
+	batch(t, s, "done", "completed", old)
+	file(t, p.Root, "eval-work/runs/done/new.txt", now)
+	if err := os.Chtimes(filepath.Join(p.Root, "eval-work/runs/done"), old, old); err != nil {
+		t.Fatal(err)
+	}
+	r, err := Collect(context.Background(), s.DB, p, now, 30, false, false)
+	if err != nil || len(r.Items) != 0 {
+		t.Fatalf("recent descendant: %+v %v", r, err)
+	}
+}
+
+func TestCollectDoesNotFollowSymlinks(t *testing.T) {
+	p, s, now := fixture(t)
+	out := t.TempDir()
+	old := now.AddDate(0, 0, -31)
+	file(t, out, "old.bak", old)
+	if err := os.Symlink(out, p.Backups); err != nil {
+		t.Skip(err)
+	}
+	if err := os.MkdirAll(filepath.Join(p.Runtime, "hook-trace"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(filepath.Join(out, "old.bak"), filepath.Join(p.Runtime, "hook-trace", "link")); err != nil {
+		t.Fatal(err)
+	}
+	r, err := Collect(context.Background(), s.DB, p, now, 30, false, false)
+	if err != nil || len(r.Items) != 0 {
+		t.Fatalf("symlinks: %+v %v", r, err)
+	}
+	if _, err := os.Stat(filepath.Join(out, "old.bak")); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestAutomaticScheduleDisableAndLock(t *testing.T) {
+	p, s, now := fixture(t)
+	old := now.AddDate(0, 0, -31)
+	file(t, p.Root, "backups/one", old)
+	if _, err := Collect(context.Background(), s.DB, p, now, 0, false, true); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(filepath.Join(p.Root, "gc.lock")); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("disabled cleanup wrote lock: %v", err)
+	}
+	if _, err := Collect(context.Background(), s.DB, p, now, 30, false, true); err != nil {
+		t.Fatal(err)
+	}
+	file(t, p.Root, "backups/two", old)
+	r, err := Collect(context.Background(), s.DB, p, now.Add(time.Hour), 30, false, true)
+	if err != nil || len(r.Items) != 0 {
+		t.Fatalf("daily limit: %+v %v", r, err)
+	}
+	r, err = Collect(context.Background(), s.DB, p, now.Add(24*time.Hour), 30, false, true)
+	if err != nil || len(r.Items) != 1 {
+		t.Fatalf("next day: %+v %v", r, err)
+	}
+	f, err := os.OpenFile(filepath.Join(p.Root, "gc.lock"), os.O_RDWR, 0o600)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	if busy, err := fslock.Try(f, true); busy || err != nil {
+		t.Fatalf("lock: %v %v", busy, err)
+	}
+	if _, err := Collect(context.Background(), s.DB, p, now, 30, false, false); !errors.Is(err, ErrBusy) {
+		t.Fatalf("busy = %v", err)
+	}
+}
+
+func TestCollectionFailureDoesNotAdvanceSchedule(t *testing.T) {
+	p, s, now := fixture(t)
+	if err := os.WriteFile(p.Backups, []byte("not a directory"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := Collect(context.Background(), s.DB, p, now, 30, false, true); err == nil {
+		t.Fatal("expected collection error")
+	}
+	if err := os.Remove(p.Backups); err != nil {
+		t.Fatal(err)
+	}
+	file(t, p.Root, "backups/retry", now.AddDate(0, 0, -31))
+	r, err := Collect(context.Background(), s.DB, p, now, 30, false, true)
+	if err != nil || len(r.Items) != 1 {
+		t.Fatalf("retry: %+v %v", r, err)
+	}
+}
+
+func TestResumedBatchIsRecheckedBeforeRemoval(t *testing.T) {
+	p, s, now := fixture(t)
+	old := now.AddDate(0, 0, -31)
+	batch(t, s, "done", "completed", old)
+	file(t, p.Root, "eval-work/runs/done/old", old)
+	name := "eval-work/runs/done"
+	if err := os.Chtimes(filepath.Join(p.Root, name), old, old); err != nil {
+		t.Fatal(err)
+	}
+	// The candidate was selected while terminal, then resumed before deletion.
+	if _, err := s.DB.Exec(`UPDATE eval_batches SET status='running' WHERE batch_id='done'`); err != nil {
+		t.Fatal(err)
+	}
+	r, err := os.OpenRoot(p.Root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer r.Close()
+	_, removed, err := collectTree(context.Background(), s.DB, r, name, "done", now.AddDate(0, 0, -30), false)
+	if err != nil || removed {
+		t.Fatalf("resumed batch: removed=%v err=%v", removed, err)
+	}
+	if _, err := os.Stat(filepath.Join(p.Root, name, "old")); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestCollectorSerializesWithConcurrentResume(t *testing.T) {
+	p, s, now := fixture(t)
+	old := now.AddDate(0, 0, -31)
+	batch(t, s, "done", "completed", old)
+	file(t, p.Root, "eval-work/runs/done/old", old)
+	name := "eval-work/runs/done"
+	if err := os.Chtimes(filepath.Join(p.Root, name), old, old); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	// BEGIN IMMEDIATE reserves the writer slot. Readers can still see the old
+	// terminal status in WAL mode; GC must wait before deleting that candidate.
+	tx, err := s.DB.BeginTx(ctx, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tx.Rollback()
+	finished := make(chan error, 1)
+	go func() { _, err := Collect(ctx, s.DB, p, now, 30, false, false); finished <- err }()
+	select {
+	case err := <-finished:
+		t.Fatalf("collector did not wait for concurrent resume: %v", err)
+	case <-time.After(100 * time.Millisecond):
+	}
+	if _, err := tx.ExecContext(ctx, `UPDATE eval_batches SET status='running' WHERE batch_id='done'`); err != nil {
+		t.Fatal(err)
+	}
+	if err := tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-finished; err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(filepath.Join(p.Root, name, "old")); err != nil {
+		t.Fatalf("removed concurrently resumed batch: %v", err)
+	}
+}
