+package cli_test
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"bint/internal/app"
+	"bint/internal/spool"
+	"bint/internal/stategc"
+	"bint/internal/testutil"
+)
+
+func TestGCPreviewAndCollect(t *testing.T) {
+	testutil.Isolate(t)
+	root := testutil.NewRepo(t, map[string]string{"go.mod": "module demo\n"})
+	if out, code := run(t, root, "", "init", "--no-hooks"); code != 0 {
+		t.Fatalf("init: %d %s", code, out)
+	}
+	w, err := app.OpenWorkspace(context.Background(), root, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := filepath.Join(w.Paths.Backups, "old.bak")
+	if err := os.WriteFile(p, []byte("old"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	old := time.Now().AddDate(0, 0, -31)
+	if err := os.Chtimes(p, old, old); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := spool.Write(w.Paths.Spool, spool.Event{SchemaVersion: spool.SchemaVersion, EventID: "pending",
+		Type: spool.SessionStarted, Source: "hook:claude", Harness: "claude", SessionID: "s", Timestamp: old}); err != nil {
+		t.Fatal(err)
+	}
+	for _, dry := range []bool{true, false} {
+		args := []string{"gc", "--json"}
+		if dry {
+			args = append(args, "--dry-run")
+		}
+		out, code := run(t, root, "", args...)
+		var res stategc.Result
+		if code != 0 || json.Unmarshal([]byte(out), &res) != nil {
+			t.Fatalf("gc: %d %s", code, out)
+		}
+		if len(res.Items) != 1 || res.Bytes != 3 || res.DryRun != dry {
+			t.Fatalf("result: %+v", res)
+		}
+		_, err := os.Stat(p)
+		if dry && err != nil {
+			t.Fatal("preview removed backup", err)
+		}
+		if !dry && !os.IsNotExist(err) {
+			t.Fatalf("backup not removed: %v", err)
+		}
+		pending, err := spool.Pending(w.Paths.Spool)
+		if err != nil || len(pending) != 1 {
+			t.Fatalf("gc consumed spool: %v %v", pending, err)
+		}
+	}
+	if out, code := run(t, root, "", "gc", "unexpected"); code != 2 {
+		t.Fatalf("arguments: %d %s", code, out)
+	}
+	if out, code := run(t, t.TempDir(), "", "gc"); code != 4 {
+		t.Fatalf("outside repo: %d %s", code, out)
+	}
+	if err := os.WriteFile(filepath.Join(root, ".bint/local.yml"), []byte("state:\n  retention_days: 0\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if out, code := run(t, root, "", "gc", "--json"); code != 0 {
+		t.Fatalf("disabled: %d %s", code, out)
+	} else {
+		var res stategc.Result
+		if err := json.Unmarshal([]byte(out), &res); err != nil || !res.Disabled {
+			t.Fatalf("disabled result: %s %v", out, err)
+		}
+	}
+}
