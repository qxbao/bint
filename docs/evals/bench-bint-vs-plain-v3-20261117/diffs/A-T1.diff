+package app
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestIngestAutomaticallyCleansOldState(t *testing.T) {
+	root, _ := runsRepo(t)
+	ctx := context.Background()
+	w, err := OpenWorkspace(ctx, root, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	old := filepath.Join(w.Paths.Backups, "old.bak")
+	if err := os.WriteFile(old, []byte("old"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	at := time.Now().AddDate(0, 0, -31)
+	if err := os.Chtimes(old, at, at); err != nil {
+		t.Fatal(err)
+	}
+	ro, err := OpenRuns(ctx, root, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ro.Close()
+	if _, err := os.Stat(old); err != nil {
+		t.Fatal("read-only open removed backup", err)
+	}
+	rw, err := OpenRuns(ctx, root, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rw.Close()
+	if rw.Ingest.Events != 3 {
+		t.Fatalf("ingest changed: %+v", rw.Ingest)
+	}
+	if _, err := os.Stat(old); !os.IsNotExist(err) {
+		t.Fatalf("old backup not cleaned: %v", err)
+	}
+}
+
+func TestCleanupFailureDoesNotBreakIngest(t *testing.T) {
+	root, _ := runsRepo(t)
+	w, err := OpenWorkspace(context.Background(), root, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// A bad lock path prevents cleanup but must not stop event ingestion.
+	if err := os.Mkdir(filepath.Join(w.Paths.Root, "gc.lock"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	r, err := OpenRuns(context.Background(), root, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer r.Close()
+	if r.Ingest.Events != 3 {
+		t.Fatalf("ingest: %+v", r.Ingest)
+	}
+}
+
+func TestGCPreviewDoesNotMigrateStore(t *testing.T) {
+	root, _ := runsRepo(t)
+	ctx := context.Background()
+	w, err := OpenWorkspace(ctx, root, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s, err := w.OpenStore(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	// Mô phỏng schema cũ: mở Store theo đường ghi sẽ thử áp lại migration
+	// và lỗi do bảng đã có; xem trước phải chỉ truy vấn và giữ nguyên version.
+	if _, err := s.DB.Exec(`DELETE FROM schema_migrations WHERE version=(SELECT MAX(version) FROM schema_migrations)`); err != nil {
+		t.Fatal(err)
+	}
+	before, err := s.Version(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := CollectState(ctx, root, true); err != nil {
+		t.Fatal(err)
+	}
+	after, err := s.Version(ctx)
+	if err != nil || before != after {
+		t.Fatalf("preview migrated schema: %d -> %d (%v)", before, after, err)
+	}
+}
