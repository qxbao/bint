+package app
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+	"time"
+
+	"bint/internal/task"
+)
+
+func TestTaskProgressDoesNotReconcileOrSync(t *testing.T) {
+	ws, root, id := taskRepo(t)
+	tk, err := ws.Tasks.Update(id, time.Now(), func(tk *task.Task) error {
+		tk.State.Status = task.StatusInProgress
+		tk.State.Runner = &task.Runner{PID: 99999999, Host: "", RunID: "dead"}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	before := snapshot(t, root, ws.K.Paths.Root)
+	report, err := AnalyzeTaskProgress(context.Background(), root, TaskProgressOptions{})
+	if err != nil || len(report.Tasks) != 1 || report.Tasks[0].Status != task.StatusInProgress {
+		t.Fatalf("%+v %v", report, err)
+	}
+	if !reflect.DeepEqual(before, snapshot(t, root, ws.K.Paths.Root)) {
+		t.Fatal("analysis changed repository or local runtime files")
+	}
+	b, err := os.ReadFile(filepath.Join(tk.Dir, task.StateFile))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var st task.State
+	if err := json.Unmarshal(b, &st); err != nil {
+		t.Fatal(err)
+	}
+	if st.Runner == nil || st.Status != task.StatusInProgress {
+		t.Fatal("analysis reconciled the dead runner")
+	}
+}
