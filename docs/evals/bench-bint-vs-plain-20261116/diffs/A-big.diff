+
+type TaskProgressReport struct {
+	Tasks    []task.TaskProgress  `json:"tasks"`
+	Summary  task.ProgressSummary `json:"summary"`
+	Warnings []string             `json:"warnings"`
+	Language string               `json:"-"`
+}
+
+// AnalyzeTaskProgress opens no database or runtime directory, and never imports,
+// exports, reconciles, or mutates tickets. It also works with only a Git ledger.
+func AnalyzeTaskProgress(ctx context.Context, dir string, o TaskProgressOptions) (TaskProgressReport, error) {
+	r := TaskProgressReport{Tasks: []task.TaskProgress{}, Warnings: []string{}}
+	if err := o.Validate(); err != nil {
+		return r, err
+	}
+	w, err := OpenWorkspace(ctx, dir, false)
+	if err != nil {
+		return r, err
+	}
+	// Read-only historical analysis also works before init (an empty ledger is a
+	// valid empty sample, never evidence that repairs are making progress).
+	r.Language = w.Config.UI.Language
+	s := task.NewStore(w.Paths.Runtime)
+	s.Root, s.Ledger = w.Repo.Toplevel, w.Config.Tasks.Ledger != config.LedgerLocal
+	ts, bad := s.ListProgressReadOnly()
+	for _, err := range bad {
+		r.Warnings = append(r.Warnings, err.Error())
+	}
+	for _, t := range ts {
+		if err := ctx.Err(); err != nil {
+			return r, err
+		}
+		r.Tasks = append(r.Tasks, task.AnalyzeProgress(t))
+	}
+	r.Summary = task.SummarizeProgress(r.Tasks)
+	return r, nil
+}
