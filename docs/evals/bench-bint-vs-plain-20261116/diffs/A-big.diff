diff --git a/internal/workflow/no_progress.go b/internal/workflow/no_progress.go
new file mode 100644
index 0000000..f1372e9
--- /dev/null
+++ b/internal/workflow/no_progress.go
@@ -0,0 +1,75 @@
+package workflow
+
+import (
+	"fmt"
+	"strings"
+
+	"bint/internal/task"
+)
+
+// Keep the whole implement sequence since the last decision, not merely the
+// final step (which may be a no-op after an earlier step made progress).
+func recordProgressFix(st *task.State, runID, before, after string) {
+	if old := st.ProgressFix; old != nil && !old.Reviewed {
+		before = old.BeforeTree
+	}
+	st.ProgressFix = &task.ProgressFix{RunID: runID, BeforeTree: before, AfterTree: after}
+}
+
+// observeProgress never changes a decision or propagates a telemetry error.
+// Both drivers reach these shared review/finalize gates only after normal steps.
+func (r *Runner) observeProgress(rs *runState, s task.ProgressSample, v *task.Verification) {
+	if r.Cfg.Workflow.NoProgress.Mode != "shadow" {
+		return
+	}
+	var previous *task.ProgressSample
+	var seen []string
+	for _, o := range rs.t.State.NoProgress {
+		seen = append(seen, o.Paths...)
+		if o.Source != s.Source {
+			continue
+		}
+		if o.Round == s.Round && o.At == s.At && o.RunID == s.RunID {
+			return
+		}
+		p := o.Sample()
+		previous = &p
+	}
+	if strings.HasPrefix(s.Source, "review:") {
+		if rev, err := rs.t.LoadReview(); err == nil {
+			for _, rd := range rev.Rounds {
+				if rd.Round < s.Round {
+					seen = append(seen, task.ProgressPaths(rd.Findings)...)
+				}
+			}
+		}
+	}
+	if fix := rs.t.State.ProgressFix; fix != nil {
+		s.FixRunID = fix.RunID
+		if previous == nil || previous.FixRunID != fix.RunID {
+			s.BeforeTree, s.AfterTree, s.TreeBasis = fix.BeforeTree, fix.AfterTree, "implementation"
+		}
+	}
+	s.VerificationCount = len(rs.t.State.Verifications)
+	if previous != nil && previous.VerificationCount == s.VerificationCount {
+		v = nil
+	}
+	task.ProgressVerification(&s, v)
+	o := task.DetectProgress(previous, s, seen)
+	note := fmt.Sprintf("no_progress shadow: %s round=%d signals=[%s] would_stop=%t", s.Source, s.Round, strings.Join(o.Signals, ","), o.WouldStop)
+	rs.res.Notes = append(rs.res.Notes, note)
+	r.logf("  %s", note)
+	if t, err := r.Tasks.Update(rs.t.State.ID, r.now(), func(t *task.Task) error {
+		t.State.NoProgress = append(t.State.NoProgress, o)
+		if t.State.ProgressFix != nil {
+			t.State.ProgressFix.Reviewed = true
+		}
+		return nil
+	}); err == nil {
+		rs.t = t
+	} else {
+		note := "no_progress shadow: không ghi được bằng chứng: " + err.Error()
+		rs.res.Notes = append(rs.res.Notes, note)
+		r.logf("  %s", note)
+	}
+}
diff --git a/internal/workflow/no_progress_test.go b/internal/workflow/no_progress_test.go
