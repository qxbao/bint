+package cli_test
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"bint/internal/app"
+	"bint/internal/task"
+	"bint/internal/testutil"
+)
+
+func TestTaskProgressReadOnlyLedger(t *testing.T) {
+	testutil.Isolate(t)
+	root := testutil.NewRepo(t, map[string]string{"a.go": "package a\n"})
+	if out, code := run(t, root, "", "init", "--no-hooks"); code != 0 {
+		t.Fatalf("%d %s", code, out)
+	}
+	dir := filepath.Join(root, task.LedgerDir, "EXAMPLE")
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	for name, body := range map[string]string{
+		task.StateFile:  `{"id":"EXAMPLE","status":"blocked","review_rounds":2}`,
+		task.TicketFile: "id: EXAMPLE\ngoal: example\n",
+		task.ReviewFile: `{"task_id":"EXAMPLE","rounds":[{"round":1,"at":"2026-11-16T10:01:00Z","findings":[{"kind":"bug","severity":"high","path":"a.go"}]},{"round":2,"at":"2026-11-16T10:02:00Z","findings":[{"kind":"bug","severity":"high","path":"a.go"}]}]}`,
+	} {
+		if err := os.WriteFile(filepath.Join(dir, name), []byte(body), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	before := progressFiles(t, root)
+	out, code := run(t, root, "", "task", "progress", "--json")
+	if code != 0 {
+		t.Fatalf("%d %s", code, out)
+	}
+	var report struct {
+		Tasks   []task.TaskProgress  `json:"tasks"`
+		Summary task.ProgressSummary `json:"summary"`
+	}
+	if err := json.Unmarshal([]byte(out), &report); err != nil {
+		t.Fatalf("%v %s", err, out)
+	}
+	if len(report.Tasks) != 1 || report.Summary.Tasks != 1 || report.Tasks[0].WouldStopRound != nil || report.Tasks[0].Observations[1].SameFailure != nil {
+		t.Fatalf("%s", out)
+	}
+	text, code := run(t, root, "", "task", "progress")
+	if code != 0 || !strings.Contains(text, "EXAMPLE") || !strings.Contains(text, "unknown") {
+		t.Fatalf("%d %s", code, text)
+	}
+	if after := progressFiles(t, root); before != after {
+		t.Fatal("task progress changed repository files")
+	}
+	if out, code := run(t, root, "", "task", "progress", "EXAMPLE"); code != 2 {
+		t.Fatalf("unexpected positional argument: %d %s", code, out)
+	}
+}
+
+func progressFiles(t *testing.T, root string) string {
+	t.Helper()
+	var b strings.Builder
+	err := filepath.WalkDir(root, func(p string, e os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if e.IsDir() {
+			return nil
+		}
+		data, err := os.ReadFile(p)
+		if err != nil {
+			return err
+		}
+		b.WriteString(p)
+		b.Write(data)
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return b.String()
+}
+
+func TestTaskProgressShadowVisibleInShowAndStatus(t *testing.T) {
+	testutil.Isolate(t)
+	asHuman(t)
+	root := testutil.NewRepo(t, map[string]string{"a.go": "package a\n"})
+	if out, code := run(t, root, "", "init", "--no-hooks"); code != 0 {
+		t.Fatalf("%d %s", code, out)
+	}
+	var created struct {
+		ID string `json:"id"`
+	}
+	if err := json.Unmarshal([]byte(exec2(t, root, "task", "new", "--json", "Sửa a.go")), &created); err != nil {
+		t.Fatal(err)
+	}
+	w, err := app.OpenWorkspace(t.Context(), root, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := task.NewStore(w.Paths.Runtime)
+	tk, err := s.Load(created.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	st := tk.State
+	b := true
+	st.NoProgress = []task.ProgressObservation{{ProgressSample: task.ProgressSample{Round: 2, Source: "review:b-review"}, NoChange: &b, Signals: []string{"no_change"}, WouldStop: true}}
+	data, err := json.Marshal(st)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(tk.Dir, task.StateFile), data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	for _, args := range [][]string{{"task", "show", created.ID, "--json"}, {"run", "status", created.ID, "--json"}} {
+		out, code := run(t, root, "", args...)
+		if code != 0 {
+			t.Fatalf("%v %d %s", args, code, out)
+		}
+		var result struct {
+			NoProgress []task.ProgressObservation `json:"no_progress"`
+		}
+		if err := json.Unmarshal([]byte(out), &result); err != nil || len(result.NoProgress) != 1 || !result.NoProgress[0].WouldStop {
+			t.Fatalf("%v %s", err, out)
+		}
+	}
+	t.Setenv("BINT_LANG", "en")
+	out, code := run(t, root, "", "run", "status", created.ID)
+	if code != 0 || !strings.Contains(out, "would_stop=true") {
+		t.Fatalf("%d %s", code, out)
+	}
+}
