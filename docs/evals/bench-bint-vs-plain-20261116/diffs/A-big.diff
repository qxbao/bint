new file mode 100644
index 0000000..3cdb15e
--- /dev/null
+++ b/internal/cli/task_progress.go
@@ -0,0 +1,90 @@
+package cli
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"strings"
+
+	"github.com/spf13/cobra"
+
+	"bint/internal/app"
+	"bint/internal/i18n"
+	"bint/internal/task"
+)
+
+func progressCatalog(language string) *i18n.Catalog {
+	lang := i18n.Resolve("", os.Getenv("BINT_LANG"), language, os.Getenv("LC_ALL"), os.Getenv("LC_MESSAGES"), os.Getenv("LANG"))
+	c, _ := i18n.Load(lang)
+	return c
+}
+
+func newTaskProgressCmd(stdio IO) *cobra.Command {
+	var asJSON bool
+	c := &cobra.Command{
+		Use: "progress", Short: "Phân tích offline các vòng sửa không tiến triển trên toàn bộ phiếu (chỉ đọc)",
+		Long: "Dựng lại các vòng review và kiểm chứng từ phiếu cục bộ và sổ Git. Không gọi agent, không đồng bộ hay sửa phiếu. Thiếu log/cây thì báo unknown; lẽ ra dừng chỉ là số đo, không phải quyết định dừng.",
+		Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, args []string) error {
+			dir, err := cwd()
+			if err != nil {
+				return err
+			}
+			r, err := app.AnalyzeTaskProgress(cmd.Context(), dir, app.TaskProgressOptions{})
+			if err != nil {
+				return err
+			}
+			if asJSON {
+				return writeJSON(stdio.Out, r)
+			}
+			cat := progressCatalog(r.Language)
+			fmt.Fprintln(stdio.Out, cat.T("progress.summary", i18n.A{"tasks": r.Summary.Tasks, "events": r.Summary.WouldStopEvents, "recovered": r.Summary.RecoveredEvents}))
+			for _, t := range r.Tasks {
+				fmt.Fprintln(stdio.Out, cat.T("progress.task", i18n.A{"id": t.TaskID, "status": t.Status, "rounds": t.Rounds}))
+				for _, o := range t.Observations {
+					printProgressObservation(stdio.Out, cat, "  ", o)
+				}
+				if t.WouldStopRound != nil {
+					fmt.Fprintln(stdio.Out, "  "+cat.T("progress.stop", i18n.A{"source": t.WouldStopSource, "round": *t.WouldStopRound, "extra": *t.ExtraRounds}))
+				}
+				for _, u := range t.Unavailable {
+					fmt.Fprintln(stdio.Out, "  unknown: "+u)
+				}
+			}
+			for _, warning := range r.Warnings {
+				fmt.Fprintln(stdio.Err, "! "+warning)
+			}
+			return nil
+		},
+	}
+	c.Flags().BoolVar(&asJSON, "json", false, "xuất JSON")
+	return c
+}
+
+func progressBool(b *bool) string {
+	if b == nil {
+		return "unknown"
+	}
+	if *b {
+		return "true"
+	}
+	return "false"
+}
+
+func printProgressObservation(w io.Writer, c *i18n.Catalog, indent string, o task.ProgressObservation) {
+	fmt.Fprintln(w, indent+c.T("progress.observation", i18n.A{"source": o.Source, "round": o.Round,
+		"no_change": progressBool(o.NoChange), "same_failure": progressBool(o.SameFailure), "new_scope": progressBool(o.NewScope), "stop": o.WouldStop}))
+	if len(o.Unavailable) > 0 {
+		fmt.Fprintln(w, indent+"  unknown: "+strings.Join(o.Unavailable, ", "))
+	}
+}
+
+func printProgressLines(w io.Writer, language, indent string, t *task.Task) {
+	if len(t.State.NoProgress) == 0 {
+		return
+	}
+	c := progressCatalog(language)
+	for _, o := range t.State.NoProgress {
+		printProgressObservation(w, c, indent, o)
+	}
+}
