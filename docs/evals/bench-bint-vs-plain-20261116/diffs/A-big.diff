index 0000000..8c8cc7d
--- /dev/null
+++ b/internal/workflow/no_progress_test.go
@@ -0,0 +1,120 @@
+package workflow
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"slices"
+	"strings"
+	"testing"
+
+	"bint/internal/task"
+)
+
+func TestNoProgressShadowPreservesReviewLoop(t *testing.T) {
+	for _, mode := range []string{"off", "shadow"} {
+		t.Run(mode, func(t *testing.T) {
+			h := newHarness(t)
+			h.cfg.Workflow.NoProgress.Mode = mode
+			h.cfg.Workflow.MaxReviewRounds = 2
+			h.behave = func(ctx context.Context, step string, e *Env, id string) error {
+				if step == StepReview {
+					_, _, err := e.SubmitReview(id, []byte(`{"summary":"bug","findings":[{"kind":"bug","severity":"high","title":"wrong","path":"app.txt","evidence":"still wrong"}]}`))
+					return err
+				}
+				return h.happy(ctx, step, e, id)
+			}
+			r := h.runner()
+			var log bytes.Buffer
+			r.Logf = func(format string, args ...any) { fmt.Fprintf(&log, format+"\n", args...) }
+			res, err := r.Run(context.Background(), RunOptions{Workflow: StepDo, Request: "Đổi app.txt", Plan: ptr(false)})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if res.Status != task.StatusBlocked || strings.Join(h.calls, ",") != "b-feat,b-review,b-feat,b-review,b-feat,b-review" {
+				t.Fatalf("flow changed: %+v %v", res, h.calls)
+			}
+			st := loadTask(t, h, res.TaskID).State
+			if mode == "off" {
+				if len(st.NoProgress) != 0 || st.ProgressFix != nil {
+					t.Fatal("off must not add telemetry")
+				}
+				return
+			}
+			if len(st.NoProgress) != 3 || st.NoProgress[0].WouldStop || !st.NoProgress[1].WouldStop || !slices.Contains(st.NoProgress[1].Signals, "no_change") {
+				t.Fatalf("observations: %+v", st.NoProgress)
+			}
+			if !strings.Contains(strings.Join(res.Notes, " "), "no_progress") || !strings.Contains(log.String(), "no_progress") {
+				t.Fatalf("missing note/log: %+v %s", res.Notes, log.String())
+			}
+		})
+	}
+}
+
+func TestNoProgressShadowSessionReviewLoop(t *testing.T) {
+	h := newHarness(t)
+	h.cfg.Workflow.NoProgress.Mode = "shadow"
+	h.cfg.Workflow.MaxReviewRounds = 1
+	h.behave = func(ctx context.Context, step string, e *Env, id string) error {
+		if step == StepReview {
+			_, _, err := e.SubmitReview(id, []byte(`{"summary":"bug","findings":[{"kind":"bug","severity":"high","title":"wrong","path":"app.txt","evidence":"still wrong"}]}`))
+			return err
+		}
+		return h.happy(ctx, step, e, id)
+	}
+	r := h.runner()
+	tk := h.newSession(r, NewTaskOptions{Plan: ptr(false), Request: "Đổi app.txt"})
+	steps, last := h.drive(r, tk.State.ID, false)
+	st := loadTask(t, h, tk.State.ID).State
+	if last.Status != task.StatusBlocked || strings.Join(steps, ",") != "b-feat,b-review,b-feat,b-review" || len(st.NoProgress) != 2 || !st.NoProgress[1].WouldStop {
+		t.Fatalf("session shadow: steps=%v last=%+v observations=%+v", steps, last, st.NoProgress)
+	}
+}
+
+func TestNoProgressShadowFullVerifyLoop(t *testing.T) {
+	h := goHarness(t)
+	h.cfg.Workflow.NoProgress.Mode = "shadow"
+	h.cfg.Workflow.MaxReviewRounds = 1
+	full := "echo FAIL same; test ! -f broken.txt"
+	h.cfg.Eval.TestCommand = &full
+	h.behaveFeat(func() {
+		h.write("a/a.go", "package a\n\nfunc A() int { return 2 }\n")
+		h.write("broken.txt", "x\n")
+		h.write("done.txt", "ok\n")
+	})
+	id := h.runFeat("Thêm tính năng cho gói a", "").TaskID
+	res := h.resumeDo(id)
+	st := h.load(id).State
+	if res.Status != task.StatusBlocked || fullVerifyFailRounds(h.load(id)) != 2 || len(st.NoProgress) != 2 || st.NoProgress[0].WouldStop || !st.NoProgress[1].WouldStop || !slices.Contains(st.NoProgress[1].Signals, "same_failure") {
+		t.Fatalf("full verify shadow: %+v observations=%+v", res, st.NoProgress)
+	}
+}
+
+func TestNoProgressShadowTracksEntireImplementSequence(t *testing.T) {
+	h := newHarness(t)
+	h.cfg.Workflow.NoProgress.Mode = "shadow"
+	h.cfg.Workflow.MaxReviewRounds = 1
+	h.writeFlow("multi", strings.ReplaceAll(strings.ReplaceAll(tddFlow, "name: tdd", "name: multi"), "fix: green", "fix: red"))
+	pass := 0
+	h.behave = func(ctx context.Context, step string, e *Env, id string) error {
+		switch step {
+		case "red":
+			pass++
+			h.write("app.txt", fmt.Sprintf("pass %d\n", pass))
+		case "green":
+			h.write("done.txt", "ok\n")
+		case "review":
+			_, _, err := e.SubmitReview(id, []byte(`{"summary":"bug","findings":[{"kind":"bug","severity":"high","title":"wrong","path":"app.txt","evidence":"still wrong"}]}`))
+			return err
+		}
+		return nil
+	}
+	res, err := h.runner().Run(context.Background(), RunOptions{Workflow: "multi", Request: "Sửa app.txt", Plan: ptr(false)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	st := loadTask(t, h, res.TaskID).State
+	if res.Status != task.StatusBlocked || pass != 2 || len(st.NoProgress) != 2 || st.NoProgress[1].WouldStop || st.NoProgress[1].NoChange == nil || *st.NoProgress[1].NoChange {
+		t.Fatalf("earlier implement progress was lost: %+v observations=%+v", res, st.NoProgress)
+	}
+}
