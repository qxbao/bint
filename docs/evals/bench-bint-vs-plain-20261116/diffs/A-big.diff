+++ b/internal/task/progress_test.go
@@ -0,0 +1,109 @@
+package task
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+)
+
+func TestFailureSignature(t *testing.T) {
+	base := "2026-11-16T10:00:00.123Z FAIL widget 12ms /tmp/build-123/test.go 0xabc123 deadbeef12345678\n\n expected true\n"
+	noisy := "2026-11-17T11:42:59Z  FAIL   widget 0.3s C:\\Users\\test\\AppData\\Local\\Temp\\build-999\\test.go 0xdef456 abcdef9876543210\r\n expected   true\n"
+	if FailureSignature([]byte(base)) != FailureSignature([]byte(noisy)) {
+		t.Fatal("timestamps, durations, temporary paths, hex and whitespace must not affect signature")
+	}
+	if FailureSignature([]byte(base)) == FailureSignature([]byte(strings.ReplaceAll(base, "expected true", "expected false"))) {
+		t.Fatal("different error must change signature")
+	}
+	if FailureSignature(nil) != "" || FailureSignature([]byte(" \n\t")) != "" {
+		t.Fatal("empty output must have no signature")
+	}
+	tail := strings.Repeat("same\n", 14000) + base
+	if FailureSignature([]byte("different prefix A"+tail)) != FailureSignature([]byte("different prefix B"+tail)) {
+		t.Fatal("signature must only read bounded tail")
+	}
+}
+
+func TestProgressSignals(t *testing.T) {
+	f := Finding{Kind: "bug", Severity: "high", Path: "./src\\a.go", Criterion: 1}
+	a := ProgressSample{Round: 1, Source: "review", Findings: []Finding{f}, FindingsKnown: true,
+		BeforeTree: "a", AfterTree: "b", Signature: "failure", VerifyKey: "test", Failed: true}
+	b := a
+	b.Round, b.BeforeTree = 2, "b"
+	for _, tc := range []struct {
+		name    string
+		prev    *ProgressSample
+		cur     ProgressSample
+		stop    bool
+		signals []string
+	}{
+		{"first round", nil, b, false, nil},
+		{"unchanged", &a, b, true, []string{"no_change", "same_failure"}},
+		{"new tree and error", &a, ProgressSample{Round: 2, BeforeTree: "b", AfterTree: "c", Signature: "other"}, false, nil},
+		{"missing evidence", &a, ProgressSample{Round: 2}, false, nil},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			o := DetectProgress(tc.prev, tc.cur, []string{"src/a.go"})
+			if o.WouldStop != tc.stop || !slices.Equal(o.Signals, tc.signals) {
+				t.Fatalf("%+v", o)
+			}
+		})
+	}
+	b.Findings = []Finding{{Kind: "risk", Severity: "high", Path: "src/b.go"}}
+	b.BeforeTree = "a"
+	o := DetectProgress(&a, b, []string{"src/a.go"})
+	if o.WouldStop || !slices.Contains(o.Signals, "new_scope") {
+		t.Fatalf("new_scope must never stop: %+v", o)
+	}
+	b.Signature = ""
+	b.BeforeTree = ""
+	if o := DetectProgress(&a, b, nil); o.SameFailure != nil || o.NoChange != nil {
+		t.Fatalf("missing evidence must be unknown: %+v", o)
+	}
+}
+
+func TestFindingKeys(t *testing.T) {
+	a := []Finding{{Kind: "bug", Severity: "high", Path: "./a\\b.go", Criterion: 2}, {Kind: "risk", Severity: "critical", Title: "  SAME  issue "}}
+	b := []Finding{{Kind: "risk", Severity: "high", Title: "same issue"}, {Kind: "bug", Severity: "high", Path: "a/b.go", Criterion: 2}, a[0], {Kind: "suggestion", Severity: "high", Path: "ignored"}}
+	if !slices.Equal(ProgressFindingKeys(a), ProgressFindingKeys(b)) {
+		t.Fatal("keys must normalize, sort and deduplicate blocking findings")
+	}
+}
+
+func TestVerificationSignatureMissingAndTail(t *testing.T) {
+	v := &Verification{Log: filepath.Join(t.TempDir(), "missing.log")}
+	if sig, err := VerificationSignature(v); err == nil || sig != "" {
+		t.Fatal("missing log must be explicit")
+	}
+	if err := os.WriteFile(v.Log, []byte("FAIL example 0.1s\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if sig, err := VerificationSignature(v); err != nil || sig == "" {
+		t.Fatalf("%q %v", sig, err)
+	}
+}
+
+func TestProgressConservativeFailureComparison(t *testing.T) {
+	a := ProgressSample{Round: 1, Signature: "sig", VerifyKey: "test", Failed: true, FindingsKnown: true}
+	for _, tc := range []struct {
+		name   string
+		change func(*ProgressSample)
+	}{
+		{"different command", func(s *ProgressSample) { s.VerifyKey = "other" }},
+		{"empty log", func(s *ProgressSample) { s.Signature = "" }},
+		{"passed verification", func(s *ProgressSample) { s.Failed = false }},
+		{"missing review", func(s *ProgressSample) { s.FindingsKnown = false }},
+		{"different error", func(s *ProgressSample) { s.Signature = "new" }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			b := a
+			b.Round = 2
+			tc.change(&b)
+			if o := DetectProgress(&a, b, nil); o.WouldStop {
+				t.Fatalf("%+v", o)
+			}
+		})
+	}
+}
