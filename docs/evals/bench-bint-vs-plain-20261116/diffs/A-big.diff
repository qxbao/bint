+++ b/internal/task/progress_offline_test.go
@@ -0,0 +1,126 @@
+package task
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestOfflineProgressRoundsAndMissingEvidence(t *testing.T) {
+	dir := t.TempDir()
+	log := filepath.Join(dir, "verify.log")
+	if err := os.WriteFile(log, []byte("FAIL same\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	f := Finding{Kind: "bug", Severity: "high", Path: "a.go"}
+	rev := Review{Rounds: []ReviewRound{
+		{Round: 1, At: "2026-11-16T10:01:00Z", Findings: []Finding{f}},
+		{Round: 2, At: "2026-11-16T10:03:00Z", Findings: []Finding{f}},
+		{Round: 3, At: "2026-11-16T10:05:00Z"},
+	}}
+	b, _ := json.Marshal(rev)
+	if err := os.WriteFile(filepath.Join(dir, ReviewFile), b, 0600); err != nil {
+		t.Fatal(err)
+	}
+	tk := &Task{Dir: dir, State: State{ID: "example", Status: StatusDone, ReviewRounds: 3, Verifications: []Verification{
+		{At: "2026-11-16T10:00:00Z", Command: "test", Tree: "same", Log: log},
+		{At: "2026-11-16T10:02:00Z", Command: "test", Tree: "same", Log: log},
+		{At: "2026-11-16T10:04:00Z", Command: "test", Tree: "fixed", Passed: true, Log: log},
+	}}}
+	r := AnalyzeProgress(tk)
+	if r.WouldStopRound == nil || *r.WouldStopRound != 2 || r.ExtraRounds == nil || *r.ExtraRounds != 1 || r.RecoveredEvents != 1 {
+		t.Fatalf("%+v", r)
+	}
+	if len(r.Observations) != 3 || !r.Observations[1].WouldStop || r.Observations[2].WouldStop {
+		t.Fatalf("%+v", r.Observations)
+	}
+	for i := range tk.State.Verifications {
+		tk.State.Verifications[i].Log = ""
+		tk.State.Verifications[i].Tree = ""
+	}
+	r = AnalyzeProgress(tk)
+	if r.WouldStopRound != nil || r.Observations[1].NoChange != nil || r.Observations[1].SameFailure != nil {
+		t.Fatalf("missing evidence guessed: %+v", r)
+	}
+	// Never reuse one verification for two reviews, even if their findings match.
+	tk.State.Verifications = []Verification{{At: "2026-11-16T10:00:00Z", Command: "test", Tree: "same", Log: log}}
+	if r := AnalyzeProgress(tk); r.WouldStopRound != nil {
+		t.Fatalf("reused stale verification: %+v", r)
+	}
+}
+
+func TestProgressReadOnlyLedgerWithoutLocalState(t *testing.T) {
+	root := t.TempDir()
+	dir := filepath.Join(root, LedgerDir, "EXAMPLE")
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	// Durable intentionally has no verification log or tree; no local import allowed.
+	d := Durable{ID: "EXAMPLE", Status: StatusBlocked, ReviewRounds: 1}
+	b, _ := json.Marshal(d)
+	if err := os.WriteFile(filepath.Join(dir, StateFile), b, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, TicketFile), []byte("id: EXAMPLE\ngoal: example\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	s := NewStore(filepath.Join(root, "missing-runtime"))
+	s.Root, s.Ledger, s.Import = root, true, true
+	ts, bad := s.ListProgressReadOnly()
+	if len(bad) != 0 || len(ts) != 1 || ts[0].State.ID != "EXAMPLE" {
+		t.Fatalf("%+v %v", ts, bad)
+	}
+	if _, err := os.Stat(s.Dir); !os.IsNotExist(err) {
+		t.Fatal("read-only analysis imported local state")
+	}
+	if _, err := os.Stat(filepath.Join(dir, ".ledger.json")); !os.IsNotExist(err) {
+		t.Fatal("read-only analysis wrote sync metadata")
+	}
+}
+
+func TestProgressReadOnlyOverlayPreservesVerificationScope(t *testing.T) {
+	root := t.TempDir()
+	s := NewStore(filepath.Join(root, "runtime"))
+	s.Root, s.Ledger = root, true
+	localDir := filepath.Join(s.Dir, "EXAMPLE")
+	ledgerDir := filepath.Join(root, LedgerDir, "EXAMPLE")
+	for _, dir := range []string{localDir, ledgerDir} {
+		if err := os.MkdirAll(dir, 0700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, TicketFile), []byte("id: EXAMPLE\ngoal: example\n"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	st := State{ID: "EXAMPLE", Status: StatusBlocked, UpdatedAt: "2026-11-16T10:05:00Z", Verifications: []Verification{
+		{At: "2026-11-16T10:00:00Z", Command: "go test ./...", Scope: "graph", Ran: "go test ./a", Log: "a.log"},
+		{At: "2026-11-16T10:02:00Z", Command: "go test ./...", Scope: "graph", Ran: "go test ./b", Log: "b.log"},
+	}}
+	b, _ := json.Marshal(st)
+	if err := os.WriteFile(filepath.Join(localDir, StateFile), b, 0600); err != nil {
+		t.Fatal(err)
+	}
+	d := ToDurable(st)
+	d.UpdatedAt = "2026-11-16T10:06:00Z"
+	b, _ = json.Marshal(d)
+	if err := os.WriteFile(filepath.Join(ledgerDir, StateFile), b, 0600); err != nil {
+		t.Fatal(err)
+	}
+	ts, bad := s.ListProgressReadOnly()
+	if len(bad) != 0 || len(ts) != 1 {
+		t.Fatalf("%v %v", ts, bad)
+	}
+	for i, v := range ts[0].State.Verifications {
+		if v.Scope != st.Verifications[i].Scope || v.Ran != st.Verifications[i].Ran {
+			t.Fatalf("lost local check identity: %+v", v)
+		}
+	}
+}
+
+func TestProgressVerificationTimestampBoundaryIsUnknown(t *testing.T) {
+	vs := []Verification{{At: "2026-11-16T10:00:00Z", Command: "test", Tree: "old"}, {At: "2026-11-16T10:01:00Z", Command: "test", Tree: "ambiguous"}}
+	if v := VerificationForReview(vs, "", "2026-11-16T10:01:00Z"); v != nil {
+		t.Fatalf("same-second evidence could be after review: %+v", v)
+	}
+}
