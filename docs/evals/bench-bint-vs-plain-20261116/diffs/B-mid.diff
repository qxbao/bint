+	"sort"
+	"strings"
+	"unicode/utf8"
+)
+
+// AgentsSize đo nội dung khối mới, không gồm marker hoặc phần ngoài khối.
+type AgentsSize struct {
+	Bytes           int
+	EstimatedTokens int
+	LargestItems    []AgentsItemSize
+}
+
+// AgentsItemSize là byte tiêu đề/thân thực sự xuất bản, sau giới hạn dòng.
+type AgentsItemSize struct {
+	ID    string
+	Title string
+	Bytes int
+}
+
+// MeasureAgents nhận toàn bộ AgentsBlock (kể cả guidance) và selection của nó.
+// Token là ước tính theo (số rune + 2) / 3, như ctxengine; không phải tokenizer.
+// Chỉ xếp hạng bản sao số đo, không đổi Selection hay nội dung render.
+func MeasureAgents(inner string, sel Selection, opts RenderOptions) AgentsSize {
+	if opts.MaxBodyLines <= 0 {
+		opts.MaxBodyLines = 8
+	}
+	s := AgentsSize{Bytes: len(inner), EstimatedTokens: (utf8.RuneCountInString(inner) + 2) / 3}
+	for _, group := range [][]*Item{sel.Rules, sel.Warnings, sel.Reference} {
+		for _, it := range group {
+			var b strings.Builder
+			writeItem(&b, it, opts.MaxBodyLines)
+			s.LargestItems = append(s.LargestItems, AgentsItemSize{ID: it.ID, Title: strings.TrimSpace(it.Title), Bytes: b.Len()})
+		}
+	}
+	sort.Slice(s.LargestItems, func(i, j int) bool {
+		a, b := s.LargestItems[i], s.LargestItems[j]
+		if a.Bytes != b.Bytes {
+			return a.Bytes > b.Bytes
+		}
+		return a.ID < b.ID
+	})
+	if len(s.LargestItems) > 5 {
+		s.LargestItems = s.LargestItems[:5]
+	}
+	return s
+}
