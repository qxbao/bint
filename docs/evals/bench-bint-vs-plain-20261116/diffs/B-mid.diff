diff --git a/internal/app/publish_size.go b/internal/app/publish_size.go
new file mode 100644
index 0000000..82f128e
--- /dev/null
+++ b/internal/app/publish_size.go
@@ -0,0 +1,42 @@
+package app
+
+import (
+	"fmt"
+	"strings"
+
+	"bint/internal/config"
+	"bint/internal/knowledge"
+)
+
+// agentsPublication là nguồn chung cho publish và doctor: đo sau khi ghép guidance.
+// Không áp trần vào lựa chọn, render hay luồng ghi.
+func agentsPublication(root string, cfg config.Config) (string, *PublishReport, error) {
+	inner, sel, err := AgentsBlock(root, cfg)
+	if err != nil {
+		return "", nil, err
+	}
+	r := &PublishReport{Selection: sel, Size: knowledge.MeasureAgents(inner, sel, knowledge.RenderOptions{}), MaxBytes: cfg.Knowledge.Publish.MaxBytes}
+	r.OverBudget = r.MaxBytes != nil && r.Size.Bytes > *r.MaxBytes
+	return inner, r, nil
+}
+
+// SizeDetail dùng chung cho CLI và doctor (kể cả JSON); số token chỉ là ước tính.
+func (r *PublishReport) SizeDetail() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "Kích thước khối Bint: %d byte UTF-8, khoảng %d token (ước tính); trần: ", r.Size.Bytes, r.Size.EstimatedTokens)
+	if r.MaxBytes == nil {
+		b.WriteString("không đặt (null)")
+	} else {
+		fmt.Fprintf(&b, "%d byte", *r.MaxBytes)
+	}
+	if len(r.Size.LargestItems) > 0 {
+		b.WriteString("\nMục đã chọn lớn nhất (tối đa 5, sau render):")
+		for _, it := range r.Size.LargestItems {
+			fmt.Fprintf(&b, "\n  - %s | %s | %d byte", it.ID, it.Title, it.Bytes)
+		}
+	}
+	if r.OverBudget {
+		fmt.Fprintf(&b, "\nCảnh báo: kích thước khối Bint vượt trần knowledge.publish.max_bytes (%d > %d byte); chỉ cảnh báo, không cắt hay chặn xuất bản.", r.Size.Bytes, *r.MaxBytes)
+	}
+	return b.String()
+}
