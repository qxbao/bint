+package app
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"bint/internal/config"
+)
+
+func TestDoctorPublishSizeBoundaries(t *testing.T) {
+	root := publishSizeRepo(t)
+	cfg, _, err := config.Load(root, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	inner, _, err := AgentsBlock(root, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, delta := range []int{-1, 0, 1, 2} {
+		capBytes := len(inner) + delta
+		cfg.Knowledge.Publish.MaxBytes = &capBytes
+		if delta == 2 {
+			cfg.Knowledge.Publish.MaxBytes = nil
+		}
+		before := publishSourceSnapshot(t, root)
+		r := &DoctorReport{}
+		knowledgeChecks(r, root, cfg)
+		c, ok := checkOf(r, "kích thước khối Bint")
+		if !ok {
+			t.Fatal("missing size check")
+		}
+		want := LevelOK
+		if delta < 0 {
+			want = LevelWarn
+		}
+		if c.Level != want || c.Fix != nil || (&DoctorReport{Checks: []Check{c}}).Failed() {
+			t.Fatalf("check: %+v", c)
+		}
+		if !strings.Contains(c.Detail, fmt.Sprintf("%d byte", len(inner))) || !strings.Contains(c.Detail, "Tiếng Việt 🙂") || !strings.Contains(c.Detail, "ước tính") {
+			t.Fatalf("details: %+v", c)
+		}
+		if !reflect.DeepEqual(before, publishSourceSnapshot(t, root)) {
+			t.Fatal("doctor measurement changed source")
+		}
+	}
+}
+
+func TestDoctorPublishSizeDoesNotInventMeasurementOnReadError(t *testing.T) {
+	root := publishSizeRepo(t)
