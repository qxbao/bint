+		t.Fatal(err)
+	}
+	r := &DoctorReport{}
+	knowledgeChecks(r, root, config.Default())
+	if _, ok := checkOf(r, "kích thước khối Bint"); ok {
+		t.Fatal("reported size despite unreadable item")
+	}
+	if !r.Failed() {
+		t.Fatal("missing knowledge read error")
+	}
+}
