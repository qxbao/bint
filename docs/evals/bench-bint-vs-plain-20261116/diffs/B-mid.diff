+
+func TestKnowledgePublishCapEndToEnd(t *testing.T) {
+	testutil.Isolate(t)
+	asHuman(t)
+	root := testutil.NewRepo(t, map[string]string{"go.mod": "module demo\n", "AGENTS.md": "# Nhóm 🙂\nGiữ phần ngoài khối.\n"})
+	if out, code := run(t, root, "", "init", "--no-hooks"); code != 0 {
+		t.Fatalf("init: %d %s", code, out)
+	}
+	for i := 0; i < 7; i++ {
+		if out, code := run(t, root, "", "knowledge", "add", "--type", "warning", "--title", fmt.Sprintf("Mục UTF-8 %d 🙂", i), "Nội dung đo kích thước."); code != 0 {
+			t.Fatalf("add: %d %s", code, out)
+		}
+	}
+	e2eWrite(t, root, ".bint/harness/guidance/size.md", "---\nid: size\nscope: global\nstatus: verified\norigin: human\nversion: 1\ntitle: Guidance\n---\n"+strings.Repeat("Chỉ dẫn 🙂\n", 20))
+	cfg, _, err := config.Load(root, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	inner, _, err := app.AgentsBlock(root, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var baseline []byte
+	for _, tt := range []struct {
+		cap  string
+		warn bool
+	}{{"1", true}, {fmt.Sprint(len(inner)), false}, {fmt.Sprint(len(inner) + 1), false}, {"null", false}} {
+		e2eWrite(t, root, ".bint/local.yml", "knowledge:\n  publish:\n    max_bytes: "+tt.cap+"\n")
+		before, err := os.ReadFile(filepath.Join(root, "AGENTS.md"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		out, code := run(t, root, "", "bootstrap", "publish", "--dry-run")
+		if code != 0 || !strings.Contains(out, fmt.Sprintf("%d byte UTF-8", len(inner))) || !strings.Contains(out, "ước tính") || strings.Contains(out, "Cảnh báo: kích thước") != tt.warn {
+			t.Fatalf("dry-run cap=%s: %d %s", tt.cap, code, out)
+		}
+		if strings.Count(out, " | ") != 10 {
+			t.Fatalf("want five largest item rows: %s", out)
+		}
+		if tt.cap == "null" && !strings.Contains(out, "không đặt (null)") {
+			t.Fatalf("null cap: %s", out)
+		}
+		after, _ := os.ReadFile(filepath.Join(root, "AGENTS.md"))
+		if string(before) != string(after) {
+			t.Fatal("dry-run wrote AGENTS.md")
+		}
+		out, code = run(t, root, "", "doctor", "--json")
+		var checks []app.Check
+		if code != 0 || json.Unmarshal([]byte(out), &checks) != nil {
+			t.Fatalf("doctor cap=%s: %d %s", tt.cap, code, out)
+		}
+		found := false
+		for _, c := range checks {
+			if c.Name == "kích thước khối Bint" {
+				found = true
+				if (c.Level == app.LevelWarn) != tt.warn || c.Fix != nil || !strings.Contains(c.Detail, fmt.Sprintf("%d byte UTF-8", len(inner))) {
+					t.Fatalf("doctor size: %+v", c)
+				}
+			}
+		}
+		if !found {
+			t.Fatal("missing doctor size JSON")
+		}
+		if out, code = run(t, root, "", "bootstrap", "publish", "--yes"); code != 0 {
+			t.Fatalf("publish: %d %s", code, out)
+		}
+		after, _ = os.ReadFile(filepath.Join(root, "AGENTS.md"))
+		if baseline == nil {
+			baseline = after
+		} else if string(baseline) != string(after) {
+			t.Fatal("cap altered published content")
+		}
+		out, code = run(t, root, "", "bootstrap", "publish", "--dry-run")
+		if code != 0 || !strings.Contains(out, fmt.Sprintf("%d byte UTF-8", len(inner))) || strings.Contains(out, "Cảnh báo: kích thước") != tt.warn || strings.Contains(out, "+++ ") {
+			t.Fatalf("no-diff report: %d %s", code, out)
+		}
+	}
+}
