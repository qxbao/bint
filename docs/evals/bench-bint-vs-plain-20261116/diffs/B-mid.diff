@@ -0,0 +1,133 @@
+package app
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"bint/internal/config"
+	"bint/internal/knowledge"
+)
+
+func publishSizeRepo(t *testing.T) string {
+	t.Helper()
+	root := sysRepo(t, InitOptions{})
+	ws, err := OpenKnowledge(context.Background(), root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	res, err := AddKnowledge(context.Background(), ws, AddOptions{Type: knowledge.TypeWarning, Title: "Tiếng Việt 🙂", Body: strings.Repeat("Nội dung UTF-8\n", 12), Origin: knowledge.OriginHuman})
+	if err != nil || !res.Saved {
+		t.Fatalf("add: %v %+v", err, res)
+	}
+	dir := filepath.Join(root, ".bint", "harness", "guidance")
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "size.md"), []byte("---\nid: size\nscope: global\nstatus: verified\norigin: human\nversion: 1\ntitle: Guidance\n---\n"+strings.Repeat("Hướng dẫn 🙂\n", 50)), 0644); err != nil {
+		t.Fatal(err)
+	}
+	return root
+}
+
+// Snapshot only source documents, not the derived DB/index touched by existing workspace opening.
+func publishSourceSnapshot(t *testing.T, root string) map[string]string {
+	t.Helper()
+	out := map[string]string{}
+	for _, rel := range []string{"AGENTS.md", "CLAUDE.md", ".bint/config.yml", ".bint/local.yml", ".bint/knowledge/items", ".bint/harness"} {
+		err := filepath.WalkDir(filepath.Join(root, rel), func(path string, d os.DirEntry, err error) error {
+			if os.IsNotExist(err) {
+				return nil
+			}
+			if err != nil {
+				return err
+			}
+			if d.IsDir() {
+				return nil
+			}
+			b, err := os.ReadFile(path)
+			if err != nil {
+				return err
+			}
+			out[path] = string(b)
+			return nil
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	return out
+}
+
+func TestPublishSizeBoundariesAndInvariance(t *testing.T) {
+	root := publishSizeRepo(t)
+	cfg, _, err := config.Load(root, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	inner, sel, err := AgentsBlock(root, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	base, _ := knowledge.RenderAgents(sel.Warnings, knowledge.RenderOptions{MaxItems: cfg.Knowledge.AgentsMDMaxItems})
+	if !strings.Contains(inner, "Hướng dẫn 🙂") || len(inner) <= len(base) {
+		t.Fatal("guidance fixture missing")
+	}
+	ctx := context.Background()
+	var published map[string]string
+	for _, tt := range []struct {
+		name, cap string
+		over      bool
+	}{
+		{"below", fmt.Sprint(len(inner) - 1), true}, {"equal", fmt.Sprint(len(inner)), false}, {"above", fmt.Sprint(len(inner) + 1), false}, {"unset", "null", false},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			if err := os.WriteFile(config.LocalPath(root), []byte("knowledge:\n  publish:\n    max_bytes: "+tt.cap+"\n"), 0644); err != nil {
+				t.Fatal(err)
+			}
+			before := publishSourceSnapshot(t, root)
+			rep, err := PublishAgents(ctx, PublishOptions{Dir: root, DryRun: true})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if rep.Size.Bytes != len(inner) || rep.Size.EstimatedTokens != (utf8.RuneCountInString(inner)+2)/3 || rep.OverBudget != tt.over || rep.Written {
+				t.Fatalf("report: %+v", rep)
+			}
+			if !reflect.DeepEqual(rep.Selection, sel) || len(rep.Size.LargestItems) != 1 {
+				t.Fatalf("selection changed: %+v", rep)
+			}
+			if !reflect.DeepEqual(before, publishSourceSnapshot(t, root)) {
+				t.Fatal("dry-run changed source files")
+			}
+			written, err := PublishAgents(ctx, PublishOptions{Dir: root, Yes: true})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if tt.over && !written.Written {
+				t.Fatal("low cap blocked publication")
+			}
+			docs := map[string]string{}
+			for _, name := range []string{"AGENTS.md", "CLAUDE.md"} {
+				b, err := os.ReadFile(filepath.Join(root, name))
+				if err != nil {
+					t.Fatal(err)
+				}
+				docs[name] = string(b)
+			}
+			if published == nil {
+				published = docs
+			} else if !reflect.DeepEqual(docs, published) {
+				t.Fatal("cap changed published bytes")
+			}
+			rep, err = PublishAgents(ctx, PublishOptions{Dir: root, DryRun: true})
+			if err != nil || rep.Changed || rep.Size.Bytes != len(inner) || rep.OverBudget != tt.over {
+				t.Fatalf("no-change report: %+v %v", rep, err)
+			}
+		})
+	}
+}
