index 0000000..8f63d7e
--- /dev/null
+++ b/internal/config/publish.go
@@ -0,0 +1,30 @@
+package config
+
+import (
+	"fmt"
+
+	"gopkg.in/yaml.v3"
+)
+
+// UnmarshalYAML giữ max_bytes là số nguyên: yaml.v3 mặc định cắt float thành int.
+// Kiểm cả khoá lạ vì Node.Decode không kế thừa KnownFields của decoder ngoài.
+func (p *KnowledgePublish) UnmarshalYAML(node *yaml.Node) error {
+	var fields map[string]yaml.Node
+	if err := node.Decode(&fields); err != nil {
+		return err
+	}
+	for key, value := range fields {
+		if key != "max_bytes" {
+			return fmt.Errorf("knowledge.publish: field %s not found in type config.KnowledgePublish", key)
+		}
+		v := &value
+		for v.Kind == yaml.AliasNode {
+			v = v.Alias
+		}
+		if v.Tag != "!!int" && v.Tag != "!!null" {
+			return fmt.Errorf("knowledge.publish.max_bytes: phải là null hoặc số nguyên dương")
+		}
+	}
+	type plain KnowledgePublish
+	return node.Decode((*plain)(p))
+}
