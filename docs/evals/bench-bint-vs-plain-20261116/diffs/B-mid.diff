+}
+
+func TestKnowledgePublishMaxBytesLayers(t *testing.T) {
+	t.Setenv("BINT_CONFIG_HOME", t.TempDir())
+	root := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(root, ".bint"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	write := func(path, value string) {
+		t.Helper()
+		if err := os.WriteFile(path, []byte(value), 0644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write(ProjectPath(root), "version: 1\n")
+	cfg, _, err := Load(root, true)
+	if err != nil || cfg.Knowledge.Publish.MaxBytes != nil {
+		t.Fatalf("legacy: %+v %v", cfg.Knowledge.Publish, err)
+	}
+	write(ProjectPath(root), "knowledge:\n  publish:\n    max_bytes: 123\n")
+	cfg, _, err = Load(root, true)
+	if err != nil || cfg.Knowledge.Publish.MaxBytes == nil || *cfg.Knowledge.Publish.MaxBytes != 123 {
+		t.Fatalf("project: %+v %v", cfg.Knowledge.Publish, err)
+	}
+	write(LocalPath(root), "knowledge:\n  publish:\n    max_bytes: null\n")
+	cfg, _, err = Load(root, true)
+	if err != nil || cfg.Knowledge.Publish.MaxBytes != nil {
+		t.Fatalf("null override: %+v %v", cfg.Knowledge.Publish, err)
+	}
+}
+
+func TestKnowledgePublishMaxBytesRejectsNonIntegers(t *testing.T) {
+	for _, value := range []string{"1.5", "true", "[1]", "{x: 1}", "\"100\""} {
+		cfg := Default()
+		if err := Decode(strings.NewReader("knowledge:\n  publish:\n    max_bytes: "+value+"\n"), &cfg); err == nil {
+			t.Errorf("max_bytes accepted non-integer %s", value)
+		}
+	}
+	cfg := Default()
+	if err := Decode(strings.NewReader("knowledge:\n  publish:\n    max_byte: 100\n"), &cfg); err == nil {
+		t.Fatal("publish accepted unknown field")
+	}
+}
