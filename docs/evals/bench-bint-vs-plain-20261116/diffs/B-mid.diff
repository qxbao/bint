+package knowledge
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestMeasureAgentsUTF8AndRenderedItems(t *testing.T) {
+	// The long original body must not outweigh an item with larger rendered text.
+	a := &Item{ID: "a", Title: "A", Body: "x\n" + strings.Repeat("long body\n", 20)}
+	b := &Item{ID: "b", Title: "B", Body: strings.Repeat("y", 100)}
+	sel := Selection{Rules: []*Item{a, b}}
+	before := append([]*Item(nil), sel.Rules...)
+	got := MeasureAgents("á🙂\n", sel, RenderOptions{MaxBodyLines: 1})
+	if got.Bytes != 7 || got.EstimatedTokens != 1 {
+		t.Fatalf("UTF-8: %+v", got)
+	}
+	if len(got.LargestItems) != 2 || got.LargestItems[0].ID != "b" || got.LargestItems[0].Bytes != 117 {
+		t.Fatalf("rendered sizes: %+v", got.LargestItems)
+	}
+	if !reflect.DeepEqual(sel.Rules, before) {
+		t.Fatal("measurement reordered selection")
+	}
+	if MeasureAgents("abcd", Selection{}, RenderOptions{}).EstimatedTokens != 2 {
+		t.Fatal("token rounding")
+	}
+}
+
+func TestMeasureAgentsTopFiveAndDefaultLines(t *testing.T) {
+	var sel Selection
+	for _, id := range []string{"g", "f", "e", "d", "c", "b", "a"} {
+		sel.Warnings = append(sel.Warnings, &Item{ID: id, Title: "T", Body: strings.Repeat("x\n", 9)})
+	}
+	got := MeasureAgents("", sel, RenderOptions{})
+	if len(got.LargestItems) != 5 {
+		t.Fatalf("top five: %+v", got)
+	}
+	for i, it := range got.LargestItems {
+		if it.ID != string(rune('a'+i)) {
+			t.Fatalf("tie order: %+v", got)
+		}
+	}
+	// Explicit 8 lines and default rendering must measure the same truncated item.
+	if !reflect.DeepEqual(got, MeasureAgents("", sel, RenderOptions{MaxBodyLines: 8})) {
+		t.Fatal("default lines differ")
+	}
+	if len(MeasureAgents("guidance", Selection{}, RenderOptions{}).LargestItems) != 0 {
+		t.Fatal("empty selection")
+	}
+}
