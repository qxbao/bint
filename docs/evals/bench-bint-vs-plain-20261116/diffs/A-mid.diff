@@ -0,0 +1,58 @@
+package app
+
+import (
+	"fmt"
+	"os"
+	"strings"
+
+	"bint/internal/config"
+	"bint/internal/i18n"
+	"bint/internal/knowledge"
+	"bint/internal/textutil"
+)
+
+// PublicationSize mô tả toàn bộ nội dung khối sắp xuất bản, gồm guidance và không gồm marker ngoài.
+// MaxBytes nil tắt cảnh báo. Kích thước không ảnh hưởng nội dung hay quyền ghi.
+type PublicationSize struct {
+	Bytes          int
+	TokensEstimate int
+	MaxBytes       *int
+	Exceeded       bool
+	LargestItems   []knowledge.ItemSize
+	Detail         string
+}
+
+func publicationCatalog(cfg config.Config) *i18n.Catalog {
+	return i18n.MustLoad(i18n.Resolve("", os.Getenv("BINT_LANG"), cfg.UI.Language,
+		os.Getenv("LC_ALL"), os.Getenv("LC_MESSAGES"), os.Getenv("LANG")))
+}
+
+func publicationSizeCheckName(cfg config.Config) string {
+	return publicationCatalog(cfg).T("knowledge.publish.size_check")
+}
+
+func measurePublication(inner string, sel knowledge.Selection, cfg config.Config) PublicationSize {
+	s := PublicationSize{Bytes: len(inner), TokensEstimate: textutil.EstimateTokens(inner),
+		MaxBytes: cfg.Knowledge.Publish.MaxBytes, LargestItems: knowledge.RenderedItemSizes(sel, knowledge.RenderOptions{})}
+	if len(s.LargestItems) > 5 {
+		s.LargestItems = s.LargestItems[:5]
+	}
+	s.Exceeded = s.MaxBytes != nil && s.Bytes > *s.MaxBytes
+	cat := publicationCatalog(cfg)
+	limit := cat.T("knowledge.publish.disabled")
+	if s.MaxBytes != nil {
+		limit = fmt.Sprintf("%d bytes", *s.MaxBytes)
+	}
+	lines := []string{cat.T("knowledge.publish.size", i18n.A{"bytes": s.Bytes, "tokens": s.TokensEstimate, "limit": limit})}
+	if s.Exceeded {
+		lines = append(lines, cat.T("knowledge.publish.exceeded"))
+	}
+	if len(s.LargestItems) > 0 {
+		lines = append(lines, cat.T("knowledge.publish.largest"))
+		for _, item := range s.LargestItems {
+			lines = append(lines, cat.T("knowledge.publish.item_size", i18n.A{"id": item.ID, "title": strings.Join(strings.Fields(item.Title), " "), "bytes": item.Bytes}))
+		}
+	}
+	s.Detail = strings.Join(lines, "\n")
+	return s
+}
