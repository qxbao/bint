+// Package textutil chứa phép đo văn bản dùng chung.
+package textutil
+
+import "unicode/utf8"
+
+// EstimateTokens ước lượng thô ceil(số ký tự/3), phù hợp văn bản tiếng Việt.
+// Chỉ để áp ngân sách và hiển thị, không dùng làm số liệu token đo thực tế.
+func EstimateTokens(s string) int { return (utf8.RuneCountInString(s) + 2) / 3 }
