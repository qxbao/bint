@@ -0,0 +1,36 @@
+package knowledge
+
+import (
+	"cmp"
+	"slices"
+	"strings"
+)
+
+// ItemSize đo phần nội dung thực sự xuất bản của một mục (không tính tiêu đề nhóm/phạm vi).
+type ItemSize struct {
+	ID    string
+	Title string
+	Bytes int
+}
+
+// RenderedItemSizes trả kích thước giảm dần, hoà thì ID tăng dần; không đổi selection.
+func RenderedItemSizes(sel Selection, opts RenderOptions) []ItemSize {
+	if opts.MaxBodyLines <= 0 {
+		opts.MaxBodyLines = 8
+	}
+	var sizes []ItemSize
+	for _, group := range [][]*Item{sel.Rules, sel.Warnings, sel.Reference} {
+		for _, it := range group {
+			var b strings.Builder
+			writeItem(&b, it, opts.MaxBodyLines)
+			sizes = append(sizes, ItemSize{ID: it.ID, Title: it.Title, Bytes: b.Len()})
+		}
+	}
+	slices.SortFunc(sizes, func(a, b ItemSize) int {
+		if n := cmp.Compare(b.Bytes, a.Bytes); n != 0 {
+			return n
+		}
+		return cmp.Compare(a.ID, b.ID)
+	})
+	return sizes
+}
