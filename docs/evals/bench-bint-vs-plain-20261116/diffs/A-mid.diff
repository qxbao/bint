+package app
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"bint/internal/config"
+	"bint/internal/fsafe"
+	"bint/internal/knowledge"
+	"bint/internal/testutil"
+)
+
+func TestPublicationSize(t *testing.T) {
+	t.Setenv("BINT_LANG", "")
+	cfg := config.Default()
+	cfg.UI.Language = "en"
+	body := "Chữ tiếng Việt\n"
+	sel := knowledge.Selection{Rules: []*knowledge.Item{{ID: "a", Title: "Luật", Body: "Dòng"}}}
+	n := len(body)
+	for _, tc := range []struct {
+		name     string
+		cap      *int
+		exceeded bool
+	}{
+		{"disabled", nil, false}, {"equal", &n, false}, {"high", intPtrSize(n + 1), false}, {"low", intPtrSize(n - 1), true}, {"zero", intPtrSize(0), true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg.Knowledge.Publish.MaxBytes = tc.cap
+			size := measurePublication(body, sel, cfg)
+			if size.Bytes != n || size.TokensEstimate != (utf8.RuneCountInString(body)+2)/3 || size.Exceeded != tc.exceeded {
+				t.Fatalf("size: %+v", size)
+			}
+			if len(size.LargestItems) != 1 || size.LargestItems[0].ID != "a" {
+				t.Fatalf("items: %+v", size)
+			}
+			if !strings.Contains(size.Detail, "bytes") || !strings.Contains(size.Detail, "a") || strings.Contains(size.Detail, "Warning:") != tc.exceeded {
+				t.Fatal(size.Detail)
+			}
+		})
+	}
+	cfg.UI.Language = "vi"
+	cfg.Knowledge.Publish.MaxBytes = intPtrSize(1)
+	if size := measurePublication(body, sel, cfg); !strings.Contains(size.Detail, "Cảnh báo:") {
+		t.Fatal(size.Detail)
+	}
+}
+
+func intPtrSize(n int) *int { return &n }
+
+func TestPublishSizeWarningDoesNotChangeContent(t *testing.T) {
+	testutil.Isolate(t)
+	asHuman(t)
+	root := testutil.NewRepo(t, map[string]string{"go.mod": "module demo\n"})
+	mustInit(t, InitOptions{Dir: root, Hooks: no(), NoSkills: true})
+	ctx := context.Background()
+	if _, err := PublishAgents(ctx, PublishOptions{Dir: root, Yes: true}); err != nil {
+		t.Fatal(err)
+	}
+	k, err := OpenKnowledge(ctx, root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := AddKnowledge(ctx, k, AddOptions{Type: knowledge.TypeRule, Title: "Luật", Body: "Nội dung tiếng Việt.", Origin: knowledge.OriginHuman}); err != nil {
+		t.Fatal(err)
+	}
+	cfg, _, err := config.Load(root, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	expected, _, err := AgentsBlock(root, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(root, "AGENTS.md")
+	before, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, cap := range []string{"1", "100000", "null"} {
+		if err := os.WriteFile(config.LocalPath(root), []byte("knowledge:\n  publish:\n    max_bytes: "+cap+"\n"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		rep, err := PublishAgents(ctx, PublishOptions{Dir: root, DryRun: true})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if rep.Written || rep.Size.Exceeded != (cap == "1") || rep.Size.Bytes != len(expected) {
+			t.Fatalf("cap=%s rep=%+v", cap, rep)
+		}
+		after, err := os.ReadFile(path)
+		if err != nil || string(before) != string(after) {
+			t.Fatalf("dry-run wrote AGENTS.md: %v", err)
+		}
+		cfg, _, err := config.Load(root, true)
+		if err != nil {
+			t.Fatal(err)
+		}
+		dr := &DoctorReport{}
+		knowledgeChecks(dr, root, cfg)
+		found := false
+		for _, check := range dr.Checks {
+			if check.Name == publicationSizeCheckName(cfg) {
+				found = true
+				want := LevelOK
+				if cap == "1" {
+					want = LevelWarn
+				}
+				if check.Level != want || check.Detail != rep.Size.Detail {
+					t.Fatalf("doctor/publish mismatch: %+v vs %+v", check, rep.Size)
+				}
+			}
+		}
+		if !found {
+			t.Fatal("doctor missing size check")
+		}
+	}
+	if err := os.WriteFile(config.LocalPath(root), []byte("knowledge:\n  publish:\n    max_bytes: 1\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	rep, err := PublishAgents(ctx, PublishOptions{Dir: root, Yes: true})
+	if err != nil || !rep.Written || !rep.Size.Exceeded {
+		t.Fatalf("warn must not block: %+v %v", rep, err)
+	}
+	blockPtr, err := fsafe.ReadBlock(path, fsafe.HTMLMarkers)
+	block := ""
+	if blockPtr != nil {
+		block = *blockPtr
+	}
+	if err != nil || block != strings.TrimSpace(expected) {
+		t.Fatalf("publication changed: %v\n%q\n%q", err, block, expected)
+	}
+}
