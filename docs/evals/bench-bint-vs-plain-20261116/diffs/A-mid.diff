+package cli_test
+
+import (
+	"os"
+	"strings"
+	"testing"
+
+	"bint/internal/config"
+	"bint/internal/testutil"
+)
+
+func TestPublishSizeWarningCLI(t *testing.T) {
+	testutil.Isolate(t)
+	root := testutil.NewRepo(t, map[string]string{"go.mod": "module demo\n"})
+	if out, code := run(t, root, "", "init", "--no-hooks"); code != 0 {
+		t.Fatalf("init: %d\n%s", code, out)
+	}
+	for _, lang := range []string{"vi", "en"} {
+		t.Run(lang, func(t *testing.T) {
+			t.Setenv("BINT_LANG", lang)
+			for _, cap := range []string{"0", "100000", "null"} {
+				if err := os.WriteFile(config.LocalPath(root), []byte("knowledge:\n  publish:\n    max_bytes: "+cap+"\n"), 0o644); err != nil {
+					t.Fatal(err)
+				}
+				out, code := run(t, root, "", "bootstrap", "publish", "--dry-run")
+				if code != 0 || !strings.Contains(out, "knowledge.publish.max_bytes:") || !strings.Contains(out, "bytes (~") {
+					t.Fatalf("publish: %d\n%s", code, out)
+				}
+				warning := "Cảnh báo: khối vượt"
+				if lang == "en" {
+					warning = "Warning: block exceeds"
+				}
+				if strings.Contains(out, warning) != (cap == "0") {
+					t.Fatalf("cap %s: %s", cap, out)
+				}
+				out, _ = run(t, root, "", "doctor") // Other doctor checks depend on installed harnesses.
+				if !strings.Contains(out, "knowledge.publish.max_bytes:") || strings.Contains(out, warning) != (cap == "0") {
+					t.Fatalf("doctor cap %s: %s", cap, out)
+				}
+			}
+		})
+	}
+}
