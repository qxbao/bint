@@ -0,0 +1,42 @@
+package knowledge
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestRenderedItemSizes(t *testing.T) {
+	a := newItem(TypeRule, StatusVerified, OriginHuman)
+	a.ID, a.Title, a.Body = "a", "Cảnh báo", "Một dòng\n"+strings.Repeat("x", 200)
+	b := newItem(TypeWarning, StatusVerified, OriginHuman)
+	b.ID, b.Title, b.Body = "b", "B", "ngắn"
+	omitted := newItem(TypeRule, StatusCandidate, OriginAgent)
+	omitted.ID, omitted.Body = "omitted", strings.Repeat("z", 1000)
+	opts := RenderOptions{MaxBodyLines: 1}
+	block, sel := RenderAgents([]*Item{b, omitted, a}, opts)
+	sizes := RenderedItemSizes(sel, opts)
+	if len(sizes) != 2 || sizes[0].ID != "a" || sizes[1].ID != "b" {
+		t.Fatalf("sizes = %+v", sizes)
+	}
+	var rendered strings.Builder
+	writeItem(&rendered, a, 1)
+	if sizes[0].Bytes != rendered.Len() || sizes[0].Title != a.Title {
+		t.Fatalf("actual rendered bytes: %+v vs %d", sizes[0], rendered.Len())
+	}
+	if sizes[0].Bytes >= len(a.Body)+len(a.Title)+100 {
+		t.Fatal("counted truncated body")
+	}
+	after, _ := RenderAgents([]*Item{b, omitted, a}, opts)
+	if after != block || sel.Rules[0] != a || sel.Warnings[0] != b {
+		t.Fatal("measurement changed publication")
+	}
+	// Equal byte counts are ordered by ID, independently of the selection order.
+	b.Title, b.Body = a.Title, a.Body
+	sizes = RenderedItemSizes(Selection{Rules: []*Item{b, a}}, opts)
+	if sizes[0].ID != "a" {
+		t.Fatal("unstable tie order")
+	}
+	if got := RenderedItemSizes(Selection{}, opts); len(got) != 0 {
+		t.Fatalf("empty: %v", got)
+	}
+}
