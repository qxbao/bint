+	"testing"
+)
+
+func TestNoProgressModes(t *testing.T) {
+	if Default().Workflow.NoProgress.Mode != "off" {
+		t.Fatal("default not off")
+	}
+	for _, mode := range []string{"off", "shadow", "stop", "bogus", ""} {
+		c := Default()
+		c.Workflow.NoProgress.Mode = mode
+		err := c.Validate()
+		if (mode == "off" || mode == "shadow") != (err == nil) {
+			t.Fatalf("%q: %v", mode, err)
+		}
+		if mode == "stop" && !strings.Contains(err.Error(), "stop") {
+			t.Fatal(err)
+		}
+	}
+}
