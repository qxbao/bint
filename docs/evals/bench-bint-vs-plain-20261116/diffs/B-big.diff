+package cli
+
+import (
+	"fmt"
+	"io"
+	"strconv"
+
+	"bint/internal/app"
+	"bint/internal/i18n"
+	"bint/internal/task"
+	"bint/internal/tui/actions"
+	"github.com/spf13/cobra"
+)
+
+func newTaskProgressCmd(stdio IO) *cobra.Command {
+	var asJSON bool
+	c := &cobra.Command{Use: "progress", Short: "Phân tích tiến triển các vòng sửa (chỉ đọc)", Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			ws, err := openTasks(cmd)
+			if err != nil {
+				return err
+			}
+			report, err := app.TaskProgress(cmd.Context(), ws, app.TaskProgressOptions{})
+			if err != nil {
+				return err
+			}
+			if asJSON {
+				return writeJSON(stdio.Out, report)
+			}
+			lang := ws.Cfg.UI.Language
+			if !i18n.Supported(lang) {
+				lang = i18n.Default
+			}
+			cat, err := i18n.Load(lang)
+			if err != nil {
+				return err
+			}
+			printTaskProgress(stdio.Out, cat, report)
+			return nil
+		}}
+	c.Flags().BoolVar(&asJSON, "json", false, "xuất JSON")
+	return c
+}
+
+func progressBool(b *bool) string {
+	if b == nil {
+		return "unknown"
+	}
+	return strconv.FormatBool(*b)
+}
+func progressInt(n *int) string {
+	if n == nil {
+		return "unknown"
+	}
+	return strconv.Itoa(*n)
+}
+func printTaskProgress(w io.Writer, cat *i18n.Catalog, r task.ProgressReport) {
+	fmt.Fprintln(w, cat.T(actions.TaskProgressTitleKey, nil))
+	for _, t := range r.Tasks {
+		fmt.Fprintf(w, "%s  %s  rounds=%d  first_would_stop_round=%s  extra_rounds=%s\n", t.ID, t.Status, t.RoundCount, progressInt(t.FirstWouldStopRound), progressInt(t.ExtraRounds))
+		printProgressObservations(w, t.Rounds)
+		for _, reason := range t.MissingReasons {
+			fmt.Fprintf(w, "  unknown: %s\n", reason)
+		}
+	}
+	s := r.Summary
+	fmt.Fprintln(w, cat.T(actions.TaskProgressSummaryKey, i18n.A{"tasks": s.Tasks, "rounds": s.Rounds, "comparable": s.ComparableRounds, "unknown": s.UnknownRounds, "stops": s.WouldStop, "extra": s.ExtraRounds, "samples": s.ExtraRoundsSamples, "missing": s.TasksWithMissingData, "errors": s.ReadErrors, "clean": s.DoneAfterStopWithCleanReview}))
+	for _, warning := range r.Warnings {
+		fmt.Fprintf(w, "! %s\n", warning)
+	}
+}
+func printProgressObservations(w io.Writer, observations []task.ProgressObservation) {
+	for _, o := range observations {
+		fmt.Fprintf(w, "  no_progress round=%d checkpoint=%s no_change=%s same_failure=%s new_scope=%s would_stop=%t\n", o.Round, o.Checkpoint, progressBool(o.NoChange), progressBool(o.SameFailure), progressBool(o.NewScope), o.WouldStop)
+		for _, reason := range o.MissingReasons {
+			fmt.Fprintf(w, "    unknown: %s\n", reason)
+		}
+	}
+}
