new file mode 100644
index 0000000..4a261ee
--- /dev/null
+++ b/internal/workflow/no_progress.go
@@ -0,0 +1,180 @@
+package workflow
+
+import (
+	"context"
+	"fmt"
+	"slices"
+	"strings"
+
+	"bint/internal/task"
+)
+
+// recordProgressRepair runs under the existing implement lock, only for a completed step.
+// Observation errors never enter fail/block or change the workflow's branch decisions.
+func (r *Runner) recordProgressRepair(ctx context.Context, rs *runState, sr *stepRun) {
+	if r.Cfg.Workflow.NoProgress.Mode != "shadow" {
+		return
+	}
+	after, err := WorktreeSnapshot(ctx, r.Root)
+	if err != nil {
+		r.progressNote(rs, "repair snapshot unavailable: "+err.Error())
+	}
+	before := sr.progressBefore
+	if sr.originRunID != "" || sr.continuations > 0 {
+		before = ""
+	} // original pre-interruption tree is unavailable
+	repair := task.ProgressRepair{Step: sr.step, RunID: sr.child, Before: task.TreeMark{Kind: "tree", Value: before}, After: task.TreeMark{Kind: "tree", Value: after}, At: r.at(), VerifyStart: len(rs.t.State.Verifications)}
+	nt, err := r.Tasks.Update(rs.t.State.ID, r.now(), func(t *task.Task) error {
+		for _, old := range t.State.ProgressRepairs {
+			if old.RunID == repair.RunID {
+				return nil
+			}
+		}
+		t.State.ProgressRepairs = append(t.State.ProgressRepairs, repair)
+		return nil
+	})
+	if err != nil {
+		r.progressNote(rs, "repair evidence not saved: "+err.Error())
+		return
+	}
+	rs.t = nt
+}
+
+func (r *Runner) progressNote(rs *runState, message string) {
+	message = "no_progress shadow: " + message
+	rs.res.Notes = append(rs.res.Notes, message)
+	r.logf("  %s", message)
+}
+
+func (r *Runner) observeProgress(rs *runState, checkpoint string, review *task.ReviewRound) {
+	if r.Cfg.Workflow.NoProgress.Mode != "shadow" {
+		return
+	}
+	repairs := rs.t.State.ProgressRepairs
+	e := task.ProgressEvidence{Round: len(repairs), Checkpoint: checkpoint, RunID: rs.runID, At: r.at()}
+	start := -1
+	cycleStart := 0
+	if len(rs.t.State.NoProgress) > 0 {
+		last := rs.t.State.NoProgress[len(rs.t.State.NoProgress)-1]
+		for i, repair := range repairs {
+			if repair.RunID == last.RepairRunID {
+				cycleStart = i + 1
+			}
+		}
+	}
+	if len(repairs) > 0 && cycleStart < len(repairs) {
+		first, last := repairs[cycleStart], repairs[len(repairs)-1]
+		e.RepairRunID = last.RunID
+		e.Completed = true
+		e.Before, e.After = first.Before, last.After
+		start = first.VerifyStart
+		var domain []string
+		for _, repair := range repairs[cycleStart:] {
+			domain = append(domain, repair.Step)
+			if repair.Before.Value == "" || repair.After.Value == "" {
+				e.Before.Value = ""
+			}
+		}
+		e.Domain = strings.Join(domain, "/")
+	} else if len(repairs) > 0 {
+		// Same cycle revisited at another checkpoint: use its last persisted boundary.
+		last := repairs[len(repairs)-1]
+		e.RepairRunID = last.RunID
+		for i := len(rs.t.State.NoProgress) - 1; i >= 0; i-- {
+			old := rs.t.State.NoProgress[i]
+			if old.RepairRunID == last.RunID {
+				e.Before, e.After, e.Completed, e.Domain = old.Before, old.After, old.Completed, old.Domain
+				break
+			}
+		}
+		start = last.VerifyStart
+	} else {
+		e.MissingReasons = append(e.MissingReasons, "completed repair evidence missing")
+	}
+	e.Round = 1
+	for _, old := range rs.t.State.NoProgress {
+		if old.Checkpoint == checkpoint {
+			e.Round = max(e.Round, old.Round+1)
+		}
+	}
+
+	if review != nil {
+		e.ReviewRound = review.Round
+		e.FindingsKnown = true
+		e.Findings = review.Findings
+	} else {
+		rev, err := rs.t.LoadReview()
+		if err == nil && rev.Last() != nil {
+			e.FindingsKnown = true
+			e.Findings = rev.Last().Findings
+			e.ReviewRound = rev.Last().Round
+		} else {
+			e.MissingReasons = append(e.MissingReasons, "review evidence missing")
+		}
+	}
+	// A checkpoint is recorded once per completed repair, including across session next/resume.
+	// Multiple clean reviewers do not create extra repair rounds.
+	for _, old := range rs.t.State.NoProgress {
+		if old.Checkpoint == checkpoint && old.RepairRunID == e.RepairRunID {
+			return
+		}
+	}
+	var candidates []*task.Verification
+	if start >= 0 && start <= len(rs.t.State.Verifications) {
+		for i := start; i < len(rs.t.State.Verifications); i++ {
+			v := &rs.t.State.Verifications[i]
+			if checkpoint == "full_verify" {
+				if !v.Full() || !strings.HasPrefix(v.Reason, partialReasonPrefix) {
+					continue
+				}
+			}
+			candidates = append(candidates, v)
+		}
+	}
+	if len(candidates) == 1 {
+		var err error
+		e.Verification, err = task.ProgressVerifyEvidence(rs.t.Dir, candidates[0])
+		if err != nil {
+			e.MissingReasons = append(e.MissingReasons, err.Error())
+		}
+	} else {
+		e.MissingReasons = append(e.MissingReasons, "verification missing or ambiguous for repair")
+	}
+	var prev *task.ProgressEvidence
+	seen := []string{}
+	for i := range rs.t.State.NoProgress {
+		old := &rs.t.State.NoProgress[i]
+		for _, finding := range old.Findings {
+			p := strings.TrimPrefix(strings.ReplaceAll(finding.Path, "\\", "/"), "./")
+			if p != "" {
+				seen = append(seen, p)
+			}
+		}
+		if old.Checkpoint == checkpoint {
+			copy := old.ProgressEvidence
+			prev = &copy
+		}
+	}
+	o := task.DetectProgress(e, prev, seen)
+	r.progressNote(rs, fmt.Sprintf("round=%d checkpoint=%s no_change=%s same_failure=%s new_scope=%s would_stop=%t", o.Round, checkpoint, progressSignal(o.NoChange), progressSignal(o.SameFailure), progressSignal(o.NewScope), o.WouldStop))
+	nt, err := r.Tasks.Update(rs.t.State.ID, r.now(), func(t *task.Task) error {
+		if slices.ContainsFunc(t.State.NoProgress, func(old task.ProgressObservation) bool {
+			return old.Checkpoint == checkpoint && old.RepairRunID == o.RepairRunID
+		}) {
+			return nil
+		}
+		t.State.NoProgress = append(t.State.NoProgress, o)
+		return nil
+	})
+	if err != nil {
+		r.progressNote(rs, "observation not saved: "+err.Error())
+		return
+	}
+	rs.t = nt
+}
+func progressSignal(b *bool) string {
+	if b == nil {
+		return "unknown"
+	}
+	return fmt.Sprint(*b)
+}
