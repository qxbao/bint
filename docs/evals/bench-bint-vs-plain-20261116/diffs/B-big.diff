+package app
+
+import (
+	"bint/internal/config"
+	"bint/internal/task"
+	"context"
+)
+
+type TaskProgressOptions struct{}
+
+func (o TaskProgressOptions) Defaults(_ config.Config) TaskProgressOptions { return o }
+func (o TaskProgressOptions) Validate() error                              { return nil }
+
+// TaskProgress bypasses reconciliation, ledger import, SQLite and all execution services.
+func TaskProgress(_ context.Context, ws *TaskWS, o TaskProgressOptions) (task.ProgressReport, error) {
+	if err := o.Validate(); err != nil {
+		return task.ProgressReport{}, err
+	}
+	return ws.Tasks.Progress()
+}
