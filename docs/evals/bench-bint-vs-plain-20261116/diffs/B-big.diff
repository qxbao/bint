+package workflow
+
+import (
+	"context"
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+
+	"bint/internal/task"
+)
+
+func TestNoProgressOffShadowProcessSession(t *testing.T) {
+	for _, session := range []bool{false, true} {
+		var baseline []string
+		var status string
+		for _, mode := range []string{"off", "shadow"} {
+			t.Run(mode+map[bool]string{false: "_process", true: "_session"}[session], func(t *testing.T) {
+				h := newHarness(t)
+				h.cfg.Workflow.NoProgress.Mode = mode
+				h.behave = h.blockingReview(2)
+				r := h.runner()
+				var logs strings.Builder
+				r.Logf = func(format string, args ...any) { fmt.Fprintf(&logs, format, args...) }
+				var tk *task.Task
+				var steps []string
+				var resultStatus string
+				if session {
+					tk = h.newSession(r, NewTaskOptions{})
+					steps, act := h.drive(r, tk.State.ID, false)
+					resultStatus = act.Status
+					_ = steps
+					// h.calls records the same fake-agent sequence for both drivers.
+				} else {
+					var err error
+					tk, _, err = r.NewTask(context.Background(), NewTaskOptions{Workflow: StepDo, Request: "Thêm tính năng app.txt"})
+					if err != nil {
+						t.Fatal(err)
+					}
+					res, err := r.Run(context.Background(), RunOptions{Workflow: StepDo, TaskRef: tk.State.ID})
+					if err != nil {
+						t.Fatal(err)
+					}
+					resultStatus = res.Status
+					if mode == "shadow" && !strings.Contains(strings.Join(res.Notes, " "), "no_progress shadow") {
+						t.Fatal("Result.Notes missing shadow")
+					}
+				}
+				steps = append(steps, h.calls...)
+				saved := loadTask(t, h, tk.State.ID)
+				if mode == "off" {
+					baseline = steps
+					status = resultStatus
+					if len(saved.State.NoProgress) != 0 || len(saved.State.ProgressRepairs) != 0 {
+						t.Fatal("off wrote observations")
+					}
+				} else {
+					if !reflect.DeepEqual(steps, baseline) || status != resultStatus {
+						t.Fatalf("changed flow: %v %s / %v %s", steps, resultStatus, baseline, status)
+					}
+					if !strings.Contains(logs.String(), "no_progress shadow") {
+						t.Fatal("shadow missing from Runner log")
+					}
+					if len(saved.State.NoProgress) != 2 || saved.State.NoProgress[0].WouldStop || !saved.State.NoProgress[1].WouldStop {
+						t.Fatalf("want first round conservative then no-change: %+v", saved.State.NoProgress)
+					}
+					if len(saved.State.NoProgress) == 0 || len(saved.State.ProgressRepairs) == 0 {
+						t.Fatal("no shadow evidence")
+					}
+					for _, o := range saved.State.NoProgress {
+						if o.Checkpoint != "review" {
+							t.Fatal(o)
+						}
+					}
+				}
+			})
+		}
+	}
+}
+
+func TestNoProgressObservationPureFailure(t *testing.T) {
+	h := newHarness(t)
+	h.cfg.Workflow.NoProgress.Mode = "shadow"
+	r := h.runner()
+	tk, _, err := r.NewTask(context.Background(), NewTaskOptions{Workflow: StepDo, Request: "app.txt"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	rs := &runState{t: tk, res: &Result{}}
+	r.observeProgress(rs, "full_verify", nil)
+	if len(rs.res.Notes) == 0 || !strings.Contains(rs.res.Notes[0], "shadow") {
+		t.Fatal(rs.res.Notes)
+	}
+}
+
+func TestNoProgressFullVerifyOffShadow(t *testing.T) {
+	for _, session := range []bool{false, true} {
+		var baseline []string
+		var baselineStatus string
+		for _, mode := range []string{"off", "shadow"} {
+			t.Run(mode+map[bool]string{false: "_process", true: "_session"}[session], func(t *testing.T) {
+				h := goHarness(t)
+				h.cfg.Workflow.NoProgress.Mode = mode
+				h.cfg.Workflow.MaxReviewRounds = 1
+				full := "echo stable_failure; test ! -f broken.txt"
+				h.cfg.Eval.TestCommand = &full
+				h.behaveFeat(func() {
+					h.write("a/a.go", "package a\n\nfunc A() int {return 2}\n")
+					h.write("broken.txt", "x\n")
+					h.write("done.txt", "ok\n")
+				})
+				r := h.runner()
+				var tk *task.Task
+				var status string
+				var notes []string
+				if session {
+					tk = h.newSession(r, NewTaskOptions{Plan: ptr(false), Request: "Thêm tính năng cho gói a"})
+					_, act := h.drive(r, tk.State.ID, false)
+					status = act.Status
+					notes = act.Notes
+				} else {
+					res, err := r.Run(context.Background(), RunOptions{Workflow: StepDo, Request: "Thêm tính năng cho gói a", Plan: ptr(false)})
+					if err != nil {
+						t.Fatal(err)
+					}
+					status = res.Status
+					tk = h.load(res.TaskID)
+					notes = res.Notes
+				}
+				saved := h.load(tk.State.ID)
+				if mode == "off" {
+					baseline = append([]string{}, h.calls...)
+					baselineStatus = status
+					if len(saved.State.NoProgress) != 0 {
+						t.Fatal("off observed")
+					}
+				} else {
+					if !reflect.DeepEqual(baseline, h.calls) || status != baselineStatus {
+						t.Fatalf("flow changed: %v %s / %v %s", h.calls, status, baseline, baselineStatus)
+					}
+					if len(saved.State.NoProgress) != 2 {
+						t.Fatalf("want two checkpoints: %+v notes=%v", saved.State.NoProgress, notes)
+					}
+					a, b := saved.State.NoProgress[0], saved.State.NoProgress[1]
+					if a.Checkpoint != "full_verify" || a.WouldStop || b.Checkpoint != "full_verify" || !b.WouldStop || b.SameFailure == nil || !*b.SameFailure {
+						t.Fatalf("%+v %+v", a, b)
+					}
+				}
+			})
+		}
+	}
+}
+
+func TestNoProgressMissingLogAndWriteFailure(t *testing.T) {
+	h := newHarness(t)
+	h.cfg.Workflow.NoProgress.Mode = "shadow"
+	r := h.runner()
+	tk, _, err := r.NewTask(context.Background(), NewTaskOptions{Workflow: StepDo, Request: "app.txt"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	tk.State.ProgressRepairs = []task.ProgressRepair{{RunID: "first"}, {RunID: "second", Before: task.TreeMark{Kind: "tree", Value: "same"}, After: task.TreeMark{Kind: "tree", Value: "same"}}}
+	tk.State.NoProgress = []task.ProgressObservation{{ProgressEvidence: task.ProgressEvidence{Round: 1, Checkpoint: "review", Completed: true, RepairRunID: "first"}}}
+	// Fail only the diagnostics update, without touching the workflow's normal task store.
+	r.Tasks.Dir = t.TempDir()
+	rs := &runState{t: tk, res: &Result{Status: task.StatusInReview}}
+	r.observeProgress(rs, "review", &task.ReviewRound{Round: 2})
+	if rs.res.Status != task.StatusInReview || len(rs.res.Notes) < 2 || !strings.Contains(strings.Join(rs.res.Notes, " "), "would_stop=true") || !strings.Contains(strings.Join(rs.res.Notes, " "), "not saved") {
+		t.Fatalf("%+v", rs.res)
+	}
+}
+
+func TestNoProgressContinuationHasUnknownTree(t *testing.T) {
+	h := newHarness(t)
+	h.cfg.Workflow.NoProgress.Mode = "shadow"
+	r := h.runner()
+	tk, _, err := r.NewTask(context.Background(), NewTaskOptions{Workflow: StepDo, Request: "app.txt"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	rs := &runState{t: tk, res: &Result{}}
+	r.recordProgressRepair(context.Background(), rs, &stepRun{child: "continued", step: StepFeat, progressBefore: "same", originRunID: "original"})
+	if len(rs.t.State.ProgressRepairs) != 1 || rs.t.State.ProgressRepairs[0].Before.Value != "" {
+		t.Fatal("continuation baseline treated as original repair", rs.t.State.ProgressRepairs)
+	}
+}
+
+func TestNoProgressWholeRepairSequence(t *testing.T) {
+	h := newHarness(t)
+	h.cfg.Workflow.NoProgress.Mode = "shadow"
+	r := h.runner()
+	tk, _, err := r.NewTask(context.Background(), NewTaskOptions{Workflow: StepDo, Request: "app.txt"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	rs := &runState{t: tk, res: &Result{}}
+	// Two implement steps belong to each repair cycle; the final step is a no-op.
+	first := task.ProgressRepair{RunID: "a1", Step: "impl-a", Before: task.TreeMark{Kind: "tree", Value: "original"}, After: task.TreeMark{Kind: "tree", Value: "changed"}}
+	last := task.ProgressRepair{RunID: "b1", Step: "impl-b", Before: first.After, After: first.After}
+	rs.t.State.ProgressRepairs = []task.ProgressRepair{first, last}
+	r.observeProgress(rs, "review", &task.ReviewRound{Round: 1})
+	first.RunID = "a2"
+	first.Before = first.After
+	first.After.Value = "changed-again"
+	last.RunID = "b2"
+	last.Before = first.After
+	last.After = first.After
+	rs.t.State.ProgressRepairs = append(rs.t.State.ProgressRepairs, first, last)
+	r.observeProgress(rs, "review", &task.ReviewRound{Round: 2})
+	got := rs.t.State.NoProgress[len(rs.t.State.NoProgress)-1]
+	if got.NoChange == nil || *got.NoChange || got.WouldStop || got.Domain != "impl-a/impl-b" {
+		t.Fatalf("not whole repair: %+v", got)
+	}
+}
