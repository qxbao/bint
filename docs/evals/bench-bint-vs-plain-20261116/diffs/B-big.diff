+package cli_test
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"bint/internal/app"
+	"bint/internal/task"
+)
+
+func progressTree(t *testing.T, roots ...string) map[string]string {
+	t.Helper()
+	out := map[string]string{}
+	for _, root := range roots {
+		err := filepath.WalkDir(root, func(p string, d fs.DirEntry, err error) error {
+			if err != nil {
+				return err
+			}
+			if d.IsDir() {
+				return nil
+			}
+			b, err := os.ReadFile(p)
+			if err != nil {
+				return err
+			}
+			out[p] = fmt.Sprintf("%x", sha256.Sum256(b))
+			return nil
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	return out
+}
+
+func TestTaskProgressReadOnly(t *testing.T) {
+	for _, ledger := range []string{"git", "local"} {
+		t.Run(ledger, func(t *testing.T) {
+			root := newLintRepo(t)
+			id := newTaskID(t, root, "--no-plan", "Đổi app.txt")
+			cfg := filepath.Join(root, ".bint", "config.yml")
+			b, err := os.ReadFile(cfg)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if ledger == "local" {
+				b = []byte(strings.Replace(string(b), "ledger: git", "ledger: local", 1))
+				if err = os.WriteFile(cfg, b, 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			ws, err := app.OpenWorkspace(context.Background(), root, true)
+			if err != nil {
+				t.Fatal(err)
+			}
+			s := task.NewStore(ws.Paths.Runtime)
+			// Supply both a valid finished ticket and a corrupt neighbor, without executing any agent.
+			if _, err = s.Update(id, time.Now(), func(tk *task.Task) error { tk.State.Status = task.StatusDone; return nil }); err != nil {
+				t.Fatal(err)
+			}
+			bad := filepath.Join(s.Dir, "BROKEN")
+			os.MkdirAll(bad, 0700)
+			os.WriteFile(filepath.Join(bad, task.StateFile), []byte("broken"), 0600)
+			before := progressTree(t, root, ws.Paths.Root)
+			for _, args := range [][]string{{"task", "progress"}, {"task", "progress", "--json"}} {
+				out, code := run(t, root, "", args...)
+				if code != 0 || !strings.Contains(out, id) || !strings.Contains(out, "BROKEN") {
+					t.Fatalf("%v: %d %s", args, code, out)
+				}
+				if args[len(args)-1] == "--json" {
+					var report task.ProgressReport
+					if err := json.Unmarshal([]byte(out), &report); err != nil || len(report.Tasks) == 0 || report.Tasks[0].Status != task.StatusDone {
+						t.Fatalf("%v %s", err, out)
+					}
+				}
+			}
+			if after := progressTree(t, root, ws.Paths.Root); !reflect.DeepEqual(before, after) {
+				t.Fatal("progress changed repository/runtime/SQLite")
+			}
+		})
+	}
+}
+
+func TestRunStatusShowsShadowWithoutRuns(t *testing.T) {
+	root := newLintRepo(t)
+	id := newTaskID(t, root, "--no-plan", "Đổi app.txt")
+	ws, err := app.OpenWorkspace(context.Background(), root, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := task.NewStore(ws.Paths.Runtime)
+	if _, err = s.Update(id, time.Now(), func(tk *task.Task) error {
+		tk.State.NoProgress = []task.ProgressObservation{{ProgressEvidence: task.ProgressEvidence{Round: 2, Checkpoint: "review"}, WouldStop: true}}
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	for _, args := range [][]string{{"run", "status", id}, {"run", "status", id, "--json"}, {"task", "show", id, "--json"}} {
+		out, code := run(t, root, "", args...)
+		if code != 0 || !strings.Contains(out, "no_progress") {
+			t.Fatalf("%v %d %s", args, code, out)
+		}
+	}
+}
